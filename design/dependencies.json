      "path": "crates/foundation/engine",
      "dependencies": [
        "nepl3-core",
        "nepl3-reader"
      ],
      "no_std": true,
      "responsibility": "共通prefix parser・束縛・editor query"
    },
    {
      "name": "nepl3-wire",
      "path": "crates/foundation/wire",
      "dependencies": [
        "nepl3-core"
      ],
      "no_std": true,
      "responsibility": "canonical CBOR codecと境界検査"
    },
    {
      "name": "nepl3-grammar-core",
      "path": "crates/languages/grammar/core",
      "dependencies": [
        "nepl3-core",
        "nepl3-reader",
