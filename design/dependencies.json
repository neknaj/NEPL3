{
  "edge_direction": "consumer -> dependency",
  "workspace": [
    {
      "name": "nepl3-core",
      "path": "crates/foundation/core",
      "dependencies": [],
      "no_std": true,
      "responsibility": "共通の値・schema・source・origin・diagnostic契約"
    },
