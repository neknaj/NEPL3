article ja "Doc[移行候補/いこうこうほ]"
body
  cons paragraph
    cons "このdirectoryは[正式文書/せいしきぶんしょ]をDocへ[移行/いこう]するための[候補/こうほ]を[置/お]きます。"
    cons sentence cons ruby text "移行済" text "いこうず" cons text "みページの" cons ruby text "正本" text "せいほん" cons text "は " cons code "../canonical.json" cons text " に" cons ruby text "登録" text "とうろく" cons text "されたDoc" cons ruby text "原稿" text "げんこう" cons text "です。" nil
    cons "[未登録/みとうろく]ページは[元/もと]のMarkdownを[正本/せいほん]とします。"
    nil
  cons paragraph
    cons sentence cons code "authored/" cons text " は " cons link relative "../authoring.md" none ruby text "執筆指針" text "しっぴつししん" cons text " に" cons ruby text "従" text "したが" cons text "って" cons ruby text "人" text "ひと" cons text "が" cons ruby text "読" text "よ" cons text "む" cons ruby text "文" text "ぶん" cons text "・" cons ruby text "振" text "ふ" cons text "り" cons ruby text "仮名" text "がな" cons text "・" cons ruby text "注釈" text "ちゅうしゃく" cons text "・" cons ruby text "構造" text "こうぞう" cons text "を" cons ruby text "判断" text "はんだん" cons text "して" cons ruby text "書" text "か" cons text "き" cons ruby text "直" text "なお" cons text "した" cons ruby text "原稿" text "げんこう" cons text "です。" nil
    cons "[元文書/もとぶんしょ]のcommitとdigestを[固定/こてい]して[対応/たいおう]を[確認/かくにん]し、[執筆者/しっぴつしゃ]とは[別/べつ]の[担当/たんとう]が[本文/ほんぶん]・コード・[表/ひょう]・[参照/さんしょう]を[独立/どくりつ]レビューします。"
    cons "[通常/つうじょう]の[本文/ほんぶん]にはsentence literalを[使/つか]い、コードや[参照/さんしょう]などを[含/ふく]む[文/ぶん]には[明示的/めいじてき]なsentence[構築/こうちく]を[使/つか]います。"
    cons "[原本/げんぽん]が[更新/こうしん]された[場合/ばあい]は[差分/さぶん]を[原稿/げんこう]にも[反映/はんえい]し、その[差分/さぶん]を[再/さい]レビューします。"
    nil
  cons paragraph
    cons "[原稿/げんこう]の[作成/さくせい]・[内容/ないよう]レビューと、[実処理系/じつしょりけい]によるHTML[生成/せいせい]・リンク/[旧/きゅう]anchor[互換/ごかん]・[正式/せいしき]な[正本切替/せいほんきりか]えは[別/べつ]の[工程/こうてい]です。"
    cons sentence cons link relative "../spec/16-doc-migration.md" none ruby text "移行条件" text "いこうじょうけん" cons text "が" cons ruby text "満" text "み" cons text "たされるまではMarkdownを" cons ruby text "削除" text "さくじょ" cons text "しません。" nil
    cons "[切替/きりか]え[後/ご]はDocを[単一/たんいつ]の[正本/せいほん]とし、[必要/ひつよう]なMarkdown[入口/いりぐち]は[生成/せいせい]projectionとして[維持/いじ]します。"
    nil
  cons section generated_signatures "[構文表/こうぶんひょう]の[生成候補/せいせいこうほ]"
    body
      cons paragraph
        cons sentence cons code "generated/*-signatures.nepld" cons text " は " cons code "design/forms.json" cons text " から" cons ruby text "生成" text "せいせい" cons text "する4" cons ruby text "言語" text "げんご" cons text "の" cons ruby text "構文表" text "こうぶんひょう" cons text "です。" nil
        cons sentence cons code "python tools/generate/signatures.py --write" cons text " で" cons ruby text "更新" text "こうしん" cons text "し、" cons ruby text "引数" text "ひきすう" cons text "なし" cons ruby text "実行" text "じっこう" cons text "で" cons ruby text "差分" text "さぶん" cons text "を" cons ruby text "検査" text "けんさ" cons text "します。" nil
        cons "[通常本文/つうじょうほんぶん]の[機械的/きかいてき]な[置換/ちかん]ではなく、[規範/きはん]データのカテゴリ・form・field[順/じゅん]・[読取/よみとり]カテゴリ・arity・[葉/は]の[規則/きそく]をDocのsectionとtableへ[投影/とうえい]します。"
        cons "コードはInlineCodeで[保持/ほじ]します。"
        cons "これらは[手書/てが]きで[保守/ほしゅ]せず、[元/もと]のMarkdown[構文表/こうぶんひょう]との[正本切替/せいほんきりか]えや[旧/きゅう]anchor[互換/ごかん]の[完了/かんりょう]とは[区別/くべつ]します。"
        nil
      nil
  cons section generated_candidates "[生成変換器/せいせいへんかんき]の[検証候補/けんしょうこうほ]"
    body
      cons paragraph
        cons sentence cons ruby text "以下" text "いか" cons text "の " cons code "00-contract.nepld" cons text " と" cons ruby text "確認用索引" text "かくにんようさくいん" cons text "は、" cons ruby text "限定" text "げんてい" cons text "した" cons ruby text "変換器" text "へんかんき" cons text "と" cons ruby text "処理系" text "しょりけい" cons text "の" cons ruby text "検証" text "けんしょう" cons text "に" cons ruby text "使" text "つか" cons text "う" cons ruby text "生成物" text "せいせいぶつ" cons text "です。" nil
        cons sentence cons ruby text "入力" text "にゅうりょく" cons text "は " cons code "tools/migration/fixtures/00-contract.md" cons text " に" cons ruby text "固定" text "こてい" cons text "した" cons ruby text "移行前" text "いこうまえ" cons text "のMarkdownです。" nil
        cons "commitとdigestは[同/おな]じdirectoryのREADMEに[記録/きろく]しています。"
        cons "[現在/げんざい]の[正式仕様/せいしきしよう]やその[生成/せいせい]Markdownを[変換器/へんかんき]の[入力/にゅうりょく]に[戻/もど]さず、[固定/こてい]fixtureから[再生成/さいせいせい]して[内容/ないよう]・[構造/こうぞう]を[比較/ひかく]します。"
        cons "[手書/てが]き[保守/ほしゅ]はしません。"
        cons sentence cons code "authored/" cons text " の" cons ruby text "執筆原稿" text "しっぴつげんこう" cons text "や " cons code "doc/spec/00-contract.nepld" cons text " の" cons ruby text "正式正本" text "せいしきせいほん" cons text "とは" cons ruby text "用途" text "ようと" cons text "が" cons ruby text "異" text "こと" cons text "なります。" nil
        nil
      cons paragraph
        cons sentence cons ruby text "最初" text "さいしょ" cons text "の" cons ruby text "変換器検証用" text "へんかんきけんしょうよう" cons text "fixtureは " cons link relative "00-contract.nepld" none concat cons ruby text "対象" text "たいしょう" cons text "と" cons ruby text "設計上" text "せっけいじょう" cons text "の" cons ruby text "決定" text "けってい" nil cons text "。" nil
        cons sentence cons code "python tools/migration/contract.py --write" cons text " で" cons ruby text "生成" text "せいせい" cons text "し、" cons ruby text "同" text "どう" cons text "コマンドの" cons ruby text "引数" text "ひきすう" cons text "なし" cons ruby text "実行" text "じっこう" cons text "で" cons ruby text "固定" text "こてい" cons text "した" cons ruby text "移行前入力" text "いこうまえにゅうりょく" cons text "との" cons ruby text "対応" text "たいおう" cons text "を" cons ruby text "検査" text "けんさ" cons text "します。" nil
        cons "この[変換器/へんかんき]が[扱/あつか]うのは[該当/がいとう]ページの[見出/みだ]し・[段落/だんらく]・flat list・inline codeだけで、[未対応/みたいおう]のMarkdownを[黙/だま]ってTextへ[変/か]えません。"
        nil
      cons paragraph
        cons "[生成後/せいせいご]は[通常/つうじょう]のDoc parser、lower、prepare、HTML backendへ[入力/にゅうりょく]します。"
        cons "この[生成/せいせい]fixture[自体/じたい]の[人/ひと]による[意味同等性/いみどうとうせい]レビュー、[旧/きゅう]anchor[互換/ごかん]や[正本切替/せいほんきりかえ]を[主張/しゅちょう]しません。"
        cons "[正式/せいしき][第/だい]0[章/しょう]の[手動執筆/しゅどうしっぴつ]・[独立/どくりつ]レビュー・annotated projectionとは[別/べつ]の[検証経路/けんしょうけいろ]です。"
        cons "この[変換器/へんかんき]の[成功/せいこう]をT21やPages[公開/こうかい]の[完了/かんりょう]とは[扱/あつか]いません。"
        nil
      cons paragraph
        cons "[確認用/かくにんよう]の[索引/さくいん]と[候補/こうほ]を[同/おな]じページ[集合/しゅうごう]として[生成/せいせい]できます。"
        nil
      cons rawcode some "sh" "python tools/migration/contract.py\npython -m unittest discover -s tools/migration -p test_contract.py\nmkdir -p dist\ncargo run --locked -p nepl3-tools -- doc-html pages doc/migration/pages.json dist/doc-migration\n"
      cons paragraph
        cons "[出力先/しゅつりょくさき]は[未作成/みさくせい]のdirectoryを[指定/してい]します。"
        cons "[索引/さくいん]から[候補/こうほ]への[参照/さんしょう]、[実際/じっさい]のHTML[配置/はいち]、[各/かく]ページのCSSを[同/おな]じ[生成処理/せいせいしょり]で[検査/けんさ]します。"
        cons "この[索引/さくいん]は[移行確認用/いこうかくにんよう]の[新規/しんき]Doc[原稿/げんこう]であり、[既存/きそん]Markdown[文書/ぶんしょ]の[第二/だいに]の[正本/せいほん]ではありません。"
        nil
      nil
  cons section markdown_compatibility "Markdown[互換表示/ごかんひょうじ]の[確認/かくにん]"
    body
      cons rawcode some "sh" "mkdir -p dist\ncargo run --locked -p nepl3-tools -- doc-markdown doc/migration/00-contract.nepld dist/00-contract.view.md\n"
      cons paragraph
        cons "[既存/きそん]のファイルには[上書/うわが]きしません。"
        cons "Doc[構造/こうぞう]を[再度検査/さいどけんさ]し、[原稿/げんこう]path・digestとrenderer[版/ばん]を[記/しる]したMarkdownを[生成/せいせい]します。"
        cons "[現在/げんざい]の[対応/たいおう]は、この[候補/こうほ]に[必要/ひつよう]な[同階層/どうかいそう]の[節/せつ]、[段落/だんらく]、[単純/たんじゅん]なunordered list、Text、InlineCodeです。"
        cons "[空白/くうはく]や[記号/きごう]が[別/べつ]のMarkdown[構造/こうぞう]にならないよう[検査/けんさ]し、[注釈/ちゅうしゃく]・parallel・リンク・[表/ひょう]・[隣接/りんせつ]code・[入/い]れ[子/こ]の[節/せつ]などは[省略/しょうりゃく]せず[拒否/きょひ]します。"
        cons "[固定/こてい]した[移行前/いこうまえ]Markdownと、[検証/けんしょう]fixtureから[生成/せいせい]したMarkdownを[独立/どくりつ]したMarkdown parserへ[通/とお]し、[本文/ほんぶん]とblock/codeのevent[列/れつ]を[比較/ひかく]します。"
        cons "これは[限定/げんてい]した[互換表示/ごかんひょうじ]で、DocのIDやsource mappingをMarkdownから[復元/ふくげん]する[一般的/いっぱんてき]なroundtripではありません。"
        nil
      nil
  nil
