article ja "13. [再現性/さいげんせい]・schema[識別/しきべつ]・[契約/けいやく]の[判定/はんてい]"
body
  cons section policy "[方針/ほうしん]" body
    cons paragraph
      cons "共有する意味と実装固有のアルゴリズムを分ける。"
      cons "digestの自己参照、言語同士の相互埋め込みによるhash循環、source順と識別子順の混同を避ける。" nil
    nil
  cons section digest "1. digest" body
    cons paragraph
      cons "Bytes32のdigest関数はSHA-256に固定する。"
      cons "sourceとresourceのcontent digestは元のbyte列にそのまま適用する。"
      cons "BOM、改行、空白も内容の一部であり、Unicode正規化を行わない。"
      cons "SourceContentのURIはhostが付ける論理的な絶対locatorであり、SourceRefの同一性とは別に保持する。"
      cons "coreはOS path canonicalizationをしない。" nil
    cons paragraph
      cons sentence cons text "このlocatorの字句profileはASCIIのscheme " cons code "[A-Za-z][A-Za-z0-9+.-]*:" cons text " と空でない後続文字列である。" nil
      cons sentence cons text "control・未escapeの空白を拒否し、" cons code "%" cons text " は2桁のASCII hexが続く場合だけ許す。" nil
      cons "scheme以降のUnicode文字を正規化しない。"
      cons "相対path・空文字をabsolute locatorとして受け付けない。"
      cons "これはhost内部locatorの境界であり、HTTPのauthorityなどscheme固有の妥当性や到達可能性を保証しない。"
      cons "外部URLとして使用するadapterはその用途のURI/IRI検査を行う。"
      cons sentence cons text "schemeの根拠は " cons link external "https://www.rfc-editor.org/rfc/rfc3986.html#section-3.1" text "RFC 3986 §3.1" cons text "、Unicodeを含む識別子とURIの区別は " cons link external "https://www.rfc-editor.org/rfc/rfc3987.html" text "RFC 3987" cons text "。" nil nil
    cons paragraph
      cons "SchemaRef.digestは、schemaの正規descriptorを対象とする。"
      cons "正規descriptorはpackage名、revision、kind/variant/field定義、意味上のoperation署名、局所制約識別を含み、source位置、documentation、cache、生成時刻を含まない。"
      cons "自己参照とforeign schemaは(package, revision, typeName)の記号的参照とし、このdescriptor内へ相互のdigestを再帰的に埋め込まない。"
      cons "実際に使用するforeign digestはProfileの解決済み一覧で固定して検査する。"
      cons "これによりDocとMathが互いの型を参照してもhashの固定点を計算する必要はない。" nil
    cons paragraph
      cons "型のconstraintsは実行順ではなく、名前で識別する局所制約の集合である。"
      cons "空・重複の識別子を拒否し、canonical descriptorへ変換するときにUnicode scalar順のarrayへ並べる。"
      cons "fieldやordered-choiceの意味順を持つarrayとは区別する。" nil
    cons paragraph
      cons "descriptorの正規化データはNull/Bool/非負Integer/Text/Array/Objectだけを使う。"
      cons sentence cons text "JSONをdigest入力として使う場合、object keyをUnicode scalar順にsortし、array順を維持し、空白なし、UTF-8、引用符とbackslashをescapeし、U+0000..001Fは小文字hexの" cons code "\\u00xx" cons text "でescapeし、それ以外のscalarは直接UTF-8とする。" nil
      cons "整数は先頭zeroなし。"
      cons "float、負数、surrogate、重複keyは禁止。"
      cons sentence cons text "hash入力はASCII " cons code "NEPL3-SCHEMA-1" cons text " + 1byte zero + このcanonical JSON。" nil nil
    cons paragraph
      cons sentence cons text "Grammar packageの意味digestはschema digestと、source位置を除いたreader/binding/style/shape/provider要件の正規descriptorに対して、同じ規則でdomain separatorを " cons code "NEPL3-PACKAGE-1" cons text " として計算する。" nil
      cons "局所kind IDはkind名のscalar順で割り当てる。"
      cons "field・宣言・ordered-choiceの意味上の順序はarrayとして保存する。"
      cons "名前で識別するsum/union/variantsのmap順には意味がなく、canonical JSONのkey sortで一致させる。"
      cons "variant payloadのfield順はarrayとして保存する。"
      cons "fieldの順序交換はdigestを変え、variant mapのkey順だけの交換は変えない。"
      cons "seedとcompile後のpackageは意味digestを比較し、provenanceの違いを意味不一致としない。"
      cons "source artifactのdigestは別に記録する。" nil
    cons paragraph
      cons "wireの操作要求は、解決済みProfileの全SchemaRefとprovider revisionを含めてcache keyを作る。"
      cons "URIやsnapshot所属を除いてよいのは明示的な意味値だけのcacheであり、診断/editor結果のcacheにはsource identityとrevisionが必要。" nil
    cons section semantic "Package[意味正規形/いみせいきけい]" body
      cons paragraph
        cons sentence cons text "実装の" cons code "CheckedLanguagePackage::semantic_json" cons text "はcategories、extensions、forms、leaves、modes、namespaces、payloadSchemas、reader、recovery、root、schemaのkeyを持つcanonical JSONを返す。" nil
        cons "Category/Mode/Namespace/Extensionは名前順、Formはcategoryとspelling順、Leafはcategoryとcanonical token-kind ID順、payloadSchemasはpackage/revision/digest順に並べる。"
        cons "重複するpayload SchemaRefは拒否する。"
        cons sentence cons text "各レコードのpayload field順は" cons code "interfaces/engine.json" cons text "の対応型に従う。" nil
        cons "ただしread/binding参照は下記の式へ展開し、provenanceとarenaそのものは含めない。"
        cons "styleにはschema/nameに加えてfallback roleも含める。" nil
      cons paragraph
        cons "readとbindingの式はvariant名を先頭とするarrayで、variantのpayloadはnative公開型のfield順とする。"
        cons sentence cons text "ListOfは" cons code "[\"ListOf\",cons,nil,element]" cons text "、Builtinは" cons code "[\"Builtin\",reader,kind,tokenKind]" cons text "とする。" nil
        cons sentence cons text "kindは" cons code "[SchemaRef,localKind]" cons text "、operationは" cons code "[SchemaRef,name]" cons text "、styleは" cons code "[selector,SchemaRef,name,fallback]" cons text "である。" nil
        cons sentence cons text "modeは" cons code "[name,skipReaders,takePairs]" cons text "、formは" cons code "[category,spelling,kind,fields,binding,styles]" cons text "、leafは" cons code "[category,kind,tokenKind,payloadType,binding,styles]" cons text "とする。" nil
        cons "field、skip/take、choice/seq、bindingの子、styleの各列は意味順を保存する。" nil
      cons paragraph
        cons "readerは全名前付きruleを名前順にたどり、直接DAGの共有を出現ごとに展開したpostorder arenaへ置換したうえで、ReaderPlanの既存canonical descriptor形式を使う。"
        cons "rule名でのRefは展開しない。"
        cons "名前付きruleは未使用でも公開宣言として残す。"
        cons "匿名の未到達arena entryは意味正規形に含めないが、package検査はその不正参照・cycleも拒否する。"
        cons "ReadSpec/Bindingも使用元から展開し、匿名entryの共有・配置・未到達収納の差を除く。"
        cons "巨大な展開は共通予算でStoppedを返し、recursive stackに依存しない。" nil
      cons paragraph
        cons "この正規形は実行上の任意の等価性を証明するものではない。"
        cons "例えば異なるreader式への代数的書換えを同一視しない。"
        cons "providerの要求署名はpackageへ含めるが、hostの実装artifact identityは下記の解析Profileへ含める。"
        cons "packageの出自を持つeditor結果はこの意味digestだけでcacheしない。" nil
      cons paragraph
        cons sentence cons text "recoveryは " cons code "[defaultUnexpected,rules]" cons text " とし、ruleはcategory順の " cons code "[category,unexpected,synchronization]" cons text "、同期列は宣言順の " cons code "[ancestorCategory,kind,spellingOrNull]" cons text " とする。" nil
        cons "回復方針も実行挙動であり、順序やstrategyの変更を意味identityへ反映する。" nil
      nil
    cons section execution "[具体実行/ぐたいじっこう]identity" body
      cons paragraph
        cons "継続のarena indexと出自の参照先を固定するため、packageは意味identityとは別にexecutionDigestを持つ。"
        cons sentence cons text "hashは " cons code "NEPL3-PACKAGE-EXECUTION-1" cons text " + zero byte + 具体実行canonical JSON とする。" nil
        cons "意味正規形に加え、元のReaderPlan descriptor、ReadSpec/Bindingの全arenaと直接参照ID、form/leaf等の宣言配置、宣言のOrigin参照、全provenance source identity/URI、Origin/sourceMap tableを含める。"
        cons "sourceのbytesは検査済みsnapshot digestで固定する。"
        cons "意味上等しいarena再配置やgrammar source位置だけの変更でも、古いframeや診断originを再利用しない。" nil
      cons paragraph
        cons "EntryContextはpackage意味identityに加えてProfile内のaliasを保持する。"
        cons "同じpackageを異なるcategory-mode overrideで複数登録できるため、packageから最初のaliasを逆引きしてはならない。"
        cons "NodeSelectionのform/leaf/read/binding indexはそのaliasが指すexecutionDigestの実tableに属する。"
        cons "再開および後段での利用時に具体digestを照合し、意味digestが一致する別配置へ勝手に差し替えない。" nil
      nil
    nil
  cons section wire "2. native[値/ち]とwire[値/ち]" body
    cons paragraph
      cons "型名中のU64/Bytes32等の有限primitiveと、任意精度Natural/Integerを区別する。"
      cons "wire sourceはopaque SourceId/revision/digestを使う。"
      cons "同じIDをbundle内・操作間の対応づけに使用し、URIやnative allocation addressへ置き換えない。"
      cons "同じURI/revision/byte列を持つ独立文書もSourceIdが異なれば別snapshotである。"
      cons "r3のURI-based bijectionは、この場合にspec02の宣言同一性を失うためr4で訂正した。" nil
    cons paragraph
      cons "native node indexはallocationごとのIDでもよい。"
      cons "wire bundleではrootからfield順に訪問した最初の出現順で連番にする。"
      cons "shared nodeは二回目以降referenceを使う。"
      cons "source tableはSourceIdのUnicode scalar順、revisionの数値順、digestのbyte順とし、schema tableはpackage/revision/digest順。"
      cons "Originの親参照はDAGを検査し、payload nodeとorigin nodeのID空間を分ける。"
      cons "SourceIdはこのnode index再採番の対象にしない。" nil
    cons paragraph
      cons "NodeRefの訪問はdepth-firstで、Childをその位置、Childrenを列の順にたどる。"
      cons "rootは0となり、全NodeRefを書き換える。"
      cons "ForeignSyntaxはguest bundleで独立して再採番し、ForeignSyntax.rootもguestの0へ対応させる。"
      cons "wire bundleは単一rootの到達閉包を表すため、到達不能nodeはUnreachableNodeで拒否し、黙って破棄しない。"
      cons "native arenaの未使用slotは許せるが、出力対象bundleへ含めない。"
      cons "Missing/Unexpected/Unparsed等の回復構文もrootから参照して保持する。" nil
    cons paragraph
      cons "TokenRef、Token内のViewRef、OriginRef、EnvironmentEntry.idはそれぞれの所有tableで宣言されたslotを指し、このNodeRef再採番の対象ではない。"
      cons "これらのtableとbinding/resource/role/relation/triviaの列順は値の一部として保存する。"
      cons "生成側はsource順または明示した生成順でtableを作り、allocation address・hash map列挙順を宣言順へ使わない。"
      cons "したがって、node arenaだけを並べ替えた同じ値はwire byte一致を要求するが、別tableの宣言順まで異なるgraphの同型性をこの規則だけで証明したとは扱わない。" nil
    cons paragraph
      cons "ParseTreeのcontexts/recoveryも同じ所有bundleのNodeRef対応表で変換する。"
      cons "ForeignStep.nodeはそのstepをたどる直前のbundle、NodeSelection.nodeとRecoveryEntry.nodeはpathの終点bundleに属する。"
      cons "contextsはhostを先頭とし、各bundle内の正準node順・field順で出会うforeign bundleをdepth-firstでたどった順に置く。"
      cons "各contextのselectionsは正準node順とする。"
      cons "recoveryは同じbundle順の部分列で、各entriesは正準node順とする。"
      cons "受信側はこの順序と参照先の意味検査を両方行い、古いwrapper番号だけを残した値を拒否する。"
      cons "packageのform/leaf/read/binding index、executionDigest、FactSetのopaque IDは構文node再採番の対象ではない。" nil
    cons paragraph
      cons "coreのNodeMappingは所有bundleの参照範囲・到達閉包と正準番号の対応を計算する。"
      cons "これは単独ではschema・source・cycle・選択の検査済みproofではない。"
      cons "engineのParseTree型付きadapterは解決済みProfileによる静的選択・回復検査に加え、Dynamicの実provider登録・固定shape・保存childContextsの整合を検査し、core-owned FoundationValueCodecを介してwireの実SyntaxBundle変換を使う。"
      cons "wireからengineへの依存は追加しない。"
      cons "Dynamicのpackage indexやchildContextsを構文node番号として再配置しない。"
      cons "この検査はproviderの実行履歴の認証を代替せず、ParseTree codec成立からparse continuation全体のportable化を推定しない。"
      cons "Facts要求応答の型付き包絡はこの同じtree codecと、要求に束縛したfacts権限検査を使用する。" nil
    cons paragraph
      cons "SyntaxBundle.sourceMapsも宣言順の列として保存する。"
      cons "そのSpanはopaque source identityとbyte rangeを持ち、NodeRef再採番で変化しない。"
      cons "foreign bundleは独自のsourceMaps/sourcesを持つ。"
      cons "生成snapshotの予約identityもhostが固定してからnative/portable比較へ渡し、別実装が独自にIDを発明して同一byte列を偽装しない。" nil
    cons paragraph
      cons sentence cons text "EnvironmentEntry.digestは " cons code "NEPL3-ENVIRONMENT-1" cons text " + zero byte + canonical NDF(Environment record) のSHA-256とする。" nil
      cons "entry自身のid/digestはhashへ入れない。"
      cons "bindings/resourcesの列順とbinding中のbundle局所OriginRefはEnvironment値の一部である。"
      cons "Origin tableを再編するhostは参照とdigestを共に更新し、別bundleへ同じ数値OriginRefだけを移して同一環境とみなさない。"
      cons "環境digest一致はoriginの実在・domain bindingの意味検査を代替しない。" nil
    cons paragraph
      cons "この値は局所table参照を含む内容digestであり、参照先Originの閉包digestではない。"
      cons "別のOrigin tableで同じ番号を使えば同じ内容digestになり得る。"
      cons "reader・editor・診断のcache keyはEnvironmentEntry.digestだけでなく、ReaderContextのOrigin table・選択Profile・source bundleのidentityを固定する。"
      cons "出自を持つ結果を別bundleへ再利用しない。"
      cons "originの再採番時はbindingとEnvironmentEntry.digestに加え、ForeignSyntax.environment.digestを同時に更新する。" nil
    nil
  cons section artifacts "3. normal formとartifact" body
    cons paragraph
      cons "printの正規形は各言語のformal source表に従う。"
      cons "lossless再出力はoriginal SourceSnapshotの抽出であり、意味printerと同一視しない。"
      cons "sourceを持たない値にもprefix printerが使える。" nil
    cons paragraph
      cons "HTML/XML出力はUTF-8、属性はnamespace URIとlocal nameのscalar順で出力する。"
      cons sentence cons text "モデル不変条件章の文字集合を検査後、Textと属性値の " cons code "&" cons text "、" cons code "<" cons text "、" cons code ">" cons text " を常に " cons code "&amp;" cons text "、" cons code "&lt;" cons text "、" cons code "&gt;" cons text " へescapeする。" nil
      cons sentence cons text "これによりXML文字データ中の " cons code "]]>" cons text " も直接出力されない。" nil
      cons sentence cons text "属性値は二重引用符で囲み、" cons code "\"" cons text " は " cons code "&quot;" cons text " とする。" nil
      cons sentence cons text "TextのCRは " cons code "&#xD;" cons text "、属性値のTAB/LF/CRはそれぞれ " cons code "&#x9;" cons text "、" cons code "&#xA;" cons text "、" cons code "&#xD;" cons text " としてparse後の値を保持する。" nil
      cons "TextのTAB/LFはそのまま出す。"
      cons "HTMLのbrはvoid、XMLでは自己閉じを使う。"
      cons "外部から任意のnamespace URIを受け付けない。"
      cons "MathML/SVGのnamespaceはserializerが固定値を生成する。" nil
    cons paragraph
      cons "pixelの完全一致はOS/font/browserに依存するため、このbackendの契約は安全なDOM内容・構造・宣言されたstyle/layout規則とする。"
      cons "同じbackend revisionの固定assetから生成するmarkup byte列は決定的。"
      cons "nativeとprocessの同実装経路ではbyte一致、異なる独立実装ではcanonical構造一致と定義済み表示規則を検査する。" nil
    nil
  cons section limits "4. limitsとproviderの[互換/ごかん]" body
    cons paragraph
      cons "algorithmごとのwork消費量は異なってよい。"
      cons "十分な予算でCompleteになった同じ入力について、意味正規形・診断code/対象範囲・解決先が一致することを要求する。"
      cons "片方だけが予算不足の場合、値の不一致と同じ扱いをしない。"
      cons "ただしlimit違反の無視、partialをCompleteにすること、hostへ制御を返さないことは契約違反。" nil
    cons paragraph
      cons "同じ入力・environment・source/resources・provider revision・budgetでの同じ実装の結果は決定的。"
      cons "外部clock、乱数、OS directory順などに意味を依存させない。" nil
    nil
  nil
