article ja "09. Rust[以外/いがい]へ[置換/ちかん]するための[契約/けいやく]"
body
  cons section policy "[方針/ほうしん]" body
    cons paragraph
      cons "[意味/いみ]モデル・[操作/そうさ]・[診断/しんだん]・source[対応/たいおう]のschemaを[公開境界/こうかいきょうかい]とする。"
      cons "Rustのメモリ[表現/ひょうげん]やtrait objectをABIにしない。"
      cons "native fast pathとportable pathを[同時/どうじ]に[提供/ていきょう]し、その[意味/いみ]を[比較/ひかく]する。" nil
    nil
  cons section layers "1. [三/みっ]つの[層/そう]" body
    cons list ordered 1
      cons item none body cons paragraph cons "[言語中立/げんごちゅうりつ]のschema: field[順/じゅん]、variant、[必須制約/ひっすせいやく]、[整数/せいすう]/[有理数/ゆうりすう]、[範囲/はんい]と[参照/さんしょう]、operation signature。" nil nil
      cons item none body cons paragraph cons "Rustの[型付/かたつ]きAPI: schemaに[対応/たいおう]するstruct/enumと[関数/かんすう]。" cons "Rust[内/ない]の[通常利用/つうじょうりよう]ではserialize[不要/ふよう]。" nil nil
      cons item none body cons paragraph cons "transport adapter: schema[値/ち]をNDF（[下記/かき]）でencode/decodeし、[別/べつ]process/[別実装/べつじっそう]へ[渡/わた]す。" nil nil
      nil
    cons paragraph
      cons "この[分離/ぶんり]により、[将来/しょうらい]のNEPL3プログラミング[言語/げんご]は[同/おな]じschemaを[生成/せいせい]/[消費/しょうひ]する[実装/じっそう]を[持/も]てばよい。"
      cons "[現在/げんざい]のRustのallocator、enum discriminant、pointer、Arc/Rc、usize、trait vtableは[境界/きょうかい]を[越/こ]えない。" nil
    nil
  cons section ndf "2. NDF/1" body
    cons paragraph
      cons sentence cons text "canonical" cons ruby text "値" text "ち" cons text "digestは " cons code "SHA-256(domain || canonical NDF/1 CBOR(value))" cons text " とする。" nil
      cons "digest[専用経路/せんようけいろ]は[通常/つうじょう]のencoderと[同/おな]じ[符号化規則/ふごうかきそく]でbyte[片/へん]を[順次/じゅんじ]hashへ[渡/わた]してよく、[完全/かんぜん]なCBOR bufferの[作成/さくせい]を[必須/ひっす]にしない。"
      cons "この[場合/ばあい]も[値/あたい]の[走査/そうさ]・[整数/せいすう]の[一時表現/いちじひょうげん]・stackの[割当/わりあて]と、[符号化/ふごうか]およびhashの[全/ぜん]byte[処理/しょり]を[同/おな]じBudgetへ[先行課金/せんこうかきん]し、[停止時/ていしじ]はdigestを[返/かえ]さない。"
      cons "[出力/しゅつりょく]は32byteのdigestとして[課金/かきん]する。"
      cons "CBOR bufferを[実際/じっさい]に[作/つく]る[経路/けいろ]ではその[出力/しゅつりょく]・[割当/わりあて]も[課金/かきん]し、[会計/かいけい]だけを[省略/しょうりゃく]してはならない。"
      cons "[通常/つうじょう]のNDF encodeは[引/ひ]き[続/つづ]き[生成/せいせい]する[全/ぜん]CBOR byteを[出力/しゅつりょく]として[課金/かきん]する。"
      cons "[文書/ぶんしょ]digestを[得/え]るための[一時/いちじ]CBORを[除去/じょきょ]することと、HTMLの[出力上限/しゅつりょくじょうげん]を[変更/へんこう]することは[別/べつ]である。"
      nil
    cons paragraph
      cons "NDFは[本仕様/ほんしよう]の[型付/かたつ]き[値/あたい]をCBORで[運/はこ]ぶ[符号化/ふごうか]profile。"
      cons "RFC 8949のdefinite lengthと[最短/さいたん]の[整数/せいすう]/[長/なが]さ[表現/ひょうげん]を[要求/ようきゅう]する。"
      cons "map、float、NaN、CBOR tag、null、indefinite lengthはNDFでは[使用/しよう]しない。"
      cons "CBORそのものの[汎用機能/はんようきのう]を[全部許可/ぜんぶきょか]するわけではない。" nil
    cons paragraph cons "[値/あたい]は[次/つぎ]のtagged arrayで[表/あらわ]す。" nil
    cons table cons right cons default cons default nil
      some row cons "tag" cons "[配列/はいれつ]" cons "[型/かた]" nil
      cons row cons "0" cons sentence cons code "[0]" nil cons "Unit" nil
      cons row cons "1" cons sentence cons code "[1, bool]" nil cons "Bool" nil
      cons row cons "2" cons sentence cons code "[2, uint64]" nil cons "Offset/Index[等/など]の[有限/ゆうげん]unsigned" nil
      cons row cons "3" cons sentence cons code "[3, negative:bool, magnitude:bytes]" nil cons "[任意精度/にんいせいど]Integer" nil
      cons row cons "4" cons sentence cons code "[4, numerator:Value(tag3), denominator:bytes]" nil cons "Rational" nil
      cons row cons "5" cons sentence cons code "[5, text]" nil cons "Text（valid UTF-8）" nil
      cons row cons "6" cons sentence cons code "[6, bytes]" nil cons "Bytes" nil
      cons row cons "7" cons sentence cons code "[7, [Value...]]" nil cons "List" nil
      cons row cons "8" cons sentence cons code "[8]" nil cons "None" nil
      cons row cons "9" cons sentence cons code "[9, Value]" nil cons "Some" nil
      cons row cons "10" cons sentence cons code "[10, SchemaRef, KindName, [Value...]]" nil cons "Record、field[順/じゅん]はschema" nil
      cons row cons "11" cons sentence cons code "[11, SchemaRef, TypeName, VariantName, [Value...]]" nil cons "Variant" nil
      nil
    cons paragraph
      cons sentence cons text "SchemaRefは " cons code "[packageName:text, revision:uint64, digest:bytes32]" cons text "。" nil
      cons "[型名/かためい]/kind[名/めい]は[登録済/とうろくず]みschemaに[照合/しょうごう]する。"
      cons "naturalはtag3のnonnegativeを[要求/ようきゅう]するfield[制約/せいやく]。"
      cons "integer magnitudeはbig-endian、[先頭/せんとう]zeroなし、zeroはempty bytesかつnegative=false。"
      cons "rational denominatorは[正/せい]で[先頭/せんとう]zeroなし、gcd=1、zero numeratorはdenominator=1。" nil
    cons paragraph
      cons "NodeId/EntityId[等/など]は[公開/こうかい]record[内/ない]のindexとしてencodeし、[同/おな]じbundleに[対応/たいおう]するtableとschemaを[含/ふく]める。"
      cons "[未定義参照/みていぎさんしょう]、[循環禁止構造/じゅんかんきんしこうぞう]の[循環/じゅんかん]、[重複/じゅうふく]ID、[範囲外/はんいがい]spanはdecode[直後/ちょくご]に[拒否/きょひ]する。"
      cons "[文字列型/もじれつがた]の[違反/いはん]を[遅/おく]れてRustのdowncastで[検出/けんしゅつ]する[方式/ほうしき]にしない。" nil
    cons paragraph
      cons sentence cons code "interfaces/contracts.json" cons text " と" cons ruby text "各言語" text "かくげんご" cons text "constructor" cons ruby text "表" text "ひょう" cons text "からcodecの" cons ruby text "網羅性検査" text "もうらせいけんさ" cons text "を" cons ruby text "生成" text "せいせい" cons text "する。" nil
      cons "serdeのderive[既定表現/きていひょうげん]を[契約/けいやく]にせず、custom codecでNDFへ[写/うつ]す。"
      cons "[内部/ないぶ]でserdeを[使/つか]う[場合/ばあい]も[明示/めいじ]したarray/schemaに[固定/こてい]する。" nil
    cons section intrinsic "2.1 intrinsic[値/ち]の[閉/と]じた[記述/きじゅつ]" body
      cons paragraph
        cons sentence cons code "interfaces/contracts.json" cons text " の " cons code "intrinsic_types" cons text " は、NDF/1をdecodeした" cons ruby text "論理値" text "ろんりち" cons text "の" cons ruby text "型" text "かた" cons text "を" cons ruby text "定義" text "ていぎ" cons text "する。" nil
        cons sentence cons code "NdfValue" cons text " の12caseは" cons ruby text "上表" text "じょうひょう" cons text "のtag 0–11に" cons ruby text "一対一" text "いちたいいち" cons text "で" cons ruby text "対応" text "たいおう" cons text "する。" nil
        cons sentence cons code "NdfScalar" cons text " はUnit、Bool、U64、Integer、Rational、Text、Bytesの" cons ruby text "部分型" text "ぶぶんがた" cons text "、" cons code "TypedValue" cons text " はRecord、Variantだけの" cons ruby text "部分型" text "ぶぶんがた" cons text "である。" nil
        cons "subsetのcase[列/れつ]は[集合/しゅうごう]であり、[順序/じゅんじょ]をwire IDにしない。"
        cons "Unitは[追加/ついか]payloadを[持/も]たず、Noneとは[異/こと]なる。"
        cons "NaturalはIntegerの[非負制約/ひふせいやく]、Bytes32はBytesの[長/なが]さ[制約/せいやく]であり、[追加/ついか]のwire tagを[持/も]たない。" nil
      cons paragraph
        cons "このintrinsic[記述/きじゅつ]は[通常/つうじょう]のdomain sumではない。"
        cons sentence cons text "たとえば " cons code "NdfValue.Integer(value: Integer)" cons text " の" cons ruby text "論理" text "ろんり" cons text "fieldを" cons ruby text "一般" text "いっぱん" cons text "のVariantとしてtag11で" cons ruby text "包" text "つつ" cons text "まず、" cons ruby text "上表" text "じょうひょう" cons text "のtag3へ" cons ruby text "直接写" text "ちょくせつうつ" cons text "す。" nil
        cons "Integerのnegative/magnitude、Rationalの[分子/ぶんし]tag3と[分母/ぶんぼ]bytesは[上表/じょうひょう]の[専用表現/せんようひょうげん]を[使/つか]う。"
        cons "tag10/11のfieldsは[裸/はだか]のCBOR arrayであり、Listのtag7を[付/つ]けない。"
        cons sentence cons text "そのheader" cons ruby text "内" text "ない" cons text "のSchemaRefも" cons ruby text "裸" text "はだか" cons text "の " cons code "[text,uint64,bytes32]" cons text " であり、" cons ruby text "通常" text "つうじょう" cons text "のRecordのtag10を" cons ruby text "付" text "つ" cons text "けない。" nil
        cons "[論理/ろんり]fieldのTextやU64も、[上表/じょうひょう]で[裸/はだか]のCBOR text/uint64を[指定/してい]する[位置/いち]へ[余分/よぶん]なNDF tagを[付/つ]けない。"
        cons "codecの[物理表現/ぶつりひょうげん]は[上表/じょうひょう]を[正本/せいほん]とする。" nil
      cons paragraph
        cons sentence cons text "intrinsicの" cons ruby text "識別子" text "しきべつし" cons text " " cons code "nepl3.ndf/1" cons text " は" cons ruby text "本符号化" text "ほんふごうか" cons text "profileに" cons ruby text "組" text "く" cons text "み" cons ruby text "込" text "こ" cons text "まれた" cons ruby text "固定識別子" text "こていしきべつし" cons text "である。" nil
        cons "intrinsic[自体/じたい]へdomain SchemaRefや[自己/じこ]hashを[要求/ようきゅう]しない。"
        cons "Record/Variant headerのSchemaRefは[運/はこ]ばれるdomain[値/ち]のdescriptorを[識別/しきべつ]し、intrinsicの[識別子/しきべつし]とは[別物/べつもの]である。"
        cons "domain descriptorの[登録/とうろく]・digest[検証/けんしょう]は[必要/ひつよう]であり、TypedValueという[型名/かためい]やtag10/11であることだけでは[検査済/けんさず]みにならない。"
        cons sentence cons ruby text "通常" text "つうじょう" cons text "のfieldとしてのSchemaRefは " cons code "nepl3.foundation" cons text " revision 1のSchemaRef recordをtag10で" cons ruby text "運" text "はこ" cons text "ぶ。" nil
        cons "そのheaderのSchemaRefだけが[裸/はだか]のtupleとなるため、[無限/むげん]のwrapper[再帰/さいき]は[生/しょう]じない。" nil
      nil
    cons section references "2.2 descriptorの[型参照検査/かたさんしょうけんさ]と[残/のこ]る[契約/けいやく]" body
      cons paragraph
        cons sentence cons text "fieldとunion" cons ruby text "参照" text "さんしょう" cons text "の" cons ruby text "型式" text "かたしき" cons text "は " cons code "Name | List<Type> | Option<Type>" cons text " とする。" nil
        cons sentence cons text "NameはASCII" cons ruby text "英字" text "えいじ" cons text "で" cons ruby text "始" text "はじ" cons text "まる" cons ruby text "英数字" text "えいすうじ" cons text "/underscoreのsegmentを " cons code ":" cons text " または " cons code "/" cons text " で" cons ruby text "接続" text "せつぞく" cons text "する。" nil
        cons "[空/くう]segment、[空白/くうはく]、[余分/よぶん]なtoken、[未宣言/みせんげん]のgeneric、[引数/ひきすう]の[過不足/かふそく]は[拒否/きょひ]する。"
        cons "List/Optionは[予約/よやく]された1[引数/ひきすう]constructorであり、[名義型/めいぎがた]として[宣言/せんげん]できない。"
        cons "[開発/かいはつ]checkerは128[階層/かいそう]を[超/こ]える[型式/かたしき]を[拒否/きょひ]する。"
        cons "この[型名文法/かためいぶんぽう]と[上限/じょうげん]は[設計/せっけい]descriptorの[記述/きじゅつ]に[限/かぎ]り、[利用者/りようしゃ]の[言語中/げんごちゅう]の[名前/なまえ]・kind[文字列/もじれつ]・source・NDF Textの[文字集合/もじしゅうごう]を[制限/せいげん]しない。"
        cons "runtime[入力/にゅうりょく]のLimitsも[代替/だいたい]しない。" nil
      cons paragraph
        cons "builtinはUnit、Bool、U64、Integer、Natural、Rational、Text、Bytes、Bytes32である。"
        cons "[所有者/しょゆうしゃ]は[本/ほん]profileであり、modelのscalar_typesとcontractsのscalar_aliasesはそれへの[参照/さんしょう]・[説明/せつめい]である。"
        cons "model.types、contracts.records/enums/intrinsic_typesの[名義型定義/めいぎがたていぎ]は[重複/じゅうふく]を[許/ゆる]さない。"
        cons "modelの[外部参照/がいぶさんしょう]はexternal_typesへ[明示/めいじ]し、[存在/そんざい]する[外部所有型/がいぶしょゆうがた]へ[解決/かいけつ]する。"
        cons "modelの[可視名/かしめい]は[自身/じしん]の[定義/ていぎ]と[明示/めいじ]したscalar/external importに[限/かぎ]る。"
        cons "[既存/きそん]の[再帰的/さいきてき]な[型/かた]graphは[許/ゆる]すが、[値/あたい]の[循環可否/じゅんかんかひ]・source/Origin tableの[整合/せいごう]は[操作/そうさ]ごとの[値検査/あたいけんさ]で[別/べつ]に[判定/はんてい]する。" nil
      cons paragraph
        cons "[型名/かためい]がすべて[解決/かいけつ]することと[公開操作契約/こうかいそうさけいやく]が[完成/かんせい]することを[区別/くべつ]する。"
        cons "27[操作/そうさ]のinput/outputには[説明用/せつめいよう]の[式/しき]が[残/のこ]り、[型付/かたつ]きの[具体化/ぐたいか]・provider frame・Profile・Doc[移行/いこう]のDG01–DG06は[対応/たいおう]する[実装/じっそう]とともに[完成/かんせい]させる。"
        cons sentence cons ruby text "進捗" text "しんちょく" cons text "と" cons ruby text "実行証拠" text "じっこうしょうこ" cons text "は " cons link relative "../progress/foundation-runtime.md" none ruby text "実装記録" text "じっそうきろく" cons text " を" cons ruby text "参照" text "さんしょう" cons text "する。" nil nil
      nil
    cons section descriptor "2.3 [実行可能/じっこうかのう]なschema descriptor" body
      cons paragraph
        cons sentence cons code "interfaces/contracts.json" cons text " のTypeDescriptorはUnit/Bool/U64/Integer/Natural/Rational/Text/Bytes/Bytes32、intrinsicのNdfValue/NdfScalar/TypedValue、List、Option、Namedを" cons ruby text "区別" text "くべつ" cons text "する。" nil
        cons "Namedはpackage/revision/nameの[記号参照/きごうさんしょう]でありdigestを[入/い]れない。"
        cons "Recordは[順序付/じゅんじょつ]きfield、Variantは[名前付/なまえつ]きのvariantと[順序付/じゅんじょつ]きpayloadを[持/も]つ。"
        cons "constraintsはschema[所有/しょゆう]の[意味制約/いみせいやく]IDの[集合/しゅうごう]である。" nil
      cons paragraph
        cons "SchemaDescriptorはpackage、revision、types、operationsを[持/も]つ。"
        cons sentence cons text "canonical JSONではtypesとoperationsを" cons ruby text "名前" text "なまえ" cons text "keyのobject、" cons ruby text "型定義" text "かたていぎ" cons text "を " cons code "{constraints,record}" cons text " または " cons code "{constraints,variant}" cons text " とし、fieldを " cons code "[name,TypeJSON]" cons text " の" cons ruby text "順序付" text "じゅんじょつ" cons text "きarrayにする。" nil
        cons sentence cons text "TypeJSONはbuiltin/intrinsic" cons ruby text "名" text "めい" cons text "の" cons ruby text "文字列" text "もじれつ" cons text "、" cons code "{list:TypeJSON}" cons text "、" cons code "{option:TypeJSON}" cons text "、" cons code "{named:{name,package,revision}}" cons text " のいずれか。" nil
        cons sentence cons text "operationは " cons code "{input,output,pure}" cons text "。" nil
        cons "constraintsは[重複/じゅうふく]を[拒否/きょひ]して[名前順/なまえじゅん]に[並/なら]べる。"
        cons "13[章/しょう]のkey[順/じゅん]・escape・domain separatorでSHA-256を[求/もと]める。" nil
      cons paragraph
        cons "[登録/とうろく]は[期待/きたい]するSchemaRefとdescriptorの[計算/けいさん]digestを[照合/しょうごう]する。"
        cons "[一/ひと]つのregistryで[同/おな]じpackage/revisionに[異/こと]なるdigestを[同時選択/どうじせんたく]しない。"
        cons "[全/ぜん]packageを[登録後/とうろくご]にfinalizeし、[使用/しよう]されていないvariantやoperationも[含/ふく]むすべてのNamed[参照/さんしょう]を[解決/かいけつ]する。"
        cons "[相互参照/そうごさんしょう]する[型/かた]・packageの[登録/とうろく]は[許/ゆる]すが、finalize[前/まえ]の[値検査/あたいけんさ]・[実行/じっこう]は[拒否/きょひ]する。" nil
      cons paragraph
        cons sentence cons code "interfaces/foundation.json" cons text " はcontractsから " cons code "cargo run --locked -p nepl3-tools -- foundation --write" cons text " で" cons ruby text "生成" text "せいせい" cons text "する" cons ruby text "実際" text "じっさい" cons text "の " cons code "nepl3.foundation" cons text " descriptorである。" nil
        cons "build.rsから[生成/せいせい]せず、[通常/つうじょう]の[検査/けんさ]で[正本/せいほん]との[一致/いっち]とproduction core registryによる[登録/とうろく]・[参照閉包/さんしょうへいほう]を[検査/けんさ]する。"
        cons "[未完成/みかんせい]のoperation[説明表/せつめいひょう]を[実行可能/じっこうかのう]なoperationsへコピーしない。"
        cons "このpackageは[共通値/きょうつうち]・transport recordのschemaを[提供/ていきょう]し、[言語操作/げんごそうさ]の[実装/じっそう]を[広告/こうこく]しない。" nil
      cons paragraph
        cons sentence cons ruby text "同" text "おな" cons text "じ" cons ruby text "明示生成" text "めいじせいせい" cons text "で " cons code "crates/foundation/core/src/schema/foundation.rs" cons text " を" cons ruby text "作" text "つく" cons text "り、productionの " cons code "foundation::descriptor" cons text " が" cons ruby text "型付" text "かたつ" cons text "きdescriptorを" cons ruby text "構築" text "こうちく" cons text "する。" nil
        cons "[構築前/こうちくまえ]に[割当/わりあて]・work[予算/よさん]を[計上/けいじょう]し、toolsのJSON parserをproductionへ[依存/いぞん]させない。"
        cons "[通常/つうじょう]の[検査/けんさ]はJSONとRust[投影/とうえい]の[両方/りょうほう]を[正本/せいほん]と[比較/ひかく]する。"
        cons "wireのsource/Span adapterはこのdescriptorを[登録/とうろく]したregistryで[構造/こうぞう]を[検査/けんさ]し、さらにsource digest・[宣言順/せんげんじゅん]・identity・locator・snapshot・UTF-8[境界/きょうかい]を[検査/けんさ]してnative[型/がた]へ[戻/もど]す。" nil
      cons paragraph
        cons "raw encode/decodeはNDF intrinsicのcanonical[性/せい]を[検査/けんさ]する。"
        cons "[公開操作/こうかいそうさ]の[境界/きょうかい]ではexpected TypeDescriptorとfinalize[済/ず]みregistryを[渡/わた]すchecked encode/decodeを[使/つか]い、[受信/じゅしん]したschema/kind/variant/field[型/がた]を[照合/しょうごう]する。"
        cons "[得/え]られるStructuralValueは[構造検査/こうぞうけんさ]の[証明/しょうめい]であり、constraintsに[列挙/れっきょ]したsourceの[対応/たいおう]・[回路/かいろ]の[幅等/はばなど]の[意味検査/いみけんさ]を[代替/だいたい]しない。"
        cons "coreの[対応/たいおう]constructorまたはdomain[操作/そうさ]で[必要/ひつよう]な[不変条件/ふへんじょうけん]を[検査/けんさ]してから[使用/しよう]する。" nil
      nil
    nil
  cons section invocation "3. [操作呼出/そうさよびだ]し" body
    cons paragraph
      cons "CallはrequestId、OperationRef、input TypedRecord、sources/resources/environment、Limitsを[持/も]つ。"
      cons "OperationRefはpackage/revision/digestとoperation[名/めい]。"
      cons "provider manifestにinput/output schema、[必要/ひつよう]capability、[純粋性契約/じゅんすいせいけいやく]を[宣言/せんげん]する。" nil
    cons paragraph
      cons "ReplyはComplete / Invalid / Stopped / Awaitのvariant。"
      cons "DiagnosticとEventは[成功値/せいこうち]と[別/べつ]field。"
      cons "[未対応/みたいおう]operationを[空/から]の[値/あたい]や[成功/せいこう]Unitで[返/かえ]さない。" nil
    cons paragraph
      cons "Awaitは[外部/がいぶ]service[要求/ようきゅう]とcontinuationを[返/かえ]す。"
      cons "hostはallowlistで[照合/しょうごう]し、[同一親予算/どういつおやよさん]で[要求/ようきゅう]を[実行/じっこう]してresumeする。"
      cons "continuationはprovider revision、[親/おや]request、snapshot digestに[束縛/そくばく]し、[別/べつ]providerへ[渡/わた]せない。"
      cons "[中断中/ちゅうだんちゅう]の[要求/ようきゅう]を[実装差替/じっそうさしか]え[対象/たいしょう]にしない。" nil
    cons paragraph
      cons "call graphはhostが[追跡/ついせき]する。"
      cons "[同/おな]じoperation/input/contextの[循環依存/じゅんかんいぞん]はCyclicOperation。"
      cons "[有限/ゆうげん]だが[大/おお]きい[再帰/さいき]も[共通/きょうつう]Limitsで[停止/ていし]できる。"
      cons "provider[内部/ないぶ]のアルゴリズム[固有/こゆう]costは[性能情報/せいのうじょうほう]であり、[二実装/にじっそう]でusageの[数値一致/すうちいっち]を[互換要件/ごかんようけん]にしない。" nil
    cons section transform "3.1 Reader Transformの[操作返信/そうさへんしん]" body
      cons paragraph
        cons "Transformのdomain[結果/けっか]と[外側/そとがわ]OperationReplyは[次/つぎ]のように[対応/たいおう]する。"
        cons "[内側/うちがわ]のtyped TransformReplyはsources/sourceMapsを[全結果/ぜんけっか]で[所有/しょゆう]する。" nil
      cons table cons default cons default cons default nil
        some row cons "TransformOutcome" cons "OperationReply" cons "typed payload" nil
        cons row cons "Complete" cons "Complete" cons "TransformReply" nil
        cons row cons "Failed" cons "Invalid" cons "partial=Some(TransformReply)" nil
        cons row cons "Stopped(reason)" cons "Stopped(reason)" cons "partial=Some(TransformReply)" nil
        nil
      cons paragraph
        cons "[内外/ないがい]のdiagnostics/events/usage/traceOverflowは[同/おな]じReportの[正確/せいかく]な[再掲/さいけい]であり、[不一致/ふいっち]を[拒否/きょひ]する。"
        cons "[再掲/さいけい]によるstorageと[符号化/ふごうか]の[費用/ひよう]は[計上/けいじょう]するが、[診断/しんだん]・eventを[再発行/さいはっこう]したことにはしない。"
        cons "Stoppedの[理由/りゆう]も[一致/いっち]を[要求/ようきゅう]する。"
        cons "CompleteにFailedを[隠/かく]す、Invalidを[成功/せいこう]Unitに[変/か]える、Transformに[未定義/みていぎ]のAwaitを[返/かえ]す、といった[返信/へんしん]は[拒否/きょひ]する。" nil
      cons paragraph
        cons "partial=NoneのInvalid/Stoppedは、domain Transform[結果/けっか]が[得/え]られる[前/まえ]のdispatch[失敗/しっぱい]である。"
        cons "adapterは[型付/かたつ]きの[拒否結果/きょひけっか]と[正式/せいしき]Reportをhostへ[返/かえ]し、Readerの[待機/たいき]slotへ[成功/せいこう]やdomain[失敗/しっぱい]として[適用/てきよう]しない。"
        cons "この[場合/ばあい]の[位置参照/いちさんしょう]は[元/もと]の[保存要求/ほぞんようきゅう]と[正式/せいしき]checkpointのsource[閉包/へいほう]だけに[限/かぎ]り、そのsource/mapsを[拒否結果/きょひけっか]が[所有/しょゆう]する。"
        cons "[新/あたら]しい[生成/せいせい]source[上/じょう]の[診断/しんだん]を[返/かえ]す[場合/ばあい]は、[明示/めいじ]source tableを[持/も]つtyped TransformReplyを[使/つか]う。"
        cons "Reportが[不正/ふせい]な[返信/へんしん]は[待機/たいき]を[消費/しょうひ]せず、[訂正返信/ていせいへんしん]を[再検査/さいけんさ]できる。" nil
      cons paragraph
        cons "この[対応/たいおう]の[実/じつ]codecは[保存要求/ほぞんようきゅう]proofを[使/つか]うTransform[返信/へんしん]のnative/NDF[比較/ひかく]を[提供/ていきょう]する。"
        cons "ReadのMatched/NoMatch/NeedMoreは[正常/せいじょう]なreader[結果/けっか]としてCompleteへ[運/はこ]ぶ[対象/たいしょう]だが、その[操作返信/そうさへんしん]adapter、[初回/しょかい]provider[要求/ようきゅう]、[全/ぜん]Await[継続/けいぞく]、process transportの[実装完了/じっそうかんりょう]をこのTransform[比較/ひかく]から[推定/すいてい]しない。" nil
      nil
    nil
  cons section native "4. native provider" body
