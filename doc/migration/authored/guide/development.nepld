article ja "[開発/かいはつ]と[検査/けんさ]"
body
  cons section portable "Portable execution CI" body
    cons paragraph
      cons "WASI foundationは[同/おな]じcomponentをWasmtime 44.0.1のnative codegenとPulley64で[実行/じっこう]し、[終了状態/しゅうりょうじょうたい]・[試験数/しけんすう]・elapsed[以外/いがい]の[出力/しゅつりょく]を[比較/ひかく]します。"
      cons "PulleyもCraneliftでbytecodeを[生成/せいせい]するため、[別/べつ]compilerの[検証/けんしょう]とは[扱/あつか]いません。"
      cons "[空/から]のlibrary test binaryはemptyとして[記録/きろく]し、[集約/しゅうやく]では[実試験/じつしけん]の[成功/せいこう]を[要求/ようきゅう]します。"
      cons "[各/かく]processは180[秒/びょう]で[停止/ていし]・[回収/かいしゅう]し、[失敗/しっぱい]ログもartifactへ[保存/ほぞん]します。"
      cons sentence cons ruby text "比較用" text "ひかくよう" cons text "componentは " cons code "cargo test --release" cons text " で" cons ruby text "最適化" text "さいてきか" cons text "します。" nil
      cons "[通常/つうじょう]のdebug WASI[試験/しけん]は[別途維持/べっといじ]します。"
      cons "[非最適化/ひさいてきか]のengine parse[全/ぜん]20[件/けん]はCIのPulleyで180[秒/びょう]を[超/こ]えたため、[試験/しけん]の[削除/さくじょ]やcoreの[資源上限変更/しげんじょうげんへんこう]ではなく、[配布時/はいふじ]にも[使/つか]う[最適化/さいてきか]コードを[比較/ひかく]します。" nil
    cons paragraph
      cons sentence cons link relative "../conformance/targets/rp2040/README.md" none text "RP2040 adapter" cons text " は" cons ruby text "別" text "べつ" cons text "workspaceのbare-metal harnessです。" nil
      cons "production core/reader/wire/engineの[依存/いぞん]を[使用/しよう]し、HAL・UART・allocatorを[外側/そとがわ]へ[置/お]きます。"
      cons "ARMv6-M buildと[固定版/こていばん]rp2040jsでのUF2[実行/じっこう]は[別/べつ]job・[別証拠/べつしょうこ]です。"
      cons "[初期実行範囲/しょきじっこうはんい]はsource[位置/いち]・budget・NDFの4[件/けん]で、Reader/Engine[全受入/ぜんうけいれ]や[実機試験/じっきしけん]の[代/か]わりにはしません。" nil
    cons paragraph
      cons "[実/じつ]ブラウザのWasm・Playground、RISC-V、big-endianの[検査/けんさ]はそれぞれ[独立/どくりつ]した[未達範囲/みたつはんい]です。"
      cons "このCI[整備/せいび]をDoc HTML・[文書移行/ぶんしょいこう]・Pages[公開/こうかい]の[完成/かんせい]へ[読/よ]み[替/か]えません。"
      cons "CIの[区切/くぎ]り[後/ご]はDoc[生成/せいせい]を[進/すす]め、[意味/いみ]・リンク・[安定/あんてい]IDの[対応/たいおう]を[検証/けんしょう]できたページからnepld[正本/せいほん]へ[移行/いこう]し、[検査済/けんさず]みの[同/おな]じsite artifactを[公開/こうかい]します。" nil
    nil
  cons section local "ローカル[環境/かんきょう]" body
    cons paragraph
      cons sentence
        cons code "doc/canonical.json"
        cons text " に"
        cons ruby text "登録" text "とうろく"
        cons text "された"
        cons ruby text "仕様" text "しよう"
        cons text "はnepldを"
        cons ruby text "編集" text "へんしゅう"
        cons text "します。"
        nil
      cons "[生成/せいせい]Markdownを[直接変更/ちょくせつへんこう]しないでください。"
      cons sentence
        cons code "cargo run --locked -p nepl3-tools -- doc-canonical --check"
        cons text " はproduction APIで"
        cons ruby text "再生成" text "さいせいせい"
        cons text "して"
        cons ruby text "差分" text "さぶん"
        cons text "を"
        cons ruby text "検査" text "けんさ"
        cons text "します。"
        nil
      cons sentence
        cons ruby text "更新時" text "こうしんじ"
        cons text "は "
        cons code "doc-markdown annotated"
        cons text " で"
        cons ruby text "新" text "あたら"
        cons text "しい"
        cons ruby text "一時" text "いちじ"
        cons text "ファイルへ"
        cons ruby text "生成" text "せいせい"
        cons text "し、"
        cons ruby text "差分" text "さぶん"
        cons text "をレビューして"
        cons ruby text "既存" text "きそん"
        cons text "のprojectionへ"
        cons ruby text "反映" text "はんえい"
        cons text "します。"
        nil
      cons sentence
        cons text "ページ"
        cons ruby text "間" text "かん"
        cons text "リンクを"
        cons ruby text "持" text "も"
        cons text "つ "
        cons code "nepl3-tools.markdown-annotated-pages/1"
        cons text " の"
        cons ruby text "登録後" text "とうろくご"
        cons text "は、"
        cons code "cargo run --locked -p nepl3-tools -- doc-canonical markdown dist/canonical-markdown"
        cons text " で"
        cons ruby text "全登録" text "ぜんとうろく"
        cons text "ページを"
        cons ruby text "新規" text "しんき"
        cons text "ディレクトリへ"
        cons ruby text "生成" text "せいせい"
        cons text "します。"
        nil
      cons "[参照先/さんしょうさき]・[別/べつ]ページのaliasも[同/おな]じ[入力集合/にゅうりょくしゅうごう]に[含/ふく]め、[旧/きゅう]rendererのページは[既存/きそん]byte[列/れつ]を[維持/いじ]します。"
      cons "[成功/せいこう]した[生成物/せいせいぶつ]の[差分/さぶん]をレビューしてからprojectionへ[反映/はんえい]してください。"
      cons sentence
        cons code "cargo run --locked -p nepl3-tools -- doc-canonical html dist/doc-canonical"
        cons text " は、"
        cons ruby text "同" text "おな"
        cons text "じ"
        cons ruby text "正本" text "せいほん"
        cons text "からHTML"
        cons ruby text "一式" text "いっしき"
        cons text "を"
        cons ruby text "新規出力" text "しんきしゅつりょく"
        cons text "します。"
        nil
      cons sentence cons text "HTML" cons ruby text "集合" text "しゅうごう" cons text "の" cons ruby text "有限出力予算" text "ゆうげんしゅつりょくよさん" cons text "を" cons ruby text "明示" text "めいじ" cons text "する" cons ruby text "場合" text "ばあい" cons text "は、registryの " cons code "html_output_limits" cons text " に8" cons ruby text "資源" text "しげん" cons text "をすべて" cons ruby text "指定" text "してい" cons text "します。" nil
      cons sentence cons text "Markdown" cons ruby text "用" text "よう" cons text "の " cons code "output_limits" cons text " とは" cons ruby text "別" text "べつ" cons text "の" cons ruby text "設定" text "せってい" cons text "であり、" cons ruby text "未指定時" text "みしていじ" cons text "は" cons ruby text "従来" text "じゅうらい" cons text "のHTML" cons ruby text "既定値" text "きていち" cons text "を" cons ruby text "維持" text "いじ" cons text "します。" nil
      cons "[停止/ていし]した[実行/じっこう]を[成功/せいこう]として[再試行/さいしこう]せず、[新/あたら]しい[設定/せってい]での[生成/せいせい]は[別/べつ]の[実行/じっこう]として[記録/きろく]します。"
      cons "いずれも[文書/ぶんしょ]の[明示的/めいじてき]な[生成工程/せいせいこうてい]とし、Cargo build.rsへ[入/い]れません。"
      nil
    cons paragraph
      cons "Doc HTMLの[配置/はいち]は、[固定版/こていばん]Playwrightと[対応/たいおう]するChromium・Firefox・WebKitでCI[実行/じっこう]します。"
      cons "[実/じつ]NEPL3[入力/にゅうりょく]からproduction backendで[生成/せいせい]した13[例/れい]を、2[画面幅/がめんはば]・3[文字/もじ]サイズ・3[行高/ぎょうこう]で[表示/ひょうじ]し、Ruby/Annoのbaseline、[複数行/ふくすうぎょう]、[入/い]れ[子/こ]、[注釈/ちゅうしゃく]と[前後行/ぜんごぎょう]の[高/たか]さ[予約/よやく]を[検査/けんさ]します。"
      cons "[文書/ぶんしょ]のJavaScriptは[無効/むこう]です。"
      cons "これは[静的/せいてき]HTMLの[検査/けんさ]であり、Wasm[実行/じっこう]や[支援技術/しえんぎじゅつ]の[操作試験/そうさしけん]ではありません。"
      cons "runner[不在/ふざい]・[例/れい]の[欠落/けつらく]・[配置不一致/はいちふいっち]は[失敗/しっぱい]となり、quality jobも[失敗/しっぱい]します。"
      nil
    cons rawcode some "sh" "python -m pip install -r tools/audit/doc_html/requirements.txt\npython -m playwright install chromium firefox webkit\nmkdir -p dist/doc-browser\ncargo test --locked -p nepl3-tools --test doc html::browser_layout_corpus_from_real_doc_source -- --exact --nocapture > dist/doc-browser/corpus.log\npython tools/audit/doc_html/browser.py --corpus dist/doc-browser/corpus.log --css crates/languages/doc/html/assets/doc.css --output dist/doc-browser/results.json\n"
    cons paragraph
      cons sentence
        cons text "Linuxではbrowser"
        cons ruby text "用" text "よう"
        cons text "のsystem libraryも"
        cons ruby text "必要" text "ひつよう"
        cons text "なため、CIは"
        cons code "playwright install --with-deps"
        cons text "を"
        cons ruby text "使" text "つか"
        cons text "います。"
        nil
      cons "PowerShellで[実行/じっこう]ログを[保存/ほぞん]する[際/さい]は、[後述/こうじゅつ]のUTF-8の[指針/ししん]に[従/したが]ってください。"
      nil
    cons paragraph
      cons sentence cons link relative "../rust-toolchain.toml" none text "rust-toolchain.toml" cons text " に" cons ruby text "固定" text "こてい" cons text "したRustと、Gitを" cons ruby text "使用" text "しよう" cons text "します。" nil
      cons "rustupはworkspace[内/ない]で[指定/してい]toolchainを[選/えら]びます。"
      cons sentence cons code "cargo" cons text " の" cons ruby text "各" text "かく" cons text "コマンドはリポジトリrootで" cons ruby text "実行" text "じっこう" cons text "してください。" nil
      cons sentence cons code "Cargo.lock" cons text " は" cons ruby text "管理対象" text "かんりたいしょう" cons text "で、CIでは " cons code "--locked" cons text " を" cons ruby text "使" text "つか" cons text "います。" nil nil
    cons paragraph
      cons "Doc inventoryのbaseline[検証/けんしょう]は[固定/こてい]commitのGit objectを[必要/ひつよう]とするため、CI checkoutは[全履歴/ぜんりれき]を[取得/しゅとく]します。"
      cons "shallow cloneではbaselineを[取得/しゅとく]してから[検査/けんさ]し、object[不在/ふざい]を[監査成功/かんさせいこう]としてskipしません。"
      cons "source archive[単体/たんたい]にはこの[履歴/りれき]が[含/ふく]まれません。" nil
    cons paragraph
      cons "[開発/かいはつ]toolchainは1.97.0、[現時点/げんじてん]で[宣言/せんげん]・[検査/けんさ]するMSRVは1.97です。"
      cons "[元設計/もとせっけい]の「1.85[以上/いじょう]」は[選定可能/せんていかのう]な[下限/かげん]であり、1.85での[実行証拠/じっこうしょうこ]を[意味/いみ]しません。"
      cons "[初期段階/しょきだんかい]では[実際/じっさい]に[検査/けんさ]するtoolchainとMSRVを[一致/いっち]させ、[未検証/みけんしょう]の[旧版対応/きゅうばんたいおう]を[広告/こうこく]しない[方針/ほうしん]を[採/と]ります。"
      cons "[将来/しょうらい]MSRVを[変更/へんこう]するときはCargo.toml、toolchainとCIの[検査対象/けんさたいしょう]を[合/あ]わせて[見直/みなお]します。" nil
    cons paragraph
      cons "[独立/どくりつ]した[構造監査/こうぞうかんさ]にはPython 3.13を[使用/しよう]します。"
      cons "これは[標準/ひょうじゅん]ライブラリだけで[動/うご]く[開発/かいはつ]host[用/よう]の[補助検査/ほじょけんさ]で、productionの[依存/いぞん]ではありません。"
      cons "Rustの[共通/きょうつう]parserの[完成/かんせい]を[示/しめ]すものでもありません。" nil
    cons paragraph
      cons "テキストはUTF-8、[通常/つうじょう]はLFです。"
      cons sentence cons text "PowerShellのファイルI/Oでは " cons code "Get-Content -Encoding UTF8" cons text "、" cons code "Set-Content -Encoding UTF8" cons text " など、encodingを" cons ruby text "明示" text "めいじ" cons text "します。" nil
      cons "source[位置試験/いちしけん]のfixtureと[取/と]り[込/こ]み[元/もと]の[証拠/しょうこ]ファイルは[元/もと]byte[列/れつ]を[維持/いじ]します。" nil
    cons rawcode some "sh" "rustup show active-toolchain\ncargo fmt --all -- --check\ncargo clippy --workspace --all-targets --locked -- -D warnings\ncargo test --workspace --locked\ncargo run --locked -p nepl3-tools -- check\ncargo run --locked -p nepl3-tools -- tasks --check\npython tools/audit/structure.py\npython -m unittest discover -s tools/audit -p test.py\npython tools/audit/allocation/run.py\npython tools/generate/grammar.py\npython tools/generate/doc.py\npython tools/generate/math.py\npython -m unittest discover -s tools/bootstrap -p test_grammar.py\n"
    cons paragraph
      cons sentence cons text "allocation" cons ruby text "検査" text "けんさ" cons text "は " cons link relative "../tools/audit/allocation/probe.rs" none concat cons ruby text "単体" text "たんたい" cons text "probe" nil cons text " の" cons ruby text "呼出" text "よびだ" cons text "し" cons ruby text "区間" text "くかん" cons text "で" cons ruby text "実際" text "じっさい" cons text "の" cons ruby text "割当" text "わりあて" cons text "を" cons ruby text "計測" text "けいそく" cons text "します。" nil
      cons "SourceMapが[予算/よさん]ゼロを[返/かえ]す[前/まえ]にsource IDを[複製/ふくせい]したR020は、[返却値/へんきゃくち]と[論理的/ろんりてき]な[使用量/しようりょう]だけの[試験/しけん]では[捕捉/ほそく]できません。"
      cons "このため[計測器/けいそくき]に[限定/げんてい]したGlobalAlloc wrapperのunsafeを[開発用途/かいはつようと]で[監査/かんさ]します。"
      cons "unsafeは[同/おな]じpointer/layoutをSystem allocatorへ[転送/てんそう]する[箇所/かしょ]だけとし、[計測/けいそく]counterは[割当/わりあて]を[伴/ともな]わないatomic[操作/そうさ]です。"
      cons sentence cons text "coreと" cons ruby text "通常" text "つうじょう" cons text "workspaceの " cons code "unsafe_code = \"forbid\"" cons text " は" cons ruby text "維持" text "いじ" cons text "し、productionへ" cons ruby text "計測器" text "けいそくき" cons text "を" cons ruby text "依存" text "いぞん" cons text "させません。" nil nil
    cons paragraph
      cons "[同/おな]じ[計測器/けいそくき]はR037のSourceStore.applyも[検査/けんさ]します。"
      cons "100000byteのSourceIdを[持/も]つ[編集/へんしゅう]に[対/たい]し、AllocationUnits=0で[停止/ていし]するまでに[実割当/じつわりあて]がないことを[要求/ようきゅう]します。"
      cons "[共有/きょうゆう]SourceAdmission、[全削除/ぜんさくじょ]の[入力入場/にゅうりょくにゅうじょう]、[複数/ふくすう]sourceの[原子性/げんしせい]と[再試行/さいしこう]は[別/べつ]のproduction API[試験/しけん]で[検証/けんしょう]します。"
      cons "[古/ふる]いapply[署名/しょめい]はadmissionを[受/う]け[取/と]らないため、[旧版/きゅうばん]の[元反例/もとはんれい]と[現行/げんこう]probeのAPI[差/さ]を[区別/くべつ]して[記録/きろく]します。" nil
    cons paragraph
      cons sentence cons link relative "../tools/audit/allocation/run.py" none text "driver" cons text " は" cons ruby text "固定" text "こてい" cons text "toolchainの " cons code "cargo build --locked" cons text " が" cons ruby text "出力" text "しゅつりょく" cons text "するJSONから" cons ruby text "対象" text "たいしょう" cons text "coreのartifactを" cons ruby text "一意" text "いちい" cons text "に" cons ruby text "取得" text "しゅとく" cons text "し、" cons ruby text "同" text "おな" cons text "じtoolchainのrustcで" cons ruby text "一時実行" text "いちじじっこう" cons text "ファイルを" cons ruby text "作" text "つく" cons text "ります。" nil
      cons "[既存/きそん]workspaceのlint[設定/せってい]を[変更/へんこう]せず、この[独立/どくりつ]した[開発計測器/かいはつけいそくき]にだけ[上記/じょうき]の[範囲/はんい]を[適用/てきよう]します。"
      cons "[意図的/いとてき]な[割当/わりあて]のpositive controlを[先/さき]に[検査/けんさ]し、[入力構築/にゅうりょくこうちく]・[表示/ひょうじ]・[返却値/へんきゃくち]のdropを[計測区間/けいそくくかん]から[外/はず]します。"
      cons "[失敗/しっぱい]・runner[不在/ふざい]・artifactの[曖昧/あいまい]さは[非/ひ]0[終了/しゅうりょう]であり、[未実行/みじっこう]を[成功/せいこう]へ[読/よ]み[替/か]えません。"
      cons "[通常/つうじょう]native CIでもこのコマンドを[実行/じっこう]し、[単/たん]なる[任意/にんい]の[手元確認/てもとかくにん]にはしません。"
      cons "[計測/けいそく]はこの[具体的/ぐたいてき]な[先行割当/せんこうわりあて]の[回帰/かいき]を[捕捉/ほそく]するもので、[一般/いっぱん]の[物理/ぶつり]メモリ[上限/じょうげん]やWASIでの[実測/じっそく]を[保証/ほしょう]しません。" nil
    cons paragraph cons "APIドキュメントも[警告/けいこく]をエラーとして[検査/けんさ]します。" nil
    cons rawcode some "powershell" "$env:RUSTDOCFLAGS = '-D warnings'\ncargo doc --workspace --no-deps --locked\nif ($LASTEXITCODE -ne 0) { throw 'cargo doc failed' }\n"
    cons paragraph
      cons "PowerShellではnative commandの[失敗/しっぱい]がスクリプトを[自動停止/じどうていし]させるとは[限/かぎ]りません。"
      cons "[複数/ふくすう]コマンドを[自動化/じどうか]するときは、[各終了/かくしゅうりょう]コードを[検査/けんさ]してください。"
      cons sentence cons text "POSIX shellでは " cons code "RUSTDOCFLAGS='-D warnings' cargo doc --workspace --no-deps --locked" cons text " と" cons ruby text "実行" text "じっこう" cons text "できます。" nil nil
    cons paragraph cons sentence cons text "タスクを" cons ruby text "変更" text "へんこう" cons text "したときは" cons ruby text "正本" text "せいほん" cons text "の " cons code "design/tasks.json" cons text " を" cons ruby text "編集" text "へんしゅう" cons text "し、" cons ruby text "生成後" text "せいせいご" cons text "の" cons ruby text "差分" text "さぶん" cons text "を" cons ruby text "確認" text "かくにん" cons text "します。" nil nil
    cons rawcode some "sh" "cargo run --locked -p nepl3-tools -- tasks --write\ncargo run --locked -p nepl3-tools -- tasks --check\ngit diff --check\ngit diff\n"
    cons paragraph
      cons sentence cons code "check" cons text " はリポジトリ" cons ruby text "内" text "ない" cons text "の" cons ruby text "設計" text "せっけい" cons text "metadataと" cons ruby text "実際" text "じっさい" cons text "のworkspaceの" cons ruby text "整合" text "せいごう" cons text "を" cons ruby text "検査" text "けんさ" cons text "します。" nil
      cons "[言語処理系/げんごしょりけい]の[代用/だいよう]ではなく、[登録/とうろく]されたruntime[受入試験/うけいれしけん]を[実行/じっこう]するコマンドでもありません。"
      cons sentence cons code "implementation-status.json" cons text " の" cons ruby text "状態" text "じょうたい" cons text "は" cons ruby text "実際" text "じっさい" cons text "の" cons ruby text "実行証拠" text "じっこうしょうこ" cons text "に" cons ruby text "基" text "もと" cons text "づいて" cons ruby text "更新" text "こうしん" cons text "します。" nil nil
    cons paragraph
      cons sentence cons ruby text "共通型" text "きょうつうがた" cons text "を" cons ruby text "変更" text "へんこう" cons text "したときは " cons code "cargo run --locked -p nepl3-tools -- foundation --write" cons text " で" cons ruby text "実際" text "じっさい" cons text "のpackage descriptorを" cons ruby text "生成" text "せいせい" cons text "します。" nil
      cons sentence cons code "check" cons text " は" cons ruby text "正本" text "せいほん" cons text "との" cons ruby text "一致" text "いっち" cons text "に" cons ruby text "加" text "くわ" cons text "え、production core registryによるdigest" cons ruby text "照合" text "しょうごう" cons text "・" cons ruby text "参照" text "さんしょう" cons text "finalizeも" cons ruby text "行" text "おこな" cons text "います。" nil
