      cons sentence cons text "Cabalのsource discovery/" cons ruby text "前処理登録" text "まえしょりとうろく" cons text "か、build directory" cons ruby text "内" text "ない" cons text "の " cons code ".hs" cons text " carrier" cons ruby text "生成" text "せいせい" cons text "を" cons ruby text "明示的" text "めいじてき" cons text "に" cons ruby text "選" text "えら" cons text "ぶ" cons ruby text "必要" text "ひつよう" cons text "がある。" nil
      cons "plugin[指定/してい]だけで[発見/はっけん]されると[仮定/かてい]しない。"
      cons " carrierを[使/つか]う[場合/ばあい]はmodule/importと[正本/せいほん]identityを[保持/ほじ]し、[本体/ほんたい]は[構文/こうぶん]モデルからASTへ[変換/へんかん]する。"
      cons " header[解析/かいせき]と[本体/ほんたい]lowerは[同/おな]じsnapshotを[参照/さんしょう]する。"
      cons "frontendからproviderを[再起動/さいきどう]する[循環/じゅんかん]を[作/つく]らない。"
