    },
    "DocPlainText": {
      "descriptor": "interfaces/doc.json",
      "package": "nepl3.doc",
      "operation": "plainText",
      "input": "nepl3.doc.PlainTextRequest",
      "output": "nepl3.doc.PlainTextReply",
      "scope": "Executable plain-text operation over an explicit DocumentSyntax, SentenceRef, AnnotationPolicy, and ResolvedInlineText inputs. Preparation and execution failures retain typed Invalid or Stopped outcomes and Report usage. Reply sources resolve only through the request document closure; decoding does not authenticate resolved inline text or issue a prepared-domain execution proof. Domain prepare/render and full Facts remain separate contracts; printing has its own DocPrint descriptor."
    },
    "DocPrint": {
      "descriptor": "interfaces/doc.json",
      "package": "nepl3.doc",
      "operation": "print",
      "input": "nepl3.doc.PrintRequest",
      "output": "nepl3.doc.PrintReply",
      "scope": "Executable print operation over DocumentSyntax, PrintMode, explicit bindings and printed guest assertions. Native execution revalidates structure/schema, canonical document/ForeignClosure identities and all supplied bindings/guests using the same Budget and SourceAdmission, then returns a typed SourceArtifact or Invalid/Stopped with Report usage. SourceArtifact text and entry do not issue a saved source revision; the host creates that snapshot. PrintedGuest is bound to document digest, embed and guest digest; semantic equivalence of its guest text remains a host responsibility. Raw identity/request/reply decoding validates explicit data and the request document Report source closure, rejects overflow with non-Stopped outcomes, and never issues an execution or guest-semantic proof."
    }
  }
