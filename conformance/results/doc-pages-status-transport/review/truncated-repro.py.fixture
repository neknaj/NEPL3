from pathlib import Path
import sys,json,threading
from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
from http.client import HTTPConnection
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment.receipt import Receipt
from deployment.transport import status
body=b'{"status":"succeed"}'
class H(BaseHTTPRequestHandler):
 def do_GET(self):
  self.send_response(200);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(body)+100));self.end_headers();self.wfile.write(body);self.close_connection=True
 def log_message(self,*args):pass
server=ThreadingHTTPServer(('127.0.0.1',0),H);thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
r=Receipt('123','https://api.github.com/repos/neknaj/NEPL3/pages/deployments/123','a'*64)
try:
 with patch('deployment.transport.HTTPSConnection',lambda host,timeout:HTTPConnection('127.0.0.1',server.server_port,timeout=timeout)):
  try:
   result=status(r,'test-token');record={'accepted_truncated_content_length':True,'phase':result.observation.phase.value,'declared_bytes':len(body)+100,'actual_bytes':len(result.raw_response)}
  except ValueError as ex:record={'accepted_truncated_content_length':False,'error':str(ex)}
finally:server.shutdown();server.server_close();thread.join()
p=Path('.tmp/pages-transport-review');(p/'truncated-repro.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf8');print(json.dumps(record,indent=2))
