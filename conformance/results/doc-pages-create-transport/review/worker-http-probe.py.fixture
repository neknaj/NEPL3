from pathlib import Path
import sys,json,subprocess,threading,runpy
from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment.create import create,CreationUnknown
from test_receipt_journal import RAW
p=Path('.tmp/create-transport-review');mode=['success'];seen=[]
class H(BaseHTTPRequestHandler):
 def do_POST(self):
  body=self.rfile.read(int(self.headers['Content-Length']));seen.append((self.path,json.loads(body)))
  if mode[0]=='lost-response':self.close_connection=True;return
  self.send_response(200 if mode[0]=='success' else 502);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(RAW)));self.end_headers();self.wfile.write(RAW)
 def log_message(self,*a):pass
server=ThreadingHTTPServer(('127.0.0.1',0),H);thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start();original=subprocess.run
site=Path('tools/site').resolve();worker=site/'deployment/create_worker.py'
code="import sys,runpy;sys.path.insert(0,sys.argv[1]);from http.client import HTTPConnection;import deployment.transport as t;t.HTTPSConnection=lambda host,timeout:HTTPConnection('127.0.0.1',int(sys.argv[3]),timeout=timeout);runpy.run_path(sys.argv[2],run_name='__main__')"
results=[]
def local_worker(command,**kwargs):return original([sys.executable,'-I','-c',code,str(site),str(worker),str(server.server_port)],**kwargs)
try:
 for case in ['success','http-error','lost-response']:
  mode[0]=case;before=len(seen)
  with patch('deployment.create.subprocess.run',local_worker):
   try:
    receipt,raw=create('neknaj','NEPL3',42,'a'*40,'test-token','test.oidc.token',timeout=5)
    assert case=='success' and raw==RAW and receipt.deployment_id=='123';outcome='receipt and original bytes'
   except CreationUnknown as ex:assert case!='success';outcome=str(ex)
  assert len(seen)-before==1
  assert seen[-1][0]=='/repos/neknaj/NEPL3/pages/deployments' and seen[-1][1]['artifact_id']==42
  results.append({'case':case,'post_count':len(seen)-before,'outcome':outcome})
finally:server.shutdown();server.server_close();thread.join()
(p/'worker-http-results.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(json.dumps(results,indent=2))
