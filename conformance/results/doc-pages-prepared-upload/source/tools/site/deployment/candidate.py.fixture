"""Validate authenticated CI observations against the publisher's selected head.

This is the run/check gate only. Artifact upload-attempt provenance, protected
writer state, freshness recheck at mutation, and deployment permission are extra
gates. A returned candidate is not a publication authorization.
"""
from dataclasses import dataclass

from journal.model import decode, hex_id
from payload import checked, digest
from .receipt import endpoint

REQUIRED = frozenset(('quality', 'native (ubuntu-latest)', 'native (windows-latest)',
                      'native (macos-latest)', 'wasi and wasm compilation',
                      'baremetal ARMv6-M build', 'baremetal RP2040 emulator execution',
                      'Doc HTML browser layout'))


@dataclass(frozen=True)
class Candidate:
    run_id: int
    attempt: int
    source_commit: str
    run_sha256: str
    jobs_sha256: str


def prepare(run_raw, jobs_raw, artifact_raw, archive, *, owner, repository,
            repository_id, workflow_id, run_id, attempt, current_main, artifact_id,
            expected_tar, expected_manifest):
    """Bind eligible CI observations to the attempt-named downloaded payload.

    Only trusted workflow uploads may establish the artifact naming convention.
    Authentication, job-to-upload provenance and final freshness remain host
    responsibilities; no serialized Candidate is accepted as proof here.
    """
    from .artifact import selected
    candidate = verify(run_raw, jobs_raw, owner=owner, repository=repository,
                       repository_id=repository_id, workflow_id=workflow_id,
                       run_id=run_id, attempt=attempt, current_main=current_main)
    payload = selected(artifact_raw, archive, owner=owner, repository=repository,
                       repository_id=repository_id, run_id=candidate.run_id,
                       attempt=candidate.attempt, source_commit=candidate.source_commit,
                       artifact_id=artifact_id, expected_tar=expected_tar,
                       expected_manifest=expected_manifest)
    return candidate, payload


def integer(value):
    checked(type(value) is int and 0 < value < 2**53, 'invalid CI identity')


def prepare_upload(run_raw, jobs_raw, artifact_raw, archive, upload_raw, upload_archive,
                   *, owner, repository, repository_id, workflow_id, run_id, attempt,
                   current_main, artifact_id, upload_id, expected_tar, expected_manifest):
    """Verify CI, diagnostic receipt, and the separate original-tar upload.

    Raw API/download inputs must be authenticated by the host. This does not
    replace freshness/permission/writer-state checks or perform a Pages POST.
    """
    import io
    import zipfile
    from .artifact import uploaded
    integer(upload_id)
    checked(upload_id != artifact_id, 'diagnostic artifact is not a Pages upload')
    candidate, original = prepare(run_raw, jobs_raw, artifact_raw, archive,
        owner=owner, repository=repository, repository_id=repository_id, workflow_id=workflow_id,
        run_id=run_id, attempt=attempt, current_main=current_main, artifact_id=artifact_id,
        expected_tar=expected_tar, expected_manifest=expected_manifest)
    # prepare has already checked the complete ZIP directory, duplicate paths,
    # sizes and archive digest. Read the receipt from those same immutable bytes.
    with zipfile.ZipFile(io.BytesIO(archive)) as bundle:
        member = bundle.getinfo('pages-upload.json')
        checked(not member.is_dir() and member.file_size <= 65536, 'upload receipt limit')
        with bundle.open(member) as stream:
            receipt = stream.read(65537)
        checked(len(receipt) == member.file_size, 'upload receipt length mismatch')
    result = uploaded(upload_raw, upload_archive, receipt,
        owner=owner, repository=repository, repository_id=repository_id, run_id=run_id,
        attempt=attempt, source_commit=current_main, artifact_id=upload_id,
        expected_tar=original.tar_sha256, expected_manifest=original.manifest_sha256)
    return candidate, result


def document(raw):
    checked(isinstance(raw, bytes) and 0 < len(raw) <= 1024 * 1024, 'CI response size limit')
    result = decode(raw)
    checked(isinstance(result, dict), 'CI response must be an object')
    return result


def verify(run_raw, jobs_raw, *, owner, repository, repository_id, workflow_id,
           run_id, attempt, current_main):
    for value in (repository_id, workflow_id, run_id, attempt): integer(value)
    hex_id(current_main, 40)
    endpoint(owner, repository, '1')
    prefix = f'https://api.github.com/repos/{owner}/{repository}'
    run = document(run_raw)
    for key, value in [('id', run_id), ('workflow_id', workflow_id), ('run_attempt', attempt)]:
        checked(type(run.get(key)) is int and run[key] == value, 'CI run identity mismatch')
    checked(run.get('url') == prefix + '/actions/runs/' + str(run_id), 'CI run URL mismatch')
    for key in ('repository', 'head_repository'):
        repo = run.get(key)
        checked(isinstance(repo, dict) and type(repo.get('id')) is int and repo['id'] == repository_id
                and repo.get('full_name') == owner + '/' + repository, 'CI repository mismatch')
    checked(run.get('path') == '.github/workflows/ci.yml', 'wrong CI workflow path')
    checked(run.get('event') in ('push', 'workflow_dispatch') and run.get('head_branch') == 'main',
            'CI candidate must originate on main')
    checked(run.get('head_sha') == current_main, 'stale CI source')
    checked(run.get('status') == 'completed' and run.get('conclusion') == 'success', 'CI run not successful')
    page = document(jobs_raw)
    jobs = page.get('jobs')
    checked(isinstance(jobs, list) and type(page.get('total_count')) is int
            and page['total_count'] == len(jobs) and 0 < len(jobs) <= 100, 'incomplete CI job listing')
    ids, found = set(), set()
    for job in jobs:
        checked(isinstance(job, dict), 'invalid CI job')
        integer(job.get('id'))
        checked(job['id'] not in ids, 'duplicate CI job ID'); ids.add(job['id'])
        checked(type(job.get('run_id')) is int and job['run_id'] == run_id
                and type(job.get('run_attempt')) is int and job['run_attempt'] == attempt
                and job.get('head_sha') == current_main, 'CI job identity mismatch')
        checked(job.get('status') == 'completed' and job.get('conclusion') in ('success', 'skipped'),
                'inconsistent successful CI run')
        name = job.get('name')
        checked(isinstance(name, str), 'invalid CI job name')
        if name in REQUIRED:
            checked(name not in found, 'duplicate required CI job'); found.add(name)
            checked(job.get('status') == 'completed' and job.get('conclusion') == 'success',
                    'required CI job not successful')
    checked(found == REQUIRED, 'missing required CI jobs')
    return Candidate(run_id, attempt, current_main, digest(run_raw), digest(jobs_raw))
