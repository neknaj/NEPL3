[
  {
    "document": 0,
    "changed_atoms": [
      {
        "kind": "leaf",
        "text": "Ruby/Annoはネスト可能なtyped span構造として描画し、base、上側のreading、下側のnotesを分離する。"
      },
      {
        "kind": "leaf",
        "text": "reference backendはinline-gridを基本とし、必要なbaseline指定に未対応のbrowserでは20章のinline-table配置へ切り替える。"
      },
      {
        "kind": "leaf",
        "text": "同じspan構造を維持するため、CSSの選択によってsemantic HTML正規形は変わらない。"
      },
      {
        "kind": "leaf",
        "text": "単純Rubyには別backendでHTML ruby/rtを使用してもよい。"
      }
    ],
    "removed_atoms": 2,
    "unchanged_atoms": 306,
    "unchanged_line_bytes": 65588
  },
  {
    "document": 1,
    "changed_atoms": [
      {
        "kind": "leaf",
        "text": "Ruby/Annoは型付きspanと固定CSSを使い、base/reading/全noteを別要素として保持する。"
      },
      {
        "kind": "Sentence",
        "text": "baseline-source:first/lastの両方を利用できないbrowserでは、同じspan構造にinline-tableの固定CSSを適用する。"
      },
      {
        "kind": "leaf",
        "text": "readingは上側、notesは下側のtable-captionとし、baseを持つ唯一の行からbaselineを公開する。"
      },
      {
        "kind": "leaf",
        "text": "Rubyのbaseはinline-blockとして最終行のbaselineを、Annoのbaseはtable-cellとして最初の行のbaselineを公開する。"
      },
      {
        "kind": "leaf",
        "text": "DOMの順序や注釈内容を変更せず、HTMLの表要素やJavaScriptを追加しない。"
      },
      {
        "kind": "leaf",
        "text": "この代替はWebKitで基底文字が本文より下がる不具合への対応であり、型付きmarkup・意味正規形は変更しない。"
      },
      {
        "kind": "Sentence",
        "text": "代替の根拠は CSS2のinline-block baseline と tableのbaseline規則 である。"
      },
      {
        "kind": "leaf",
        "text": "対応propertyの有無だけで合否を決めず、実際のproduction HTMLとCSSをChromium・Firefox・WebKitで表示し、本文とのbaseline、読み・注釈の上下配置、複数行の基準、入れ子と前後行の高さ予約を検査する。"
      },
      {
        "kind": "leaf",
        "text": "文書内のJavaScriptは無効とする。"
      },
      {
        "kind": "leaf",
        "text": "この静的文書の検査はWasm・Playground・支援技術による実操作の受入を代行しない。"
      }
    ],
    "removed_atoms": 1,
    "unchanged_atoms": 77,
    "unchanged_line_bytes": 17506
  },
  {
    "document": 2,
    "changed_atoms": [
      {
        "kind": "leaf",
        "text": "実ブラウザのWasm・Playground、RISC-V、big-endianの検査はそれぞれ独立した未達範囲です。"
      },
      {
        "kind": "leaf",
        "text": "Doc HTMLの配置は、固定版Playwrightと対応するChromium・Firefox・WebKitでCI実行します。"
      },
      {
        "kind": "leaf",
        "text": "実NEPL3入力からproduction backendで生成した13例を、2画面幅・3文字サイズ・3行高で表示し、Ruby/Annoのbaseline、複数行、入れ子、注釈と前後行の高さ予約を検査します。"
      },
      {
        "kind": "leaf",
        "text": "文書のJavaScriptは無効です。"
      },
      {
        "kind": "leaf",
        "text": "これは静的HTMLの検査であり、Wasm実行や支援技術の操作試験ではありません。"
      },
      {
        "kind": "leaf",
        "text": "runner不在・例の欠落・配置不一致は失敗となり、quality jobも失敗します。"
      },
      {
        "kind": "RawCode",
        "text": "python -m pip install -r tools/audit/doc_html/requirements.txt\npython -m playwright install chromium firefox webkit\nmkdir -p dist/doc-browser\ncargo test --locked -p nepl3-tools --test doc html::browser_layout_corpus_from_real_doc_source -- --exact --nocapture > dist/doc-browser/corpus.log\npython tools/audit/doc_html/browser.py --corpus dist/doc-browser/corpus.log --css crates/languages/doc/html/assets/doc.css --output dist/doc-browser/results.json\n"
      },
      {
        "kind": "Sentence",
        "text": "Linuxではbrowser用のsystem libraryも必要なため、CIはplaywright install --with-depsを使います。"
      },
      {
        "kind": "leaf",
        "text": "PowerShellで実行ログを保存する際は、後述のUTF-8の指針に従ってください。"
      }
    ],
    "removed_atoms": 1,
    "unchanged_atoms": 182,
    "unchanged_line_bytes": 50677
  }
]
