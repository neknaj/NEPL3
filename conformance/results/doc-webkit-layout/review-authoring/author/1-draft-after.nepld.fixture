article ja "20. DocのHTML[変換/へんかん]"
body
  cons paragraph
    cons sentence
      cons code "nepl3-doc-html"
      cons text " はDoc coreとmarkupへ"
      cons ruby text "依存" text "いぞん"
      cons text "する"
