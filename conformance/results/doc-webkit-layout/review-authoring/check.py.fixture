from pathlib import Path
import json,re,importlib.util,difflib,hashlib
R=Path(__file__).resolve().parent
sp=importlib.util.spec_from_file_location('s',R/'structure.py');s=importlib.util.module_from_spec(sp);sp.loader.exec_module(s);categories=json.loads((R/'forms.json').read_bytes())['categories']
han=re.compile(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3005]+');ruby=[];codes=[];links=[]
def text(n,protected=False):
 if isinstance(n,list):return ''.join(text(x,protected) for x in n)
 if not isinstance(n,dict):return ''
 k=n['kind']
 if k=='leaf':
  t=json.loads(n['token']);pairs=re.findall(r'\[([^/\[\]]+)/([^\[\]]+)\]',t)
  for b,v in pairs:assert han.fullmatch(b) and v;ruby.append((b,v))
  rest=re.sub(r'\[([^/\[\]]+)/([^\[\]]+)\]','',t);assert not han.search(rest) and not any(c in rest for c in '[{}]')
  return re.sub(r'\[([^/\[\]]+)/([^\[\]]+)\]',r'\1',t)
 f=n['fields']
 if k=='Text':
  if not protected:assert not han.search(f['text'])
  return f['text']
 if k=='Ruby':
  b=text(f['base'],True);v=text(f['reading'],True);assert han.fullmatch(b) and v;ruby.append((b,v));return b
 if k=='InlineCode':codes.append(f['text']);return f['text']
 if k=='Link':links.append(f['target']);return text(f['label'])
 if k=='RawCode':return f['text']
 assert k in ['Sentence','Concat'],k
 return ''.join(text(v,protected) for v in f.values())
def atoms(n):
 if isinstance(n,list):
  for x in n:yield from atoms(x)
 elif isinstance(n,dict):
  if n['kind'] in ['leaf','Sentence','RawCode']:yield n
  else:
   for v in n['fields'].values():yield from atoms(v)
out=[]
for i in range(3):
 before=(R/f'author/{i}-draft-before.txt').read_text(encoding='utf8');after=(R/f'author/{i}-draft-after.nepld').read_text(encoding='utf8');source=(R/f'author/{i}-source-before.txt').read_text(encoding='utf8')
 a=list(atoms(s.Parser(before,categories).complete('Doc/Article')));b=list(atoms(s.Parser(after,categories).complete('Doc/Article')))
 aa=[json.dumps(x,ensure_ascii=False) for x in a];bb=[json.dumps(x,ensure_ascii=False) for x in b]
 canonical=re.sub(r'\[([^\]]+)\]\([^\)]+\)',r'\1',source);canonical=re.sub(r'`([^`]+)`',r'\1',canonical);canonical=''.join(canonical.splitlines())
 changed=[];removed=0;unchanged=0
 for tag,j,k,l,m in difflib.SequenceMatcher(a=aa,b=bb,autojunk=False).get_opcodes():
  if tag=='equal':unchanged+=k-j;continue
  removed+=k-j
  for node in b[l:m]:
   value=text(node)
   if node['kind']=='RawCode':assert value in re.findall(r'```[^\n]*\n(.*?)```',source,re.S)
   else:assert value in canonical and value.count('。')==1 and value.endswith('。'),value
   changed.append({'kind':node['kind'],'text':value})
 # Raw source line bytes not involved in the author edits remain exact via line-level matching.
 equal_bytes=sum(len(''.join(before.splitlines(True)[j:k]).encode()) for tag,j,k,l,m in difflib.SequenceMatcher(a=before.splitlines(True),b=after.splitlines(True),autojunk=False).get_opcodes() if tag=='equal')
 out.append({'document':i,'changed_atoms':changed,'removed_atoms':removed,'unchanged_atoms':unchanged,'unchanged_line_bytes':equal_bytes})
assert [len(x['changed_atoms']) for x in out]==[4,10,9]
assert codes==['baseline-source:first/last','playwright install --with-deps']
assert len(links)==2
(R/'comparisons.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n',encoding='utf8');(R/'readings.json').write_text(json.dumps(sorted(set(ruby)),ensure_ascii=False,indent=2)+'\n',encoding='utf8')
(R/'result.json').write_text(json.dumps({'result':'PASS','changed_atoms':[len(x['changed_atoms']) for x in out],'changed_sentences':22,'raw_code':1,'inline_codes':codes,'link_targets':links,'ruby_occurrences':len(ruby),'ruby_unique':len(set(ruby))},indent=2)+'\n',encoding='utf8');print('PASS: 22 changed/new sentences, one exact RawCode, two InlineCode, two links; unchanged atoms preserved')
