from pathlib import Path
from functools import partial
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
from threading import Thread
from playwright.sync_api import sync_playwright
import json,hashlib
ROOT=Path('dist/doc13-nowrap').resolve()
OUT=Path('.tmp/doc13/browser-nowrap');OUT.mkdir(parents=True,exist_ok=True)
class Quiet(SimpleHTTPRequestHandler):
 def log_message(self,*args): pass
server=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(ROOT.parent)))
thread=Thread(target=server.serve_forever,daemon=True);thread.start()
url=f'http://127.0.0.1:{server.server_port}/doc13-nowrap/docs/spec/13-reproducibility.html'
rows=[]
try:
 with sync_playwright() as playwright:
  for name in ['chromium','firefox','webkit']:
   browser=getattr(playwright,name).launch(headless=True)
   for width in [375,1280]:
    context=browser.new_context(java_script_enabled=False,viewport={'width':width,'height':900})
    page=context.new_page();failures=[];page.on('requestfailed',lambda r:failures.append(r.url))
    response=page.goto(url,wait_until='networkidle')
    row=page.evaluate("""() => ({title:document.title, scripts:document.scripts.length,
      language:document.documentElement.lang, headings:[...document.querySelectorAll('h1,h2,h3')].map(n=>n.textContent),
      links:[...document.querySelectorAll('a[href]')].map(n=>n.getAttribute('href')),
      ids:[...document.querySelectorAll('[id]')].map(n=>n.id),
      ruby:document.querySelectorAll('.nepl-ruby').length,
      css:[...document.styleSheets].map(s=>({href:s.href,rules:s.cssRules.length})),
      overflow:document.documentElement.scrollWidth>innerWidth,
      background:getComputedStyle(document.querySelector('article')).backgroundColor})""")
    row.update(browser=name,version=browser.version,width=width,status=response.status,failed_requests=failures)
    page.screenshot(path=str(OUT/f'{name}-{width}.png'))
    rows.append(row);context.close()
   browser.close()
finally:
 server.shutdown();server.server_close();thread.join()
(OUT/'results.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
print(json.dumps(rows,ensure_ascii=False))
