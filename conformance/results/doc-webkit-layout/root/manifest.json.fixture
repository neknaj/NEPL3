  "design": "nepl3-design-2026-09-06-r4",
  "target": "Windows host, Chromium 151.0.7922.34 / Firefox 153.0 / WebKit 26.5 via Playwright 1.62.0",
  "commands": [
    {
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "nepl3-tools",
        "--test",
        "doc",
        "browser_layout_corpus_from_real_doc_source",
        "--",
        "--nocapture"
      ],
      "exit_code": 0,
      "log": "corpus.log"
    },
    {
      "command": [
        ".tmp/browser-venv/Scripts/python.exe",
        "tools/audit/doc_html/browser.py",
        "--corpus",
        ".tmp/doc13/corpus-after.log",
        "--css",
        "crates/languages/doc/html/assets/doc.css",
        "--output",
        ".tmp/doc13/browser-nowrap.json"
      ],
      "exit_code": 0,
      "result": "after.json",
      "checks": 702
    },
    {
      "command": [
        ".tmp/browser-venv/Scripts/python.exe",
        "tools/audit/doc_html/browser.py",
        "--corpus",
        ".tmp/doc13/corpus-after.log",
        "--css",
        ".tmp/doc13/caption-wrap.css",
        "--output",
        ".tmp/doc13/browser-caption-wrap.json"
      ],
      "exit_code": 1,
      "result": "caption-wrap.json",
      "purpose": "negative control before white-space preservation"
    },
    {
      "command": [
        "target/debug/nepl3-tools.exe",
        "check"
      ],
      "exit_code": 0,
      "log": "repository.stdout"
    }
  ],
  "cli_sha256": "49db709cdcff2953912650a66e4a08d2367a1a1c169c3eb8227c6e635a270530",
  "scope": "Static Doc CSS regression and chapter13 generated document inspection. No canonical cutover, no Wasm/Playground execution, no human screen-reader or Safari-on-Apple-device result, no Pages deployment, no aggregate acceptance status change.",
  "limitations": [
    "before-expanded.json used the earlier runner before case-marker/text-fragment checks; final negative mutations are recorded in the independent review",
    "repository check preceded archiving these proof files; final archive check is recorded separately"
  ],
