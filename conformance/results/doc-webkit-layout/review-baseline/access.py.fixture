from pathlib import Path
import importlib.util,json
from playwright.sync_api import sync_playwright
R=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location('corpus',R/'before/tools/audit/doc_html/browser.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
cases=m.extract_cases((R/'corpus.log').read_bytes());result={}
with sync_playwright() as p:
 for engine in ['chromium','firefox','webkit']:
  browser=getattr(p,engine).launch(headless=True);context=browser.new_context(java_script_enabled=False);page=context.new_page();rows=[]
  for phase,path in [('before','before/crates/languages/doc/html/assets/doc.css'),('after','after/doc.css')]:
   css=(R/path).read_text(encoding='utf8')
   for name,html in cases.items():
    # Real DOM for accessibility inspection; layout stress is explicitly derived below.
    page.set_content('<!doctype html><meta charset=utf-8><style>'+css+'</style>'+html)
    ax=page.locator('article').aria_snapshot()
    rows.append({'phase':phase,'case':name,'scope':'real corpus','aria_snapshot':ax})
   for name in ['ruby','anno','anno-ruby','ruby-anno','ruby-ruby']:
    html=cases[name].replace('read</span>','long reading with several words</span>').replace('note</span>','note one</span><span class="nepl-note">note two</span>').replace('C</span></p>','C<br>Z</span></p>')
    page.set_content('<!doctype html><meta charset=utf-8><style>'+css+'.nepl-doc{font-family:Arial;font-size:20px;line-height:1.2;width:80px}</style>'+html)
    measure=page.evaluate('''() => {
      const root=document.querySelector('article'),w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT), texts=[];
      while(w.nextNode())texts.push(w.currentNode);
      const rect=n=>{const r=document.createRange();r.selectNodeContents(n);return r.getBoundingClientRect();};
      const z=texts.find(t=>t.data==='Z');if(!z)throw Error('missing following line');
      const annotation=texts.filter(t=>t.parentElement.closest('.nepl-ruby,.nepl-anno'));
      return {following_top:rect(z).top,annotation_bottom:Math.max(...annotation.map(t=>rect(t).bottom)),baseRects:[...root.querySelectorAll('.nepl-base')].map(n=>n.getClientRects().length),scripts:document.scripts.length,text:root.textContent};
    }''')
    rows.append({'phase':phase,'case':name,'scope':'derived CSS-only narrow-width/long annotation/following-line diagnostic',**measure})
  result[engine]={'version':browser.version,'rows':rows};browser.close()
(R/'access-results.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8')
print(json.dumps({k:{'ax_changed':[n for n in cases if next(r['aria_snapshot'] for r in v['rows'] if r['phase']=='before' and r['case']==n and 'aria_snapshot'in r)!=next(r['aria_snapshot'] for r in v['rows'] if r['phase']=='after' and r['case']==n and 'aria_snapshot'in r)],'after_overlap':[r['case'] for r in v['rows'] if r['phase']=='after' and 'following_top'in r and r['annotation_bottom']>r['following_top']]} for k,v in result.items()},indent=2))
