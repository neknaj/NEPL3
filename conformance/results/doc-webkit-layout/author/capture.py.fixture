from pathlib import Path
import subprocess,json,hashlib
p=Path(__file__).resolve().parent;root=p.parents[1]
pairs=[('doc/spec/05-document.md','doc/migration/authored/05-document.nepld'),('doc/spec/20-doc-html.md','doc/migration/authored/20-doc-html.nepld'),('doc/development.md','doc/migration/authored/guide/development.nepld')]
result=[]
for i,(source,draft) in enumerate(pairs):
    for kind,path in [('source',source),('draft',draft)]:
        b=(root/path).read_bytes();target=p/(str(i)+'-'+kind+'-before.txt');assert not target.exists();target.write_bytes(b)
        result.append({'path':path,'snapshot':target.name,'sha256':hashlib.sha256(b).hexdigest(),'bytes':len(b)})
    (p/(str(i)+'-source-base.md')).write_bytes(subprocess.check_output(['git','show','HEAD:'+source],cwd=root))
(p/'source-delta.patch').write_bytes(subprocess.check_output(['git','diff','--',*(x[0] for x in pairs)],cwd=root))
(p/'capture.json').write_text(json.dumps({'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root).decode().strip(),'files':result},indent=2)+'\n',encoding='utf-8')
