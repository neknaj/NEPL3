article ja "[開発/かいはつ]への[参加/さんか]" body
  cons paragraph
    cons sentence
      cons ruby text "最初" text "さいしょ"
      cons text "に "
      cons link relative "doc/README.md" none concat cons ruby text "仕様" text "しよう" cons text "の" cons ruby text "入口" text "いりぐち" nil
      cons text "、"
      cons link relative "AGENTS.md" none text "AGENTS.md"
      cons text "、"
      cons link relative "doc/development.md" none ruby text "開発手順" text "かいはつてじゅん"
      cons text " を"
      cons ruby text "読" text "よ"
      cons text "んでください。"
      nil
    cons sentence
      cons ruby text "実装対象" text "じっそうたいしょう"
      cons text "は "
      cons link relative "design/tasks.json" none concat cons text "タスク" cons ruby text "定義" text "ていぎ" nil
      cons text " の"
      cons ruby text "依存順" text "いぞんじゅん"
      cons text "に"
      cons ruby text "選" text "えら"
      cons text "び、"
      cons link relative "implementation-status.json" none ruby text "実装状態" text "じっそうじょうたい"
      cons text " を"
      cons ruby text "確認" text "かくにん"
      cons text "します。"
      nil
    nil
  cons paragraph
    cons "[変更/へんこう]は[具体的/ぐたいてき]な[問題/もんだい]と[受入条件/うけいれじょうけん]に[結/むす]び[付/つ]け、[必要最小限/ひつようさいしょうげん]の[範囲/はんい]にします。"
    cons sentence
      cons ruby text "設計" text "せっけい"
      cons text "の"
      cons ruby text "誤" text "あやま"
      cons text "りが"
      cons ruby text "見" text "み"
      cons text "つかった"
      cons ruby text "場合" text "ばあい"
      cons text "は、"
      cons ruby text "根拠" text "こんきょ"
      cons text "を"
      cons ruby text "示" text "しめ"
      cons text "して"
      cons ruby text "仕様" text "しよう"
      cons text "・schema・"
      cons ruby text "文法" text "ぶんぽう"
      cons text "・"
      cons ruby text "例" text "れい"
      cons text "・conformanceを"
      cons ruby text "整合" text "せいごう"
      cons text "させ、"
      cons code "doc/decisions/"
      cons text " に"
      cons ruby text "理由" text "りゆう"
      cons text "を"
      cons ruby text "記録" text "きろく"
      cons text "します。"
      nil
    cons "ChatGPTが[生成/せいせい]した[設計/せっけい]も[検証対象/けんしょうたいしょう]です。"
    nil
  cons paragraph
    cons "agentによる[開発/かいはつ]では、メインagentが[設計具体化/せっけいぐたいか]・[実装/じっそう]・[試験/しけん]・[指摘修正/してきしゅうせい]と[統括/とうかつ]を[担当/たんとう]し、subagentには[独立/どくりつ]レビューを[依頼/いらい]します。"
    cons "ユーザーが[明示許可/めいじきょか]したDoc[文書/ぶんしょ]の[書/か]き[直/なお]しに[限/かぎ]り、subagentによる[並行執筆/へいこうしっぴつ]を[行/おこな]い、[執筆者/しっぴつしゃ]と[別/べつ]の[担当/たんとう]が[独立/どくりつ]レビューします。"
    cons "レビュー[担当/たんとう]は[契約/けいやく]と[実際/じっさい]の[差分/さぶん]・[試験根拠/しけんこんきょ]を[確認/かくにん]し、メインagentが[指摘/してき]の[解消/かいしょう]と[再検査/さいけんさ]を[確認/かくにん]します。"
    nil
  cons paragraph
    cons "PRには[変更後/へんこうご]の[動作/どうさ]、[関連/かんれん]タスク・[受入条件/うけいれじょうけん]、[実行/じっこう]した[検査/けんさ]、[未実行/みじっこう]の[範囲/はんい]を[記載/きさい]してください。"
    cons sentence
      cons code "doc/development.md"
      cons text " の"
      cons ruby text "検査" text "けんさ"
      cons text "とdiff"
      cons ruby text "確認" text "かくにん"
      cons text "を"
      cons ruby text "行" text "おこな"
      cons text "います。"
      nil
    cons "タスク[本文/ほんぶん]の[直接編集/ちょくせつへんしゅう]、[未実装/みじっそう]の[成功/せいこう]stub、golden[更新/こうしん]だけによる[正/ただ]しさの[主張/しゅちょう]は[避/さ]けます。"
    cons sentence
      cons code ".tmp/"
      cons text " や"
      cons ruby text "秘密情報" text "ひみつじょうほう"
      cons text "をcommitしません。"
      nil
    nil
  cons paragraph
    cons sentence
      cons ruby text "提供" text "ていきょう"
      cons text "されるコードと"
      cons ruby text "文書" text "ぶんしょ"
      cons text "は、このリポジトリの "
      cons link relative "LICENSE" none text "MIT License"
      cons text " の"
      cons ruby text "下" text "もと"
      cons text "で"
      cons ruby text "扱" text "あつか"
      cons text "います。"
      nil
    nil
  nil
