from pathlib import Path
import subprocess,json,hashlib,sys,re
r=Path(__file__).resolve().parents[2];p=Path(__file__).parent;sys.path.insert(0,str(r))
from tools.audit.structure import Parser,load_forms
base='d67e67546a0c928591e193289edb8ed702c1637e';draft='doc/migration/authored/21-doc-pages.nepld';source='doc/spec/21-doc-pages.md'
def git(*x):return subprocess.check_output(['git',*x],cwd=r)
def sha(b):return hashlib.sha256(b).hexdigest()
for label,name in [('source',source),('draft',draft)]:
 (p/(label+'-before')).write_bytes(git('show',base+':'+name));(p/(label+'-after')).write_bytes((r/name).read_bytes());(p/(label+'.diff')).write_bytes(git('diff',base,'--',name))
old=(p/'draft-before').read_text(encoding='utf8');new=(p/'draft-after').read_text(encoding='utf8');start=new.index('    cons section annotated_pages ')
assert new[:start]+new[new.index('    nil\n  nil',start):]==old
tree=Parser(new,load_forms(r)).complete('Doc/Article')
source_text=(p/'source-after').read_text(encoding='utf8');md=source_text.replace('\n','');md_word_boundary=source_text.replace('host\nmetadata','host metadata').replace('\n','');matched=[]
for line in new[start:].splitlines():
 m=re.fullmatch(r'\s*cons "(.*)"',line)
 if m:
  text=re.sub(r'\[([^/\[\]]+)/[^\[\]]+\]',r'\1',m[1]);assert text in md or text in md_word_boundary,text;matched.append(text)
for name in ['doc/authoring.md','AGENTS.md','design/forms.json']:
 q=p/'context'/name;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes((r/name).read_bytes())
raw=(r/'.tmp/author-page-projection/manifest.json').read_bytes();assert sha(raw)=='42d73560125daeb2286aeb7078d0d678d9ed050ad2bb0eee6c5ad8b632f4f0f7';(p/'author-manifest.json').write_bytes(raw)
for e in json.loads(raw)['files']:
 b=(r/'.tmp/author-page-projection'/e['path']).read_bytes();assert len(b)==e['bytes'] and sha(b)==e['sha256']
(p/'result.json').write_text(json.dumps({'base':base,'source_sha256':sha((p/'source-after').read_bytes()),'draft_sha256':sha((p/'draft-after').read_bytes()),'earlier_content_identical':True,'full_structure':'pass','matched_literals':matched,'runtime':'not-run'},ensure_ascii=False,indent=2)+'\n',encoding='utf8');print('PASS',len(matched))
