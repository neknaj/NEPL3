from pathlib import Path
import re,json,hashlib,difflib
from tools.audit.structure import Parser,load_forms
root=Path.cwd();r=root/'.tmp/author-page-projection'
helpers=Path('C:/projects/NEPL3-external-extensions/.tmp/author-external-extensions/helpers.py')
exec(helpers.read_text(encoding='utf8'))
p=root/'doc/migration/authored/21-doc-pages.nepld'
b=(r/'before.nepld').read_bytes();a=p.read_bytes()
assert not a.startswith(b'\xef\xbb\xbf') and b'\r' not in a
old=b.decode().splitlines(True);new=a.decode().splitlines(True)
changes=[x for x in difflib.SequenceMatcher(None,old,new,autojunk=False).get_opcodes() if x[0]!='equal']
assert len(changes)==1 and changes[0][0]=='insert',changes
tag,i,j,k,l=changes[0]
assert ''.join(old[i:])=='    nil\n  nil\n'
assert ''.join(new[:k]+new[l:]).encode()==b
raw=Parser(a.decode(),load_forms(root)).complete('Doc/Article')
n=normalize(raw,True)
s=next(x for x in walk(n) if x['kind']=='Section' and x['fields']['id']=='annotated_pages')
parent=next(x for x in walk(n) if x['kind']=='Section' and x['fields']['id']=='annotated')
assert parent['fields']['body']['fields']['blocks'][-1]==s
paragraphs=[plain(x['fields']['items']) for x in s['fields']['body']['fields']['blocks']]
source=(r/'source.md').read_text(encoding='utf8').split('### 明示したページ集合の注釈付きprojection\n',1)[1].strip()
expected=[]
for para in source.split('\n\n'):
    # Preserve space between ASCII host and metadata across Markdown softwrap;
    # explicit InlineCode n- retains its boundary space at the other wrap.
    para=para.replace('host\nmetadata','host metadata').replace('実projectionに\n`n-`','実projectionに `n-`')
    expected.append(''.join(para.splitlines()).replace('`',''))
assert paragraphs==expected,[(x,y) for x,y in zip(paragraphs,expected) if x!=y]
assert len(paragraphs)==4
codes=[x['fields']['text'] for x in walk(s) if x['kind']=='InlineCode']
assert codes==re.findall(r'`([^`]+)`',source)
added=next(x for x in walk(raw) if x['kind']=='Section' and x['fields']['id']=='annotated_pages')
audit_text(added)
assert (root/'doc/spec/21-doc-pages.md').read_bytes()==(r/'source.md').read_bytes()
(r/'after.nepld').write_bytes(a)
(r/'helpers.py').write_bytes(helpers.read_bytes())
(r/'draft.diff').write_text(''.join(difflib.unified_diff(old,new,fromfile='before.nepld',tofile='after.nepld')),encoding='utf8',newline='\n')
(r/'result.json').write_text(json.dumps({'formal_structure':'PASS (not production runtime)','unchanged_previous_bytes':True,'source_unchanged':True,'paragraphs':paragraphs,'body_sentences':sum(len(x['fields']['items']) for x in s['fields']['body']['fields']['blocks']),'code_values':codes,'subsection_id':'annotated_pages','parent_section':'annotated','before_sha256':hashlib.sha256(b).hexdigest(),'after_sha256':hashlib.sha256(a).hexdigest(),'source_sha256':hashlib.sha256((r/'source.md').read_bytes()).hexdigest()},ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS: one insertion, four paragraphs, nineteen sentences, four exact code values; prior bytes retained')
