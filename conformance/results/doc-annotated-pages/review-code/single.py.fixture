from pathlib import Path
import subprocess,json,hashlib
O=Path(__file__).resolve().parent;W=O/'workspace';P=O/'single';P.mkdir(exist_ok=True)
src=P/'13.nepld';aliases=P/'aliases.json';src.write_bytes((W/'doc/spec/13-reproducibility.nepld').read_bytes());aliases.write_bytes((W/'doc/migration/aliases/13-reproducibility.json').read_bytes())
before=Path('C:/projects/NEPL3-doc-canonical-contract/.tmp/review-canonical00-code/target/debug/nepl3-tools.exe');after=O/'target/debug/nepl3-tools.exe';rows=[]
for label,exe in [('before',before),('after',after)]:
    cmd=[str(exe),'doc-markdown','annotated',str(src),str(aliases),str(P/(label+'.md'))]
    p=subprocess.run(cmd,cwd=O,capture_output=True,timeout=180);(P/(label+'.stdout.log')).write_bytes(p.stdout);(P/(label+'.stderr.log')).write_bytes(p.stderr)
    rows.append(dict(label=label,command=cmd,exit_code=p.returncode,binary_sha256=hashlib.sha256(exe.read_bytes()).hexdigest()));assert p.returncode==0,p.stderr
b=(P/'before.md').read_bytes();assert b==(P/'after.md').read_bytes()
(P/'result.json').write_text(json.dumps(dict(commands=rows,source_sha256=hashlib.sha256(src.read_bytes()).hexdigest(),aliases_sha256=hashlib.sha256(aliases.read_bytes()).hexdigest(),output_sha256=hashlib.sha256(b).hexdigest(),bytes=len(b),exact_equal=True),indent=2)+'\n',encoding='utf-8',newline='\n');print('actual chapter13 single article before/after exact')
