use nepl3_core::{budget::{Budget,Resource,StopReason},source::{SourceStore,SourceAdmission}};
use nepl3_doc_core::{pages::*,check::Category,lower,portable};
use nepl3_tools::doc::{source::{compiled,budget,err,Compiled},projection::{Error,annotated::{self,Alias,pages::{render,PagesArtifact}}}};
use nepl3_wire::foundation::FoundationCodec;
use pulldown_cmark::{Parser,Event,Tag};

fn page(c:&Compiled,id:&str,source:&str,route:&str,text:&str)->Result<PageDocument,String>{
 let document=nepl3_tools::doc::source::with_named_input(true,c,text,id,"Article",|tree,p,_,_|{
  let store=SourceStore::default();let mut admission=SourceAdmission::default();let mut codec=FoundationCodec::new(p.registry(),&store,&mut admission).map_err(err)?;
  lower::document(tree.syntax(),&c.doc.package.schema,Category::Article,p.registry(),&mut budget(),&mut codec).map_err(err)
 })?;
 Ok(PageDocument{registration:PageRegistration{id:id.into(),source:source.into(),route:route.into()},document})
}
fn run(c:&Compiled,set:&PageSet,b:&mut Budget,aliases:&[&[Alias]])->Result<PagesArtifact,Error>{
 let store=SourceStore::default();let mut admission=SourceAdmission::default();let mut codec=FoundationCodec::new(&c.doc.registry,&store,&mut admission).map_err(|e|Error::Invalid(err(e)))?;
 render(set,&c.doc.registry,&mut codec,b,aliases)
}
fn urls(md:&str)->Vec<String>{Parser::new(md).filter_map(|e|match e{Event::Start(Tag::Link{dest_url,..})=>Some(dest_url.into_string()),_=>None}).collect()}
fn main()->Result<(),String>{
 let c=compiled()?;
 let a=page(&c,"a","logical/a.md","docs/a.md",r#"article en "A" body cons paragraph cons sentence cons link page "b" some "節" concat cons ruby text "漢" text "かん" cons text " & " cons code "x|\\y" nil cons text " next " cons link relative "legacy.md" none text "file" nil nil nil"#)?;
 let b=page(&c,"b","logical/nested/b.md","docs/nested/b.md",r#"article en "B" body cons section 節 "B" body cons paragraph cons sentence cons link relative "../a.md" none text "back" nil nil nil nil"#)?;
 let set=PageSet{pages:vec![a,b],files:vec![PageFile{registration:PageRegistration{id:"legacy".into(),source:"logical/legacy.md".into(),route:"reference/legacy.md".into()},content:FileBytes(b"# Legacy\n".to_vec())}]};let original=set.clone();
 let mut records=Vec::new();
 for (ra,rb,forward,back) in [
  ("a.md","b.md","b.md#n-e7af80","a.md"),
  ("docs/a.md","docs/b.md","b.md#n-e7af80","a.md"),
  ("docs/a.md","docs/nested/b.md","nested/b.md#n-e7af80","../a.md"),
  ("docs/nested/a.md","docs/b.md","../b.md#n-e7af80","nested/a.md"),
  ("docs/a.md","other/b.md","../other/b.md#n-e7af80","../docs/a.md"),
  ("docs/docs/a.md","docs/docs2/b.md","../docs2/b.md#n-e7af80","../docs/a.md"),
  ("docs/a.md","doc/b.md","../doc/b.md#n-e7af80","../docs/a.md"),
 ]{
  let mut input=set.clone();input.pages[0].registration.route=ra.into();input.pages[1].registration.route=rb.into();
  let output=run(&c,&input,&mut budget(),&[&[],&[]]).map_err(err)?;
  assert_eq!(urls(&output.pages[0].markdown)[0],forward);assert_eq!(urls(&output.pages[1].markdown),[back]);assert!(output.pages[1].markdown.contains("<a name=\"n-e7af80\"></a>"));
  let code:Vec<_>=Parser::new(&output.pages[0].markdown).filter_map(|e|if let Event::Code(t)=e{Some(t.into_string())}else{None}).collect();assert_eq!(code,["x|\\y"]);
  records.push(serde_json::json!({"case":"route","source":ra,"target":rb,"forward":forward,"back":back}));
 }
 let output=run(&c,&set,&mut budget(),&[&[],&[]]).map_err(err)?;
 // The published identity is the set identity, deliberately not an alias/artifact identity.
 let aliases=[Alias{section:None,name:"old-a".into()}];let changed=run(&c,&set,&mut budget(),&[&aliases,&[]]).map_err(err)?;assert_eq!(output.identity,changed.identity);assert_ne!(output.pages[0].markdown,changed.pages[0].markdown);
 records.push(serde_json::json!({"case":"aliases affect output, set identity unchanged as specified"}));
 // Fresh first receiver with no sender store/admission.
 let empty=SourceStore::default();let mut admission=SourceAdmission::default();let mut sender=FoundationCodec::new(&c.doc.registry,&empty,&mut admission).map_err(err)?;
 let value=portable::pages::set_to_value(&set,&c.doc.registry,&mut sender,&mut budget()).map_err(err)?;let bytes=nepl3_wire::encode(&value,&mut budget()).map_err(err)?;
 let value=nepl3_wire::decode(&bytes,&mut budget()).map_err(err)?;let mut fresh=SourceAdmission::default();let mut receiver=FoundationCodec::new(&c.doc.registry,&empty,&mut fresh).map_err(err)?;
 let received=portable::pages::set_from_value(&value,&c.doc.registry,&mut receiver,&mut budget()).map_err(err)?;
 let again=run(&c,&received,&mut budget(),&[&[],&[]]).map_err(err)?;assert_eq!(output.identity,again.identity);assert_eq!(output.pages.iter().map(|p|&p.markdown).collect::<Vec<_>>(),again.pages.iter().map(|p|&p.markdown).collect::<Vec<_>>());
 let mut plan=resolve(&set,&c.doc.registry,&mut sender,&mut budget()).map_err(err)?.into_plan();plan.links[0].node=u64::MAX;
 assert!(portable::pages::plan_to_value(&plan,&set,&c.doc.registry,&mut sender,&mut budget()).is_err());
 records.push(serde_json::json!({"case":"first CBOR receiver equal; forged node in plan rejected","wire_bytes":bytes.len()}));
 let mut reference=budget();reference.charge(Resource::Work,19).map_err(err)?;run(&c,&set,&mut reference,&[&[],&[]]).map_err(err)?;let usage=reference.usage();
 for (field,reason) in [("work",StopReason::WorkLimit),("allocation",StopReason::AllocationLimit),("output",StopReason::OutputLimit),("nodes",StopReason::NodeLimit),("source",StopReason::SourceLimit),("depth",StopReason::DepthLimit)]{
  let mut limits=budget().limits();match field{"work"=>limits.work=usage.work-1,"allocation"=>limits.allocation_units=usage.allocation_units-1,"output"=>limits.output_bytes=usage.output_bytes-1,"nodes"=>limits.nodes=usage.nodes-1,"source"=>limits.source_bytes=0,"depth"=>limits.depth=0,_=>unreachable!()};
  let mut limited=Budget::new(limits);limited.charge(Resource::Work,19).map_err(err)?;let result=run(&c,&set,&mut limited,&[&[],&[]]);assert!(matches!(result,Err(Error::Stopped(s)) if s==reason),"{field}: {result:?}");let used=limited.usage();let result=run(&c,&set,&mut limited,&[&[],&[]]);assert!(matches!(result,Err(Error::Stopped(s)) if s==reason));assert_eq!(used,limited.usage());records.push(serde_json::json!({"case":"sticky","resource":field}));
 }
 let mut cancel=budget();cancel.cancel();assert!(matches!(run(&c,&set,&mut cancel,&[&[],&[]]),Err(Error::Stopped(StopReason::Cancelled))));
 let mut depth=budget();depth.with_depth_at_least(7,|b|run(&c,&set,b,&[&[],&[]])).map_err(err)?;assert!(depth.usage().depth>=usage.depth+7);assert_eq!(depth.current_depth(),0);
 records.push(serde_json::json!({"case":"cancel and caller depth composition"}));
 // Native whole-set admission: separately parsed same source identity cannot redefine bytes.
 let conflicting=page(&c,"a","logical/conflict.md","conflict.md",r#"article en "different source" body nil"#)?;let mut bad=set.clone();bad.pages.push(PageDocument{registration:PageRegistration{id:"c".into(),..conflicting.registration},document:conflicting.document});assert!(matches!(run(&c,&bad,&mut budget(),&[&[],&[],&[]]),Err(Error::Invalid(_))));
 records.push(serde_json::json!({"case":"same snapshot ID conflicting native source rejected"}));
 // Semantic label is real but unsupported Anchor output cannot fabricate a successful target.
 let anchor=page(&c,"b","logical/nested/b.md","docs/b.md",r#"article en "B" body cons paragraph cons sentence cons anchor 節 text "anchor" nil nil nil"#)?;let mut bad=set.clone();bad.pages[1]=anchor;assert!(matches!(run(&c,&bad,&mut budget(),&[&[],&[]]),Err(Error::Unsupported{..})));
 records.push(serde_json::json!({"case":"semantic inline Anchor does not imply representable output"}));
 // Pure single-article path still rejects these non-external requirements.
 let mut fresh=SourceAdmission::default();let mut codec=FoundationCodec::new(&c.doc.registry,&empty,&mut fresh).map_err(err)?;assert!(matches!(annotated::render(&set.pages[0].document,&c.doc.registry,&mut codec,&mut budget(),&[]),Err(Error::NeedsResolution)));
 assert_eq!(set,original);records.push(serde_json::json!({"case":"single article unchanged; all input bytes/models unchanged"}));
 println!("{}",serde_json::to_string_pretty(&records).map_err(err)?);Ok(())
}
