  },
  {
    "headings": [
      "11. 受入条件と検証",
      "方針",
      "1. 必須の試験群",
      "2. propertyとfuzz",
      "3. 不変条件のCI",
      "4. 開発の段階",
      "5. 群全体の型付き証拠"
    ],
    "codes": [
      ">",
      "]]>",
      "design/acceptance.json",
      "cargo fmt --check",
      "design/tasks.json",
      "conformance/results/",
      "task_id",
