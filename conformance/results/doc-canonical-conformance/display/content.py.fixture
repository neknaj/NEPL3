from pathlib import Path
import re,json
OUT=Path(__file__).parent
original=Path('.tmp/original.md').read_text(encoding='utf-8'); rendered=json.loads((OUT/'first/results.json').read_text(encoding='utf-8'))[0]
plain=lambda s: re.sub(r'\[([^\]]+)\]\([^)]+\)',r'\1',s.replace('`',''))
original_items={i:plain(t) for i,t in re.findall(r'^([A-Z][0-9]{2}): (.+)$',original,re.M)}
rendered_items={m.group(1):m.group(2) for group in rendered['lists'] for s in group if (m:=re.match(r'^([A-Z][0-9]{2}): (.+)$',s))}
catalog=json.loads(Path('design/acceptance.json').read_text(encoding='utf-8'))
required=[g['id'] for g in catalog['groups'] if g['required']]
md=Path('.tmp/markdown-expanded-first/doc/spec/11-conformance.md').read_text(encoding='utf-8')
parts=md.split('<!-- -->');separators=[]
for i in range(len(parts)-1):
 before=parts[i].rstrip().splitlines()[-1];after=parts[i+1].lstrip().splitlines()[0]
 separators.append({'before':before[:35],'after':after[:35],'between_items':before.startswith('- ') and after.startswith('- ')})
result={'required_catalog_count':len(required),'required_content_count':len(rendered_items),'required_id_set_equal':set(required)==set(rendered_items),'all_required_item_plain_text_exact':original_items==rendered_items,'list_lengths':[len(x) for x in rendered['lists']],'s06_cases':rendered['lists'][11],'separators':separators,'original_code_count':len(re.findall(r'`([^`]+)`',original)),'generated_code_count':len(rendered['codes']),'extra_inline_code':']]>'}
(OUT/'content.json').write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf-8')
print(json.dumps(result,ensure_ascii=False))
