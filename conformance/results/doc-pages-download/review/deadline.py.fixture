from pathlib import Path
import json,sys,subprocess,time
from unittest.mock import patch
p=Path('.tmp/pages-download-review');sleep=p/'sleep-worker.py';sleep.write_text('import time\ntime.sleep(2)\n',encoding='utf8');sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment.download import download
from deployment.observations import Query,Kind
from deployment.transport import TransportError
real=subprocess.run;started=time.monotonic();rejected=False
with patch('deployment.download.subprocess.run',side_effect=lambda cmd,**kw:real([*cmd[:-1],str(sleep.resolve())],**kw)):
 try:download(Query('a','b',Kind.ARTIFACT,7),'dummy-token',size=9,sha256='0'*64,timeout=0.1)
 except TransportError as e:rejected='deadline' in str(e)
if not rejected:raise ValueError('deadline failure')
(p/'deadline-probe.json').write_text(json.dumps(dict(actual_sleep_child_timeout=True,configured_wait=0.1,elapsed_seconds=time.monotonic()-started,not_hard_realtime=True),indent=2)+'\n',encoding='utf8')
