from pathlib import Path
import hashlib,json,subprocess
r=Path('.tmp/review-annotated-projection')
def h(p):return hashlib.sha256(p.read_bytes()).hexdigest()
binaries=[]
for p in [r/'target/debug/nepl3-tools.exe',*list((r/'target/debug/deps').glob('doc-*.exe')),*list((r/'target-wasi/wasm32-wasip2/debug/deps').glob('doc-*.wasm'))]:
 binaries.append(dict(path=str(p.resolve()),bytes=p.stat().st_size,sha256=h(p)))
(r/'final-binaries.json').write_text(json.dumps(binaries,indent=2),encoding='utf-8')
(r/'results.json').write_text(json.dumps({'original_native_managed':4,'original_native_independent_content':1,'original_boundary_probe':'FAILED (real P2)','original_wasi_managed_and_content':5,'fixed_native_managed_and_probes':7,'fixed_wasi_managed_and_probes':6,'compat_native':10,'final_native_managed_and_probes':7,'final_wasi_managed_and_probes':6,'cli_original':13,'cli_fixed':13,'cli_final':13,'final_commit':subprocess.check_output(['git','rev-parse','2e8fafa']).decode().strip(),'unverified':['browser/GitHub rendered anchors','physical OOM','write-device failure','full Doc migration/Pages/T16']},indent=2),encoding='utf-8')
excluded_roots={'workspace','fixed','target','target-wasi'}
files=[];large=[]
for p in sorted(r.rglob('*')):
 if not p.is_file():continue
 rel=p.relative_to(r)
 if rel.parts[0] in excluded_roots or rel.name in {'manifest.json','source.tar'}:continue
 item=dict(path=rel.as_posix(),bytes=p.stat().st_size,sha256=h(p))
 if p.stat().st_size>1048576:large.append(item)
 else:files.append(item)
(r/'large-fixture-identities.json').write_text(json.dumps(large,indent=2),encoding='utf-8')
p=r/'large-fixture-identities.json';files=[f for f in files if f['path']!=p.name]+[dict(path=p.name,bytes=p.stat().st_size,sha256=h(p))]
manifest={'review':'independent annotated Markdown production review','status':'PASS after 5a fix, final 2e8fafa revalidated','production_identity':'production-identity.json','source_archive_sha256':h(r/'source.tar'),'files':files,'excluded_helper_logs':['content-native-first.log','content-native.log'],'real_original_failure':'boundary-original.log','excluded_large_generated_fixtures':'large-fixture-identities.json','limitations':'review.md'}
p=r/'manifest.json';p.write_text(json.dumps(manifest,indent=2),encoding='utf-8')
print(str(p.resolve()));print(h(p));print(len(files),'files')
