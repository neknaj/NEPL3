from pathlib import Path
import sys,tempfile,json,subprocess
r=Path.cwd();sys.path.insert(0,str(r/'tools/site'))
from journal import Event,append,load
from journal import store
out=r/'.tmp/journal-ci-review'
e=Event('DeployIntent','original',123,1,'a'*40,'b'*64)
results={}
with tempfile.TemporaryDirectory(dir=out) as d:
 repo=Path(d)/'mirror.git';subprocess.run(['git','init','--bare','--quiet',str(repo)],check=True)
 first=append(repo,None,e,b'{}')
 tree=store.git(repo,'rev-parse',first+'^{tree}').decode().strip()
 bad=store.git(repo,'commit-tree',tree,'-p',first,data=b'Invalid same-tree descendant\n').decode().strip()
 store.git(repo,'update-ref',store.REF,bad,first)
 try:load(repo);results['ordinary_bad_history']='accepted'
 except ValueError as ex:results['ordinary_bad_history']='rejected: '+str(ex)
 (repo/'shallow').write_text(bad+'\n',encoding='utf8')
 try:load(repo);results['shallow_bad_history']='accepted'
 except ValueError as ex:results['shallow_bad_history']='rejected: '+str(ex)
print(json.dumps(results,indent=2));(out/'shallow-final.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8')
