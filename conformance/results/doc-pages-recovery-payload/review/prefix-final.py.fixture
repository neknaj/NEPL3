from pathlib import Path
import sys,json
sys.path.insert(0,str(Path('tools/site').resolve()))
from payload import digest,tar_bytes
from recovery import verify
files={'index.html':b'<html></html>','build.json':b'{}','.nojekyll':b'','assets':b'file','assets/a.css':b'css'}
files['manifest.json']=json.dumps({'version':1,'files':[{'path':k,'bytes':len(v),'sha256':digest(v)} for k,v in files.items()]}).encode()
data=tar_bytes(files)
try:
 value=verify(data,digest(data),digest(files['manifest.json']));result={'accepted_file_directory_conflict':True,'files':value.files}
except ValueError as ex:result={'accepted_file_directory_conflict':False,'error':str(ex)}
p=Path('.tmp/recovery-payload-review');(p/'prefix-final.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print(json.dumps(result))

assert not result["accepted_file_directory_conflict"]
