from pathlib import Path
from playwright.sync_api import sync_playwright
import json,hashlib,shutil,threading,http.server,functools
OUT=Path(__file__).parent.resolve()/'final';bundle=OUT/'bundle';bundle.mkdir(exist_ok=True)
css=Path('crates/languages/doc/html/assets/doc.css').read_bytes()
for src in Path('.tmp/html-chapter02-resolved-first/docs/spec').glob('*.html'): shutil.copyfile(src,bundle/src.name)
(bundle/'assets').mkdir(exist_ok=True);(bundle/'assets/doc.css').write_bytes(css)
shutil.copyfile('conformance/results/doc-local-html/example/document.html',bundle/'parallel.html')
class Handler(http.server.SimpleHTTPRequestHandler):
 def log_message(self,*args): pass
server=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(Handler,directory=str(bundle)))
threading.Thread(target=server.serve_forever,daemon=True).start()
measure='''()=>{let article=document.querySelector('article'),r=article.getBoundingClientRect();return {overflow:document.documentElement.scrollWidth>innerWidth,scrollWidth:document.documentElement.scrollWidth,width:r.width,left:r.left,background:getComputedStyle(article).backgroundColor,bodyBackground:getComputedStyle(document.body).backgroundColor,bodyMargin:getComputedStyle(document.body).margin,scriptCount:document.scripts.length,ruby:article.querySelectorAll('.nepl-ruby').length,anno:article.querySelectorAll('.nepl-anno').length,badAnnotations:[...article.querySelectorAll('.nepl-ruby,.nepl-anno')].filter(n=>{let b=n.querySelector(':scope>.nepl-base').getBoundingClientRect(),x=n.querySelector(':scope>.nepl-reading'),y=n.querySelector(':scope>.nepl-notes');return x?x.getBoundingClientRect().bottom>b.top+.2:y.getBoundingClientRect().top<b.bottom-.2}).length,paragraphs:article.querySelectorAll('.nepl-paragraph').length,codes:article.querySelectorAll('code').length,groups:[...article.querySelectorAll('[data-nepl-group]')].map(n=>({id:n.dataset.neplGroup,mode:n.className,languages:[...n.children].map(c=>c.lang),blockChildren:n.querySelectorAll('p,div,section').length,rect:{x:n.getBoundingClientRect().x,y:n.getBoundingClientRect().y,w:n.getBoundingClientRect().width,h:n.getBoundingClientRect().height},variantRects:[...n.children].map(c=>{let r=c.getBoundingClientRect();return {x:r.x,y:r.y,w:r.width,h:r.height}})}))}}'''
rows=[]
with sync_playwright() as p:
 for engine in ['chromium','firefox','webkit']:
  browser=getattr(p,engine).launch()
  for width in [375,1280]:
   ctx=browser.new_context(java_script_enabled=False,viewport={'width':width,'height':900});page=ctx.new_page()
   for f in sorted(bundle.glob('*.html')):
    page.goto(f'http://127.0.0.1:{server.server_port}/{f.name}',wait_until='networkidle')
    if f.name=='parallel.html':
     for mode in ['rows','columns','single']:
      page.reload(wait_until='networkidle')
      page.evaluate('''mode=>document.querySelectorAll('[data-nepl-group]').forEach(n=>{n.className='nepl-parallel-'+mode;if(mode==='single')[...n.children].filter(c=>c.lang!=='ja').forEach(c=>c.remove())})''',mode)
      row=page.evaluate(measure);row.update(engine=engine,viewport=width,file=f.name,mode=mode);rows.append(row)
      page.screenshot(path=str(OUT/f'{engine}-{width}-{mode}.png'))
    else:
     row=page.evaluate(measure);row.update(engine=engine,viewport=width,file=f.name);rows.append(row)
     if f.name=='02-foundation.html':page.screenshot(path=str(OUT/f'{engine}-{width}-foundation.png'))
   ctx.close()
  browser.close()
server.shutdown()
(OUT/'results.json').write_text(json.dumps({'css_sha256':hashlib.sha256(css).hexdigest(),'cases':rows},ensure_ascii=False,indent=2),encoding='utf-8')
print(json.dumps({'cases':len(rows),'overflow':[ {k:r[k] for k in ['engine','viewport','file','scrollWidth']} for r in rows if r['overflow']],'annotationBad':[(r['engine'],r['viewport'],r['file'],r['badAnnotations']) for r in rows if r['badAnnotations']]}))
