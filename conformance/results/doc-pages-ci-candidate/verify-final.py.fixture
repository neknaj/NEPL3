from pathlib import Path
import sys,subprocess,json,copy
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_candidate import CandidateTests
from deployment.candidate import verify
p=Path('.tmp/ci-candidate-review');rows=[]
for flags in [[],['-O']]:
 cmd=[sys.executable]+flags+['-m','unittest','discover','-s','tools/site','-p','test_candidate.py'];r=subprocess.run(cmd,capture_output=True);label='final-optimized' if flags else 'final-normal';(p/(label+'.stdout')).write_bytes(r.stdout);(p/(label+'.stderr')).write_bytes(r.stderr);rows.append(dict(command=cmd,exit_code=r.returncode))
(p/'final-commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8')
if any(r['exit_code'] for r in rows):raise ValueError('tests failed')
t=CandidateTests();run,jobs=t.fixture();probes=[]
for count in [100,101]:
 j=copy.deepcopy(jobs)
 for i in range(count-8):j['jobs'].append(dict(j['jobs'][0],id=1000+i,name='extra-'+str(i)))
 j['total_count']=len(j['jobs'])
 try:t.check(run,j);accepted=True
 except ValueError:accepted=False
 if accepted!=(count==100):raise ValueError('count boundary')
 probes.append(dict(count=count,accepted=accepted))
for key,value in [('total_count',True),('total_count',8.0)]:
 try:t.check(run,dict(jobs,**{key:value}))
 except ValueError:probes.append(dict(invalid_total=value,rejected=True))
 else:raise ValueError('invalid total accepted')
live=Path('.tmp/ci-candidate-live');raw=(live/'run.json').read_bytes();jr=(live/'jobs.json').read_bytes();r=json.loads(raw)
c=verify(raw,jr,owner='neknaj',repository='NEPL3',repository_id=r['repository']['id'],workflow_id=r['workflow_id'],run_id=r['id'],attempt=r['run_attempt'],current_main=r['head_sha'])
probes.append(dict(saved_api_run=c.run_id,attempt=c.attempt,source=c.source_commit,run_digest=c.run_sha256,jobs_digest=c.jobs_sha256,interoperability_only_current_main_from_saved_run=True))
(p/'final-probes.json').write_text(json.dumps(probes,indent=2)+'\n',encoding='utf8');print(probes)
