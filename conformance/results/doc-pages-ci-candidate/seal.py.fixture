from pathlib import Path
import sys,json,hashlib
p=Path('.tmp/ci-candidate-review');sys.path.insert(0,str(Path('tools/site').resolve()))
from test_candidate import CandidateTests
t=CandidateTests();checks=[]
for status,conclusion in [('queued','success'),('in_progress',None),('completed','cancelled'),('completed','skipped')]:
 run,jobs=t.fixture();jobs['jobs'].append(dict(jobs['jobs'][0],id=999,name='deliver source',status=status,conclusion=conclusion));jobs['total_count']=9
 try:t.check(run,jobs);accepted=True
 except ValueError:accepted=False
 if accepted!=(conclusion=='skipped'):raise ValueError('optional state accepted')
 checks.append(dict(status=status,conclusion=conclusion,accepted=accepted))
(p/'optional-probes.json').write_text(json.dumps(checks,indent=2)+'\n',encoding='utf8')
with (p/'review.md').open('a',encoding='utf8',newline='\n') as f:f.write('\nFinal revision review: all optional jobs must also be completed with success/skipped; independent queued, in_progress and cancelled optional probes reject, while skipped delivery passes. Final 5-test suites pass normally and under python -O; earlier 4-test logs remain historical. Final tools/site/README.md accurately separates candidate checks from authenticated fetch, attempt-bound artifact provenance and mutation permission.\n')
for name in ['tools/site/deployment/candidate.py','tools/site/test_candidate.py','tools/site/README.md']:
 f=p/'source'/name;f.parent.mkdir(parents=True,exist_ok=True);f.write_bytes(Path(name).read_bytes())
rows=[]
for f in sorted(p.rglob('*')):
 if f.is_file() and f.name!='manifest.json':
  b=f.read_bytes();rows.append(dict(path=f.relative_to(p).as_posix(),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
(p/'manifest.json').write_text(json.dumps(dict(files=rows),indent=2)+'\n',encoding='utf8');print(len(rows),sum(r['bytes'] for r in rows))
