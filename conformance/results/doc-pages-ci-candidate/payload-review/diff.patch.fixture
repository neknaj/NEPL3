diff --git a/tools/site/deployment/artifact.py b/tools/site/deployment/artifact.py
index ae271b3..00a661d 100644
--- a/tools/site/deployment/artifact.py
+++ b/tools/site/deployment/artifact.py
@@ -18,10 +18,10 @@ MAX_ARCHIVE = 256 * 1024 * 1024
 MAX_ENTRIES = 8192
 
 
-def selected(raw, archive, *, owner, repository, artifact_id, run_id,
+def selected(raw, archive, *, owner, repository, artifact_id, run_id, attempt,
              repository_id, source_commit, expected_tar, expected_manifest):
     """Return the original checked raw tar, never extract or rebuild files."""
-    for value in (artifact_id, run_id, repository_id):
+    for value in (artifact_id, run_id, attempt, repository_id):
         checked(type(value) is int and 0 < value < 2**53, 'invalid artifact/run/repository ID')
     hex_id(source_commit, 40)
     checked(isinstance(raw, bytes) and len(raw) <= 65536, 'artifact metadata limit')
@@ -33,7 +33,8 @@ def selected(raw, archive, *, owner, repository, artifact_id, run_id,
     checked(isinstance(meta, dict), 'invalid artifact metadata')
     checked(type(meta.get('id')) is int and meta['id'] == artifact_id, 'artifact ID mismatch')
     checked(meta.get('url') == prefix and meta.get('archive_download_url') == prefix + '/zip', 'artifact URL mismatch')
-    checked(meta.get('name') == 'doc-browser-' + source_commit and meta.get('expired') is False, 'artifact name or expiry mismatch')
+    checked(meta.get('name') == f'doc-browser-{source_commit}-{run_id}-{attempt}'
+            and meta.get('expired') is False, 'artifact name or expiry mismatch')
     checked(type(meta.get('size_in_bytes')) is int and meta['size_in_bytes'] == len(archive), 'archive size mismatch')
     checked(meta.get('digest') == 'sha256:' + digest(archive), 'archive digest mismatch')
     run = meta.get('workflow_run')
diff --git a/tools/site/deployment/candidate.py b/tools/site/deployment/candidate.py
index 8ced7eb..8da1202 100644
--- a/tools/site/deployment/candidate.py
+++ b/tools/site/deployment/candidate.py
@@ -25,6 +25,27 @@ class Candidate:
     jobs_sha256: str
 
 
+def prepare(run_raw, jobs_raw, artifact_raw, archive, *, owner, repository,
+            repository_id, workflow_id, run_id, attempt, current_main, artifact_id,
+            expected_tar, expected_manifest):
+    """Bind eligible CI observations to the attempt-named downloaded payload.
+
+    Only trusted workflow uploads may establish the artifact naming convention.
+    Authentication, job-to-upload provenance and final freshness remain host
+    responsibilities; no serialized Candidate is accepted as proof here.
+    """
+    from .artifact import selected
+    candidate = verify(run_raw, jobs_raw, owner=owner, repository=repository,
+                       repository_id=repository_id, workflow_id=workflow_id,
+                       run_id=run_id, attempt=attempt, current_main=current_main)
+    payload = selected(artifact_raw, archive, owner=owner, repository=repository,
+                       repository_id=repository_id, run_id=candidate.run_id,
+                       attempt=candidate.attempt, source_commit=candidate.source_commit,
+                       artifact_id=artifact_id, expected_tar=expected_tar,
+                       expected_manifest=expected_manifest)
+    return candidate, payload
+
+
 def integer(value):
     checked(type(value) is int and 0 < value < 2**53, 'invalid CI identity')
 
