from pathlib import Path
import subprocess,sys,json
from unittest.mock import patch
p=Path('.tmp/candidate-payload-review');rows=[]
for pattern in ['test_candidate*.py','test_artifact*.py']:
 for flag in [[],['-O']]:
  cmd=[sys.executable]+flag+['-m','unittest','discover','-s','tools/site','-p',pattern];r=subprocess.run(cmd,capture_output=True);label=('candidate' if 'candidate' in pattern else 'artifact')+('-optimized' if flag else '-normal');(p/(label+'.stdout')).write_bytes(r.stdout);(p/(label+'.stderr')).write_bytes(r.stderr);rows.append(dict(command=cmd,exit_code=r.returncode))
(p/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8')
if any(r['exit_code'] for r in rows):raise ValueError('tests failed')
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_candidate_payload import CandidatePayloadTests
t=CandidatePayloadTests();run,jobs,meta,archive,kw,tar=t.fixture();jobs['jobs'][0]['conclusion']='failure'
with patch('deployment.artifact.selected') as select:
 try:t.call(run,jobs,meta,archive,kw)
 except ValueError:pass
 else:raise ValueError('failed CI accepted')
 if select.call_count:raise ValueError('selected before verified')
run,jobs,meta,archive,kw,tar=t.fixture();run['run_attempt']=2;kw['attempt']=2;meta['name']='doc-browser-'+kw['current_main']+'-8-2'
for job in jobs['jobs']:job['run_attempt']=2
candidate,payload=t.call(run,jobs,meta,archive,kw)
if candidate.attempt!=2 or payload.data!=tar:raise ValueError('attempt2 handoff failed')
(p/'probes.json').write_text(json.dumps(dict(failed_ci_calls_selected=0,consistent_attempt2_passed=True,raw_tar_preserved=True),indent=2)+'\n',encoding='utf8');print(rows)
