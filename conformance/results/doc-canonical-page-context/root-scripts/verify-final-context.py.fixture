import json,pathlib,subprocess,sys,time
out=pathlib.Path('.tmp/verify-final-context');out.mkdir(parents=True,exist_ok=True)
commands=[('format',['cargo','fmt','--all','--','--check']),('tools-lib',['cargo','test','--locked','-p','nepl3-tools','--lib','--','--test-threads=1','--nocapture']),('doc-tests',['cargo','test','--locked','-p','nepl3-tools','--test','doc','--','--test-threads=1']),('clippy',['cargo','clippy','--locked','--workspace','--all-targets','--','-D','warnings']),('canonical-current',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','--check']),('repository',['cargo','run','--locked','-p','nepl3-tools','--','check'])]
results=[]
head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
for name,cmd in commands:
    started=time.monotonic()
    with (out/(name+'.stdout.log')).open('wb') as stdout,(out/(name+'.stderr.log')).open('wb') as stderr:
        p=subprocess.run(cmd,stdout=stdout,stderr=stderr,timeout=1200)
    results.append(dict(source_commit=head,name=name,command=cmd,exit_code=p.returncode,elapsed=time.monotonic()-started))
    (out/'commands.json').write_text(json.dumps(results,indent=2),encoding='utf-8')
    print(name,p.returncode,flush=True)
    if p.returncode:
        print((out/(name+'.stderr.log')).read_text(encoding='utf-8',errors='replace')[-2000:]);sys.exit(p.returncode)
