from pathlib import Path
import re, sys, json, hashlib, difflib
ROOT=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(ROOT))
from tools.audit.structure import Parser,load_forms
exec((Path(__file__).parent/'helpers.py').read_text(encoding='utf8'))
out=Path(__file__).parent
def visible(n):
    if isinstance(n,list):return ''.join(map(visible,n))
    if not isinstance(n,dict):return ''
    f=n['fields']
    if n['kind']=='Link':return visible(f['label'])
    if n['kind'] in ('Text','InlineCode','RawCode'):return f['text']
    return ''.join(visible(v) for v in f.values())
def md(s):
    return re.sub(r'\[([^\]]+)\]\([^\)]+\)',r'\1',s.replace('`','').replace('\n',''))
result={}
for number,before in [('16',3),('21',4)]:
    name='16-doc-migration' if number=='16' else '21-doc-pages'
    path=ROOT/f'doc/migration/authored/{name}.nepld'
    raw=path.read_bytes(); assert not raw.startswith(b'\xef\xbb\xbf') and b'\r' not in raw
    text=raw.decode('utf8'); tree=Parser(text,load_forms(ROOT)).complete('Doc/Article')
    normalized=normalize(tree,True)
    old=(out/f'before-{before}.txt').read_bytes()
    operations=[(tag,a,b,c,d) for tag,a,b,c,d in difflib.SequenceMatcher(None,old.splitlines(keepends=True),raw.splitlines(keepends=True)).get_opcodes() if tag!='equal']
    if number=='16':
        assert len(operations)==1 and operations[0][0]=='insert',operations
        section=next(x for x in walk(normalized) if x['kind']=='Section' and x['fields']['id']=='page_projection')
        original=next(x for x in walk(tree) if x['kind']=='Section' and x['fields']['id']=='page_projection')
        # Only the new blocks are subject to new Ruby audit; old paragraphs remain exact bytes.
        blocks=section['fields']['body']['fields']['blocks'][:7]
        audit_text(original['fields']['body']['fields']['blocks'][:7])
        rendered=[]
        for b in blocks:
            if b['kind']=='List':
                assert b['fields']['style']['fields']['start']=='1'
                rendered.extend(visible(i['fields']['body']) for i in b['fields']['items'])
            else:rendered.append(visible(b))
        source=(ROOT/f'doc/spec/{name}.md').read_text(encoding='utf8')
        segment=source.split('### ページ間参照を持つMarkdown projection\n\n',1)[1].split('\n\n互換alias',1)[0]
        expected=[]
        for p in segment.split('\n\n'):
            if p.startswith('1. '):expected.extend(md(re.sub(r'^\d+\. ','',line)) for line in p.splitlines())
            else:expected.append(md(p))
        assert rendered==expected,list(zip(rendered,expected))
        result[number]={'new_body_units':len(rendered),'new_sentences':sum(x['kind']=='Sentence' for x in walk(blocks)),'existing_bytes':'single insertion only','source_units':expected}
    else:
        assert len(operations)==2 and all(x[0]=='replace' for x in operations),operations
        section=next(x for x in walk(normalized) if x['kind']=='Section' and x['fields']['id']=='annotated_pages')
        original=next(x for x in walk(tree) if x['kind']=='Section' and x['fields']['id']=='annotated_pages')
        para=section['fields']['body']['fields']['blocks'][-1]
        audit_text(original['fields']['body']['fields']['blocks'][-1])
        source=(ROOT/f'doc/spec/{name}.md').read_text(encoding='utf8')
        expected=md(source[source.index('返すidentityは既存のPageSet identity'):].strip())
        assert visible(para)==expected,(visible(para),expected)
        links=[x['fields']['target'] for x in walk(para) if x['kind']=='Link']
        assert links==[{'kind':'RelativeTarget','fields':{'path':'16-doc-migration.md','fragment':{'kind':'NoText','fields':{}}}}],links
        result[number]={'paragraph_exact':True,'new_relative_link':links,'source_paragraph':expected}
    result[number]['diff_operations']=operations
    (out/f'after-{number}.nepld').write_bytes(raw)
    (out/f'draft-{number}.diff').write_text(''.join(difflib.unified_diff(old.decode('utf8').splitlines(True),text.splitlines(True),fromfile='before',tofile='after')),encoding='utf8',newline='\n')
(out/'checks.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS: both full structures; exact added source prose/list/code/link; Kanji-only Ruby; constrained byte diffs')
