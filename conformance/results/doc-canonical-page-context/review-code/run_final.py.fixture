from pathlib import Path
import subprocess,json,hashlib,os,sys
out=Path(__file__).parent;ws=out/'workspace-final';name=sys.argv[1] if len(sys.argv)>1 else 'native-final'
base=(out/'final819/source/tools/src/doc/canonical/tests.rs').read_bytes();probe=(out/'probe.rs').read_bytes()+b'\n'+(out/'precharge_probe.rs').read_bytes()
(ws/'tools/src/doc/canonical/tests.rs').write_bytes(base+b'\n'+probe)
env=dict(os.environ,CARGO_TARGET_DIR=str((out/'target-final').resolve()))
artifacts=out/'artifacts';artifacts.mkdir(exist_ok=True)
env['NEPL3_REVIEW_CONTEXT_OUTPUT']=str((artifacts/name).resolve())
cmd=['cargo','test','--locked','-p','nepl3-tools','--lib','independent_context','--','--nocapture','--test-threads=1']
r=subprocess.run(cmd,cwd=ws,env=env,capture_output=True,timeout=900)
(out/(name+'.stdout.log')).write_bytes(r.stdout);(out/(name+'.stderr.log')).write_bytes(r.stderr)
bins=list((out/'target-final/debug/deps').glob('nepl3_tools-*.exe'))
record=dict(command=cmd,cwd=str(ws),head='819f0e9a7d983bb8b104f1dceb5681989e046369',target_dir=env['CARGO_TARGET_DIR'],artifact_directory=env['NEPL3_REVIEW_CONTEXT_OUTPUT'],deadline_seconds=900,exit_code=r.returncode,probe_sha256=hashlib.sha256(probe).hexdigest(),binaries=[dict(path=str(p),sha256=hashlib.sha256(p.read_bytes()).hexdigest(),bytes=p.stat().st_size) for p in bins])
(out/(name+'.command.json')).write_text(json.dumps(record,indent=2)+'\n',encoding='utf8')
print(name,r.returncode,r.stdout.decode('utf8','replace')[-1200:].encode('ascii','backslashreplace').decode(),r.stderr.decode('utf8','replace')[-1200:],flush=True)
assert r.returncode==0
