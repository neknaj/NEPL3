from pathlib import Path
import subprocess,json,hashlib,os,sys
out=Path(__file__).parent;ws=out/'workspace';name=sys.argv[1] if len(sys.argv)>1 else 'native-expanded'
base=(out/'source/tools/src/doc/canonical/tests.rs').read_bytes();probe=(out/'probe.rs').read_bytes()
(ws/'tools/src/doc/canonical/tests.rs').write_bytes(base+b'\n'+probe)
env=dict(os.environ,CARGO_TARGET_DIR=str((out/'target').resolve()))
cmd=['cargo','test','--locked','-p','nepl3-tools','--lib','independent_context','--','--nocapture','--test-threads=1']
r=subprocess.run(cmd,cwd=ws,env=env,capture_output=True,timeout=900)
(out/(name+'.stdout.log')).write_bytes(r.stdout);(out/(name+'.stderr.log')).write_bytes(r.stderr)
record=dict(command=cmd,cwd=str(ws),target_dir=env['CARGO_TARGET_DIR'],deadline_seconds=900,exit_code=r.returncode,probe_sha256=hashlib.sha256(probe).hexdigest())
(out/(name+'.command.json')).write_text(json.dumps(record,indent=2)+'\n',encoding='utf8')
print(name,r.returncode,r.stdout.decode('utf8','replace'),r.stderr.decode('utf8','replace'),flush=True)
assert r.returncode==0
