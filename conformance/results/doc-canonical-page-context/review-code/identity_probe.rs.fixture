#[test]
fn independent_context_each_frozen_input_changes_context() -> Result<()> {
    fn digest(header:&str, label:&str)->Result<String>{Ok(header.split_once(label).ok_or("missing digest label")?.1.split_whitespace().next().ok_or("missing digest")?.to_owned())}
    let f=Fixture::new()?;
    let source=r#"article en "A" body nil"#;
    f.write("doc/a.nepld",source)?;f.write("doc/b.nepld",source)?;f.write("doc/a.json",b"[]")?;
    let base=json!({"version":1,"pages":[{"id":"a","source":"doc/a.nepld","projection":"doc/a.md","aliases":"doc/a.json","route":"site/a.html","renderer":projection::RENDERER}]});
    f.json("doc/canonical.json",&base)?;
    let mut budget=super::super::source::budget();let initial=projection::generate(f.root(),"doc/canonical.json",&mut budget)?;
    let initial_context=digest(&initial.files[0].1,"input context SHA-256 ")?;
    let initial_set=digest(&initial.files[0].1,"input PageSet digest ")?;
    let mut rows=Vec::new();
    for kind in ["registry-whitespace","registry-path","source-bytes","source-path","alias-bytes","alias-path","page-id","projection","route","limits"] {
        let mut value=base.clone();let mut manifest="doc/canonical.json";
        f.write("doc/a.nepld",source)?;f.write("doc/a.json",b"[]")?;
        match kind {
            "registry-path"=>manifest="doc/other.json",
            "source-bytes"=>f.write("doc/a.nepld",format!("{source}\n"))?,
            "source-path"=>value["pages"][0]["source"]=json!("doc/b.nepld"),
            "alias-bytes"=>f.write("doc/a.json",b"[ ]")?,
            "alias-path"=>{f.write("doc/other.json",b"[]")?;value["pages"][0]["aliases"]=json!("doc/other.json");},
            "page-id"=>value["pages"][0]["id"]=json!("other"),
            "projection"=>value["pages"][0]["projection"]=json!("doc/other.md"),
            "route"=>value["pages"][0]["route"]=json!("site/other.html"),
            "limits"=>value["output_limits"]=serde_json::to_value(super::super::export::pages::resources::OutputLimits::default())?,
            _=>(),
        }
        f.json(manifest,&value)?;
        if kind=="registry-whitespace" {let raw=fs::read_to_string(f.root().join(manifest))?;f.write(manifest,format!("\n{raw}"))?;}
        let mut b=super::super::source::budget();let result=projection::generate(f.root(),manifest,&mut b)?;
        let context=digest(&result.files[0].1,"input context SHA-256 ")?;
        let set=digest(&result.files[0].1,"input PageSet digest ")?;
        assert_ne!(context,initial_context,"{kind}");
        if matches!(kind,"registry-whitespace"|"registry-path"|"source-path"|"alias-bytes"|"alias-path"|"route"|"limits") {assert_eq!(set,initial_set,"{kind}");}
        let mut repeated=super::super::source::budget();let again=projection::generate(f.root(),manifest,&mut repeated)?;
        assert_eq!(again.files,result.files);assert_eq!(again.manifest,result.manifest);
        rows.push(json!({"mutation":kind,"context":context,"pageset":set,"repeat_exact":true}));
    }
    println!("INDEPENDENT_IDENTITY {}",json!({"initial_context":initial_context,"initial_pageset":initial_set,"mutations":rows}));
    Ok(())
}
