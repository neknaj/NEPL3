// Independent tests appended only to a fixed isolated canonical/tests.rs copy.
fn review_context_fixture(f: &Fixture) -> Result<serde_json::Value> {
    let value = json!({"version":1,"pages":[
        {"id":"a","source":"doc/a.nepld","projection":"doc/nested/a.md","aliases":"doc/a.json","route":"site/a.html","renderer":projection::RENDERER},
        {"id":"b","source":"doc/b.nepld","projection":"doc/b.md","aliases":"doc/b.json","route":"else/b.html","renderer":projection::RENDERER},
        {"id":"legacy","source":"doc/legacy.nepld","projection":"doc/legacy.md","aliases":"doc/legacy.json","route":"legacy/l.html","renderer":RENDERER}
    ]});
    f.json("doc/canonical.json", &value)?;
    f.write("doc/a.nepld", r#"article ja "A" body cons paragraph cons sentence cons link page "b" some "節" text "B" cons text " / " cons link relative "../legacy.md" some "old" text "L" cons text " / " cons link relative "a.md" none text "self" nil nil nil"#)?;
    f.write("doc/b.nepld", r#"article ja "B" body cons section 節 "[節/せつ]" body cons paragraph cons sentence cons link page "a" none text "A" nil nil nil nil"#)?;
    f.write("doc/legacy.nepld", r#"article en "L" body cons section old "Old" body cons paragraph cons "Legacy." nil nil nil"#)?;
    f.write("doc/a.json", b"[]")?;
    f.write("doc/b.json", b"[]")?;
    f.write("doc/legacy.json", br#"[{"section":"old","name":"old-heading"}]"#)?;
    Ok(value)
}

fn review_destinations(text: &str) -> Vec<String> {
    pulldown_cmark::Parser::new(text).filter_map(|e| match e {
        pulldown_cmark::Event::Start(pulldown_cmark::Tag::Link {dest_url,..}) => Some(dest_url.into_string()),
        _ => None,
    }).collect()
}

#[test]
fn independent_context_mutual_unicode_legacy_and_actual_staging() -> Result<()> {
    let f=Fixture::new()?;
    let registry=review_context_fixture(&f)?;
    let stage=f.root().join("staged");
    markdown(f.root(),"doc/canonical.json",&stage)?;
    let a=fs::read_to_string(stage.join("doc/nested/a.md"))?;
    let b=fs::read_to_string(stage.join("doc/b.md"))?;
    let l=fs::read_to_string(stage.join("doc/legacy.md"))?;
    assert_eq!(review_destinations(&a),["../b.md#n-e7af80","../legacy.md#n-6f6c64","a.md"]);
    assert_eq!(review_destinations(&b),["nested/a.md"]);
    assert!(b.contains("<a name=\"n-e7af80\"></a>"));
    assert!(l.contains("<a name=\"n-6f6c64\"></a>") && l.contains("<a name=\"old-heading\"></a>"));
    let compiled=super::super::source::compiled()?;
    let old=host::generate(&compiled,"doc/legacy.nepld",&fs::read_to_string(f.root().join("doc/legacy.nepld"))?,&fs::read(f.root().join("doc/legacy.json"))?)?;
    assert_eq!(l,old);
    for (path,text) in [("doc/nested/a.md",&a),("doc/b.md",&b),("doc/legacy.md",&l)] {f.write(path,text)?;}
    check(f.root(),"doc/canonical.json")?;
    assert!(markdown(f.root(),"doc/canonical.json",&stage).is_err());
    assert_eq!(fs::read_to_string(stage.join("doc/nested/a.md"))?,a);
    f.write("doc/legacy.md","corrupt stale view\n")?;
    assert!(check(f.root(),"doc/canonical.json").is_err());
    let fresh=f.root().join("fresh");markdown(f.root(),"doc/canonical.json",&fresh)?;
    assert_eq!(fs::read_to_string(fresh.join("doc/legacy.md"))?,old);
    let site=f.root().join("site");html(f.root(),"doc/canonical.json",&site)?;
    let h=fs::read_to_string(site.join("site/a.html"))?;
    assert!(h.contains("../else/b.html#n-e7af80"));
    assert!(h.contains("../legacy/l.html#n-6f6c64"));
    let mut inputs=Vec::new();
    for p in registry["pages"].as_array().ok_or("pages")? {
        inputs.push(json!({"source":fs::read_to_string(f.root().join(p["source"].as_str().ok_or("source")?))?,"aliases":fs::read_to_string(f.root().join(p["aliases"].as_str().ok_or("aliases")?))?}));
    }
    println!("INDEPENDENT_CONTEXT {}",json!({"case":"mutual-unicode","manifest_path":"doc/canonical.json","manifest_raw":fs::read_to_string(f.root().join("doc/canonical.json"))?,"inputs":inputs,"header":a.split_once("\n\n").ok_or("header")?.0,"legacy_exact":true,"html_hrefs_exact":true}));
    Ok(())
}

#[test]
fn independent_context_late_failures_leave_no_directory() -> Result<()> {
    for kind in ["ambient","alias","source","unemitted"] {
        let f=Fixture::new()?;let mut registry=review_context_fixture(&f)?;
        match kind {
            "ambient" => {registry["pages"].as_array_mut().ok_or("pages")?.remove(1);f.json("doc/canonical.json",&registry)?;f.write("doc/b.md","# 節\n")?;},
            "alias" => f.write("doc/legacy.json",b"[{")?,
            "source" => f.write("doc/legacy.nepld","not an article")?,
            _ => f.write("doc/b.nepld",r#"article ja "B" body cons paragraph cons sentence cons anchor 節 text "B" nil nil nil"#)?,
        }
        let out=f.root().join("output");assert!(markdown(f.root(),"doc/canonical.json",&out).is_err(),"{kind}");assert!(!out.exists(),"{kind}");
        println!("INDEPENDENT_CONTEXT {}",json!({"case":kind,"failed_without_output":true}));
    }
    Ok(())
}

#[test]
fn independent_context_budget_caller_state_and_pre_stopped_root() -> Result<()> {
    use nepl3_core::budget::{Budget,Resource,StopReason};
    let f=Fixture::new()?;review_context_fixture(&f)?;
    let mut success=super::super::source::budget();success.charge(Resource::Work,19).map_err(super::super::source::err)?;
    projection::generate(f.root(),"doc/canonical.json",&mut success)?;
    // Keep the Work/Output limit decimal widths stable when subtracting one.
    // A receipt containing limits otherwise changes length with the test cap.
    let ceiling=|v:u64|->Result<u64>{Ok(10u64.checked_pow(v.ilog10()+1).and_then(|n|n.checked_sub(1)).ok_or("ceiling overflow")?)};
    let mut reference_limits=success.limits();
    reference_limits.work=ceiling(success.usage().work)?;
    reference_limits.output_bytes=ceiling(success.usage().output_bytes)?;
    let mut success=Budget::new(reference_limits);success.charge(Resource::Work,19).map_err(super::super::source::err)?;
    let expected=projection::generate(f.root(),"doc/canonical.json",&mut success)?;
    let used=success.usage();let default=success.limits();
    for reason in [StopReason::WorkLimit,StopReason::AllocationLimit,StopReason::OutputLimit,StopReason::NodeLimit,StopReason::SourceLimit,StopReason::DepthLimit,StopReason::Cancelled] {
        let mut limits=default;
        match reason {
            StopReason::WorkLimit=>limits.work=used.work-1,
            StopReason::AllocationLimit=>limits.allocation_units=used.allocation_units-1,
            StopReason::OutputLimit=>limits.output_bytes=used.output_bytes-1,
            StopReason::NodeLimit=>limits.nodes=used.nodes-1,
            StopReason::SourceLimit=>limits.source_bytes=0,
            StopReason::DepthLimit=>limits.depth=0,
            _=>(),
        }
        let mut b=Budget::new(limits);b.charge(Resource::Work,19).map_err(super::super::source::err)?;
        if reason==StopReason::Cancelled {b.cancel();}
        assert!(projection::generate(f.root(),"doc/canonical.json",&mut b).is_err());
        assert_eq!(b.poll(),Err(reason));let stopped=b.usage();
        assert!(projection::generate(f.root(),"doc/absent.json",&mut b).is_err());
        assert_eq!(b.poll(),Err(reason));assert_eq!(b.usage(),stopped);assert!(stopped.work>=19);
        println!("INDEPENDENT_CONTEXT {}",json!({"case":"sticky","reason":format!("{reason:?}"),"usage":format!("{stopped:?}")}));
    }
    let mut nested=Budget::new(default);nested.charge(Resource::Work,19).map_err(super::super::source::err)?;
    let mut result=None;
    nested.with_depth_at_least(7,|b| {result=Some(projection::generate(f.root(),"doc/canonical.json",b));Ok::<(),StopReason>(())}).map_err(super::super::source::err)?;
    let actual=result.ok_or("depth callback was not entered")??;
    assert_eq!(actual.files,expected.files);assert_eq!(nested.current_depth(),0);
    let a:serde_json::Value=serde_json::from_str(&actual.manifest)?;let mut e:serde_json::Value=serde_json::from_str(&expected.manifest)?;
    assert_eq!(a["output_budget"]["initial_usage"]["depth"],7);
    assert_eq!(a["output_budget"]["usage_before_receipt_serialization"]["depth"],e["output_budget"]["usage_before_receipt_serialization"]["depth"].as_u64().ok_or("depth")?+7);
    e["output_budget"]["initial_usage"]["depth"]=json!(7);
    e["output_budget"]["usage_before_receipt_serialization"]["depth"]=a["output_budget"]["usage_before_receipt_serialization"]["depth"].clone();
    assert_eq!(a,e);
    println!("INDEPENDENT_CONTEXT {}",json!({"case":"caller-depth","used":format!("{used:?}"),"nested":format!("{:?}",nested.usage())}));
    Ok(())
}

#[test]
fn independent_context_same_source_bytes_distinct_page_ids() -> Result<()> {
    let f=Fixture::new()?;
    let doc=r#"article en "Same" body cons paragraph cons "Same." nil nil"#;
    let mut regs=Vec::new();
    for name in ["first","second"] {
        regs.push(json!({"id":name,"source":format!("doc/{name}.nepld"),"projection":format!("doc/{name}.md"),"aliases":format!("doc/{name}.json"),"route":format!("site/{name}.html"),"renderer":projection::RENDERER}));
        f.write(&format!("doc/{name}.nepld"),doc)?;f.write(&format!("doc/{name}.json"),b"[]")?;
    }
    f.json("doc/canonical.json",&json!({"version":1,"pages":regs}))?;
    let a=projection::generate(f.root(),"doc/canonical.json",&mut super::super::source::budget())?;
    let digest=|s:&str|->Result<String>{Ok(s.split("document digest ").nth(1).ok_or("digest")?.split(';').next().ok_or("end")?.into())};
    assert_ne!(digest(&a.files[0].1)?,digest(&a.files[1].1)?);
    assert_eq!(a.files[0].1.split_once("\n\n").ok_or("body")?.1,a.files[1].1.split_once("\n\n").ok_or("body")?.1);
    println!("INDEPENDENT_CONTEXT {}",json!({"case":"distinct-source-identities","digests":[digest(&a.files[0].1)?,digest(&a.files[1].1)?]}));
    Ok(())
}

#[test]
fn independent_context_old_only_129_pages_check_but_stage_limit() -> Result<()> {
    let f=Fixture::new()?;
    let source=r#"article en "P" body nil"#;
    let first=host::generate(&super::super::source::compiled()?,"doc/p000.nepld",source,b"[]")?;
    let mut pages=Vec::new();
    for i in 0..129 {
        let id=format!("p{i:03}");
        let src=format!("doc/{id}.nepld");let md=format!("doc/{id}.md");let aliases=format!("doc/{id}.json");
        f.write(&src,source)?;f.write(&aliases,b"[]")?;f.write(&md,first.replace("doc/p000.nepld",&src))?;
        pages.push(json!({"id":id,"source":src,"projection":md,"aliases":aliases,"route":format!("site/{id}.html"),"renderer":RENDERER}));
    }
    f.json("doc/canonical.json",&json!({"version":1,"pages":pages}))?;
    check(f.root(),"doc/canonical.json")?;
    let output=f.root().join("stage");
    let error=markdown(f.root(),"doc/canonical.json",&output).err().ok_or("129 staged pages unexpectedly succeeded")?;
    assert!(error.to_string().contains("PageCountLimit"));assert!(!output.exists());
    println!("INDEPENDENT_CONTEXT {}",json!({"case":"old-only-129","legacy_check":true,"explicit_stage_count_rejection":true}));
    Ok(())
}

#[test]
fn independent_context_public_limits_are_selected_before_both_operations() -> Result<()> {
    let f=Fixture::new()?;let original=review_context_fixture(&f)?;
    let default_limits=json!({"source_bytes":10000000,"work":100000000,"depth":1000,"nodes":10000000,"allocation_units":500000000,"output_bytes":10000000,"diagnostics":1000,"events":1000});
    for (field,reason) in [("work","WorkLimit"),("allocation_units","AllocationLimit"),("output_bytes","OutputLimit"),("nodes","NodeLimit"),("source_bytes","SourceLimit"),("depth","DepthLimit")] {
        let mut reg=original.clone();reg["output_limits"]=default_limits.clone();reg["output_limits"][field]=json!(0);f.json("doc/canonical.json",&reg)?;
        let output=f.root().join(format!("stop-{field}"));
        let error=markdown(f.root(),"doc/canonical.json",&output).err().ok_or("zero public limit succeeded")?;
        assert!(error.to_string().contains(reason),"{field}: {error}");assert!(!output.exists());
        let error=check(f.root(),"doc/canonical.json").err().ok_or("zero check limit succeeded")?;
        assert!(error.to_string().contains(reason),"{field}: {error}");
        if field=="work" {
            let empty=Fixture::new()?;empty.json("doc/canonical.json",&reg)?;
            let error=markdown(empty.root(),"doc/canonical.json",&empty.root().join("missing-input-output")).err().ok_or("Work0 succeeded")?;
            assert!(error.to_string().contains("WorkLimit"),"Work0 must precede missing registered source: {error}");
        }
        println!("INDEPENDENT_CONTEXT {}",json!({"case":"public-zero-limit","field":field,"reason":reason,"no_output":true}));
    }
    let limits=json!({"source_bytes":10000,"work":2000000,"depth":40,"nodes":100000,"allocation_units":5000000,"output_bytes":20000,"diagnostics":0,"events":0});
    let mut reg=original.clone();reg["output_limits"]=limits.clone();f.json("doc/canonical.json",&reg)?;
    let output=f.root().join("selected");markdown(f.root(),"doc/canonical.json",&output)?;
    let receipt:serde_json::Value=serde_json::from_slice(&fs::read(output.join("manifest.json"))?)?;
    assert_eq!(receipt["output_budget"]["limits"],limits);
    assert!(receipt["output_budget"]["initial_usage"].as_object().ok_or("usage")?.values().all(|n| n.as_u64()==Some(0)));
    for p in reg["pages"].as_array().ok_or("pages")? {let path=p["projection"].as_str().ok_or("path")?;f.write(path,fs::read(output.join(path))?)?;}
    check(f.root(),"doc/canonical.json")?;
    for (field,value) in [("unknown",json!(1)),("work",json!(-1)),("work",json!(true)),("work",json!(1.5)),("work",json!(null))] {
        reg["output_limits"]=default_limits.clone();reg["output_limits"][field]=value;f.json("doc/canonical.json",&reg)?;assert!(load(f.root(),"doc/canonical.json").is_err());
    }
    for value in [json!(null),json!({"work":1000})] {reg["output_limits"]=value;f.json("doc/canonical.json",&reg)?;assert!(load(f.root(),"doc/canonical.json").is_err());}
    f.json("doc/canonical.json",&original)?;load(f.root(),"doc/canonical.json")?;
    println!("INDEPENDENT_CONTEXT {}",json!({"case":"public-selected-limits","limits":limits,"receipt":receipt,"bad_limit_values_rejected":7,"omitted_setting_default_accepted":true}));
    Ok(())
}

#[test]
fn independent_context_real_four_docs_through_public_command_operation() -> Result<()> {
    let repository=Path::new(env!("CARGO_MANIFEST_DIR")).parent().ok_or("repository")?;
    let f=Fixture::new()?;
    let mut registry:serde_json::Value=serde_json::from_slice(&fs::read(repository.join("doc/canonical.json"))?)?;
    let original_pages=registry["pages"].as_array().ok_or("pages")?.clone();assert_eq!(original_pages.len(),3);
    for page in &original_pages {for field in ["source","aliases"] {let path=page[field].as_str().ok_or("path")?;f.write(path,fs::read(repository.join(path))?)?;}}
    let input="doc/migration/authored/01-architecture.nepld";
    f.write(input,fs::read(repository.join(input))?)?;f.write("doc/architecture-aliases.json",b"[]")?;
    registry["pages"].as_array_mut().ok_or("pages")?.push(json!({"id":"architecture","source":input,"projection":"doc/spec/01-architecture.md","aliases":"doc/architecture-aliases.json","route":"docs/spec/01-architecture.html","renderer":projection::RENDERER}));
    registry["output_limits"]=json!({"source_bytes":10000000,"work":300000000,"depth":1000,"nodes":10000000,"allocation_units":750000000,"output_bytes":10000000,"diagnostics":1000,"events":1000});
    f.json("doc/canonical.json",&registry)?;
    let output=std::path::PathBuf::from(std::env::var("NEPL3_REVIEW_CONTEXT_OUTPUT")?);
    markdown(f.root(),"doc/canonical.json",&output)?;
    for p in &original_pages {let path=p["projection"].as_str().ok_or("projection")?;assert_eq!(fs::read(output.join(path))?,fs::read(repository.join(path))?,"{path}");}
    let a=fs::read_to_string(output.join("doc/spec/01-architecture.md"))?;
    assert!(review_destinations(&a).iter().any(|d|d=="22-external-extensions.md"));
    let visible:String=pulldown_cmark::Parser::new(&a).filter_map(|e|match e {pulldown_cmark::Event::Text(t)|pulldown_cmark::Event::Code(t)=>Some(t.into_string()),_=>None}).collect();
    assert!(visible.contains("doc-core") && visible.contains("math-core") && visible.contains("import"));
    let receipt:serde_json::Value=serde_json::from_slice(&fs::read(output.join("manifest.json"))?)?;
    assert_eq!(receipt["output_budget"]["limits"],registry["output_limits"]);
    println!("INDEPENDENT_CONTEXT {}",json!({"case":"real-four","registry":registry,"receipt":receipt,"legacy_three_exact":true,"actual_01_to_22_link":true,"default_budget_success":"not claimed"}));
    Ok(())
}
