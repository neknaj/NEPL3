#[test]
fn independent_context_file_ancestor_boundaries() -> Result<()> {
    for (field,path) in [("projection","doc/A.md/deep/b.md"),("source","doc/a.md/b.nepld"),("aliases","doc/a.md/b.json"),("source","doc/A.nepld/b.nepld"),("projection","doc/a.json/b.md")] {
        for reverse in [false,true] {
            let f=Fixture::new()?;
            let mut a=json!({"id":"a","source":"doc/a.nepld","projection":"doc/a.md","aliases":"doc/a.json","route":"site/a.html","renderer":RENDERER});
            let mut b=json!({"id":"b","source":"doc/b.nepld","projection":"doc/b.md","aliases":"doc/b.json","route":"site/b.html","renderer":RENDERER});
            b[field]=json!(path);if reverse {core::mem::swap(&mut a,&mut b);}
            f.json("doc/canonical.json",&json!({"version":1,"pages":[a,b]}))?;
            let output=f.root().join("stage");let e=markdown(f.root(),"doc/canonical.json",&output).err().ok_or("conflict unexpectedly accepted")?;
            assert!(e.to_string().starts_with("canonical file path used as directory:"),"{field}/{path}: {e}");
            assert!(!output.exists());
        }
    }
    let f=Fixture::new()?;let mut pages=Vec::new();
    for (id,path) in [("a","doc/a.md"),("b","doc/a.md.other.md")] {
        f.write(&format!("doc/{id}.nepld"),r#"article en "P" body nil"#)?;f.write(&format!("doc/{id}.json"),b"[]")?;
        pages.push(json!({"id":id,"source":format!("doc/{id}.nepld"),"projection":path,"aliases":format!("doc/{id}.json"),"route":format!("site/{id}.html"),"renderer":RENDERER}));
    }
    f.json("doc/canonical.json",&json!({"version":1,"pages":pages}))?;
    let output=f.root().join("stage");markdown(f.root(),"doc/canonical.json",&output)?;
    assert!(output.join("doc/a.md").is_file());assert!(output.join("doc/a.md.other.md").is_file());assert!(output.join("manifest.json").is_file());
    println!("INDEPENDENT_PREFIX_BOUNDARIES {}",json!({"rejected_before_io":10,"shared_string_prefix_with_no_component_conflict":true}));
    Ok(())
}
