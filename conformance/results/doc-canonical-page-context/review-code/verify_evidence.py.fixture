from pathlib import Path
import hashlib,json,subprocess,platform,re
p=Path(__file__).parent.resolve();root=p.parents[1]
def sha(b):return hashlib.sha256(b).hexdigest()
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
head='819f0e9a7d983bb8b104f1dceb5681989e046369'
expected={r['path']:r for r in json.loads((p/'final/dependencies.json').read_bytes())}
for phase in ['final37','final819']:
    for r in json.loads((p/phase/'snapshot.json').read_bytes())['files']:expected[r['path']]=r
for path,r in expected.items():
    b=git('show',head+':'+path)
    assert sha(b)==r['sha256'] and len(b)==r['bytes'],path
    if path!='tools/src/doc/canonical/tests.rs':assert (p/'workspace-final'/path).read_bytes()==b,path
records=[]
for name in ['native-37','native-819']:
    directory=p/'artifacts'/name;m=json.loads((directory/'manifest.json').read_bytes())
    for r in m['files']:
        b=(directory/r['path']).read_bytes();assert len(b)==r['bytes'] and sha(b)==r['sha256']
    records.append(dict(run=name,receipt_sha256=sha((directory/'manifest.json').read_bytes()),files=m['files'],budget=m['output_budget']))
assert records[0]['files']==records[1]['files']
for r in records[1]['files']:
    if '01-architecture' not in r['path']:assert (p/'artifacts/native-819'/r['path']).read_bytes()==git('show',head+':'+r['path'])
for key in ['allocation_units','nodes','depth','output_bytes','source_bytes','diagnostics','events']:
    assert records[0]['budget']['usage_before_receipt_serialization'][key]==records[1]['budget']['usage_before_receipt_serialization'][key]
assert records[1]['budget']['usage_before_receipt_serialization']['work']-records[0]['budget']['usage_before_receipt_serialization']['work']==396
raw=(p/'identity-819.stdout.log').read_text(encoding='utf8');match=re.search(r'^INDEPENDENT_IDENTITY (\{.*\})$',raw,re.M);assert match
identity=json.loads(match[1]);assert len(identity['mutations'])==10
for r in identity['mutations']:
    # Probe captures whitespace-separated header tokens, including '.' / ';'.
    assert re.fullmatch('[0-9a-f]{64}\\.',r['context']) and re.fullmatch('[0-9a-f]{64};',r['pageset'])
    assert r['repeat_exact'] and r['context']!=identity['initial_context']
tests_delta=git('diff','--name-only',head,'8981ba013618c38232fee58ea00b8b479d17ca74').decode().splitlines()
assert tests_delta==['tools/src/doc/canonical/tests.rs']
(p/'898-tests.patch').write_bytes(git('diff',head,'8981ba013618c38232fee58ea00b8b479d17ca74'))
versions={name:subprocess.check_output(cmd).decode('utf8') for name,cmd in [('rustc',['rustc','-Vv']),('cargo',['cargo','-V']),('git',['git','--version'])]}
result=dict(head=head,dependency_files_verified=len(expected),scratch_production_matches_fixed_git=True,excluded_scratch_path='tools/src/doc/canonical/tests.rs (explicit probe overlay)',platform=platform.platform(),versions=versions,artifact_runs=records,metadata_work_delta=396,identity_mutations=10,tests_only_followup='8981ba013618c38232fee58ea00b8b479d17ca74',cross_target='Windows x86_64 native host tests only; no independent Linux/WASI execution in this scope')
(p/'verified-evidence.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8')
print('PASS',len(expected),'fixed dependencies, 10 artifacts, byte-identical Markdown outputs and scoped receipt Work delta396')
