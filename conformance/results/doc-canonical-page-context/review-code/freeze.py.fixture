from pathlib import Path
import subprocess,json,hashlib,difflib
out=Path(__file__).parent;root=out.parents[1]
BASE='e45323ff136cbd7be488ab697af9b555a0d3df26';HEAD='87ce544168a808918a01608b02a73f577a9f8caf'
SCOPE=['doc/development.md','doc/spec/16-doc-migration.md','doc/spec/21-doc-pages.md','tools/src/doc/canonical.rs','tools/src/doc/canonical/projection.rs','tools/src/doc/canonical/tests.rs','tools/src/doc/projection/annotated/host.rs','tools/src/main.rs']
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
def sha(b):return hashlib.sha256(b).hexdigest()
def put(path,b):p=out/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b)
def js(path,v):put(path,(json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode())
changed=git('diff','--name-only',BASE,HEAD).decode().splitlines();assert sorted(changed)==sorted(SCOPE)
allnames=git('ls-tree','-r','--name-only',BASE).decode().splitlines()
names=[x for x in allnames if '/' not in x or x.startswith(('crates/','tools/','doc/','interfaces/','design/','languages/','conformance/fixtures/','.cargo/','examples/'))]
proc=subprocess.Popen(['git','cat-file','--batch'],cwd=root,stdin=subprocess.PIPE,stdout=subprocess.PIPE)
def blob(rev,name):
    proc.stdin.write((rev+':'+name+'\n').encode());proc.stdin.flush();h=proc.stdout.readline().split();assert h[1]==b'blob',h
    b=proc.stdout.read(int(h[2]));assert proc.stdout.read(1)==b'\n';return b
deps=[]
for n in names:
    b=blob(BASE,n);put(Path('workspace')/n,b);deps.append(dict(path=n,bytes=len(b),sha256=sha(b)))
sources=[]
for n in SCOPE:
    if n in names:put(Path('before')/n,(out/'workspace'/n).read_bytes())
    b=blob(HEAD,n);put(Path('source')/n,b);put(Path('workspace')/n,b);sources.append(dict(path=n,bytes=len(b),sha256=sha(b)))
proc.stdin.close();assert proc.wait()==0
put('source.patch',git('diff','--binary',BASE,HEAD))
js('snapshot.json',dict(base=BASE,head=HEAD,allowlist=SCOPE,files=sources));js('dependencies.json',deps)
design=Path('C:/projects/NEPL3-doc-page-projection/.tmp/review-canonical-page-context-design')
m=(design/'manifest.json').read_bytes();put('design/manifest.json',m)
for row in json.loads(m)['files']:
    b=(design/row['path']).read_bytes();assert sha(b)==row['sha256'] and len(b)==row['bytes'];put(Path('design')/row['path'],b)
test=out/'workspace/tools/src/doc/canonical/tests.rs'
test.write_bytes(test.read_bytes()+b'\n'+(out/'probe.rs').read_bytes())
js('probe-overlay.json',dict(path='tools/src/doc/canonical/tests.rs',original_sha256=next(r['sha256'] for r in sources if r['path'].endswith('canonical/tests.rs')),probe_sha256=sha((out/'probe.rs').read_bytes()),combined_sha256=sha(test.read_bytes())))
print('Frozen',len(deps),'base Git blobs and exact',len(SCOPE),'changed paths; probe only in isolated copy')
