from pathlib import Path
import subprocess,json,hashlib
out=Path(__file__).parent;root=out.parents[1]
old='37cfaa88149191e1e066b08682720f5df471cf2d';head='819f0e9a7d983bb8b104f1dceb5681989e046369'
allowed=['tools/src/doc/canonical/projection.rs','tools/src/doc/canonical/tests.rs']
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
assert sorted(git('diff','--name-only',old,head).decode().splitlines())==sorted(allowed)
rows=[]
for n in allowed:
    b=git('show',head+':'+n);p=out/'final819/source'/n;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b)
    (out/'workspace-final'/n).write_bytes(b);rows.append(dict(path=n,bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
(out/'final819/source.patch').write_bytes(git('diff','--binary',old,head))
(out/'final819/snapshot.json').write_text(json.dumps(dict(head=head,previous=old,allowlist=allowed,files=rows),indent=2)+'\n',encoding='utf8')
print('Imported fixed two-path precharge delta')
