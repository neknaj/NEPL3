from pathlib import Path
import sys,json,re,hashlib,subprocess,difflib
r=Path(__file__).resolve().parents[2];p=Path(__file__).parent;sys.path.insert(0,str(r))
from tools.audit.structure import Parser,load_forms
def git(*args):return subprocess.check_output(['git',*args],cwd=r)
def sha(b):return hashlib.sha256(b).hexdigest()
def walk(x):
 if isinstance(x,list):
  for y in x:yield from walk(y)
 elif isinstance(x,dict):
  yield x
  for y in x.get('fields',{}).values():yield from walk(y)
def plain(x):
 if isinstance(x,list):return ''.join(map(plain,x))
 if not isinstance(x,dict):return ''
 if x['kind']=='leaf':return re.sub(r'\[([^/\[\]]+)/[^\[\]]+\]',r'\1',json.loads(x['token']))
 f=x['fields'];k=x['kind']
 if k=='Ruby':return plain(f['base'])
 if k in ('Text','InlineCode'):return f['text']
 if k=='Link':return plain(f['label'])
 return ''.join(plain(y) for y in f.values())
base='e45323f';result={}
for chapter in ['16-doc-migration','21-doc-pages']:
 for kind,name in [('source','doc/spec/'+chapter+'.md'),('draft','doc/migration/authored/'+chapter+'.nepld')]:
  old=git('show',base+':'+name);new=(r/name).read_bytes()
  (p/(chapter+'-'+kind+'-before')).write_bytes(old);(p/(chapter+'-'+kind+'-after')).write_bytes(new)
  (p/(chapter+'-'+kind+'.diff')).write_bytes(git('diff',base,'--',name))
 tree=Parser(new.decode('utf8'),load_forms(r)).complete('Doc/Article')
 result[chapter]={'draft_sha256':sha(new),'full_structure':'passed'}
 if chapter.startswith('16'):
  sm=difflib.SequenceMatcher(None,old.decode().splitlines(True),new.decode().splitlines(True),autojunk=False)
  changes=[x for x in sm.get_opcodes() if x[0]!='equal'];assert len(changes)==1 and changes[0][0]=='insert'
  section=next(x for x in walk(tree) if x['kind']=='Section' and x['fields']['id']=='page_projection')
  units=[plain(x) for x in walk(section) if x['kind']=='Paragraph']
  source=(p/(chapter+'-source-after')).read_text(encoding='utf8').split('### ページ間参照を持つMarkdown projection\n\n')[1].split('互換aliasとGitHub')[0]
  md=re.sub(r'`([^`]+)`',r'\1',source)
  normalized=md.replace('\n','')
  for unit in units[:-2]:assert unit in normalized,unit
  result[chapter]['added_paragraphs_including_list']=len(units)-2
 else:
  newparas=[x for x in walk(tree) if x['kind']=='Paragraph'];last=plain(newparas[-1]);source=(p/(chapter+'-source-after')).read_text(encoding='utf8')
  md=re.sub(r'\[([^]]+)\]\([^)]*\)',r'\1',source).replace('\n','')
  assert last in md,last
  links=[x for x in walk(newparas[-1]) if x['kind']=='Link'];assert len(links)==1
  result[chapter]['new_link']=links[0]
for name in ['doc/authoring.md','AGENTS.md','design/forms.json','tools/audit/structure.py']:
 dest=p/'context'/name;dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes((r/name).read_bytes())
raw=(r/'.tmp/author-canonical-context/manifest.json').read_bytes();assert sha(raw)=='0a124e0fd008f11ced4702bf693282bc5dfe6a97e6092f913cddaf53324fcd74'
(p/'author-manifest.json').write_bytes(raw)
for e in json.loads(raw)['payloads']:
 b=(r/'.tmp/author-canonical-context'/e['path']).read_bytes();assert len(b)==e['bytes'] and sha(b)==e['sha256']
result['runtime']='not-run';(p/'result.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n',encoding='utf8');print('PASS')
