from pathlib import Path
import sys,tempfile,json,subprocess
from dataclasses import replace
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from journal import Event,append,load
from deployment import journal as bridge
from test_receipt_journal import RAW
p=Path('.tmp/receipt-journal-review');results={}
with tempfile.TemporaryDirectory() as d:
 repo=Path(d)/'j.git';subprocess.run(['git','init','--bare','--quiet',str(repo)],check=True)
 intent=Event('DeployIntent','tx',23,1,'a'*40,'b'*64);first=append(repo,None,intent,b'{}')
 for field,value in [('transaction','other'),('run_id',24),('attempt',2),('source_commit','c'*40),('payload_sha256','d'*64),('kind','RecoveryIntent')]:
  try:bridge.record_created(repo,first,replace(intent,**{field:value}),RAW,owner='neknaj',repository='NEPL3');raise AssertionError(field)
  except ValueError:results['mismatch_'+field]='rejected'
  assert load(repo).head==first
 raw=RAW+b' '*(65536-len(RAW))
 try:bridge.record_created(repo,first,intent,raw,owner='neknaj',repository='NEPL3');raise AssertionError('base64 envelope exceeded limit')
 except ValueError as ex:results['large_base64_envelope']=str(ex)
 assert load(repo).head==first
 winner=[]
 def raced(*args,**kwargs):
  winner.append(append(repo,first,replace(intent,kind='Observation'),b'{}'))
  return append(*args,**kwargs)
 with patch.object(bridge,'append',raced):
  try:bridge.record_created(repo,first,intent,RAW,owner='neknaj',repository='NEPL3');raise AssertionError('race overwritten')
  except ValueError as ex:results['competing_append']=str(ex)
 assert load(repo).head==winner[0] and len(load(repo).events)==2
 results['winner_retained']=True
(p/'probe-results.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(json.dumps(results,indent=2))
