from pathlib import Path
import sys,subprocess,tempfile,gzip,json,os,hashlib
p=Path('.tmp/pages-stage-review');rows=[]
for flags in [[],['-O']]:
 cmd=[sys.executable]+flags+['-m','unittest','discover','-s','tools/site','-p','test_stage.py'];r=subprocess.run(cmd,capture_output=True);label='optimized' if flags else 'normal';(p/(label+'.stdout')).write_bytes(r.stdout);(p/(label+'.stderr')).write_bytes(r.stderr);rows.append(dict(command=cmd,exit_code=r.returncode))
if any(r['exit_code'] for r in rows):raise ValueError('tests failed')
original=gzip.decompress(Path('conformance/results/doc-pages-payload/final-review/identical-tars.tar.gz.fixture').read_bytes());sha=hashlib.sha256(original).hexdigest();manifest='39000dd5b7aad48deae97741c5b077b44a242a0badb7b30e81b3c1c26f301446';results=[]
with tempfile.TemporaryDirectory() as d:
 root=Path(d).resolve();source=root/'source.tar';source.write_bytes(original);out=root/'artifact.tar'
 def call(output,expected=sha):
  cmd=[sys.executable,'-I',str(Path('tools/site/stage.py').resolve()),str(source),str(output),'--expected-tar',expected,'--expected-manifest',manifest];r=subprocess.run(cmd,capture_output=True,timeout=30);rows.append(dict(command=cmd,exit_code=r.returncode));return r
 r=call(out)
 if r.returncode or out.read_bytes()!=original or json.loads(r.stdout)['publication_verified'] is not False:raise ValueError('CLI copy')
 results.append(dict(case='isolated-cli-original',exit_code=r.returncode,bytes=len(original),sha256=sha))
 r=call(out)
 if r.returncode!=1 or out.read_bytes()!=original:raise ValueError('overwrite')
 results.append(dict(case='existing-output',report=json.loads(r.stdout)))
 target=root/'real';target.mkdir();alias=root/'alias'
 subprocess.run(['powershell','-NoProfile','-Command','New-Item -ItemType Junction -Path $env:NEPL_LINK -Target $env:NEPL_TARGET | Out-Null'],env={**os.environ,'NEPL_LINK':str(alias),'NEPL_TARGET':str(target)},check=True)
 try:
  r=call(alias/'artifact.tar')
  if r.returncode!=1 or (target/'artifact.tar').exists():raise ValueError('junction accepted')
  results.append(dict(case='junction-parent',report=json.loads(r.stdout),no_output=True))
 finally:os.rmdir(alias)
 r=call(root/'invalid.tar','0'*64)
 if r.returncode!=1 or (root/'invalid.tar').exists():raise ValueError('invalid produced output')
 results.append(dict(case='invalid-input',report=json.loads(r.stdout),no_output=True))
(p/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8');(p/'probes.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(results)
