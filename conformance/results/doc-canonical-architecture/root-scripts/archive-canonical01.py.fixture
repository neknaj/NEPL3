from pathlib import Path
import hashlib,json,subprocess,sys
root=Path(__file__).resolve().parent.parent
out=root/'conformance/results/doc-canonical-architecture';out.mkdir(parents=True,exist_ok=True)
rows=[]
def save(owner,path,relative):
    data=path.read_bytes();assert len(data)<=1048576,path
    safe='/'.join('saved-'+p.lstrip('.') if p in {'.tmp','dist','target','.git','node_modules','__pycache__'} else p for p in relative.split('/'))
    name=f'{owner}/{safe}.fixture';dest=out/name
    assert dest.resolve().is_relative_to(out.resolve())
    dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(data)
    rows.append(dict(file=name,owner=owner,restore=relative,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
for owner,name in [('root-generation','generation-anchor'),('root-browser','browser-canonical01-anchor'),('root-github','github-canonical01-anchor'),('root-github-failure','github-canonical01'),('root-html-first','html-anchor-first'),('root-html-second','html-anchor-second'),('root-markdown-first','markdown-anchor-first'),('root-markdown-second','markdown-anchor-second'),('root-verification','verify-canonical01'),('root-fixture','verify-fixture')]:
    directory=root/'.tmp'/name
    for p in sorted(directory.rglob('*')):
        if p.is_file():save(owner,p,p.relative_to(directory).as_posix())
for name in ['start.json','original.md','prepare.py','regenerate-anchor.py','browser-canonical01-anchor.py','github-canonical01-anchor.py','github-canonical01.py','browser-canonical01-initial.py','browser-code-initial-mismatch.json','browser-canonical01-anchor-alias-assumption-failed.py','html-alias-scope-correction.md','archive-canonical01.py','verify-canonical01.py','verify-fixture.py']:
    save('root-scripts',root/'.tmp'/name,name)
directories={
    'preflight':Path('C:/projects/NEPL3-doc-canonical-page-context/.tmp/preflight-canonical01'),
    'review-content':Path('C:/projects/NEPL3-doc-canonical-page-context/.tmp/review-canonical01-content'),
    'review-collision':root/'.tmp/review-canonical01-collision',
}
if '--review' in sys.argv:
    directories.update({'review-code':root/'.tmp/review-canonical01-code','review-cutover':root/'.tmp/review-canonical01-cutover'})
if '--bootstrap' in sys.argv:
    for p in sorted((root/'.tmp/bootstrap-canonical01').iterdir()):
        if p.is_file():save('root-bootstrap',p,p.name)
for owner,directory in directories.items():
    manifest=json.loads((directory/'manifest.json').read_text(encoding='utf-8'))
    save(owner,directory/'manifest.json','manifest.json')
    for row in manifest['files']:
        p=directory/row['path'];data=p.read_bytes()
        assert len(data)==row['bytes'] and hashlib.sha256(data).hexdigest()==row['sha256'],p
        save(owner,p,row['path'])
head='652347cb5a37ea341e5ee67887f61ccf11692cee';base='14df7e9d77faa86715c4605b28a853812980c4b0'
sources=[];removed=[]
for name in subprocess.check_output(['git','diff','--name-only','--no-renames',base,head],cwd=root,text=True).splitlines():
    if not (root/name).exists():
        data=subprocess.check_output(['git','show',base+':'+name],cwd=root)
        removed.append(dict(path=name,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()));continue
    data=(root/name).read_bytes();assert data==subprocess.check_output(['git','show',head+':'+name],cwd=root)
    sources.append(dict(path=name,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
(out/'payloads.json').write_text(json.dumps(dict(implementation_commit=head,integration_commit='126ac1f5d1c577aa3bd5b3a6d494afebe203518e',base_commit=base,sources=sources,removed=removed,files=rows),indent=2)+'\n',encoding='utf-8',newline='\n')
(out/'.gitattributes').write_text('*.fixture -text -whitespace\n',encoding='utf-8',newline='\n')
print(len(rows),'payloads',sum(r['bytes'] for r in rows),'bytes')
