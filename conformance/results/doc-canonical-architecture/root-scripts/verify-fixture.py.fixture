import pathlib,subprocess,json,time,os
out=pathlib.Path('.tmp/verify-fixture');out.mkdir(exist_ok=True)
fixed=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip();rows=[]
env=os.environ.copy();env['CARGO_TARGET_WASM32_WASIP2_RUNNER']='wasmtime run'
for name,cmd in [('format',['cargo','fmt','--all','--','--check']),('doc-native',['cargo','test','--locked','-p','nepl3-tools','--test','doc']),('pages-wasi',['cargo','test','--locked','-p','nepl3-tools','--test','doc','--target','wasm32-wasip2','annotated_pages::']),('clippy',['cargo','clippy','--locked','--workspace','--all-targets','--','-D','warnings'])]:
    assert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==fixed
    started=time.monotonic()
    with (out/(name+'.stdout.log')).open('wb') as stdout,(out/(name+'.stderr.log')).open('wb') as stderr:
        p=subprocess.run(cmd,env=env,stdout=stdout,stderr=stderr,timeout=1200)
    unchanged=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==fixed
    rows.append(dict(source_commit=fixed,unchanged_head=unchanged,command=cmd,runner=env['CARGO_TARGET_WASM32_WASIP2_RUNNER'],exit_code=p.returncode,elapsed=time.monotonic()-started))
    (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8')
    print(name,p.returncode,flush=True)
    assert unchanged and p.returncode==0
