import hashlib,json,pathlib,subprocess
root=pathlib.Path.cwd()
def git(*args): return subprocess.check_output(['git',*args])
start={'commit':git('rev-parse','HEAD').decode().strip(),'status':git('status','--porcelain').decode(),'purpose':'Chapter 1 canonical cutover prepared on reviewed-in-progress page-context implementation; not merged or approved by this preparation.'}
assert not start['status']
(root/'.tmp/start.json').write_text(json.dumps(start,indent=2),encoding='utf-8')
old=root/'doc/migration/authored/01-architecture.nepld'
new=root/'doc/spec/01-architecture.nepld'
source=old.read_bytes()
assert hashlib.sha256(source).hexdigest()=='8d338b3ce98f3030e503ecd0aea9374c439c606cfbeb48bcd6b777a3f45654b2'
(root/'.tmp/original.md').write_bytes((root/'doc/spec/01-architecture.md').read_bytes())
assert not new.exists()
old.rename(new)
aliases=[(None,'01-repositorycrate依存方向'),('policy','方針'),('layout','1-配置'),('dependencies','2-主な依存方向'),('bootstrap','3-surface-descriptorとbootstrap'),('rust','4-rust設定'),('allowed_dependencies','5-許可集合の検査'),('current_stage','現在の作業段階')]
path=root/'doc/migration/aliases/01-architecture.json'
assert not path.exists()
path.write_text(json.dumps([dict(section=s,name=n) for s,n in aliases],ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
path=root/'doc/canonical.json'; registry=json.loads(path.read_bytes())
registry['pages'].append(dict(id='architecture',source='doc/spec/01-architecture.nepld',projection='doc/spec/01-architecture.md',aliases='doc/migration/aliases/01-architecture.json',route='docs/spec/01-architecture.html',renderer='nepl3-tools.markdown-annotated-pages/1'))
# Fixed finite allowance selected before this batch. These are logical units,
# not measured physical heap. Ordinary old-only checks retain their limits.
registry['output_limits']=dict(source_bytes=10_000_000,work=300_000_000,depth=1000,nodes=10_000_000,allocation_units=750_000_000,output_bytes=10_000_000,diagnostics=100_000,events=100_000)
path.write_text(json.dumps(registry,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
print('Prepared unchanged Doc move and explicit registry/aliases; projection not yet generated.')
