from pathlib import Path
from playwright.sync_api import sync_playwright
import hashlib,json,re,subprocess
root=Path(__file__).resolve().parent.parent
out=root/'.tmp/bootstrap-canonical01';out.mkdir(exist_ok=True)
readme=root/'conformance/results/doc-canonical-architecture/README.md'
snippet=re.search(rb'```python\n(.*?)```',readme.read_bytes(),re.S).group(1)
restore=out/'restore.py';restore.write_bytes(snippet)
subprocess.run(['python',str(restore)],cwd=root,check=True)
artifact=root/'dist/canonical01-snapshot';original=root/'.tmp/html-anchor-first'
files={p.relative_to(artifact).as_posix():p.read_bytes() for p in artifact.rglob('*') if p.is_file()}
assert len(files)==6
for name,data in files.items():assert data==(original/name).read_bytes()
rows=[]
with sync_playwright() as p:
    for name in ['chromium','firefox','webkit']:
        browser=getattr(p,name).launch(headless=True)
        context=browser.new_context(java_script_enabled=False)
        context.route('http://**',lambda route:route.abort())
        context.route('https://**',lambda route:route.abort())
        page=context.new_page()
        page.goto((artifact/'docs/spec/01-architecture.html').as_uri(),wait_until='load')
        row=page.evaluate('''()=>({scripts:document.scripts.length,ruby:document.querySelectorAll('.nepl-ruby').length,
          headings:document.querySelectorAll('h1,h2,h3').length,codes:document.querySelectorAll('pre code').length,
          background:getComputedStyle(document.querySelector('article')).backgroundColor,
          css:[...document.querySelectorAll('link[rel=stylesheet]')].map(n=>!!n.sheet)})''')
        assert row['scripts']==0 and row['ruby']>0 and row['headings']==8 and row['codes']==2
        assert row['background']=='rgb(13, 17, 23)' and row['css']==[True]
        page.locator('article a[href="22-external-extensions.html"]').click()
        assert page.url.endswith('/docs/spec/22-external-extensions.html') and page.locator('h1').count()==1
        row.update(browser=name,version=browser.version,result='passed',cross_page_link=page.url)
        rows.append(row);context.close();browser.close()
(out/'results.json').write_text(json.dumps(dict(scope='verbatim README restoration; six exact files; JavaScript disabled, HTTP(S) blocked; no compiler generation',files={n:hashlib.sha256(b).hexdigest() for n,b in files.items()},rows=rows),indent=2)+'\n',encoding='utf-8',newline='\n')
(out/'bootstrap-canonical01.py').write_bytes(Path(__file__).read_bytes())
print('three-engine compiler-free snapshot passed')
