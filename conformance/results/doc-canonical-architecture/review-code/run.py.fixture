from pathlib import Path
import subprocess,json,os,hashlib,time
p=Path(__file__).parent.resolve();ws=p/'workspace';target=p/'target'
def sha(b):return hashlib.sha256(b).hexdigest()
rows=[]
def run(name,cmd,seconds=900):
    start=time.monotonic();r=subprocess.run(cmd,cwd=ws,env=dict(os.environ,CARGO_TARGET_DIR=str(target)),capture_output=True,timeout=seconds)
    (p/(name+'.stdout.log')).write_bytes(r.stdout);(p/(name+'.stderr.log')).write_bytes(r.stderr)
    row=dict(name=name,command=cmd,deadline_seconds=seconds,elapsed_seconds=time.monotonic()-start,exit_code=r.returncode);rows.append(row)
    (p/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8');print(name,r.returncode,flush=True);assert r.returncode==0,r.stderr[-1000:]
for name,cmd in [('rust-version',['rustc','-Vv']),('cargo-version',['cargo','-V']),('build',['cargo','build','--locked','-p','nepl3-tools'])]:run(name,cmd)
binary=target/'debug/nepl3-tools.exe';original=sha(binary.read_bytes())
run('canonical-check',[str(binary),'doc-canonical','--check'])
for phase in ['first','second']:
    for kind in ['markdown','html']:run(kind+'-'+phase,[str(binary),'doc-canonical',kind,str(p/(kind+'-'+phase))])
assert sha(binary.read_bytes())==original
(p/'binary.json').write_text(json.dumps(dict(path=str(binary),sha256=original,bytes=binary.stat().st_size,head='9c5883b555ebe5e09380ea4ab20ce275d0687259'),indent=2)+'\n',encoding='utf8')
print('All actual fixed CLI commands passed; binary unchanged',flush=True)
