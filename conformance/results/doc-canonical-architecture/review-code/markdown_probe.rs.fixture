#[test]
fn generated_architecture_markdown_retains_actual_link_and_code() -> Result<(),Box<dyn std::error::Error>> {
    use pulldown_cmark::{Event,Tag,TagEnd,Parser};
    let path=std::env::var("NEPL3_REVIEW_GENERATED")?;
    let text=std::fs::read_to_string(path)?;let mut links=Vec::new();let mut blocks=Vec::new();let mut current=None;
    for event in Parser::new(&text) {
        match event {
            Event::Start(Tag::Link{dest_url,..})=>links.push(dest_url.into_string()),
            Event::Start(Tag::CodeBlock(_))=>current=Some(String::new()),
            Event::End(TagEnd::CodeBlock)=>blocks.push(current.take().ok_or("missing code block")?),
            Event::Text(t)=>{if let Some(b)=current.as_mut(){b.push_str(&t)}},
            _=>(),
        }
    }
    assert_eq!(links,["22-external-extensions.md"]);assert_eq!(blocks.len(),2);
    println!("CANONICAL01_MARKDOWN {}",serde_json::json!({"links":links,"raw_code":blocks}));
    Ok(())
}
