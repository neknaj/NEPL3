from pathlib import Path
import sys,re,json,hashlib,subprocess
r=Path(__file__).resolve().parents[2];p=Path(__file__).parent;sys.path.insert(0,str(r))
from tools.audit.structure import Parser,load_forms
base='afeadcf70b120c7cf05e48ec2c282e0e4edd5e44'
def sha(b):return hashlib.sha256(b).hexdigest()
paths=['doc/spec/01-architecture.md','doc/migration/authored/01-architecture.nepld','doc/authoring.md','AGENTS.md','design/dependencies.json','design/forms.json','tools/audit/structure.py']
for name in paths:
 b=(r/name).read_bytes();fixed=subprocess.check_output(['git','show',base+':'+name],cwd=r);assert b==fixed,name
 q=p/'source'/name;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
source=(r/paths[0]).read_text(encoding='utf8');draft=(r/paths[1]).read_text(encoding='utf8');tree=Parser(draft,load_forms(r)).complete('Doc/Article')
def walk(x):
 if isinstance(x,list):
  for y in x:yield from walk(y)
 elif isinstance(x,dict):
  yield x
  for y in x.get('fields',{}).values():yield from walk(y)
nodes=list(walk(tree));raw=[x['fields'] for x in nodes if x['kind']=='RawCode'];blocks=re.findall(r'```([^\n]*)\n(.*?)```',source,re.S);assert len(raw)==len(blocks)==2
for x,(hint,text) in zip(raw,blocks):assert x['text']==text and x['languageHint']['fields']['text']==hint
src_codes=re.findall(r'`([^`]+)`',re.sub(r'```.*?```','',source,flags=re.S));codes=[x['fields']['text'] for x in nodes if x['kind']=='InlineCode'];assert [x for x in codes if x not in ('no_std + alloc','build.rs')]==src_codes
links=[x for x in nodes if x['kind']=='Link'];assert len(links)==1
target=links[0]['fields']['target'];assert target=={'kind':'RelativeTarget','fields':{'path':'22-external-extensions.md','fragment':{'kind':'NoText','fields':{}}}}
assert not [x for x in nodes if x['kind'] in ('Table','List')]
deps=json.loads((r/'design/dependencies.json').read_bytes())['workspace'];assert len(deps)==20 and sum(x['no_std'] for x in deps)==15
pre=(r/'.tmp/preflight-canonical01/manifest.json').read_bytes();assert sha(pre)=='4ff685911ce4864774355b998caea38a1395273ce70d959c957bcb1ac26c3bc5';(p/'preflight-manifest.json').write_bytes(pre)
for e in json.loads(pre)['files']:
 b=(r/'.tmp/preflight-canonical01'/e['path']).read_bytes();assert len(b)==e['bytes'] and sha(b)==e['sha256']
(p/'result.json').write_text(json.dumps({'source_commit':base,'source_sha256':sha(source.encode()),'draft_sha256':sha(draft.encode()),'full_structure':'passed','raw_code_byte_and_hint_pairs':2,'source_inline_code':src_codes,'draft_additional_code_presentation':['no_std + alloc','build.rs'],'link':target,'target_crates':20,'target_no_std':15,'runtime':'not-run'},ensure_ascii=False,indent=2)+'\n',encoding='utf8');print('PASS')
