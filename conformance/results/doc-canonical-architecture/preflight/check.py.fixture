from pathlib import Path
from html.parser import HTMLParser
import json,re,hashlib,subprocess
r=Path('.tmp/preflight-canonical01')
class Scripts(HTMLParser):
    def __init__(self):super().__init__();self.active=False;self.parts=[];self.scripts=[]
    def handle_starttag(self,t,a):
        if t=='script' and dict(a).get('type')=='application/json':self.active=True;self.parts=[]
    def handle_data(self,s):
        if self.active:self.parts.append(s)
    def handle_endtag(self,t):
        if t=='script' and self.active:self.scripts.append(''.join(self.parts));self.active=False
class Headings(HTMLParser):
    def __init__(self):super().__init__();self.rows=[];self.active=None;self.anchors=[]
    def handle_starttag(self,t,a):
        attrs=dict(a)
        if re.fullmatch('h[1-6]',t):self.active={'tag':t,'text':''}
        if t=='a' and attrs.get('id','').startswith('user-content-'):
            self.anchors.append({k:attrs[k] for k in ('id','href','aria-label')})
    def handle_data(self,s):
        if self.active is not None:self.active['text']+=s
    def handle_endtag(self,t):
        if self.active and self.active['tag']==t:self.rows.append(self.active);self.active=None
html=(r/'github.html').read_text(encoding='utf8');p=Scripts();p.feed(html)
payloads=[json.loads(s) for s in p.scripts]
payload=next(x['payload'] for x in payloads if 'codeViewBlobRoute' in x.get('payload',{}))
assert payload['codeViewLayoutRoute']['path']=='doc/spec/01-architecture.md'
raw=payload['codeViewBlobLayoutRoute.StyledBlob']['rawLines']
source=(r/'source.md').read_bytes()
assert raw==source.decode('utf8').splitlines()
assert ('\n'.join(raw)+'\n').encode('utf8')==source
rich=payload['codeViewBlobRoute']['richText'];(r/'richText.html').write_text(rich,encoding='utf8',newline='\n')
h=Headings();h.feed(rich);server=Headings();server.feed(html)
assert h.anchors==server.anchors
expected=[{'tag':'h'+str(len(m[1])),'text':m[2]} for m in re.finditer(r'^(#{1,6}) (.+)$',source.decode(),re.M)]
assert h.rows==expected and len(h.rows)==len(h.anchors)==8
assert len({a['id'] for a in h.anchors})==8
for a,heading in zip(h.anchors,h.rows):assert a['aria-label']=='Permalink: '+heading['text']
fetch=json.loads((r/'fetch.json').read_bytes())
assert source==subprocess.check_output(['git','show',fetch['commit']+':doc/spec/01-architecture.md'])
(r/'rawLines.json').write_text(json.dumps(raw,ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
(r/'result.json').write_text(json.dumps({'status':'PASS','commit':fetch['commit'],'url':fetch['url'],'rawLines_match_source':True,'rawLines_reconstruct_exact_LF_bytes':True,'rendered_headings_match_source':True,'server_dom_and_embedded_richText_anchors_equal':True,'unique_anchors':8,'headings':h.rows,'anchors':h.anchors,'source_sha256':hashlib.sha256(source).hexdigest(),'browser_navigation':'not run','scope':'actual fixed GitHub server HTML; no inferred slugs; no draft meaning review'},ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS: rawLines full source bytes and 8 actual server DOM anchors')
