from pathlib import Path
import sys,re,json,hashlib,subprocess
r=Path(__file__).parent
root=r.parents[1];sys.path.insert(0,str(root))
from tools.audit.structure import Parser,load_forms
exec((r/'helpers.py').read_text(encoding='utf8'))
sha=lambda b:hashlib.sha256(b).hexdigest()
source=(r/'source.md').read_bytes();draft=(r/'draft.nepld').read_bytes()
sp='doc/spec/01-architecture.md';dp='doc/migration/authored/01-architecture.nepld'
assert source==subprocess.check_output(['git','show','75e73a7:'+sp])
assert draft==subprocess.check_output(['git','show','2bbac28:'+dp])
assert source==(root/sp).read_bytes() and draft==(root/dp).read_bytes()
evidence=root/'conformance/results/external-extension-consumer/delta-review'
assert source==(evidence/'01-source-after.txt').read_bytes()
assert draft==(evidence/'01-draft-after.txt').read_bytes()
for name in ['record.md','result.json','manifest.json']:(r/('prior-extension-'+name)).write_bytes((evidence/name).read_bytes())
(r/'prior-foundation-review.md').write_bytes((root/'conformance/results/doc-authoring-foundation/integration/review.md').read_bytes())
tree=normalize(Parser(draft.decode(),load_forms(root)).complete('Doc/Article'),True)
def base(n):
    if isinstance(n,list):return ''.join(map(base,n))
    if not isinstance(n,dict):return ''
    f=n['fields'];k=n['kind']
    if k in ['Text','InlineCode','RawCode']:return f['text']
    if k in ['Anno','Ruby']:return base(f['base'])
    if k=='Link':return base(f['label'])
    return ''.join(base(v) for v in f.values())
sections=[n for n in walk(tree) if n['kind']=='Section']
titles=[base(tree['fields']['title'])]+[base(s['fields']['title']) for s in sections]
actual=json.loads((r/'result.json').read_text(encoding='utf8'))
assert titles==[h['text'] for h in actual['headings']]
ids=[None]+[s['fields']['id'] for s in sections]
mapping=[{'section':i,'name':a['href'][1:],'old_dom_id':a['id'],'heading':t,'evidence':'actual fixed GitHub server DOM; not slug inference','new_auto_id_collision':'not tested on generated Markdown'} for i,a,t in zip(ids,actual['anchors'],titles)]
assert len(set(i for i in ids if i))==7
assert not any(m['name'].startswith('n-') for m in mapping)
raw=[n['fields'] for n in walk(tree) if n['kind']=='RawCode']
oldraw=re.findall(r'^```([^\n]*)\n(.*?)^```',source.decode(),re.M|re.S)
assert [f['text'] for f in raw]==[v for h,v in oldraw]
assert [f['languageHint']['fields']['text'] for f in raw]==[h for h,v in oldraw]
links=[n['fields']['target'] for n in walk(tree) if n['kind']=='Link']
assert len(links)==1 and links[0]['fields']['path']=='22-external-extensions.md'
codes=[n['fields']['text'] for n in walk(tree) if n['kind']=='InlineCode']
stripped=re.sub(r'^```[^\n]*\n.*?^```','',source.decode(),flags=re.M|re.S)
originalcodes=re.findall(r'`([^`]+)`',stripped)
extras=codes.copy()
for v in originalcodes:extras.remove(v)
assert extras==['no_std + alloc','build.rs'],extras
(r/'mapping.json').write_text(json.dumps(mapping,ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
(r/'content.json').write_text(json.dumps({'source_sha256':sha(source),'draft_sha256':sha(draft),'source_equals_reviewed_75e73a7':True,'draft_equals_reviewed_2bbac28_and_archived_after':True,'all_eight_heading_base_texts_exact':True,'raw_code_count':len(raw),'raw_code_bytes_and_hints_exact':True,'source_inline_codes':originalcodes,'draft_inline_codes':codes,'existing_draft_extra_inlinecode_presentation':extras,'links':links,'ruby_count':len(pairs),'list_count':sum(n['kind']=='List' for n in walk(tree)),'table_count':sum(n['kind']=='Table' for n in walk(tree))},ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
(r/'git-history.txt').write_bytes(subprocess.check_output(['git','log','--format=%H %s','afeadcf','--',sp,dp]))
print('PASS: fixed source/draft equal reviewed snapshots; headings/rawcodes/link; no later source drift')
