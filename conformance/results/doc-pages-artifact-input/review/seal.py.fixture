from pathlib import Path
import hashlib,json
p=Path('.tmp/artifact-input-review')
for name in ['tools/site/deployment/artifact.py','tools/site/test_artifact.py','conformance/results/doc-pages-artifact-input/README.md']:
 f=p/'source'/name;f.parent.mkdir(parents=True,exist_ok=True);f.write_bytes(Path(name).read_bytes())
with (p/'review.md').open('a',encoding='utf8',newline='\n') as f:f.write('\nFinal archive README reviewed: its root-test claims and saved interoperability figures agree with supplied evidence; it explicitly discloses authentication/eligibility and central-directory allocation limitations. Source snapshots include both Python files and that README on base e180e684af3d1e21b7523d2b9ea9f651633338c3 before commit.\n')
rows=[]
for f in sorted(p.rglob('*')):
 if f.is_file() and f.name!='manifest.json':
  b=f.read_bytes();rows.append(dict(path=f.relative_to(p).as_posix(),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
(p/'manifest.json').write_text(json.dumps(dict(files=rows),indent=2)+'\n',encoding='utf8');print(len(rows),sum(r['bytes'] for r in rows))
