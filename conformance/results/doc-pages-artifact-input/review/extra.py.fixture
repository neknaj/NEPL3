from pathlib import Path
import json,sys,io,zipfile
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_artifact import ArtifactTests
from deployment.artifact import selected
from payload import digest
p=Path('.tmp/artifact-input-review');meta,archive,kw,tar=ArtifactTests().fixture();checks=[]
for limit in [2,1]:
 with patch('deployment.artifact.MAX_ENTRIES',limit):
  try:r=selected(json.dumps(meta).encode(),archive,**kw);accepted=True
  except ValueError:accepted=False
 if accepted!=(limit==2):raise ValueError('entry bound')
 checks.append(dict(entries_limit=limit,accepted=accepted))
live=Path('.tmp/artifact-input-live');raw=(live/'metadata.json').read_bytes();m=json.loads(raw);receipt=json.loads((live/'receipt.json').read_bytes());data=(live/'archive.zip').read_bytes()
r=selected(raw,data,owner='neknaj',repository='NEPL3',artifact_id=m['id'],run_id=m['workflow_run']['id'],repository_id=m['workflow_run']['repository_id'],source_commit=m['workflow_run']['head_sha'],expected_tar=receipt['tar_sha256'],expected_manifest=receipt['manifest_sha256'])
checks.append(dict(saved_live_interoperability_only=True,zip_bytes=len(data),zip_sha256=digest(data),tar_bytes=len(r.data),files=r.files,pins_from_same_receipt_not_eligibility_proof=True))
(p/'boundary-and-interop.json').write_text(json.dumps(checks,indent=2)+'\n',encoding='utf8');print(checks)
