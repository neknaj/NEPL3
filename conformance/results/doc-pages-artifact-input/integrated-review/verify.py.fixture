from pathlib import Path
import sys,json,subprocess,hashlib,tempfile,io,zipfile
from dataclasses import replace
from unittest.mock import patch
p=Path('.tmp/artifact-integrated-review');reviews=['artifact-input-review','artifact-export-review','creation-gate-review'];rows=[]
paths=subprocess.run(['git','diff','--name-only','e180e68..HEAD','--','tools/site'],capture_output=True,text=True,check=True).stdout.splitlines()
for name in paths:
 matches=[r for r in reviews if (Path('.tmp')/r/'source'/name).is_file() and (Path('.tmp')/r/'source'/name).read_bytes()==Path(name).read_bytes()]
 if not matches:raise ValueError(name)
 rows.append(dict(path=name,matching_reviews=matches))
(p/'source-match.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8')
seals=[]
for r in reviews:
 root=Path('.tmp')/r;entries=json.loads((root/'manifest.json').read_text())['files']
 for entry in entries:
  b=(root/entry['path']).read_bytes()
  if len(b)!=entry['bytes'] or hashlib.sha256(b).hexdigest()!=entry['sha256']:raise ValueError(entry)
 seals.append(dict(review=r,files=len(entries)))
(p/'seal-check.json').write_text(json.dumps(seals,indent=2)+'\n',encoding='utf8')
live=Path('.tmp/artifact-input-live').resolve();meta=json.loads((live/'metadata.json').read_bytes());receipt=json.loads((live/'receipt.json').read_bytes())
with tempfile.TemporaryDirectory() as d:
 out=Path(d).resolve()/'pages.tar';cmd=[sys.executable,'-I',str(Path('tools/site/artifact.py').resolve()),str(live/'metadata.json'),str(live/'archive.zip'),str(out)]
 kw=dict(owner='neknaj',repository='NEPL3',repository_id=meta['workflow_run']['repository_id'],artifact_id=meta['id'],run_id=meta['workflow_run']['id'],source_commit=meta['workflow_run']['head_sha'],expected_tar=receipt['tar_sha256'],expected_manifest=receipt['manifest_sha256'])
 for k,v in kw.items():cmd+=['--'+k.replace('_','-'),str(v)]
 r=subprocess.run(cmd,capture_output=True);(p/'export.stdout').write_bytes(r.stdout);(p/'export.stderr').write_bytes(r.stderr)
 if r.returncode:raise ValueError('export failure')
 with zipfile.ZipFile(live/'archive.zip') as z:original=z.read('pages.tar')
 if out.read_bytes()!=original:raise ValueError('bytes changed')
 report=json.loads(r.stdout)
 sys.path.insert(0,str(Path('tools/site').resolve()))
 from deployment.journal import require_creation_receipts
 from journal import Event
 from journal.model import Snapshot
 intent=Event('DeployIntent','old',kw['run_id'],1,kw['source_commit'],report['tar_sha256'])
 blocked=False
 try:require_creation_receipts(Snapshot('a'*40,(intent,),(b'{}',)),owner='neknaj',repository='NEPL3')
 except ValueError:blocked=True
 if not blocked:raise ValueError('export receipt bypassed unresolved intent')
 result=dict(exit_code=r.returncode,original_tar_bytes=len(original),original_tar_sha256=hashlib.sha256(original).hexdigest(),byte_identical=True,publication_verified=report['publication_verified'],unresolved_creation_still_blocked=blocked,interop_pins_from_same_receipt=True)
(p/'interop.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print(result)
