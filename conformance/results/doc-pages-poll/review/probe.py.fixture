from pathlib import Path
import sys,json
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment import poll
from deployment.receipt import Receipt,observed
from deployment.transport import Result,TransportError
r=Receipt('123','https://api.github.com/repos/neknaj/NEPL3/pages/deployments/123','a'*64)
def result(state):
 raw=json.dumps({'status':state}).encode();return Result(observed(raw,receipt=r,request_url=r.status_endpoint),raw)
records={};calls=[];sleeps=[]
report=poll._wait(r,'token',timeout=600,clock=lambda:0,sleep=sleeps.append,fetch=lambda *a,**k:(calls.append(k['timeout']) or result('deployment_queued')))
assert report.stop==poll.Stop.OBSERVATION_LIMIT and len(report.responses)==len(calls)==128
records['stalled_clock_observation_limit']={'stop':report.stop.value,'responses':len(report.responses),'calls':len(calls),'scope':'defensive limit with intentionally stationary clock and no-op sleep'}
for cost,expected in [(0.999,poll.Stop.SUCCEEDED),(1,poll.Stop.DEADLINE),(1.001,poll.Stop.DEADLINE)]:
 now=[0];budgets=[]
 def fetch(*a,**k):budgets.append(k['timeout']);now[0]+=cost;return result('succeed')
 report=poll._wait(r,'token',timeout=1,clock=lambda:now[0],sleep=lambda d:None,fetch=fetch)
 assert report.stop==expected and len(report.responses)==1 and budgets==[1]
 records['success_at_'+str(cost)]={'stop':report.stop.value,'responses':len(report.responses)}
now=[0];calls=[]
def fetch(*a,**k):
 calls.append(k['timeout'])
 if len(calls)==1:return result('deployment_queued')
 raise TransportError('test failure')
def sleep(d):now[0]+=d
with patch.object(poll.time,'monotonic',lambda:now[0]),patch.object(poll.time,'sleep',sleep),patch.object(poll,'status',fetch):report=poll.wait(r,'token',timeout=8)
assert report.stop==poll.Stop.TRANSPORT and len(report.responses)==1 and calls==[8,3]
records['public_wiring_pending_then_transport']={'stop':report.stop.value,'retained_responses':len(report.responses),'budgets':calls}
p=Path('.tmp/pages-poll-review');(p/'probe-results.json').write_text(json.dumps(records,indent=2)+'\n',encoding='utf8');print(json.dumps(records,indent=2))
