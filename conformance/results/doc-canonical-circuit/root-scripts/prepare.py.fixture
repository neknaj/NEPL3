from pathlib import Path
import hashlib,json,subprocess
root=Path.cwd(); tmp=root/'.tmp';tmp.mkdir(exist_ok=True)
assert not subprocess.check_output(['git','status','--porcelain']).strip()
head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
source=root/'doc/migration/authored/07-circuit.nepld'; original=root/'doc/spec/07-circuit.md'
record=dict(commit=head,status='',source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),original_sha256=hashlib.sha256(original.read_bytes()).hexdigest(),purpose='Chapter07 migration on pending independently reviewed chapter18; no acceptance completion')
(tmp/'start.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8')
(tmp/'original.md').write_bytes(original.read_bytes())
source.rename(root/'doc/spec/07-circuit.nepld')
aliases=[dict(section=s,name=n) for s,n in [(None,'07-circuit言語'),('policy','方針'),('surface','1-surfaceと型'),('declarations','2-各宣言'),('operations','3-演算'),('elaboration','4-検査とelaboration'),('time','5-stepと時間'),('nor','6-nor-ir'),('svg','7-svg-backend'),('public','8-公開操作')]]
(root/'doc/migration/aliases/07-circuit.json').write_text(json.dumps(aliases,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
path=root/'doc/canonical.json';registry=json.loads(path.read_bytes())
registry['pages'].append(dict(id='circuit',source='doc/spec/07-circuit.nepld',projection='doc/spec/07-circuit.md',aliases='doc/migration/aliases/07-circuit.json',route='docs/spec/07-circuit.html',renderer='nepl3-tools.markdown-annotated/2'))
path.write_text(json.dumps(registry,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
print('Unchanged Circuit manuscript prepared; six-page allowances retained')
