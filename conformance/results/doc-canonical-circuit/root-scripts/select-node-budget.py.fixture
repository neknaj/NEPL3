from pathlib import Path
import json,hashlib,subprocess
root=Path.cwd(); path=root/'doc/canonical.json'; before=path.read_bytes(); registry=json.loads(before)
assert registry['output_limits']['nodes']==10000000
registry['output_limits']['nodes']=20000000
after=(json.dumps(registry,ensure_ascii=False,indent=2)+'\n').encode()
path.write_bytes(after)
(root/'.tmp/node-budget-selection.json').write_text(json.dumps(dict(source_commit=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),before_sha256=hashlib.sha256(before).hexdigest(),after_sha256=hashlib.sha256(after).hexdigest(),change='Only canonical Markdown output Nodes: 10M to 20M. Six-page baseline stopped NodeLimit before output; independent HTML generation succeeded with existing limits. New operation before entry, no Budget reset, no global or parsing/lowering change.'),indent=2)+'\n',encoding='utf-8')
