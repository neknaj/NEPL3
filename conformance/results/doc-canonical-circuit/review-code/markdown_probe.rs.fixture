use pulldown_cmark::{Event, Options, Parser, Tag, TagEnd};

#[test]
fn actual_circuit_projection_retains_lists_code_and_control_meaning() -> Result<(), Box<dyn std::error::Error>> {
    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("../../markdown-first/doc/spec/07-circuit.md");
    let markdown = std::fs::read_to_string(path)?;
    let mut styles = Vec::new();
    let mut counts = Vec::new();
    let mut active = None;
    let mut codes = Vec::new();
    let mut headings = 0;
    let mut links = 0;
    let mut code_blocks = 0;
    let mut tables = 0;
    let mut text = String::new();
    for event in Parser::new_ext(&markdown, Options::ENABLE_TABLES | Options::ENABLE_TASKLISTS) {
        match event {
            Event::Start(Tag::List(style)) => {
                assert!(active.is_none());
                styles.push(style); counts.push(0); active = Some(counts.len() - 1);
            }
            Event::End(TagEnd::List(_)) => active = None,
            Event::Start(Tag::Item) => counts[active.ok_or("item outside list")?] += 1,
            Event::Start(Tag::Heading { .. }) => headings += 1,
            Event::Start(Tag::Link { .. }) => links += 1,
            Event::Start(Tag::Table(_)) => tables += 1,
            Event::Start(Tag::CodeBlock(_)) => code_blocks += 1,
            Event::Text(value) => text.push_str(&value),
            Event::Code(value) => codes.push(value.into_string()),
            Event::TaskListMarker(_) => return Err("unexpected checkbox".into()),
            _ => {}
        }
    }
    // Original: five declarations, six ordered elaboration steps. No nested or
    // checked list, table, link or fenced code. Five declaration signatures are
    // explicitly typed InlineCode in the reviewed Doc, alongside seven original code tokens.
    assert_eq!(styles, [None, Some(1)]);
    assert_eq!(counts, [5, 6]);
    assert_eq!((headings, links, code_blocks, tables), (10, 0, 0, 0));
    assert_eq!(codes, ["(width, unsigned value)", "0 <= value < 2^width", "wire name expr", "state name width initial", "next name expr", "next q q", "inst name module arguments", "output name width expr", "[lo,lo+width)", "initial(PreparedNetlist)", "step", "observe"]);
    for exact in ["(q_{k+1},y_k)", "xor a b = nor (nor a b) (and a b)。", "mux = (select AND yes) OR ((NOT select) AND no)。", "NextBit/OutputBit", "InvalidTestShape", "textLength"] {
        assert!(text.contains(exact), "missing exact visible token: {exact}");
    }
    println!("CIRCUIT_VISIBLE {}", serde_json::to_string(&text)?);
    Ok(())
}
