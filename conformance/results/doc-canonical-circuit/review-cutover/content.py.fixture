from pathlib import Path
import re,sys,json
from playwright.sync_api import sync_playwright
OUT=Path(__file__).parent;sys.path.insert(0,str(OUT/'source'))
from tools.audit.structure import Parser,load_forms
exec((OUT/'helpers.py').read_text(encoding='utf8'))
raw=Parser((OUT/'source/doc/spec/07-circuit.nepld').read_text(encoding='utf8'),load_forms(OUT/'source')).complete('Doc/Article')
def expand(n):
    if isinstance(n,list):return [expand(x) for x in n]
    if not isinstance(n,dict):return n
    if n['kind']=='leaf':return expand(literal(n['token']))
    return dict(kind=n['kind'],fields={k:expand(v) for k,v in n['fields'].items()})
tree=expand(raw)
def view(n):
    if isinstance(n,list):return ''.join(map(view,n))
    if not isinstance(n,dict):return ''
    k=n['kind'];f=n['fields']
    if k=='Ruby':return view(f['base'])+'['+view(f['reading'])+']'
    if k in ('Text','InlineCode'):return f['text']
    return ''.join(view(x) for x in f.values())
paragraphs=[view(n) for n in walk(tree) if n['kind']=='Paragraph']
headings=[view(tree['fields']['title'])]+[view(n['fields']['title']) for n in walk(tree) if n['kind']=='Section']
with sync_playwright() as p:
    browser=p.chromium.launch(headless=True);page=browser.new_page()
    url='https://github.com/neknaj/NEPL3/blob/e600c9325193fce64e4c4a7116a8cecca31f6e75/doc/spec/07-circuit.md'
    page.goto(url,wait_until='networkidle',timeout=90000)
    result=page.locator('article.markdown-body').evaluate('a=>({paragraphs:[...a.querySelectorAll("p,li")].filter(n=>n.tagName!=="LI"||!n.querySelector("p")).map(n=>n.textContent),headings:[...a.querySelectorAll("h1,h2")].map(n=>n.textContent)})')
    empty_count=sum(x=='' for x in result['paragraphs'])
    assert empty_count==19
    result['paragraphs']=[x for x in result['paragraphs'] if x!='']
    assert result['paragraphs']==paragraphs and result['headings']==headings,(len(result['paragraphs']),len(paragraphs))
    (OUT/'all-notes-content.json').write_text(json.dumps(dict(result='PASS',source='fixed typed Doc; annotations expanded by independently read all-notes contract',paragraphs=paragraphs,headings=headings),ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
    browser.close()
    browser=p.webkit.launch(headless=True)
    for width in [375,1280]:
        context=browser.new_context(java_script_enabled=False,viewport={'width':width,'height':900})
        page=context.new_page();path=OUT/'served/independent/deep/first/docs/spec/07-circuit.html'
        page.goto(path.resolve().as_uri(),wait_until='networkidle');page.screenshot(path=str(OUT/f'visual-webkit-{width}-title.png'))
        page.goto(path.resolve().as_uri()+'#n-6465636c61726174696f6e73',wait_until='networkidle');page.screenshot(path=str(OUT/f'visual-webkit-{width}-list.png'))
        context.close()
    browser.close()
print('PASS: all 33 paragraphs and 10 headings including every Ruby reading match actual GitHub display')
