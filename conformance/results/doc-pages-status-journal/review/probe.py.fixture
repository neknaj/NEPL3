from pathlib import Path
import sys,tempfile,json,subprocess,base64
from dataclasses import replace
sys.path.insert(0,str(Path('tools/site').resolve()))
from journal import Event,append,load
from journal.model import encode
from deployment.journal import record_created,record_status,status_history
from test_receipt_journal import RAW
p=Path('.tmp/status-journal-review');records=[]
for state in ['deployment_failed','future_state','succeed']:
 with tempfile.TemporaryDirectory() as d:
  repo=Path(d)/'j.git';subprocess.run(['git','init','--bare','--quiet',str(repo)],check=True)
  intent=Event('RecoveryIntent','tx',23,1,'a'*40,'b'*64);head=append(repo,None,intent,b'{}');head,r=record_created(repo,head,intent,RAW,owner='neknaj',repository='NEPL3')
  raw=json.dumps({'status':state}).encode();head,_=record_status(repo,head,raw,owner='neknaj',repository='NEPL3',request_url=r.status_endpoint)
  history=status_history(repo,owner='neknaj',repository='NEPL3');assert history.observations[0].raw_response==raw
  try:record_status(repo,head,b'{"status":"succeed"}',owner='neknaj',repository='NEPL3',request_url=r.status_endpoint);raise AssertionError('appended after terminal')
  except ValueError:pass
  assert load(repo).head==head
  proof=encode(dict(version=1,request_url=r.status_endpoint,response=base64.b64encode(b'{"status":"succeed"}').decode()))
  appended=append(repo,head,replace(intent,kind='Observation'),proof)
  try:status_history(repo,owner='neknaj',repository='NEPL3');raise AssertionError('replayed after terminal')
  except ValueError as ex:reason=str(ex)
  assert load(repo).head==appended
  records.append(dict(state=state,record_followup_rejected=True,replay_followup_rejected=True,reason=reason))
(p/'probe-results.json').write_text(json.dumps(records,indent=2)+'\n',encoding='utf8');print(json.dumps(records,indent=2))
