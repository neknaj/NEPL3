from pathlib import Path
from playwright.sync_api import sync_playwright
import json
p=Path(__file__).parent
with sync_playwright() as api:
    browser=api.chromium.launch(headless=True);page=browser.new_page(viewport={'width':1280,'height':900})
    url='https://github.com/neknaj/NEPL3/blob/e8c396ada1e3d48d981f7a43276889e691e1be1b/doc/spec/19-html-fragment.md'
    response=page.goto(url,wait_until='domcontentloaded',timeout=60000);assert response.status==200
    article=page.locator('article.markdown-body');article.wait_for(state='visible')
    title=article.locator('h1');assert title.inner_text()=='19. HTML fragmentの構造契約[こうぞうけいやく]'
    title.scroll_into_view_if_needed();page.screenshot(path=str(p/'github-viewport.png'),animations='disabled')
    (p/'github-shot.json').write_text(json.dumps(dict(result='PASS',url=url,readiness='domcontentloaded then visible fixed article/title',version=browser.version),ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
    browser.close()
print('PASS separate viewport screenshot; previous optional reload networkidle timeout remains recorded')
