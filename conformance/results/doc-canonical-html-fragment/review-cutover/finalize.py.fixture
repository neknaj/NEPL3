from pathlib import Path
import json,hashlib
p=Path(__file__).parent;sha=lambda b:hashlib.sha256(b).hexdigest()
assert len(json.loads((p/'html-results.json').read_bytes()))==12
assert json.loads((p/'github-results.json').read_bytes())['complete']
assert json.loads((p/'all-notes-content.json').read_bytes())['result']=='PASS'
assert json.loads((p/'github-shot.json').read_bytes())['result']=='PASS'
assert json.loads((p/'bootstrap-results.json').read_bytes())['complete']
files=[]
for f in sorted(p.rglob('*')):
    rel=f.relative_to(p)
    if not f.is_file() or f.name=='manifest.json' and f.parent==p:continue
    if rel.parts[0] in ['served','bootstrap-workspace'] or '__pycache__' in rel.parts:continue
    if f.name.startswith(('webkit-first-','webkit-second-')) and f.suffix=='.png':continue
    data=f.read_bytes();files.append(dict(path=rel.as_posix(),bytes=len(data),sha256=sha(data)))
b=(json.dumps(dict(version=1,source_commit='e8c396ada1e3d48d981f7a43276889e691e1be1b',scope='Independent generated-view checks and README nine-file offline reconstruction; optional screenshot reload timed out, separate screenshot succeeded',prior_manifest=dict(path='initial-manifest.json',sha256='256c818049c8d94389ad0f89cf526143d2d82ee05670f4fb8a7f6a6a122a20aa'),excluded=['served/**','bootstrap-workspace/**','**/__pycache__/**','webkit-first-*.png','webkit-second-*.png'],files=files),ensure_ascii=False,indent=2)+'\n').encode();(p/'manifest.json').write_bytes(b);print(len(files),sha(b))
