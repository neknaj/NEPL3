from pathlib import Path
import subprocess,json,hashlib
p=Path(__file__).parent.resolve();root=p.parents[1]
head='e8c396ada1e3d48d981f7a43276889e691e1be1b';base='e600c9325193fce64e4c4a7116a8cecca31f6e75'
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
def sha(b):return hashlib.sha256(b).hexdigest()
def put(n,b):q=p/n;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
changed=['doc/canonical.json','doc/migration/aliases/19-html-fragment.json','doc/migration/authored/19-html-fragment.nepld','doc/spec/01-architecture.md','doc/spec/19-html-fragment.md','doc/spec/19-html-fragment.nepld','tools/src/doc/canonical/tests.rs']
assert sorted(git('diff','--no-renames','--name-only',base,head).decode().splitlines())==sorted(changed)
scope=changed+['AGENTS.md','doc/authoring.md','doc/spec/16-doc-migration.md','doc/spec/21-doc-pages.md','tools/src/doc/canonical.rs','tools/src/doc/canonical/projection.rs','tools/src/doc/export/pages.rs','tools/src/doc/projection/annotated/blocks.rs','tools/tests/doc/annotated_pages.rs','design/forms.json','tools/audit/structure.py']
reg=json.loads(git('show',head+':doc/canonical.json'))
for page in reg['pages']:scope.extend(page[k] for k in ['source','projection','aliases'])
scope=list(dict.fromkeys(scope))
names=git('ls-tree','-r','--name-only',head).decode().splitlines();names=[n for n in names if '/' not in n or n.startswith(('tools/','crates/','design/','interfaces/','languages/','doc/','conformance/fixtures/','examples/','.cargo/'))]
proc=subprocess.Popen(['git','cat-file','--batch'],cwd=root,stdin=subprocess.PIPE,stdout=subprocess.PIPE);rows=[]
for n in names:
    proc.stdin.write((head+':'+n+'\n').encode());proc.stdin.flush();h=proc.stdout.readline().split();assert h[1]==b'blob';b=proc.stdout.read(int(h[2]));assert proc.stdout.read(1)==b'\n'
    put('workspace/'+n,b);rows.append(dict(path=n,sha256=sha(b),bytes=len(b)))
    if n in scope:put('source/'+n,b)
proc.stdin.close();assert proc.wait()==0
for n in changed:
    r=subprocess.run(['git','show',base+':'+n],cwd=root,capture_output=True)
    if r.returncode==0:put('before/'+n,r.stdout)
put('source.patch',git('diff','--binary',base,head))
prior=Path('C:/projects/NEPL3-doc-canonical-circuit/.tmp/review-canonical07-code');m=(prior/'manifest.json').read_bytes();put('prior-k/manifest.json',m);index={r['path']:r for r in json.loads(m)['files']}
chapters=['00-contract','01-architecture','07-circuit','13-reproducibility','18-html-delivery','22-external-extensions']
selected=['record.md','html-first/docs/spec/assets/doc.css']+['html-first/docs/spec/'+n+'.html' for n in chapters]+['markdown-first/doc/spec/'+n+'.md' for n in chapters]
for n in selected:
    b=(prior/n).read_bytes();r=index[n];assert len(b)==r['bytes'] and sha(b)==r['sha256'];put('prior-k/'+n,b)
content=root/'.tmp/review-canonical19-content';m=(content/'manifest.json').read_bytes();put('prior-content/manifest.json',m)
for r in json.loads(m)['files']:
    b=(content/r['path']).read_bytes();assert len(b)==r['bytes'] and sha(b)==r['sha256'];put('prior-content/'+r['path'],b)
put('snapshot.json',(json.dumps(dict(head=head,base=base,changed=changed,scope=scope,prior_k_selected=selected,runtime_unchanged=True),indent=2)+'\n').encode())
put('dependencies.json',(json.dumps(rows,indent=2)+'\n').encode())
print('Frozen',len(rows),'Git dependencies; seven L source paths and verified K/content evidence')
