            {
              "kind": "Paragraph",
              "fields": {
                "items": [
                  {
                    "kind": "leaf",
                    "token": "\"sidecarのentryは[所有/しょゆう]bundle/nodeの[保存/ほぞん]selectionと[照合/しょうごう]する。\""
