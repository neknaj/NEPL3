article ja "12. [意味/いみ]モデル・[中間表現/ちゅうかんひょうげん]の[補足不変条件/ほそくふへんじょうけん]"
body
  cons section policy "[方針/ほうしん]" body
    cons paragraph
      cons sentence cons code "interfaces/model.json" cons text " はsourceのform" cons ruby text "表" text "ひょう" cons text "と" cons ruby text "別" text "べつ" cons text "の、lower" cons ruby text "後" text "ご" cons text "の" cons ruby text "意味値" text "いみち" cons text "・" cons ruby text "実行" text "じっこう" cons text "IRの" cons ruby text "構造" text "こうぞう" cons text "を" cons ruby text "記述" text "きじゅつ" cons text "する。" nil
      cons "surfaceとmeaningのSchemaRefは[別/べつ]にする。"
