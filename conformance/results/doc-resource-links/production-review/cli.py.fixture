from pathlib import Path
import subprocess,json,hashlib,copy
p=Path('.tmp/review-resource-links-production');d=p/'cli';d.mkdir(exist_ok=True);(d/'physical').mkdir(exist_ok=True)
(d/'doc.nepld').write_text('article en "Title" body cons paragraph cons sentence cons link relative "../data/blob" none text "Download" nil nil nil',encoding='utf8');payload=bytes([0,255,13,10,128]);(d/'physical/blob.bin').write_bytes(payload)
exe=(p/'target/debug/nepl3-tools.exe').resolve();m={'version':1,'pages':[{'id':'guide','source':'docs/guide.md','input':'doc.nepld','route':'docs/guide/index.html'}],'files':[{'id':'file','source':'data/blob','input':'physical/blob.bin','route':'downloads/blob.bin'}]};results=[]
def run(name,v,success=False):
 path=d/(name+'.json');path.write_text(json.dumps(v));out=d/(name+'-out');cmd=[str(exe),'doc-html','pages',str(path.resolve()),str(out.resolve())];r=subprocess.run(cmd,capture_output=True);(d/(name+'.log')).write_bytes(r.stdout+r.stderr);results.append({'name':name,'command':cmd,'exit':r.returncode,'output_exists':out.exists()});assert r.returncode==(0 if success else 1),results[-1];assert out.exists()==success;return out
out=run('success',m,True);assert (out/'downloads/blob.bin').read_bytes()==payload;html=(out/'docs/guide/index.html').read_text();assert 'href="../../downloads/blob.bin"' in html
for name,path in [('traversal','../blob.bin'),('absolute','C:/outside'),('encoded','physical/%62lob.bin'),('missing','physical/missing'),('directory','physical')]:v=copy.deepcopy(m);v['files'][0]['input']=path;run(name,v)
for name,route in [('stylesheet','docs/guide/assets/doc.css'),('manifest','manifest.json'),('page','docs/guide/index.html'),('case','DOCS/guide/other.bin'),('reserved','downloads/CON'),('prefix','docs')]:v=copy.deepcopy(m);v['files'][0]['route']=route;run(name,v)
for key in ['id','source']:v=copy.deepcopy(m);v['files'][0][key]=v['pages'][0][key];run('duplicate-'+key,v)
v=copy.deepcopy(m);v['files']=None;run('null',v)
v=copy.deepcopy(m);v['files']=[];run('unregistered',v)
# New generated source deliberately requests a forbidden file fragment.
(d/'fragment.nepld').write_text((d/'doc.nepld').read_text().replace('none text','some "anchor" text'));v=copy.deepcopy(m);v['pages'][0]['input']='fragment.nepld';run('fragment',v)
# Reuse selected physical bytes via another name: identity remains content-based.
(d/'physical/other.bin').write_bytes(payload);v=copy.deepcopy(m);v['files'][0]['input']='physical/other.bin';o=run('physical-move',v,True)
a=json.loads((out/'manifest.json').read_text());b=json.loads((o/'manifest.json').read_text());assert a['identity']==b['identity'];assert a['execution_identity']==b['execution_identity'];assert a['phase_execution']==b['phase_execution']
assert a['registered_files'][0]['sha256']==hashlib.sha256(payload).hexdigest()
(p/'cli-results.json').write_text(json.dumps({'binary_sha256':hashlib.sha256(exe.read_bytes()).hexdigest(),'results':results},indent=2)+'\n');print(len(results))
