import hashlib,json,sys,threading
from pathlib import Path
from http.server import SimpleHTTPRequestHandler,ThreadingHTTPServer
from urllib.parse import urlsplit
sys.path.insert(0,str(Path('tools/site').resolve()))
from smoke import run
root=Path('.tmp/site-final-primary').resolve()
class Handler(SimpleHTTPRequestHandler):
    def __init__(self,*args,**kwargs):super().__init__(*args,directory=str(root),**kwargs)
    def do_GET(self):
        path=urlsplit(self.path).path
        if not path.startswith('/NEPL3/'):
            self.send_error(404);return
        self.path='/'+path[len('/NEPL3/'):]
        super().do_GET()
    def log_message(self,*args):pass
server=ThreadingHTTPServer(('127.0.0.1',0),Handler)
thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
try:
    result=run(root,hashlib.sha256((root/'manifest.json').read_bytes()).hexdigest(),
               f'http://127.0.0.1:{server.server_port}/NEPL3/',local=True)
    Path('.tmp/site-smoke-result.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
    print(result['result'],len(result.get('observations',[])),'observations')
    if result['result']!='passed':raise RuntimeError(result)
finally:
    server.shutdown();server.server_close();thread.join()
