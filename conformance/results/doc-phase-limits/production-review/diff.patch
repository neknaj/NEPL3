+                limits.source_bytes,
+                limits.work,
+                limits.depth,
+                limits.nodes,
+                limits.allocation_units,
+                limits.output_bytes,
+                limits.diagnostics,
+                limits.events,
+            ] {
+                bytes.extend_from_slice(&value.to_be_bytes());
+            }
+            // The configuration entry starts a fresh operation, with zero usage.
+            bytes.extend_from_slice(&[0; 64]);
+        }
+    }
