from pathlib import Path
import sys,subprocess,json
p=Path('.tmp/creation-gate-review');rows=[]
for label,args in [('normal',['-m','unittest','discover','-s','tools/site','-p','test_creation_gate.py']),('optimized',['-O','-m','unittest','discover','-s','tools/site','-p','test_creation_gate.py']),('real-git',['-m','unittest','test_submit.SubmitTests.test_lost_response_leaves_remote_intent_and_rejects_replay'])]:
 cmd=[sys.executable]+args;r=subprocess.run(cmd,capture_output=True,cwd='tools/site' if label=='real-git' else None);(p/(label+'.stdout')).write_bytes(r.stdout);(p/(label+'.stderr')).write_bytes(r.stderr);rows.append(dict(command=cmd,cwd='tools/site' if label=='real-git' else '.',exit_code=r.returncode))
(p/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8');print(rows)
if any(r['exit_code'] for r in rows):raise ValueError('test failure')
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_creation_gate import CreationGateTests
from journal import Event
from journal.model import Snapshot
from dataclasses import replace
t=CreationGateTests();intent=Event('DeployIntent','tx',1,1,'a'*40,'b'*64);receipt=replace(intent,kind='DeployReceipt');cases=[]
for field,value in [('run_id',2),('attempt',2),('source_commit','c'*40)]:
 try:state=t.snapshot([intent,replace(receipt,**{field:value})]);t.gate(state)
 except (ValueError,TypeError) as e:cases.append(dict(field=field,rejected=True,error=type(e).__name__))
 else:raise ValueError('identity accepted')
state=t.snapshot([intent,receipt]);t.gate(state)
try:t.gate(Snapshot(state.head,state.events,state.evidence[:-1]))
except ValueError:cases.append(dict(evidence_count_rejected=True))
else:raise ValueError('count accepted')
(p/'boundary.json').write_text(json.dumps(cases,indent=2)+'\n',encoding='utf8');print(cases)
