:root { color-scheme: dark; background: #0d1117; color: #e2eaf3; font-family: sans-serif; }
body { margin: 0; }
main { max-width: 58rem; margin: auto; padding: 2rem 1rem; line-height: 1.8; }
a { color: #88c0ff; overflow-wrap: anywhere; }
a:focus-visible { outline: 2px solid #4aa3ff; outline-offset: 3px; }
li { margin-block: .5rem; }
