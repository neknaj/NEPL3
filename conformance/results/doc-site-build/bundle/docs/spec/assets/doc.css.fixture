.nepl-doc{color-scheme:dark;--nepl-bg:#0d1117;--nepl-bg2:#10161e;--nepl-bg3:#0c1118;--nepl-border:#1d2a3b;--nepl-border2:#253142;--nepl-text:#e2eaf3;--nepl-muted:#7a8fa6;--nepl-accent:#4aa3ff;--nepl-accent2:#88c0ff;background:var(--nepl-bg);color:var(--nepl-text);white-space:pre-wrap;overflow-wrap:anywhere;padding:1.5rem;line-height:1.8;font-family:system-ui,sans-serif}
.nepl-doc a{color:var(--nepl-accent);text-underline-offset:.2em}
.nepl-doc a:visited{color:var(--nepl-accent2)}
.nepl-doc a:focus-visible{outline:2px solid var(--nepl-accent2);outline-offset:3px}
body:has(>.nepl-doc){margin:0;background:#0d1117;color-scheme:dark}
.nepl-doc{box-sizing:border-box;max-width:72rem;margin-inline:auto;padding:clamp(1rem,3vw,2rem);font-family:"Hiragino Sans","Yu Gothic UI",system-ui,sans-serif}
.nepl-doc h1,.nepl-doc h2,.nepl-doc h3,.nepl-doc h4,.nepl-doc h5,.nepl-doc h6{margin-block:1.4em .65em;line-height:1.5;scroll-margin-block-start:1rem}
.nepl-doc>h1:first-child{margin-block-start:0}
.nepl-doc h1{font-size:1.65em}
.nepl-doc h2{font-size:1.3em;padding-block-end:.35em;border-block-end:1px solid var(--nepl-border)}
.nepl-doc h3{font-size:1.1em}
.nepl-doc h4,.nepl-doc h5,.nepl-doc h6{font-size:1em}
.nepl-doc code{font-family:"Cascadia Code",Consolas,Menlo,monospace;font-size:.9em}
.nepl-doc :not(pre)>code{background:var(--nepl-bg2);border:1px solid var(--nepl-border);border-radius:.2em;padding:.1em .25em}
.nepl-doc pre{border-radius:.35rem;white-space:pre}
.nepl-doc img{max-width:100%;height:auto}
.nepl-doc blockquote{margin-inline:0;padding-inline:1em;border-inline-start:3px solid var(--nepl-border2)}
.nepl-doc table{border-collapse:collapse;margin-block:1rem}
.nepl-doc th,.nepl-doc td{border:1px solid var(--nepl-border2);padding:.4em .7em}
.nepl-doc th{background:var(--nepl-bg2)}
.nepl-doc pre{background:var(--nepl-bg3);border:1px solid var(--nepl-border);padding:1rem;overflow:auto}
.nepl-doc figcaption{color:var(--nepl-muted)}
.nepl-doc li{margin-block:.4em}
.nepl-paragraph{display:block;margin-block:.85em}
.nepl-paragraph>p{margin:0}
.nepl-ruby,.nepl-anno{display:inline-grid;vertical-align:baseline;grid-template-columns:max-content}
.nepl-ruby{baseline-source:last}
.nepl-anno{baseline-source:first}
.nepl-base{grid-row:2;grid-column:1}
.nepl-anno>.nepl-base{grid-row:1}
.nepl-reading{grid-row:1;grid-column:1;font-size:.6em;text-align:center;color:var(--nepl-accent2)}
.nepl-notes{grid-row:2;grid-column:1;font-size:.6em;text-align:center;color:var(--nepl-muted)}
.nepl-note{display:block}
@supports not ((baseline-source:first) and (baseline-source:last)){
  .nepl-ruby,.nepl-anno{display:inline-table;width:max-content;white-space:pre;border-collapse:collapse;border-spacing:0}
  .nepl-ruby>.nepl-base{display:inline-block}
  .nepl-anno>.nepl-base{display:table-cell}
  .nepl-reading{display:table-caption;caption-side:top}
  .nepl-notes{display:table-caption;caption-side:bottom}
}
.nepl-parallel-rows{display:inline-grid;grid-auto-flow:row}
.nepl-parallel-columns{display:inline-grid;grid-auto-flow:column;gap:1em}
.nepl-parallel-single{display:inline}
.nepl-align-left{text-align:left}
.nepl-align-center{text-align:center}
.nepl-align-right{text-align:right}
.nepl-checkbox{white-space:pre}
