article ja "03. Reader / tokenizer"
body
  cons section policy "[方針/ほうしん]"
    body cons paragraph
      cons "Readerは、[通常/つうじょう]の[字句解析/じくかいせき]を[超/こ]える[再帰/さいき]・[状態/じょうたい]・[外部実装/がいぶじっそう]を[許/ゆる]す。"
      cons "[共通/きょうつう]prefix parserに[対/たい]しては、[一/ひと]つのtokenを[返/かえ]す[境界/きょうかい]を[保/たも]つ。"
      cons "[正規表現/せいきひょうげん]だけを、[表現能力/ひょうげんのうりょく]の[上限/じょうげん]にしない。"
      nil nil
  cons section request "1. [呼出/よびだ]し[契約/けいやく]"
    body
      cons paragraph
        cons sentence cons code "ReadRequest = {snapshot, start, limit, finalInput, context, state, limits}" cons text "。" nil
        cons sentence cons code "ReadReply = Matched(value, end, newState, view, facts, diagnostics) | NoMatch(expected, furthest) | NeedMore(expected) | Failed(diagnostic, recovery) | Stopped(reason) | Await(externalRequest, continuation)" cons text "。" nil
        cons "limitは、このreaderが[参照/さんしょう]できる[入力末尾/にゅうりょくまつび]を[表/あらわ]す。"
        cons "start/end/limitは、[同一/どういつ]snapshotのUTF-8[境界/きょうかい]に[置/お]く。"
        cons sentence cons ruby text "通常" text "つうじょう" cons text "tokenの" cons ruby text "成功" text "せいこう" cons text "には " cons code "start < end <= limit" cons text " を" cons ruby text "要求" text "ようきゅう" cons text "する。" nil
        cons "combinator[内部/ないぶ]のlook/optionalなどでは[空/から]の[成功/せいこう]を[許/ゆる]すが、token[化/か]・skip・[反復/はんぷく]の[反復単位/はんぷくたんい]では[進捗/しんちょく]を[要求/ようきゅう]する。"
        nil
      cons paragraph
        cons "NoMatchとNeedMoreは、state/facts/[確定診断/かくていしんだん]を[変更/へんこう]しない。"
        cons "Failedは、[形式/けいしき]を[確定/かくてい]してから[見/み]つかった[不正入力/ふせいにゅうりょく]を[表/あらわ]す。"
        cons "finalInput=trueで[入力/にゅうりょく]が[終/お]わる[場合/ばあい]は、NeedMoreではなくNoMatchまたはFailedを[返/かえ]す。"
        cons "StoppedをNoMatchへ[変/か]えて、[別候補/べつこうほ]へ[進/すす]んではならない。"
        nil
      cons paragraph
        cons sentence cons code "Await" cons text " は、プログラム" cons ruby text "製" text "せい" cons text "reader/transformの" cons ruby text "呼出" text "よびだ" cons text "し" cons ruby text "要求" text "ようきゅう" cons text "である。" nil
        cons "engine/suiteがmanifestで[許可/きょか]したproviderだけを[呼/よ]び、[同/おな]じ[予算/よさん]で[再開/さいかい]する。"
        cons "continuationはproviderとsnapshotに[束縛/そくばく]する。"
        cons "[対象/たいしょう]ソースに[書/か]かれた[任意/にんい]コードを、[自動実行/じどうじっこう]しない。"
        nil
      nil
  cons section combinators "2. combinatorの[意味/いみ]"
    body
      cons paragraph cons "ReaderExprの[全/ぜん]signatureは、grammar-signaturesを[参照/さんしょう]する。" nil
      cons list unordered
        cons item none body cons paragraph
          cons "literalは[指定/してい]のUTF-8[文字列/もじれつ]に[完全一致/かんぜんいっち]し、Unitを[返/かえ]す。"
          cons "[空/くう]literalも[認/みと]めるが、[進捗検査/しんちょくけんさ]の[対象/たいしょう]とする。" nil nil
        cons item none body cons paragraph
          cons "scalarは、[一/ひと]つのUnicode scalarが[指定/してい]classに[属/ぞく]すれば、Textとして[返/かえ]す。" nil nil
        cons item none body cons paragraph
          cons "seqは[順/じゅん]に[実行/じっこう]し、[結果/けっか]のListを[返/かえ]す。"
          cons "[失敗時/しっぱいじ]には、[状態/じょうたい]とfactsをtransaction[開始位置/かいしいち]へ[戻/もど]す。" nil nil
        cons item none body cons paragraph
          cons "choiceは[順/じゅん]に[試/ため]し、[最初/さいしょ]の[成功/せいこう]を[返/かえ]す。"
          cons "NoMatchのときだけ[次/つぎ]の[候補/こうほ]を[試/ため]し、NeedMore/Failed/Stoppedはその[場/ば]で[伝播/でんぱ]する。"
          cons "[全枝/ぜんえだ]の[成功値/せいこうち]は、[同/おな]じ[宣言型/せんげんがた]を[持/も]つ。"
          cons "[境界認識/きょうかいにんしき]だけが[必要/ひつよう]で[枝/えだ]ごとの[値/あたい]が[異/こと]なる[場合/ばあい]は、[各枝/かくえだ]へ[明示的/めいじてき]なdiscardを[適用/てきよう]してUnitに[揃/そろ]える。"
          cons "seqのList[値/ち]を、[暗黙/あんもく]にTextへ[連結/れんけつ]しない。" nil nil
        cons item none body cons paragraph
          cons "many/someは、それぞれ0[回以上/かいいじょう]と1[回以上/かいいじょう]の[反復/はんぷく]であり、NoMatchで[終了/しゅうりょう]する。"
          cons "[成功/せいこう]しても[入力/にゅうりょく]を[消費/しょうひ]しなければNonProgressとする。"
          cons "NeedMoreを[終了扱/しゅうりょうあつか]いにしない。" nil nil
        cons item none body cons paragraph
          cons "repeat min max pは、[有限回/ゆうげんかい]のmanyである。"
          cons "0 <= min <= maxを[要求/ようきゅう]し、maxへ[到達/とうたつ]した[後/あと]はそれ[以上読/いじょうよ]まない。" nil nil
        cons item none body cons paragraph
          cons "optionalはNoMatchをNoneへ[変/か]え、[成功/せいこう]はSomeとする。"
          cons "その[他/ほか]の[失敗/しっぱい]は[伝播/でんぱ]する。" nil nil
        cons item none body cons paragraph
          cons "look/notは、[元/もと]のcursor/state/factsを[変更/へんこう]しない。"
          cons "lookは、[成功/せいこう]または[不一致/ふいっち]という[結果/けっか]だけを[保持/ほじ]する。"
          cons "notはMatchedとNoMatchを[交換/こうかん]してUnitを[返/かえ]し、NeedMore/Failed/Stoppedは[伝播/でんぱ]する。" nil nil
        cons item none body cons paragraph
          cons "commit pはpのNoMatchをFailedへ[変換/へんかん]し、prefixを[認識/にんしき]した[後/あと]の[残/のこ]りを[包/つつ]む。"
          cons sentence cons ruby text "例" text "たと" cons text "えば " cons code "seq [literal quote, commit bodyAndClose]" cons text " とする。" nil nil nil
        cons item none body cons paragraph
          cons "captureは[子/こ]の[成功範囲/せいこうはんい]にfield[名/めい]を[付/つ]け、regionは[表示/ひょうじ]roleを[付/つ]ける。"
          cons "[両者/りょうしゃ]とも[意味値/いみち]を[変更/へんこう]しない。" nil nil
        cons item none body cons paragraph
          cons "nodeは、[子/こ]のmatch treeを[指定/してい]kindのViewElementで[包/つつ]む。"
          cons "kindは、[現在/げんざい]packageのschemaへ[登録/とうろく]する。" nil nil
        cons item none body cons paragraph
          cons "discardは[成功値/せいこうち]をUnitへ[変/か]えるが、sourceと[確定診断/かくていしんだん]は[失/うしな]わない。" nil nil
        cons item none body cons paragraph
          cons "refは、[同/おな]じpackageのreaderを[呼/よ]ぶ。"
          cons "[進捗/しんちょく]のない[再帰/さいき]は[静的検査/せいてきけんさ]ができる[範囲/はんい]で[拒否/きょひ]し、[実行時/じっこうじ]にもcallsite+cursor+contextの[再入/さいにゅう]を[検出/けんしゅつ]する。" nil nil
        cons item none body cons paragraph
          cons "decodeは[成功後/せいこうご]にnamed pure decoderを[適用/てきよう]し、[元/もと]からdecode[後/ご]へのSourceMapも[返/かえ]す。" nil nil
        cons item none body cons paragraph
          cons "mapは、named Transform providerを[成功値/せいこうち]とsource/viewへ[適用/てきよう]する。"
          cons "[結果/けっか]が[宣言済/せんげんず]み[型/かた]と[一致/いっち]しなければ、ProviderContractViolationとする。" nil nil
        cons item none body cons paragraph
          cons "thenは、[最初/さいしょ]のparserの[値/あたい]とendを[依存/いぞん]parser providerへ[渡/わた]し、そのproviderが[後続/こうぞく]を[読/よ]み[取/と]る。"
          cons "[返/かえ]す[値/あたい]は[後続/こうぞく]parserの[値/あたい]とし、[全体範囲/ぜんたいはんい]は[開始/かいし]から[後続/こうぞく]endまでとする。"
          cons "[前半/ぜんはん]のsource/factsは[保持/ほじ]する。" nil nil
        cons item none body cons paragraph
          cons "callは、named Reader providerへ[要求全体/ようきゅうぜんたい]を[渡/わた]す。"
          cons "reader[全体/ぜんたい]をRustなどで[実装/じっそう]できる。" nil nil
        cons item none body cons paragraph
          cons "eofはlimitで[成功/せいこう]するが、finalInput=falseならNeedMoreとする。" nil nil
        cons item none body cons paragraph
          cons "takecount nはn[個/こ]のUnicode scalarを[読/よ]み、byte[数/すう]と[混同/こんどう]しない。" nil nil
        cons item none body cons paragraph
          cons "until dは、[最初/さいしょ]の[非空/ひくう]delimiter dの[直前/ちょくぜん]までをTextとして[読/よ]み、delimiterは[消費/しょうひ]しない。"
          cons "delimiterが[無/な]ければ、[未確定入力/みかくていにゅうりょく]ではNeedMore、[確定入力/かくていにゅうりょく]ではNoMatchとする。" nil nil
        nil
      cons paragraph
        cons "choice[途中/とちゅう]の[失敗診断/しっぱいしんだん]は、[最終的/さいしゅうてき]に[全候補/ぜんこうほ]がNoMatchになった[場合/ばあい]だけ、[最遠到達位置/さいえんとうたついち]のexpected[集合/しゅうごう]へ[統合/とうごう]する。"
        cons "[成功/せいこう]した[別候補/べつこうほ]へ、[誤/あやま]ったエラーを[残/のこ]さない。"
        cons "work[予算/よさん]は[巻/ま]き[戻/もど]さない。"
        nil
      cons paragraph
        cons "native readerの[内部/ないぶ]checkpointは、[追記済/ついきず]みcollectorの[不変/ふへん]なprefixに[対/たい]する[長/なが]さ、cursor、state、trace overflowを[保存/ほぞん]してよい。"
        cons "viewの[要素/ようそ]とroot、facts、[診断/しんだん]、event、source、SourceMapは、それぞれ[開始時/かいしじ]のprefixを[保/たも]つ。"
        cons "[失敗/しっぱい]やlookの[復帰/ふっき]では[追加部分/ついかぶぶん]を[除去/じょきょ]し、[保存/ほぞん]したstateへ[戻/もど]す。"
        cons "Nodeによるrootの[束/たば]ね[直/なお]しやtransformによる[置換/ちかん]は、そのframeが[開始/かいし]してから[追加/ついか]した[範囲/はんい]に[限定/げんてい]する。"
        cons "[外部/がいぶ]へAwaitを[公開/こうかい]するときは、[各/かく]frameの[完全/かんぜん]な[所有/しょゆう]checkpointを[予算内/よさんない]で[具体化/ぐたいか]し、[既存/きそん]のReaderContinuation schemaを[使用/しよう]する。"
        cons "privateな[長/なが]さやpointerだけを[交換形式/こうかんけいしき]へ[渡/わた]さず、[再開時/さいかいじ]には[従来/じゅうらい]どおり[保存済/ほぞんず]みcontinuationと[応答/おうとう]を[検査/けんさ]する。"
        cons "これは[実際/じっさい]のcollectorコピーを[省/はぶ]く[内部表現/ないぶひょうげん]の[変更/へんこう]であり、[実施/じっし]したコピーの[課金/かきん]を[取/と]り[除/のぞ]く[理由/りゆう]にはしない。"
        nil
      nil
  cons section lexical "3. [文字集合/もじしゅうごう]と[基礎/きそ]reader"
    body
      cons paragraph
        cons "[配布/はいふ]profileではUnicode 16.0.0のXID_Start / XID_Continueを[使/つか]い、underscoreは[開始/かいし]にも[許/ゆる]す。"
        cons "[識別子/しきべつし]を[勝手/かって]にNFC[変換/へんかん]せず、scalar[列/れつ]の[完全一致/かんぜんいっち]で[比較/ひかく]する。"
        cons "[将来/しょうらい]のUnicode[版変更/はんへんこう]は、package revisionに[含/ふく]める。"
        nil
      cons paragraph
        cons sentence cons text "Nameの" cons ruby text "文字判定" text "もじはんてい" cons text "と" cons ruby text "全綴" text "ぜんつづ" cons text "り" cons ruby text "検査" text "けんさ" cons text "、Langの" cons ruby text "全綴" text "ぜんつづ" cons text "りABNF" cons ruby text "検査" text "けんさ" cons text "は、" cons ruby text "共通" text "きょうつう" cons text "coreの " cons code "lexical" cons text " " cons ruby text "契約" text "けいやく" cons text "としてreaderとdomain printerが" cons ruby text "共有" text "きょうゆう" cons text "する。" nil
        cons sentence cons ruby text "現" text "げん" cons text "native" cons ruby text "実装" text "じっそう" cons text "のXID" cons ruby text "表" text "ひょう" cons text "は、pinned " cons code "unicode-ident = 1.0.18" cons text " の " cons link external "https://github.com/dtolnay/unicode-ident/blob/1.0.18/src/tables.rs" concat cons text "Unicode 16.0.0" cons ruby text "生成表" text "せいせいひょう" nil cons text " に" cons ruby text "従" text "したが" cons text "う。" nil
        cons "[全綴/ぜんつづ]り[検査/けんさ]は[予算付/よさんつ]きで、[区切/くぎ]り・triviaを[含/ふく]まない[一/ひと]つの[語/ご]だけを[判定/はんてい]する。"
        cons "[選択言語/せんたくげんご]の[予約/よやく]head[判定/はんてい]や[正規化/せいきか]を[代行/だいこう]しない。"
        cons "readerの[最大一致/さいだいいっち]、[非/ひ]final[入力/にゅうりょく]のNeedMore、[境界診断/きょうかいしんだん]はreader[側/がわ]に[残/のこ]し、この[共通化/きょうつうか]で[認識集合/にんしきしゅうごう]を[変更/へんこう]しない。"
        cons "printerは[不適合/ふてきごう]な[意味値/いみち]を[型付/かたつ]き[失敗/しっぱい]として[扱/あつか]い、reader[依存/いぞん]や[別/べつ]のUnicode/BCP47[規則/きそく]の[複製/ふくせい]を[導入/どうにゅう]しない。"
        nil
      cons paragraph
        cons sentence cons ruby text "基礎" text "きそ" cons text " " cons code "Name" cons text " は、" cons ruby text "上記" text "じょうき" cons ruby text "識別子" text "しきべつし" cons text " " cons ruby text "一" text "ひと" cons text "つである。" nil
        cons sentence cons code "Nat" cons text " は " cons code "0" cons text " または " cons code "[1-9][0-9]*" cons text " とする。" nil
        cons sentence cons code "Number" cons text " はoptional " cons code "-" cons text "、Nat、optional " cons code "." cons text " と1" cons ruby text "桁以上" text "けたいじょう" cons text "の" cons ruby text "数字" text "すうじ" cons text "から" cons ruby text "成" text "な" cons text "る。" nil
        cons "このsurfaceには、[指数表記/しすうひょうき]を[設/もう]けない。"
        cons sentence cons code "Text" cons text " は、" cons ruby text "通常" text "つうじょう" cons text "の" cons ruby text "二重引用符文字列" text "にじゅういんようふもじれつ" cons text "である。" nil
        cons sentence cons code "Lang" cons text " は、ASCIIのwell-formed BCP47 tagである。" nil
        cons "BCP47 tagの[比較/ひかく]はASCII case-insensitiveとし、[元/もと]の[綴/つづ]りは[保存/ほぞん]する。"
        cons "[登録状況/とうろくじょうきょう]をnetworkで[照会/しょうかい]しない。"
        nil
      cons paragraph
        cons sentence cons ruby text "通常" text "つうじょう" cons text "Textのescapeは " cons code "\\\\" cons text "、" cons code "\\\"" cons text "、" cons code "\\n" cons text "、" cons code "\\r" cons text "、" cons code "\\t" cons text "、" cons code "\\u{1〜6 hex}" cons text " とする。" nil
        cons "surrogateとU+10FFFF[超/ちょう]は[拒否/きょひ]し、[未知/みち]escapeはエラーとする。"
        cons "Textではruby/annoを[認識/にんしき]しない。"
        cons "Textも[直接/ちょくせつ]CR/LFを[拒否/きょひ]し、[開始引用符後/かいしいんようふご]はcommitする。"
        cons "[閉/と]じ[引用符/いんようふ]・escape・Unicode escapeの[途中/とちゅう]で[入力/にゅうりょく]が[途切/とぎ]れた[場合/ばあい]は、finalInput=falseならNeedMore、trueならFailedとする。"
        cons "[既/すで]に[不正/ふせい]と[確定/かくてい]したescapeやscalarは、[追加入力/ついかにゅうりょく]を[待/ま]たずFailedとする。"
        cons "Numberの[小数点後/しょうすうてんご]には[最低/さいてい]1[桁/けた]を[要求/ようきゅう]する。"
        cons "[入力末尾/にゅうりょくまつび]で[桁/けた]が[欠/か]ける[場合/ばあい]も、[非/ひ]finalではNeedMore、finalではFailedとなる。"
        nil
      cons paragraph
        cons "[基礎/きそ]readerの[値/あたい]は、Name/Text/LangがText、Natが[非負/ひふ]の[任意精度/にんいせいど]Integer、Numberが[正確/せいかく]なRational、TriviaがUnitである。"
        cons "Natからarity/revisionなどのU64へ[変換/へんかん]するlowerは、[範囲/はんい]を[明示検査/めいじけんさ]する。"
        cons sentence cons text "Langのwell-formedは、" cons link external "https://www.rfc-editor.org/rfc/rfc5646.html#section-2.2.9" text "RFC 5646 §2.1/§2.2.9" cons text "のABNFを" cons ruby text "意味" text "いみ" cons text "し、26" cons ruby text "個" text "こ" cons text "のgrandfathered tagとprivate-useを" cons ruby text "含" text "ふく" cons text "む。" nil
        cons "[登録状態/とうろくじょうたい]やvariant/singleton[重複/じゅうふく]を[含/ふく]むvalid[判定/はんてい]を、この[操作/そうさ]の[追加要件/ついかようけん]にしない。"
        nil
      cons paragraph
        cons sentence cons text "BuiltinRequestはkind、ReadRequest、" cons code "Option<SourceReservation>" cons text "を" cons ruby text "持" text "も" cons text "つ。" nil
        cons "SourceReservationは、hostが[一/ひと]つの[生成/せいせい]snapshotへ[予約/よやく]するsourceId/revision/[絶対/ぜったい]URIであり、digestは[生成/せいせい]bytesから[算出/さんしゅつ]する。"
        cons "Textでのみ[予約/よやく]を[必須/ひっす]とし、[他/ほか]のbuiltinへ[渡/わた]した[予約/よやく]は[契約違反/けいやくいはん]とする。"
        cons "[入力/にゅうりょく]と[同/おな]じsourceId/revisionの[予約/よやく]は[拒否/きょひ]する。"
        cons "[成功/せいこう]するまで[生成/せいせい]sourceをadmitせず、NoMatch/NeedMore/Failedでは[生成物/せいせいぶつ]を[確定/かくてい]しない。"
        cons "[成功後/せいこうご]のdecoded sourceと、[元/もと]からdecodedへのSourceMapをReadReplyへ[保持/ほじ]する。"
        cons "coreが[乱数/らんすう]・[時計/とけい]・[独自/どくじ]namespaceからIDを[発明/はつめい]するのではなく、tokenizer/hostが[各呼出/かくよびだ]しの[予約/よやく]を[供給/きょうきゅう]する。"
        cons "[再試行/さいしこう]は[同/おな]じ[予約/よやく]・[同/おな]じ[結果/けっか]bytesなら[同一/どういつ]snapshotとして[扱/あつか]い、[異/こと]なるbytesへの[使/つか]い[回/まわ]しはIdentityConflictとする。"
        nil
      cons paragraph
        cons sentence cons text "standard triviaはASCII space/tab/CR/LFと、" cons code "#" cons text "から" cons ruby text "行末直前" text "ぎょうまつちょくぜん" cons text "までのcommentである。" nil
        cons "literal[内/ない]ではtrivia[処理/しょり]を[行/おこな]わない。"
        cons "readerが[処理/しょり]するのは[前側/まえがわ]のtriviaだけであり、[子/こ]の[最終/さいしゅう]tokenの[後/あと]で[子言語/こげんご]のtriviaを[勝手/かって]に[消費/しょうひ]しない。"
        cons "これらは[配布/はいふ]4[言語/げんご]のprofileであり、[全/ぜん]NEPL3[言語/げんご]へ[同/おな]じ[字句規則/じくきそく]を[強制/きょうせい]しない。"
        cons "[新/あたら]しいpackageは、[別/べつ]modeとreaderを[定義/ていぎ]できる。"
        nil
      nil
  cons section modes "4. modeとtoken[決定/けってい]"
    body
      cons paragraph
