from pathlib import Path
import re,json,hashlib,difflib,subprocess
from tools.audit.structure import Parser,load_forms

root=Path.cwd(); evidence=root/'.tmp/author-block-projection'
helpers=Path('C:/projects/NEPL3-external-extensions/.tmp/author-external-extensions/helpers.py')
exec(helpers.read_text(encoding='utf8'))
draft=root/'doc/migration/authored/21-doc-pages.nepld'
data=draft.read_bytes(); before=(evidence/'before.nepld').read_bytes()
assert not data.startswith(b'\xef\xbb\xbf') and b'\r' not in data
tree=Parser(data.decode('utf8'),load_forms(root)).complete('Doc/Article')
normalized=normalize(tree,True)
section=next(n for n in walk(normalized) if n['kind']=='Section' and n['fields']['id']=='annotated')
def visible(n):
    if isinstance(n,list):return ''.join(visible(v) for v in n)
    if not isinstance(n,dict):return ''
    k=n['kind'];f=n['fields']
    if k=='Link':return visible(f['label'])
    if k in ('Text','InlineCode','RawCode'):return f['text']
    return ''.join(visible(v) for v in f.values())
actual=[visible(n['fields']['items']) for n in section['fields']['body']['fields']['blocks']]
source=(evidence/'source.md').read_text(encoding='utf8')
source_section=source.split('## 注釈付きMarkdown閲覧projection\n',1)[1]
expected=[]
for p in source_section.strip().split('\n\n'):
    p=''.join(p.splitlines())
    p=re.sub(r'\[([^\]]+)\]\(([^)]+)\)',r'\1',p)
    p=p.replace('`','')
    expected.append(p)
# Two pre-existing spaces at Markdown soft-wrap/inline-code boundaries are
# preserved in the draft, not silently rewritten as part of this delta.
expected[0]=expected[0].replace('renderer識別子はnepl3-', 'renderer識別子は nepl3-')
expected[7]=expected[7].replace('HTML backendと同じn-', 'HTML backendと同じ n-')
assert actual==expected,[(i,a,b) for i,(a,b) in enumerate(zip(actual,expected)) if a!=b]
old_lines=before.decode('utf8').splitlines(keepends=True)
new_lines=data.decode('utf8').splitlines(keepends=True)
opcodes=difflib.SequenceMatcher(None,old_lines,new_lines,autojunk=False).get_opcodes()
changed=[{'tag':tag,'before':[a,b],'after':[c,d]} for tag,a,b,c,d in opcodes if tag!='equal']
assert len(changed)==3,changed
assert all(a>=next(i for i,line in enumerate(old_lines) if 'cons section annotated ' in line) for tag,a,b,c,d in opcodes if tag!='equal')
deleted=[line for tag,a,b,c,d in opcodes if tag!='equal' for line in old_lines[a:b]]
assert len(deleted)==3,deleted
assert 'markdown-annotated/1' in deleted[0] and 'Paragraph/RawCode' in deleted[1] and '初期' in deleted[2]
new_tree_section=next(n for n in walk(tree) if n['kind']=='Section' and n['fields']['id']=='annotated')
audit_text(new_tree_section)
assert (root/'doc/spec/21-doc-pages.md').read_bytes()==(evidence/'source.md').read_bytes()
links=[n['fields']['target'] for n in walk(section) if n['kind']=='Link']
assert len(links)==1 and links[0]['fields']['uri']=='https://github.github.com/gfm/#tables-extension-'
(evidence/'after.nepld').write_bytes(data)
(evidence/'draft.diff').write_text(''.join(difflib.unified_diff(old_lines,new_lines,fromfile='before.nepld',tofile='after.nepld')),encoding='utf8',newline='\n')
(evidence/'helpers.py').write_bytes(helpers.read_bytes())
(evidence/'result.json').write_text(json.dumps({'formal_structure':'PASS (not production runtime)','annotated_paragraphs_exact_source':len(actual),'changes':changed,'removed_old_lines':3,'added_section_link':links,'ruby_all_document':len(pairs),'annotated_unrubied_kanji':'none','source_unchanged':True,'draft_sha256':hashlib.sha256(data).hexdigest(),'source_sha256':hashlib.sha256((evidence/'source.md').read_bytes()).hexdigest(),'paragraphs':actual},ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS',len(actual),'paragraphs; draft',hashlib.sha256(data).hexdigest())
