article ja "10. Profile・[埋/う]め[込/こ]み・[実行入口/じっこういりぐち]"
body
  cons section policy "[方針/ほうしん]" body
    cons paragraph
      cons "ソース上の相互埋め込みとcrate依存を分離する。"
      cons "suiteが登録済みlanguage package、domain operation、output adapterを接続する。" nil
    nil
  cons section profile "1. Profile" body
    cons paragraph
      cons "Profileはlanguage alias→SchemaRef、category mode、provider allowlist、operation bridge、resource snapshot、Limitsを持つ不変値。"
      cons "root languageはファイル拡張子またはCLI引数で選び、全ソースを一律のlexerで先にtoken化しない。" nil
    cons paragraph
      cons sentence cons code "design/profile.json" cons text " はsource manifestであり、解決済みruntime Profileではない。" nil
      cons "R009の解消では生成結果の閉じた型、各schema/package/provider digest、許可capability、resource identityと整合検査を先に定める。"
      cons "T05/T11で実際の検査済みpackageから生成・差分検査し、UI/Workerはこの値を利用する。"
      cons "R006の操作・bundle型の未定義を文字列signatureや仮digestで補わない。" nil
    cons paragraph
      cons sentence cons text "解析の実入口はengineの" cons code "ParseProfile" cons text "とし、suite Profileから渡す不変なprojectionとして扱う。" nil
      cons sentence cons code "interfaces/engine.json" cons text "にlanguage登録、category mode、選択schema、provider要件、operation allowlist、resource identity、Limitsの型を置く。" nil
      cons sentence cons code "resolve" cons text "は独立したhost RuntimeCatalogとfinalize済みregistryを使い、実package意味digest、schema参照閉包、guest category/mode、host provider登録の実装identity、resourceの実byte列digestを照合する。" nil
      cons "外部Profileの自己申告をそのままhost登録へ複写して検査済みとしない。" nil
    cons paragraph
      cons "provider identityはhostが実assetまたは版管理された実装manifestから確定する。"
      cons "coreはbinaryを読み込まず、binary自身のhashを同じbinary内の定数へ埋める自己hash循環も要求しない。"
      cons "operationのschema署名が既知でもcallbackが登録されたことにはならない。"
      cons "parseに使うreader providerは許可済み実登録を要求し、未実行のfacts等のextensionは署名を検査するが自動実行しない。" nil
    cons paragraph
      cons sentence cons text "解析Profileのidentityは" cons code "NEPL3-PARSE-PROFILE-1" cons text "、zero byte、canonical JSONのSHA-256。" nil
      cons "id、language登録、schema、category-mode指定、providerの実装identity、allowlist、resource identity、Limitsを含める。"
      cons "宣言はalias/idまたは完全OperationRef/SchemaRef順、Limits列はsourceBytes/work/depth/nodes/allocationUnits/outputBytes/diagnostics/events順とする。"
      cons "実resource bytesはhash照合し、Profileへ全文複製しない。" nil
    cons paragraph
      cons "HeadProviderの登録はheadProvidersのHeadRegistration(alias,category,provider)で選ぶ。"
      cons "同じpackageを登録した別aliasの設定を共有したと推定しない。"
      cons "(alias,category)重複を拒否し、shape/childContextの両OperationRefについて純粋なHeadCall→HeadReply署名、allowlist、独立host catalogの実装identityを検査する。"
      cons "標準操作名はheadShape/headChildContextだが、登録済みの同署名操作も選択できる。"
      cons sentence cons text "Profile identityにはheadProviders keyを含め、alias/category順の " cons code "[alias,category,shapeOperation,childContextOperation]" cons text " 列で記述する。" nil
      cons "列挙順だけの変更はidentityを変えず、操作の役割・alias/categoryへの割当変更は変える。" nil
    cons paragraph
      cons "ここでのallowlistはoperation呼出可否を表す。"
      cons "providerのtransport、隔離、ネットワーク等の権限、強制停止方法、bridge、EnvironmentProjectionを含むfull suite Profileの契約は引き続き実装対象である。"
      cons "この解析projectionだけではR009全体を完了しない。"
      cons "hostは実行環境のcapabilityを別途検査し、解析projectionはその承認を代行しない。" nil
    cons paragraph
      cons sentence cons text "配布拡張子は " cons code ".neplg" cons text "、" cons code ".nepld" cons text "、" cons code ".neplm" cons text "、" cons code ".neplc" cons text "。" nil
      cons sentence cons text "汎用 " cons code ".nepl" cons text " ではlanguage指定を必須にする。" nil
      cons "既存NCGやGlossのファイルを新言語として黙って解釈しない。" nil
    cons paragraph
      cons "ParseProfile.limitsは解析操作に対するresource別上限であり、単なる既定値ではない。"
      cons "操作開始時に実Budgetの全LimitsがProfile上限以下であることを照合し、超える場合はLimitsMismatchで拒否する。"
      cons "小さい操作予算を使うことは許す。"
      cons "既に消費したUsageはresetせず、継続も同じ操作Limitsと単調なUsageを保持する。"
      cons "Profileのresolve自体を行う開発・host側Budgetはこの解析操作Budgetとは別であり、解決時の消費を解析へ済んだものとして移さない。" nil
    cons paragraph
      cons "EntryContextはaliasを明示保存する。"
      cons "同じpackage identityを異なるaliasで登録してcategory-mode overrideだけを変えることを許し、子のLocal解決も親の実aliasを使う。"
      cons "Profileのlanguage列の並び順は意味に含めず、aliasから選ぶ対応を継続へ保持する。"
      cons "alias別のreader stateとenvironmentも明示し、guest不足をUnitやhost環境で補わない。" nil
    nil
  cons section bridges "2. [標準/ひょうじゅん]bridge" body
    cons table cons default cons default cons default cons default nil
      some row cons "host slot" cons "source[入口/いりぐち]" cons "guest root" cons "[操作/そうさ]" nil
      cons row cons "Doc InlineMath" cons "Math" cons "Math.Expr" cons "lower/check、17章の生成policyによるrender" nil
      cons row cons "Doc DisplayMath" cons "Math" cons "Math.Expr" cons "同上、display style" nil
      cons row cons "Doc CircuitFigure" cons "Circuit" cons "Circuit.Design" cons "lower/check/elaborate/diagram" nil
      cons row cons "Doc Code" cons "Grammar/Doc/Math/Circuit" cons "対応する根" cons "source/viewの表示のみ" nil
      cons row cons "Math Label" cons "Doc" cons "Doc.Sentence" cons "lower/check/render phrasing" nil
      nil
    cons paragraph
      cons "MathのDoc注記は文書全体やparagraphを受け入れない。"
      cons "これでMathMLの注記位置へblock文書が混入しない。"
      cons "Code内の不正なguestはRecover構文として保持できる。"
      cons "render時にもevaluate/compileを開始しない。" nil
    cons paragraph
      cons "言語の切替えは一つの引数の範囲に限定し、終了時にhostのmodeへ戻る。"
      cons "たとえばDoc/math/Math/add内からDoc sentenceへ戻っても、そのguestの外側のtriviaを読み過ぎない。" nil
    nil
  cons section recursion "3. [相互依存/そうごいぞん]と[再帰/さいき]" body
    cons paragraph
      cons "ソース上の有限な入れ子は許す。"
      cons "ForeignSyntaxはroot node、language revision、originと環境参照を保持する。"
      cons "操作グラフは対象nodeとoperationの組を頂点に持ち、suiteが必要な依存順に処理する。" nil
    cons paragraph
      cons "Doc→Math→Docの有限の注記は循環ではない。"
      cons "同じnodeのrenderが再び自分のrenderを要求する等の循環はCyclicOperation。"
      cons "生成によって構造が増える場合も共通予算とoriginを維持する。" nil
    nil
  cons section environment "4. [環境/かんきょう]の[受渡/うけわた]し" body
    cons paragraph
      cons "各guestの名前空間は既定で新しく分離する。"
      cons "DocLabel、MathSymbol、CircuitSignalを一つの名前辞書へ入れない。"
      cons sentence cons text "bridgeは必要に応じて " cons code "EnvironmentProjection" cons text " として、どのnamespace/entityをどの型の外部値として渡すかを明示する。" nil nil
    cons paragraph
      cons "配布bridgeはMathのfree symbol値をRenderContextから明示的に受け取り、DocLabelとCircuitSignalは自動exportしない。"
      cons "Doc annotation内のlabelはそのsentenceの局所scopeで検査する。"
      cons "呼出し側のlabel参照が必要ならprofileのprojectionで明示する。" nil
    nil
  cons section artifacts "5. artifactの[準備/じゅんび]" body
    cons paragraph
      cons "backendsに任意raw HTML stringを渡さない。"
      cons "suiteがforeign subtreeをtyped MarkupFragmentへ変換し、そのslotに適合する内容モデルを検査する。"
      cons "doc-htmlはPreparedEmbedsの対応表を入力として受け取る。"
      cons "math-mathml/circuit-svgを直接importしない。" nil
    cons paragraph
      cons "asset参照は固定内容とdigestを持つResourceSnapshot。"
      cons "coreがpathから読んだりURLへ接続したりしない。"
      cons "HTML出力は既定で外部network無しで閲覧できる。"
      cons "KaTeX生成時は同じ固定版のCSS/fontをartifactへ同梱し、相対参照とlicenseを保持する。"
      cons sentence cons text "host生成・独立MathML fallback・出力検査・asset identityは" cons link relative "17-math-html.md" none text "17章" cons text "に従う。" nil
      cons "全資源を明示的なartifact dependencyとして報告する。" nil
    nil
  cons section cli "6. CLI" body
    cons list unordered
      cons item none body cons paragraph cons sentence cons code "nepl3 parse --language doc input.nepld --format ndf|json" cons text " はRecover treeと診断を出す。" nil nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 check input.nepld" cons text " は必要なdomain検査と参照検査を行う。" nil nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 render input.nepld --output out.html" cons text " は埋め込みをprepareしHTMLを出す。" nil nil nil
      cons item none body cons paragraph
        cons sentence cons code "nepl3 render input.neplm --output out.html" cons text " は生成済み数式を含むHTMLと必要assetを出す。" nil
        cons sentence cons text "Doc/Mathのrenderは " cons code "--math-renderer katex-preferred|mathml-only" cons text " を取り、既定はKaTeX優先。" nil
        cons "生成能力不足等のMathML fallbackは診断を保持する。" nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 evaluate input.neplm --bindings bindings.ndf" cons text " はExact/Symbolic/Invalidを構造化出力する。" nil nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 grammar compile input.neplg --output out.ndf" cons text " はLanguagePackageを出す。" nil nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 circuit test input.neplc" cons text " は全testを実行する。" nil nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 circuit compile input.neplc --target nor --output out.ndf" cons text " はNOR IRを出す。" nil nil nil
      cons item none body cons paragraph cons sentence cons code "nepl3 circuit diagram input.neplc --output out.svg" cons text " はSVGを出す。" nil nil nil
      cons item none body cons paragraph
        cons sentence cons code "nepl3 format input --style prefix|compact" cons text " は明示的なformatter。" nil
        cons "既定はstdoutで、--write時だけファイルを置換する。" nil nil
      nil
    cons paragraph
      cons "終了code: 0 成功（Symbolicは操作が許す正常結果）、1 入力/検査/テスト失敗、2 CLI/config/protocolエラー、3 limit/cancel、4 provider内部違反。"
      cons "stdoutは成果物だけ。"
      cons "sourceのdecode失敗を成功空文書にしない。" nil
    nil
  cons section hosts "7. browser/native/WASI" body
    cons paragraph
      cons "同じsuite APIを利用する。"
      cons "browserではWorkerで計算し、未応答時はWorkerを終了できる。"
      cons "ファイル/ネットワーク権限はWeb shellに限定する。"
      cons "wasm-bindgenのJS undefined/nullは境界でOption/Resultへ変換し、domainへ流さない。" nil
    cons paragraph
      cons "wasm32-wasip2 CLIはWASI I/O adapterを使う。"
      cons "nativeのprocess provider呼出しをbrowser/WASIへ無条件に持ち込まない。"
      cons "該当hostが提供するregistry/runnerのcapabilityを検査する。"
      cons "組込み4言語の基本操作は全targetで使える。" nil
    nil
  nil
