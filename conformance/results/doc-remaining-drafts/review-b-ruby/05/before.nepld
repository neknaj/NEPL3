article ja "05. Doc[言語/げんご]"
body
  cons section policy "[方針/ほうしん]" body
    cons paragraph
      cons "本文の階層、文単位の翻訳対応、inlineの注釈を独立した構造として扱う。"
      cons "sentence literalとprefix constructorを同じ意味モデルへlowerする。"
      cons "source表記は別に保持する。" nil
    nil
  cons section types "1. [主要/しゅよう]な[型/かた]" body
    cons paragraph
      cons "Article(language, title:Sentence, body:Body)。"
      cons "BodyはBlockの列。"
      cons "BlockはParagraph、Section、DisplayMath、CircuitFigure、Code、Table、List、RawCode、Image。"
      cons "ParagraphはFlowの列。"
      cons "FlowはSentence、ParallelとBlockの各variant。"
      cons "したがってParagraphを再帰的に含められる。"
      cons "SentenceはInlineの列。"
      cons "Parallelは2個以上のVariant(language, sentence)の列。"
      cons "VariantへParagraphやParallelは入れられない。"
      cons "InlineはText、Concat、Ruby(base,reading)、Anno(base,notes)、InlineMath、Anchor(id,label)、Reference(target,label)、Emphasis、Strong、Break、Link、InlineCode、InlineImage。" nil
    cons paragraph
      cons "全signatureはdoc-signaturesを参照。"
      cons "bare quoted文字列をSentence/Flowの位置で読むとSentenceLiteralになる。"
      cons sentence cons code "text" cons text " の子は通常Textであり、その内部の " cons code "[" cons text " や " cons code "{" cons text " を注釈と解釈しない。" nil nil
    cons section arena "1.1 [意味/いみ]モデルと[公開/こうかい]arena" body
      cons paragraph
        cons sentence cons code "interfaces/model.json" cons text " の " cons code "Doc:*" cons text " recordと " cons code "Doc/*" cons text " unionはconstructorの論理的な意味展開であり、独立した再帰wire layoutではない。" nil
        cons sentence cons text "Doc操作で送受信する値の正本は " cons code "interfaces/doc.json" cons text " の " cons code "DocumentSyntax" cons text " / " cons code "DocValue" cons text "。" nil
        cons sentence cons code "DocValue.nodes" cons text " の各 " cons code "DocNode.kind" cons text " がconstructorを表し、子はカテゴリ別のindex参照を使う。" nil
        cons "Rust enumの並びをwire tagへ転用せず、schemaの明示variant名とfield列を対応させる。" nil
      cons paragraph
        cons sentence cons text "Article以外のBody、Block、Flow、Sentence、Inline、Variant、Row、ListItem、MathGuest、CircuitGuest、Guestも明示 " cons code "DocRoot" cons text " として単独のfragmentを構成できる。" nil
        cons "Alignment、ListStyle、Check、LinkTarget、Asset、OptionalRow、OptionalSentence、OptionalTextは表層の固定arity補助constructorである。"
        cons "単独lower時には対応するarena wrapperをrootとする。"
        cons "親constructorのoperandである場合はAlignment、ListKind、Option、LinkTarget、AssetRefという型付き値へ取り込み、補助wrapperを意味的な子として残さない。"
        cons "元operandのView、Origin、source byte宣言はこの取り込みで破棄しない。"
        cons sentence cons text "Optionやlistの暗黙文法は導入せず、signatureにある " cons code "none" cons text " / " cons code "some" cons text "、" cons code "cons" cons text " / " cons code "nil" cons text " を読む。" nil nil
      cons paragraph
        cons "arenaの構造検査はroot/childカテゴリ、index範囲、循環、到達性、注釈内容、表の列数等を検査する。"
        cons "共有DAGを許すが全経路の最大Depthを検査し、ForeignClosureの内側深さもその所有nodeまでの深さに合成する。"
        cons "この構造proofはlabel解決、guest意味check、PreparedArticleを意味しない。"
        cons sentence cons text "tokenごとのViewは " cons code "DocView.head" cons text " に束縛し、ViewRefとrelationのID空間をtoken間で混ぜない。" nil
        cons "Text正規化後も元ViewとOriginを保存する。"
        cons "sourceを持つTextとsource-less Textを結合する場合、後者を明示Synthetic OriginとしてCompositeに含め、既知spanを全体のspanに偽装しない。" nil
      nil
    cons section elements "1.2 [文書入力/ぶんしょにゅうりょく]に[必要/ひつよう]な[要素/ようそ]" body
      cons paragraph
        cons "DG01のTableは列ごとのDefault/Left/Center/Right、任意header、順序付きRowを持つ。"
        cons "全Rowのcell数は列数と一致する。"
        cons "cellはSentenceであり空Sentenceも明示値として許す。"
        cons "ゼロ列のTableは構造上の空表として表現可能で、内容のある列を補わない。" nil
      cons paragraph
        cons "DG02のListはUnorderedまたはOrdered(start:Nat)を明示し、ListItemは任意のchecked状態とBodyを持つ。"
        cons "Bodyを介した入れ子を保持する。"
        cons "Orderedのstartは公開arenaのU64で表せる範囲をlower時に検査し、範囲外を丸めない。" nil
      cons paragraph
        cons "DG03のLinkはPage(page,fragment)、Relative(path,fragment)、External(uri)を区別し、表示labelを保持する。"
        cons "DG06のSection/Anchor/Referenceのarticle内IDとは区別し、ページ名、外部URI、相対pathを同じ名前空間で自動解決しない。"
        cons "公開URIへの写像とリンク解決はcheck/prepare側の明示入力であり、構造値だけからファイル読出し権限や安全なHTML属性を得ない。" nil
      cons paragraph
        cons "DG04のInlineCodeとRawCodeは意味解析しないTextを保持する。"
        cons "RawCodeのlanguageHintは任意の表示情報で、parserや評価器の自動実行要求ではない。"
        cons "DG05のImage/InlineImageはAssetRef(id,任意digest)とaltを持ち、block画像は任意captionを持つ。"
        cons "表層のdigestはOptionalTextの64桁hexを32byteのDigestへlowerし、無効な桁数・文字を拒否する。"
        cons "assetの読出し、digest照合、表示準備は別の解決操作で行う。"
        cons "RawHtmlは追加しない。" nil
      cons paragraph
        cons sentence cons text "この要素選択はmain " cons code "b5295cef655aa59affffd6644f2902268d071953" cons text " の文書入力監査（inventory SHA-256 " cons code "daf94085913930f05c1655d2adbef4f56651864f9a97ac4d261400449c98499e" cons text "）に基づく。" nil
        cons "61 Markdown、52表/1283cell、39list/233item、1134 inline code、12 code block、249link、1imageを含む。"
        cons sentence cons text "監査は実装中差分やrustdocの意味監査の完了を示さず、実装済み操作は " cons code "implementation-status.json" cons text " と実行済み受入で区別する。" nil nil
      nil
    cons section inspection "1.3 [文書準備/ぶんしょじゅんび]の[要求発見/ようきゅうはっけん]" body
      cons paragraph
        cons sentence cons code "prepare::inspect" cons text " はArticleの構造・source閉包・article内labelを検査し、" cons code "DocPreparationPlan" cons text " を返す。" nil
        cons "これは必要な外部入力の列挙であり、完全なPreparedArticleではない。"
        cons "全Parallel variantを対象とし、表示言語の選択やguest操作を実行しない。" nil
      cons paragraph
        cons sentence cons text "planは " cons code "documentDigest" cons text " と順序付き " cons code "requirements" cons text " を持つ。" nil
        cons "Linkは意味node indexと元LinkTarget、Assetは意味node indexと元AssetRef、ForeignはEmbedRef・EmbedKind・guestDigestを持つ。"
        cons "Link/Assetはarena順に一度ずつ列挙し、その後owner embed表順にForeignを列挙する。"
        cons "同じ資源を参照する別nodeは別の要求であり、共有nodeの表示出現ごとには増やさない。"
        cons "Codeも構文のままForeignとして保持し、意味エラーを含む例の表示を可能にする。" nil
      cons paragraph
        cons sentence cons text "documentDigestは " cons code "SHA-256(\"NEPL3.Doc.Prepare.Document.v1\\0\" || canonical-NDF/1-CBOR(DocumentSyntax))" cons text "、guestDigestは " cons code "SHA-256(\"NEPL3.Doc.Prepare.Guest.v1\\0\" || canonical-NDF/1-CBOR(ForeignClosure))" cons text "。" nil
        cons sentence cons text "domainの " cons code "\\0" cons text " はゼロbyte、digestは32byte。" nil
        cons "owner環境・source・Originを含め、型名やURIだけをidentityにしない。"
        cons "Doc nodeとOrigin IDは保持し、共通codecのsource表順・guest NodeRef正準化に従う。" nil
      cons paragraph
        cons "portable planの送受信には対象DocumentSyntaxを明示し、同じ検査と要求列挙を再実行して全fieldを比較する。"
        cons "schema-validでも古い文書、欠落/追加/重複/順序違い、異なるnode/guest/digestを拒否する。"
        cons "source admissionとBudgetを操作内で共有し、停止は元StopReasonを保持する。"
        cons "native helperのPreparationErrorは構造/label/boundary/停止を区別するが、完全なcheck/prepareのReport操作包絡として広告しない。" nil
      cons paragraph
        cons "この発見段階はURIの安全性、page/fragmentの存在、asset byte列・MIME・digestの適合、guest生成物や表示言語の準備を証明しない。"
        cons "後続prepareで明示資源・解決結果を同じdocument/guest identityへ束縛し、必要条件がすべて満たされてからHTML backendへ渡す。" nil
      nil
    nil
  cons section literal "2. sentence literalの[完全/かんぜん]な[規則/きそく]" body
    cons paragraph cons "説明用EBNF:" nil
    cons rawcode some "text" "SentenceLiteral = '\"' InlineSequence '\"'\nInlineSequence  = InlineItem*\nInlineItem      = TextRun | Escape | Ruby | Anno\nRuby            = '[' NonemptySequence '/' NonemptySequence ']'\nAnno            = '{' NonemptySequence ('/' NonemptySequence)+ '}'\n"
    cons paragraph
      cons "InlineSequenceの終端集合は呼出し位置で決まる。"
      cons sentence cons text "topでは未escapeの " cons code "\"" cons text "、Rubyのbaseでは " cons code "/" cons text "、readingでは " cons code "]" cons text "、Annoの各fieldでは " cons code "/" cons text " または " cons code "}" cons text "。" nil
      cons sentence cons text "入れ子のRuby/Annoは一つのInlineItemとして読むため、内側の " cons code "/" cons text " を外側の区切りにしない。" nil nil
    cons paragraph
      cons sentence cons text "未escapeの " cons code "[" cons text " と " cons code "{" cons text " は常に注釈開始。" nil
      cons sentence cons text "対応しない " cons code "]" cons text " / " cons code "}" cons text " はエラー。" nil
      cons sentence cons text "topの " cons code "/" cons text " は通常文字。" nil
      cons sentence cons text "注釈field内のliteral " cons code "/" cons text " は " cons code "\\/" cons text " と書く。" nil
      cons "Rubyはtop-level separatorがちょうど一つ。"
      cons "Annoは一つ以上。" nil
    cons paragraph
      cons sentence cons text "escapeは通常Textのものに加え " cons code "\\[" cons text "、" cons code "\\]" cons text "、" cons code "\\{" cons text "、" cons code "\\}" cons text "、" cons code "\\/" cons text "。" nil
      cons "escapeの出力を改めて注釈開始として解析しない。"
      cons sentence cons text "直接のCR/LFは禁止、" cons code "\\n" cons text " は内容の改行。" nil
      cons "EOF・改行・終了引用符に達した時点で閉じていない注釈は、その開始位置をrelatedに持つUnclosedAnnotation。" nil
    cons paragraph
      cons "Nonemptyはlower後に可視内容が存在すること。"
      cons "空Textや空Concatだけのbase/reading/noteはEmptyAnnotationPart。"
      cons "Annoのnotesは非空。"
      cons "Sentence自体は空を許す。" nil
    cons paragraph
      cons "ここで可視内容はfontや描画幅に依存させず、保持する内容で判定する。"
      cons "Text（および明示inline code）は非空なら内容を持ち、空白だけのTextやescapeで生成した改行も含める。"
      cons "明示Break、InlineMath、inline画像は表示要素として内容を持つ。"
      cons "Concatは子のいずれか、装飾・Anchor・Reference・Linkはlabel/子、Ruby/Annoはbaseの内容を用いる。"
      cons "空要素を隠れた空白へ補うことはない。"
      cons "literal、prefix、portable constructorは同じ判定を用いる。" nil
    cons paragraph
      cons sentence cons text "例: " cons code "\"これは{[文書/ぶんしょ]/document}を記述する。\"" cons text " はText + Anno(Ruby(...),[Text]) + Text。" nil nil
    cons section linebreak "2.1. [文書構造/ぶんしょこうぞう]の[明示改行/めいじかいぎょう]" body
      cons paragraph
        cons sentence cons text "前置構文の " cons code "break" cons text "（Doc/Inline、arity 0）はDoc.Breakを構築する。" nil
        cons "同じSentence内の明示的な改行であり、新しいSentence・Paragraph・Parallel variantを作らない。"
        cons sentence cons text "例えば " cons code "sentence cons text \"a\" cons break cons text \"b\" nil" cons text " と書く。" nil
        cons sentence cons text "HTMLは" cons code "br" cons text "、plain_textはLFを出力し、source printerは" cons code "break" cons text "を保持する。" nil nil
      cons paragraph
        cons "著者が指定する文書の改行にはbreakを用いる。"
        cons sentence cons text "Text中の" cons code "\\n" cons text "は文字データのLFとして保持する既存escapeであり、Break nodeを生成しない。" nil
        cons "literalにはBreak constructorを追加せず、明示改行を含むSentenceは前置構築を使う。"
        cons "TextのLF、明示Break、Paragraph境界、表示時の自動折返しを相互に推測変換しない。" nil
      nil
    nil
  cons section equivalence "3. prefix[経路/けいろ]との[等価性/とうかせい]" body
    cons rawcode some "text" "sentence\n  cons text \"これは\"\n  cons anno\n    ruby text \"文書\" text \"ぶんしょ\"\n    cons text \"document\" nil\n  cons text \"を記述する。\"\n  nil\n"
    cons paragraph
      cons "上例と前節のliteralは、Origin/sourceを除いた意味正規形が等しい。"
      cons "正規化はConcatの平坦化、空Textの除去、同じinline列内の隣接Textの結合だけ。"
      cons "Ruby/Annoの境界、noteの順、明示Break、Math等の埋め込みは保存する。" nil
    cons paragraph
      cons "受理済みSentenceLiteralとprefix constructorの混在lowerでは、literal payloadを明示DocumentSyntax schemaとpayload自身のsource宣言で検査する。"
      cons "payloadの単一View owner/headと局所Viewは外tokenのものと一致し、意味nodeのSpanとOriginの位置は同じtoken head内、または明示SourceMapの全経路でその範囲内へ戻らなければならない。"
      cons "別tokenのpayloadや、Viewだけを合わせて意味位置を別source・別範囲へ移した値は拒否する。"
      cons "元テキストを再parseして意味値を推測し直さない。"
      cons "外側構文のOrigin IDとtoken-local View IDは保持し、literal内のOrigin参照だけを結合後のarenaへ再配置する。"
      cons "ForeignClosureのowner-local Originと環境digestにはこの再配置を適用しない。"
      cons "source admissionは操作内で共有し、payload宣言の欠落をambient source storeから補わない。" nil
    cons paragraph
      cons "意味値からliteralを出力するprinterはText/Ruby/Annoだけの表現ならescapeを行ってliteral化できる。"
      cons "他のInlineがあればprefix構文を出力する。"
      cons "内容を削除して無理にliteralにしない。"
      cons "どちらでも再parse/lower後の意味が一致することを保証する。" nil
    nil
  cons section parallel "4. parallelの[単位/たんい]" body
    cons paragraph
      cons "Sentenceは著者が明示した対応単位であり、句読点を自動検出した自然言語学的な文ではない。"
      cons "literal中に句点が二つあっても一つのSentence。"
      cons "二つのSentenceに対応させたい場合は著者が別ノードにする。" nil
    cons paragraph
      cons "Parallelはvariantのlanguageがcase-insensitiveで重複しないこと、2variant以上であることを検査する。"
      cons "空Sentenceは翻訳が空であるという明示値として許すが、missingと推測して他言語から補わない。"
      cons "並び順はソース順。"
      cons "各variantにCorrespondsTo relationを与え、名前束縛の同一性にはしない。" nil
    cons paragraph
      cons "paragraphのネスト、節番号、HTMLの行折返しはこの対応を変更しない。"
      cons "単一言語表示はRenderOptionsの指定languageに一致するvariantのみを選ぶ。"
      cons "なければMissingVariantを返すか、明示されたFallbackLanguage順で選ぶ。"
      cons "暗黙の先頭選択はしない。" nil
    nil
  cons section labels "5. ラベルと[参照/さんしょう]" body
    cons paragraph
      cons "Section.idとInline Anchor.idはarticleのDocLabel空間へ定義をexportする。"
      cons "ネストしたparagraph/sectionも同じarticle内で集める。"
      cons "重複はエラー。"
      cons "Reference.targetはarticle内から解決し、前方参照を認める。"
      cons "別articleやforeign言語へ暗黙にscopeを広げない。" nil
    cons paragraph
      cons "source上の名前の選択範囲と、定義全体の範囲を分ける。"
      cons "Referenceは表示labelを持ち、参照先の見出し文字列を自動コピーしない。"
      cons sentence cons text "HTML idは " cons code "n-" cons text " + UTF-8 byteの小文字hexとし、任意の名前から衝突なく生成する。" nil nil
    cons paragraph
      cons sentence cons code "DocNode.locations" cons text " は名前operandの位置を " cons code "DocFieldLocation" cons text " として保持する。" nil
      cons "fieldはDoc所有の閉じた種別SectionId / AnchorId / ReferenceTargetで、対応するDocKindだけに指定でき、同じfieldの重複を許さない。"
      cons "lowerは元の型付きchild/tokenからSpanとOriginを取得し、意味Stringの綴りを本文から検索して位置を作らない。"
      cons "source-less constructorでは空のlocationsまたはNoneの位置を保持する。"
      cons "存在するSpan/Originは宣言済みsource/Origin arenaを参照し、Spanは指定された定義全体cover内へ明示SourceMapを通じて包含される必要がある。"
      cons "Originも指定した場合は、その明示causeが選択Spanを支えることを検査する。"
      cons "構造検査と初回NDF decodeに同じ条件を適用し、元tokenの局所Viewは変更しない。" nil
    cons paragraph
      cons "意味nodeの共有と表示上のanchorの一意性は別である。"
      cons "同じSection/Anchor nodeへArticle rootから複数の表示経路がある場合はDuplicateOccurrenceとする。"
      cons "直接同じ子を二度参照する場合と、共有parentを介する場合の双方を含む。"
      cons "labelを含まないDAG共有は許容する。"
      cons "暗黙のID複製・改名では回避しない。"
      cons sentence cons text "経路数を2で飽和させる予算付き検査を行い、同じsource selectionを持つ二つの出現は、owner node・子の順序index・target nodeを並べた " cons code "LabelOccurrencePaths" cons text " で識別する。" nil
      cons sentence cons text "この型付き経路を通常Diagnosticの " cons code "LabelDiagnosticArguments" cons text " に含め、架空のSpanを追加しない。" nil
      cons "foreign guestの構造はこのArticleの表示経路として展開せず、そのlabelを暗黙に定義・参照へ取り込まない。" nil
    nil
  cons section embedding "6. [埋/う]め[込/こ]み" body
    cons paragraph
      cons "InlineMath / DisplayMath / CircuitFigure / Codeは、スロット種別とForeignClosureを保持する。"
      cons "ForeignClosureはForeignSyntaxに選択済みowner環境、元Origin表、source/map宣言閉包を加えた共通型である。"
      cons "環境digestに含まれる元Origin IDを保存し、guest自身のOrigin表と混同しない。"
      cons "MathやCircuitの型をdoc-coreへimportしない。" nil
    cons paragraph
      cons sentence cons text "suiteがMathの構造・bindingをcheckし、" cons link relative "17-math-html.md" none text "17章" cons text "の生成policyに従ってhostによるKaTeX生成、または独立math-mathmlの検査済みfragmentを準備する。" nil
      cons "閲覧時にKaTeXを再実行しない。"
      cons "CircuitFigureはcheck/elaborateとdiagramを使う。"
      cons "Codeは元のguest sourceとviewの表示であり、guestのlower・意味check・compile・evaluateを実行しない。"
      cons "guestがDoc自身の場合もDoc:DocGuest.syntaxはForeignClosure中のForeignSyntaxを保持し、Doc/Articleの意味値への変換を表示の前提にしない。"
      cons "bundleのschema・参照・source範囲の安全性検査は省略しない。" nil
    cons paragraph
      cons sentence cons text "標準Doc文法の " cons code "DocGuest.syntax" cons text " は " cons code "foreign Doc Article" cons text " を読む。" nil
      cons sentence cons text "表層の " cons code "Doc article ..." cons text " は変わらないが、同aliasへの入れ子でも独立guest bundleと選択された環境を保持し、終了後はhostの読取contextへ復帰する。" nil
      cons sentence cons text "Profileには標準alias " cons code "Doc" cons text " の登録が必要である。" nil
      cons "hostを別aliasへ登録してもforeign先をそのaliasへ暗黙に置換しない。"
      cons sentence cons text "同じpackageを " cons code "Doc" cons text " として明示登録するか、別名を指定する変更済み文法/packageを明示選択する。" nil
      cons "Code用Doc guestが意味的に不正な注釈やlabelを含んでも、構文が成立している限り表示のためにguestのDoc lowerを呼んで拒否しない。" nil
    cons paragraph
      cons "Docのcheckは通常構造・注釈・labelを検査し、foreign slotにはRequirementを返す。"
      cons sentence cons text "suiteが要求を解決した " cons code "PreparedArticle" cons text " だけをHTML backendへ渡す。" nil
      cons "未解決slotの空表示や文字列化による偽成功は禁止。" nil
    nil
  cons section html "7. HTML backend" body
    cons paragraph
      cons "Articleはarticle要素、titleはh1。"
      cons "Sectionはsection要素と適切な見出し。"
      cons "深さ6超はrole=headingとaria-levelを持つ要素を使う。"
      cons "Paragraphを機械的に入れ子のpへ変換しない。"
      cons "Paragraphはdiv構造、連続したSentence/Parallelのrunをpへまとめ、子Blockはrunを閉じてから出す。" nil
    cons paragraph
      cons "Sentence間へ空白を勝手に挿入しない。"
      cons "必要な空白はTextに含める。"
      cons "white-space:pre-wrapで著者の空白と明示改行を尊重する。" nil
    cons paragraph
      cons "Ruby/Annoはネスト可能なinline-gridのtyped span構造として描画し、base、上側のreading、下側のnotesを別セルへ置く。"
      cons "単純RubyにはHTML ruby/rtを使用してもよいが、semantic HTML正規形のreference backendはinline-gridへ統一する。"
      cons "CSSは配布asset、リモートfont/CDN/JSは不要。" nil
    cons paragraph
      cons "Parallelは一つのalignment wrapperにlanguageごとのsentence spanを入れる。"
      cons "横並び・縦並び・単一言語はRenderOptionsとして変える。"
      cons "DOM上に対応関係IDを保存する。" nil
    cons paragraph
      cons "全Text/属性をmarkup serializerでescapeする。"
      cons "RawHtml variantはDocに存在しない。"
      cons "外部HTMLを表示するextensionは別の明示的なtrust契約を要求する。"
      cons "token化されたHTMLをそのままinnerHTMLへ渡してはならない。" nil
    nil
  cons section public "8. [公開操作/こうかいそうさ]" body
    cons paragraph
      cons "lower(Parsed, Profile) -> DocumentSyntax + diagnostics。"
      cons "check(DocumentSyntax, LabelEnvironment) -> CheckedArticle + foreign Requirements。"
      cons "prepare(CheckedArticle, ResolvedEmbeds) -> PreparedArticle。"
      cons "render(PreparedArticle, RenderOptions) -> HtmlArtifact。"
      cons "plain_text(PlainTextRequest) -> PlainTextReply。"
      cons "print(PrintRequest) -> PrintReply。" nil
    cons paragraph
      cons "AnnotationPolicyはBaseOnly、WithReadings、WithAllNotesを明示する。"
      cons "テキスト抽出時に隠れた翻訳選択を行わない。"
      cons "各constructorはRust APIとportable record constructorの双方から呼べる。" nil
    cons section plaintext "8.1. plain_text の[実行契約/じっこうけいやく]" body
      cons paragraph
        cons sentence cons text "実操作descriptorは " cons code "nepl3.doc@1" cons text " の " cons code "plainText: PlainTextRequest -> PlainTextReply" cons text "（pure）である。" nil
        cons "要求は宣言source閉包を持つDocumentSyntax、対象SentenceRef、AnnotationPolicy、明示ResolvedInlineText列を所有する。"
        cons "SentenceRefはそのdocument内のSentenceを指す必要があり、別categoryはExpectedSentenceとなる。"
        cons "schemaとDocumentSyntax構造の不正は入力境界の型付きエラーである。"
        cons "受理済み要求の名前付き失敗はPlainTextFailureで返し、停止は準備段階も含めStoppedと元StopReasonを返す。"
        cons "成功時だけComplete.textを返す。"
        cons "Reportは同一操作のUsageを持ち、その位置参照は元要求documentの宣言source閉包に限る。"
        cons "独立返信codecにも元要求documentを明示して渡し、ambient sourceを補完しない。"
        cons "非StoppedとtraceOverflowの組合せを拒否する。" nil
      cons paragraph
        cons "BaseOnlyはRubyとAnnoのbaseだけを投影する。"
        cons sentence cons text "WithReadingsはRubyを " cons code "base[reading]" cons text " とし、Annoはbaseだけを投影する。" nil
        cons sentence cons text "WithAllNotesはRubyも同じとし、Annoを " cons code "base{note1/note2}" cons text " とする。" nil
        cons "入れ子にも同じpolicyを適用する。"
        cons "TextとInlineCodeの文字は変更せず、BreakはLFを一つ出力する。"
        cons "装飾は子inline、Anchor/Reference/Linkは明示label、InlineImageは明示alt Sentenceを投影する。"
        cons "Sentence/Concatの子間に空白を追加しない。"
        cons "この出力は再parse用sentence literalではなく、角括弧・波括弧・slashをescapeし直さない。"
        cons "任意separatorのoptionsは設けない。" nil
      cons paragraph
        cons "InlineMathは暗黙にlower・意味check・評価しない。"
        cons sentence cons text "必要な表示textはhostが " cons code "ResolvedInlineText{documentDigest,embed,guestDigest,text}" cons text " として提供する。" nil
        cons sentence cons text "documentDigestは " cons code "SHA-256(\"NEPL3.Doc.PlainText.Document.v1\\0\" || canonical-NDF/1-CBOR(DocumentSyntax))" cons text "、guestDigestは " cons code "SHA-256(\"NEPL3.Doc.PlainText.Guest.v1\\0\" || canonical-NDF/1-CBOR(ForeignClosure))" cons text " とする。" nil
        cons sentence cons text "引用内の " cons code "\\0" cons text " は一つのゼロbyte、他はASCII byteである。" nil
        cons "値はそれぞれDocの正式DocumentSyntax codecとfoundationの正式ForeignClosure codecが返すschema検査済み値であり、型を参照するSchemaRefのdigestもcanonical CBORへ含める。"
        cons "guest側はowner環境・元Origin列・source/map閉包も含み、局所EmbedRefだけの一致で別guestや古い環境のtextを再利用しない。" nil
      cons paragraph
        cons "全提供entryについて32byte digest、対象InlineMath、重複EmbedRef、現在document/guest両identityとの一致を検査する。"
        cons "policyがそのentryを表示しない場合も不正entryを黙殺しない。"
        cons "一方、未提供textによるUnresolvedEmbedは選択policyで実際に投影するInlineMathだけに適用し、BaseOnlyで隠れるreading/notesのtextを要求しない。"
        cons "hostのtextは明示データであり、guest意味checkが成功した証明ではない。" nil
      cons paragraph
        cons "identity取得のprepareは独立した操作であり、後の実行予算を支払い済みとするproofではない。"
        cons "公開実行入口plain_textは毎回同一Budget/SourceAdmissionでdocument検査、canonical値生成とhash、entry検査、出力を合成する。"
        cons "sourceは共有admissionで同snapshotを一度だけ計上し、出力byte、Work、Allocation、深さを計上する。"
        cons "停止時は元要求を変更せず、不完全なTextをCompleteへ昇格させない。" nil
      nil
    cons section print "8.2. print の[実行契約/じっこうけいやく]" body
      cons paragraph
        cons sentence cons text "実descriptorは " cons code "nepl3.doc@1" cons text " の " cons code "print: PrintRequest -> PrintReply" cons text "（pure）。" nil
        cons "PrintRequestはDocumentSyntax、PrintMode（Prefix / Compact）、明示GuestBinding列、PrintedGuest列を所有する。"
        cons sentence cons text "Completeだけが " cons code "SourceArtifact{text,entry}" cons text " を返す。" nil
        cons "entryは再parseする具体的なDoc表層categoryであり、hostがtext保存時のSourceId・revision・URIとSourceSnapshotを発行する。"
        cons "printerが架空のsnapshotや元source位置を作ることはない。"
        cons "再parse/lowerとの一致はsource/Originを除いた意味正規形について定め、未正規化のconstructor値を変更して入力へ書き戻さない。" nil
      cons paragraph
        cons "Prefixは全constructorを正式なheadと引数順で出力する。"
        cons "CompactはSentence内がText / Concat / Ruby / Annoだけで表せる場合にsentence literalへし、それ以外はprefixを保持する。"
        cons "Textは引用符・backslash・CR・LF・tabをescapeし、literalでは注釈delimiterもescapeする。"
        cons "escapeの生成文字を再び注釈と解釈しない。"
        cons "明示BreakはTextの改行と異なる意味nodeなので、Breakを含むSentenceをliteralへ変換しない。"
        cons "装飾・link・画像・Mathを省略してliteral化することもない。" nil
      cons paragraph
        cons "補助fragmentを含む表層entryは20種類である。"
        cons "guestの具体entryはMathGuest / CircuitGuest / Guestの3種類、wrapperはMath / Circuit / Grammar / Docの4種類。"
        cons sentence cons text "独立rootでは " cons code "DocKind.Guest{language,syntax}" cons text " とEmbedKind.Guestを保持し、MathGuest/CircuitGuestのrootはそのlanguageとの一致を検査する。" nil
        cons "親の埋め込みoperandへ取り込む場合はwrapper nodeを別の意味子として残さず、元ForeignClosure・View・Originを保持する。"
        cons "GrammarGuestとDocGuestはform kindであり、独立した文法category名ではない。" nil
      cons paragraph
        cons sentence cons text "NameとLangはreaderと共通の " cons code "nepl3_core::lexical" cons text " の規則で印字可能性を検査する。" nil
        cons "NameはUnicode 16 XIDと先頭underscore、Langは既存readerのRFC 5646節2.1 ABNFでありregistry上の登録や重複variant/singletonの追加制約を意味しない。"
        cons "source-less意味値の定義域をこの表層規則へ狭めず、表せない値をUnprintableName / UnprintableLanguageとして返す。"
        cons "名前の正規化・置換・本文からの位置推測は行わない。" nil
      cons paragraph
        cons sentence cons text "GuestBindingは " cons code "{schema,category,language}" cons text "。" nil
        cons "標準wrapperに対応するcategoryはMath→Expr、Circuit→Design、Grammar→Root、Doc→Articleとする。"
        cons "schemaからaliasを推測しない。"
        cons "同じschemaまたは同じlanguage（表層alias）への複数binding、カテゴリ不整合、使用するguestのbinding欠落を型付き失敗とする。"
        cons "InlineMath/DisplayMath/CircuitFigureと独立guest rootではslot/languageの制約も検査する。"
        cons "提供bindingは使用の有無によらず検査する。" nil
      cons paragraph
        cons sentence cons text "PrintedGuestは " cons code "{documentDigest,embed,guestDigest,text}" cons text "。" nil
        cons sentence cons text "documentDigestは " cons code "SHA-256(\"NEPL3.Doc.Print.Document.v1\\0\" || canonical-NDF/1-CBOR(DocumentSyntax))" cons text "、guestDigestは " cons code "SHA-256(\"NEPL3.Doc.Print.Guest.v1\\0\" || canonical-NDF/1-CBOR(ForeignClosure))" cons text " とする。" nil
        cons sentence cons code "\\0" cons text " はゼロbyte、他のdomain文字はASCIIで、正式Doc/foundation codecが返すschema検査済み値のSchemaRef digest、owner環境、元Origin表、source/map閉包を含める。" nil
        cons "全提供entryの32byte digest、EmbedRefの存在、重複、両identityを検査し、必要な印字がなければUnresolvedGuestとする。" nil
      cons paragraph
        cons "このdigestはtextがguest意味と一致することを証明しない。"
        cons "通常printの意味roundtrip保証は、hostが同じguestを扱う実printerの正しい出力を供給することを前提とする。"
        cons "raw受信やDoc coreはその意味proofを発行せず、guestのlower・意味check・評価も呼ばない。"
        cons sentence cons text "原文取得helper " cons code "original_guest_source" cons text " はroot coverに対応する保持byteを返すだけであり、coverがなければNoneとなる。" nil
        cons "構造検査済みForeignClosureにも構文と原文の一致proofはないため、通常printはこのhelperを自動fallbackとして使わない。"
        cons "host側の統合試験では実guest parserとchecked tree、generic engine printerを通し、Doc→Docの意味不正なCodeもguest構文のまま保持する。" nil
      cons paragraph
        cons "公開identity取得はhost要求の準備データであり、実行予算を支払い済みにするproofではない。"
        cons "公開printは同一Budget/SourceAdmissionでDocumentSyntax再検査、canonical値生成・digest、全entry検査と出力を合成する。"
        cons "sourceの重複計上を避け、反復処理で共有DAGの各表示経路を出力し、そのWork・出力byte・Allocation・Depthを計上する。"
        cons "停止時は元要求を変更せず、準備中も元StopReasonのStoppedとUsageを返し、途中textをCompleteへ昇格させない。"
        cons "構造/schema不正は型付き入力境界エラー、受理後の不適合はPrintFailureとなる。"
        cons "返信Reportの位置は明示要求documentの宣言source閉包だけを参照でき、独立reply codecにもそのdocumentを渡す。"
        cons "ambient補完と非StoppedのtraceOverflowを拒否する。" nil
      nil
    nil
  nil
