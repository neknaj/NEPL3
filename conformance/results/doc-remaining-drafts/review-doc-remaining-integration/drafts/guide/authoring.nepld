      cons sentence cons code "\\n" cons text "はTextのデータとしてLFを" cons ruby text "保持" text "ほじ" cons text "するescapeであり、" cons ruby text "文書構造" text "ぶんしょこうぞう" cons text "の" cons ruby text "改行" text "かいぎょう" cons text "を" cons ruby text "表" text "あらわ" cons text "す" cons ruby text "標準表記" text "ひょうじゅんひょうき" cons text "にはしない。" nil
      cons sentence cons ruby text "引用符" text "いんようふ" cons text "は " cons code "\\\"" cons text "、backslashは " cons code "\\\\" cons text "、" cons ruby text "文字" text "もじ" cons text "としての" cons ruby text "注釈区切" text "ちゅうしゃくくぎ" cons text "りは " cons code "\\[" cons text " などでescapeする。" nil
      cons "[画面幅/がめんはば]に[応/おう]じた[折返/おりかえ]しは[表示側/ひょうじがわ]に[任/まか]せる。"
      cons "[長/なが]い[一文/いちぶん]は、それだけを[理由/りゆう]に[別/べつ]の[対応単位/たいおうたんい]へ[分割/ぶんかつ]せず、[編集/へんしゅう]しにくい[場合/ばあい]に[前置構築/ぜんちこうちく]を[選/えら]ぶ。" nil
    nil
  cons section prefix "[明示的/めいじてき]なsentence[構築/こうちく]を[選/えら]ぶ[場面/ばめん]" body
    cons paragraph
