      cons "[空/から]の[段落/だんらく]や[複数/ふくすう]のbreakを[余白調整/よはくちょうせい]に[使/つか]わない。" nil
    cons rawcode some "text" "sentence\n  cons text \"ここで\"\n  cons break\n  cons ruby text \"改行\" text \"かいぎょう\"\n  cons text \"します。\"\n  nil\n"
    cons paragraph
      cons "[既存/きそん]のText[内/ない]LFやRawCodeの[元/もと]の[改行/かいぎょう]は、[内容/ないよう]を[保/たも]つためにそのまま[保持/ほじ]する。"
      cons sentence cons code "break" cons text "との" cons ruby text "自動相互変換" text "じどうそうごへんかん" cons text "はしない。" nil
      cons "Compact printerも、breakを[含/ふく]むSentenceをliteralへ[押/お]し[込/こ]まない。"
      cons sentence cons link relative "../examples/document/line-break.nepld" none concat cons ruby text "改行" text "かいぎょう" cons text "の" cons ruby text "例" text "れい" nil cons text "では、" cons ruby text "日英" text "にちえい" cons text "の" cons ruby text "対応文" text "たいおうぶん" cons text "それぞれにbreakを" cons ruby text "置" text "お" cons text "いている。" nil nil
