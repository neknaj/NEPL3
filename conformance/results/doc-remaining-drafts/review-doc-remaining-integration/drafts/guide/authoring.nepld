    cons rawcode some "text" "sentence\n  cons anno ruby text \"係数\" text \"けいすう\" cons text \"coefficient\" nil\n  cons text \"の\"\n  cons strong text \"すべて\"\n  cons text \"の\"\n  cons ruby text \"可能性\" text \"かのうせい\"\n  cons text \"を\"\n  cons ruby text \"考\" text \"かんが\"\n  cons text \"えます。\"\n  nil\n"
    cons paragraph
