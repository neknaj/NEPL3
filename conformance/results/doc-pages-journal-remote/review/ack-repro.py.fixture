from pathlib import Path
import sys,tempfile,json
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from journal import append,remote,store,load
from test_journal import event,initialize
p=Path('.tmp/journal-remote-review')
with tempfile.TemporaryDirectory() as d:
 server=Path(d).resolve()/'server.git';repo=Path(d).resolve()/'mirror.git'
 initialize(server);initialize(repo);store.git(repo,'remote','add','origin',str(server))
 first=append(repo,None,event(),b'{}');original=remote.git
 def changed_after_push(repo,*args,**kwargs):
  value=original(repo,*args,**kwargs)
  if args and args[0]=='push':append(server,first,event('external-successor'),b'{}')
  return value
 result={}
 with patch.object(remote,'git',side_effect=changed_after_push):
  try:remote.publish(repo,str(server),None,first);result['result']='accepted'
  except ValueError as ex:result['result']='rejected: '+str(ex)
 result['server_retains_successor']=len(load(server).events)==2
 print(json.dumps(result,indent=2));(p/'ack-repro.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8')
 assert result['result'].startswith('rejected: remote journal acknowledgement differs') and result['server_retains_successor']
