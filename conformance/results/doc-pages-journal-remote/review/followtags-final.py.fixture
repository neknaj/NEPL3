from pathlib import Path
import sys,tempfile,json,subprocess
sys.path.insert(0,str(Path('tools/site').resolve()))
from journal import append,remote,store
from test_journal import event,initialize
p=Path('.tmp/journal-remote-review')
with tempfile.TemporaryDirectory() as d:
 server=Path(d).resolve()/'server.git';repo=Path(d).resolve()/'mirror.git'
 initialize(server);initialize(repo);store.git(repo,'remote','add','origin',str(server))
 first=append(repo,None,event(),b'{}')
 store.git(repo,'tag','-a','unrelated-tag',first,'-m','Must remain local')
 store.git(repo,'config','push.followTags','true')
 receipt=remote.publish(repo,str(server),None,first)
 refs=store.git(server,'for-each-ref','--format=%(refname)').decode().splitlines()
 result={'remote_refs':refs,'unrequested_tag_pushed':'refs/tags/unrelated-tag' in refs,'publication_verified':receipt.publication_verified}
 print(json.dumps(result,indent=2));(p/'followtags-final.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8')

assert not result["unrequested_tag_pushed"]
