from pathlib import Path
import sys,json
from types import SimpleNamespace
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment import journal as bridge
from deployment.receipt import Receipt,observed
from deployment.transport import Result
r=Receipt('123','https://api.github.com/repos/neknaj/NEPL3/pages/deployments/123','a'*64);now=[0];calls=[]
def history(*a,**k):
 now[0]+=6
 return SimpleNamespace(head='a'*40,observations=(),receipt=r)
def fetch(*a,**k):
 calls.append(k['timeout']);raw=b'{"status":"succeed"}';return Result(observed(raw,receipt=r,request_url=r.status_endpoint),raw)
with patch.object(bridge,'status_history',history),patch.object(bridge,'record_status',return_value=('b'*40,None)):
 head,report=bridge._wait_recorded(None,'a'*40,'token',owner='neknaj',repository='NEPL3',remaining_seconds=5,clock=lambda:now[0],sleep=lambda d:None,fetch=fetch)
result={'elapsed_before_first_fetch':now[0],'supplied_remaining_seconds':5,'fetch_budgets':calls,'stop':report.stop.value,'scope':'deterministic simulated initial history-load cost'}
p=Path('.tmp/recorded-wait-review');(p/'initial-budget-final.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print(json.dumps(result,indent=2))

assert not calls and report.stop.value=="deadline"
