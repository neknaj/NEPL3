from pathlib import Path
import sys,json
from types import SimpleNamespace
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment import journal as bridge
from deployment.receipt import Receipt,observed
from deployment.transport import Result
r=Receipt('123','https://api.github.com/repos/neknaj/NEPL3/pages/deployments/123','a'*64);now=[0];calls=[];writes=[]
def history(*a,**k):
 now[0]+=2;return SimpleNamespace(head='a'*40,observations=(),receipt=r)
def fetch(*a,**k):
 calls.append(k['timeout']);raw=b'{"status":"succeed"}';return Result(observed(raw,receipt=r,request_url=r.status_endpoint),raw)
def persist(*a,**k):writes.append(a[2]);now[0]+=4;return 'b'*40,None
with patch.object(bridge,'status_history',history),patch.object(bridge,'record_status',persist):
 head,report=bridge._wait_recorded(None,'a'*40,'token',owner='neknaj',repository='NEPL3',remaining_seconds=5,clock=lambda:now[0],sleep=lambda d:None,fetch=fetch)
assert calls==[3] and head=='b'*40 and report.stop.value=='deadline' and len(report.responses)==len(writes)==1
result={'fetch_budgets':calls,'stop':report.stop.value,'saved_response_count':len(writes),'retained_response_count':len(report.responses),'saved_head_returned':head=='b'*40}
p=Path('.tmp/recorded-wait-review');(p/'persistence-budget.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print(json.dumps(result))
