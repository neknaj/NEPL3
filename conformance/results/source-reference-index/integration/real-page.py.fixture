import pathlib,subprocess,json,hashlib
root=pathlib.Path(__file__).resolve().parents[1];dest=root/'.tmp/real-page';dest.mkdir(exist_ok=True)
source=root/'doc/migration/authored/13-reproducibility.nepld'
(dest/'source.nepld').write_bytes(source.read_bytes())
(dest/'input.json').write_text(json.dumps({'version':1,'pages':[{'id':'reproducibility','input':'source.nepld','source':'doc/spec/13-reproducibility.md','route':'docs/reproducibility/index.html'}]},indent=2)+'\n',encoding='utf-8',newline='\n')
sha=lambda b:hashlib.sha256(b).hexdigest()
record={'scope':'Unchanged authored chapter 13 with registered page and external RFC links; default finite limits, no fallback/retry. Artifact equality is not canonical migration acceptance.','source_sha256':sha(source.read_bytes()),'input_sha256':sha((dest/'input.json').read_bytes()),'runs':[]}
for label,worktree in [('before',pathlib.Path('C:/projects/NEPL3-source-reference-baseline')),('after',root)]:
 binary=worktree/'target/release/nepl3-tools.exe';output=dest/(label+'-output');log=dest/(label+'.log')
 command=[str(binary),'doc-html','pages',str(dest/'input.json'),str(output)]
 with log.open('wb') as f:r=subprocess.run(command,cwd=worktree,stdout=f,stderr=subprocess.STDOUT,timeout=180)
 files=[{'path':p.relative_to(output).as_posix(),'bytes':p.stat().st_size,'sha256':sha(p.read_bytes())} for p in sorted(output.rglob('*')) if p.is_file()] if output.exists() else []
 record['runs'].append({'label':label,'commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=worktree,text=True).strip(),'binary_sha256':sha(binary.read_bytes()),'command':command,'exit_code':r.returncode,'log_sha256':sha(log.read_bytes()),'files':files})
 (dest/'results.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8',newline='\n')
 print(label,r.returncode,files,log.read_text(encoding='utf-8',errors='replace')[-1000:],flush=True)
assert all(r['exit_code']==0 for r in record['runs'])
assert record['runs'][0]['files']==record['runs'][1]['files'],'Artifact drift'
print('All emitted artifact bytes match',flush=True)
