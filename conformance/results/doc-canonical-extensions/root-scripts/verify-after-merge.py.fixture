from pathlib import Path
import subprocess,json,hashlib
root=Path(__file__).resolve().parent.parent
out=root/'.tmp/verify-canonical22'
rows=[]
for name,args in [('after-merge-check',['doc-canonical','--check']),('after-merge-html',['doc-canonical','html','.tmp/verify-canonical22/after-merge'])]:
    cmd=['cargo','run','--locked','-p','nepl3-tools','--']+args
    p=subprocess.run(cmd,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    (out/(name+'.stdout.log')).write_bytes(p.stdout)
    (out/(name+'.stderr.log')).write_bytes(p.stderr)
    rows.append(dict(command=cmd,exit_code=p.returncode))
    assert p.returncode==0,(name,p.stderr.decode('utf-8'))
    print(name,'passed',flush=True)
def files(directory):
    return {p.relative_to(directory).as_posix():p.read_bytes() for p in directory.rglob('*') if p.is_file()}
assert files(out/'first')==files(out/'after-merge')
(out/'after-merge.json').write_text(json.dumps(dict(head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),commands=rows,five_files_unchanged=True),indent=2)+'\n',encoding='utf-8')
print('All five files unchanged after PR89 integration',flush=True)
