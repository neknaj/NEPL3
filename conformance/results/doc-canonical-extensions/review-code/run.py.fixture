from pathlib import Path
import subprocess, json, hashlib, os, time
out=Path(__file__).parent; ws=out/'workspace'; env=dict(os.environ,CARGO_TARGET_DIR=str((out/'target').resolve()))
rows=[]
def run(name,cmd):
    start=time.monotonic()
    p=subprocess.run(cmd,cwd=ws,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=900)
    (out/(name+'.stdout.log')).write_bytes(p.stdout);(out/(name+'.stderr.log')).write_bytes(p.stderr)
    rows.append(dict(name=name,command=cmd,cwd=str(ws),target_dir=env['CARGO_TARGET_DIR'],exit_code=p.returncode,elapsed_seconds=time.monotonic()-start))
    (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8')
    print(name,p.returncode,flush=True);assert p.returncode==0,p.stderr.decode('utf-8','replace')[-3000:]
run('rust-version',['rustc','-Vv']);run('cargo-version',['cargo','-V'])
run('canonical-check',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','--check'])
exe=out/'target/debug/nepl3-tools.exe'
run('html-first',[str(exe.resolve()),'doc-canonical','html',str((out/'html-first').resolve())])
run('html-second',[str(exe.resolve()),'doc-canonical','html',str((out/'html-second').resolve())])
def files(folder): return {p.relative_to(folder).as_posix():p.read_bytes() for p in folder.rglob('*') if p.is_file()}
a=files(out/'html-first'); b=files(out/'html-second'); assert a==b and len(a)==5
root_first=files(out.parents[1]/'.tmp/verify-canonical22/first');assert a==root_first
result=dict(binary_sha256=hashlib.sha256(exe.read_bytes()).hexdigest(),twice_exact=True,root_generation_exact=True,files=[dict(path=k,bytes=len(v),sha256=hashlib.sha256(v).hexdigest()) for k,v in sorted(a.items())])
(out/'generation.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print('5 artifacts exact twice and root',flush=True)
