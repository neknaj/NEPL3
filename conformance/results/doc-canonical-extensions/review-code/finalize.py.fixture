from pathlib import Path
import json,hashlib,subprocess
from bs4 import BeautifulSoup
import check
out=Path(__file__).parent;root=out.parents[1];ws=out/'workspace'
def sha(b):return hashlib.sha256(b).hexdigest()
def write(name,obj): (out/name).write_text(json.dumps(obj,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
original=Path('C:/projects/NEPL3-doc-canonical-contract/.tmp/review-canonical00-cutover/independent-generated')
same=[]
for name in ['docs/spec/00-contract.html','docs/spec/13-reproducibility.html','docs/spec/assets/doc.css']:
    b=(out/'html-first'/name).read_bytes();assert b==(original/name).read_bytes();same.append(dict(path=name,sha256=sha(b)))
soup=BeautifulSoup((out/'html-first/docs/spec/22-external-extensions.html').read_text(encoding='utf8'),'html.parser')
assert len(soup.select('script'))==0
assert [x['id'] for x in soup.select('section[id]')]==check.semantic
for n in soup.select('.nepl-reading'):n.decompose()
actual=[n.get_text().replace('\n','') for n in soup.article.find_all(['h1','h2','p','li','th','td']) if not(n.name=='li' and n.find('p'))]
assert actual==check.entries(False)
write('html-content.json',dict(old00_13_css_exact=same,html_base_entries_equal=len(actual),semantic_ids=check.semantic,scripts=0))
snapshot=json.loads((out/'snapshot.json').read_bytes());expected={r['path']:r for r in json.loads((out/'dependencies.json').read_bytes())}
for row in snapshot['files']:
    if row.get('deleted'):expected.pop(row['path'])
    else:expected[row['path']]=row
for name,row in expected.items():
    b=(ws/name).read_bytes();assert sha(b)==row['sha256'] and len(b)==row['bytes'],name
actualdiff=subprocess.check_output(['git','diff','--name-only','--no-renames',snapshot['base'],snapshot['final']],cwd=root).decode().splitlines()
assert set(actualdiff)=={r['path'] for r in snapshot['files']}
diff=subprocess.run(['git','diff','--check',snapshot['base'],snapshot['final']],cwd=root,capture_output=True)
assert diff.returncode==0
(out/'diff-check.stdout.log').write_bytes(diff.stdout);(out/'diff-check.stderr.log').write_bytes(diff.stderr)
write('final-checks.json',dict(final=snapshot['final'],base=snapshot['base'],diff_paths=actualdiff,production_logic_changes=False,workspace_files_rechecked=len(expected),mutation_inputs_restored=True,diff_check_exit_code=diff.returncode))
record='''# Chapter 22 canonical source/code/content/generation review

Fixed b13f395c3874c378911ee8b686f0a55033b20e68 against 889a53ab6d678d7c9673dc716878fcbb34b9d466. No blocking finding in this bounded scope. This record does not certify public navigation, deployment, all migration acceptance, human accessibility, independent crate distribution, or process-provider completion.

I directly read the complete old Markdown, 170-line authored Doc, generated Markdown, authoring guidance, canonical host code, alias registration and previous independent meaning record. The Doc move is byte-identical to both the base authored source and Kepler's independently reviewed source (SHA 0a4b8bf7f98cfc2c75ef1e96cd4bf8e9a6dd84cb070aed7ff5f3ff70c55a64fa). The source Markdown equals both prior review and fixed GitHub input (SHA d3ea5308c7d0d79d915e4c1fcbe971fb366f3ee1ebe5d7685dad5e0c8cb53a9a). All prior manifest entries were independently length/hash verified and copied. Their pass reports were supplemental, not the sole content basis.

Whole-text comparison preserves 37 heading/paragraph/table-cell entries, separately testing plain base against old Markdown and every Ruby reading against parsed generated Markdown. The table is header + five layers, two columns; ordered list starts at 1 and contains six conditions; all four InlineCode byte values are exact. No Link, RawCode or Anno was introduced. Direct reading confirms the qualification permitting recorded common fixes/compatibility changes, monorepo/no implicit publishing authority, the five ownership layers, no reverse/direct domain dependencies, native versus portable ABI boundaries, separate package and schema compatibility, T26 prerequisites without blocking prior Doc/HTML work, path-consumer versus actual process/distribution distinction, and all six extraction conditions. Kanji-only bases and normal-literal/code-bearing sentence choices remain as independently authored. The final Circuit and wider project goals and unfinished-operation qualifications remain.

Only five no-renames paths change: registry, alias file, old authored-path deletion, exact Doc move, generated Markdown. No Rust/schema/CI/runtime changes. First two registry records are exact; new paths, route and renderer /2 bind the selected Doc. All five manual aliases equal the IDs in the retained fixed-commit server HTML; the four Section IDs map to actual generated n-UTF8hex anchors. Saved-server evidence alone does not prove navigation of the newly published page.

Fresh isolated workspace from 670 Git blobs plus the exact five-path overlay, distinct Cargo target, Rust/Cargo versions and full commands/logs retained. Actual production doc-canonical --check passed for all three selected pages. HTML generation twice produced five identical files, also exactly equal to root's fresh generation. Existing 00/13 HTML and CSS equal my earlier chapter00 independent output. New 22 HTML base text equals all 37 source entries, contains the four semantic IDs and no script. Manifest includes parse/lower/output budgets and original source identities; no limits were increased. Three actual negative canonical checks reject replacing the projection with old Markdown, dropping a legacy alias, or changing Doc bytes; inputs are not rewritten, and all fixed dependencies were rehashed after restoration.

Initial snapshot guard encountered root's commit advancing HEAD from the expected dirty base to b13f395 and stopped before copying. Final capture uses the committed clean head. Initial structural helper incorrectly used Section.label instead of the actual form's Section.id and failed after the text/code/table comparisons; check-initial.py is retained and final helper uses the formal id. These are reviewer setup failures, not successful product executions. A diagnostic terminal rendering of Japanese was console-encoded; all checked and saved source/JSON is UTF-8. No WASI/runtime regression rerun is claimed because this slice changes no implementation; independent native generation is direct evidence for the new inputs.
'''
(out/'record.md').write_text(record,encoding='utf8')
files=[]
for p in sorted(out.rglob('*')):
    if not p.is_file():continue
    rel=p.relative_to(out)
    if rel.parts[0] in ('workspace','target','__pycache__') or p.name=='manifest.json' and len(rel.parts)==1:continue
    b=p.read_bytes();files.append(dict(path=rel.as_posix(),bytes=len(b),sha256=sha(b)))
write('manifest.json',dict(scope='Fixed code/content/generation; browser cutover separate',files=files))
print('FROZEN',len(files),sum(r['bytes'] for r in files),sha((out/'manifest.json').read_bytes()))
