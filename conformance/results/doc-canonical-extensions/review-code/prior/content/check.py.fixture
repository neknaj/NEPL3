from pathlib import Path
import subprocess,hashlib,json,sys,re
import mistune
from bs4 import BeautifulSoup
r=Path(__file__).resolve().parents[2];p=Path(__file__).parent;sys.path.insert(0,str(r))
from tools.audit.structure import Parser,load_forms
head='d67e67546a0c928591e193289edb8ed702c1637e'
paths=['doc/spec/22-external-extensions.md','doc/migration/authored/22-external-extensions.nepld','doc/authoring.md','AGENTS.md','design/forms.json','design/tasks.json','design/acceptance.json','design/dependencies.json']
ids=[]
for name in paths:
 b=subprocess.check_output(['git','show',head+':'+name],cwd=r);q=p/'source'/name;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b);ids.append({'path':name,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
tree=Parser((p/'source'/paths[1]).read_text(encoding='utf8'),load_forms(r)).complete('Doc/Article')
readings=[]
def plain(n):
 if isinstance(n,list):return ''.join(map(plain,n))
 if not isinstance(n,dict):return ''
 k=n['kind'];f=n.get('fields',{})
 if k=='leaf':
  s=json.loads(n['token'])
  def sub(m):
   base,reading=m.groups();assert re.fullmatch(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3005]+',base) and reading;readings.append([base,reading]);return base
  return re.sub(r'\[([^/\[\]]+)/([^\[\]]+)\]',sub,s)
 if k=='Ruby':
  base=plain(f['base']);reading=plain(f['reading']);assert re.fullmatch(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3005]+',base);readings.append([base,reading]);return base
 if k in ('Text','InlineCode'):return f['text']
 return ''.join(plain(x) for x in f.values())
def walk(n):
 if isinstance(n,dict):
  yield n
  for x in n.get('fields',{}).values():yield from walk(x)
 elif isinstance(n,list):
  for x in n:yield from walk(x)
expected=[plain(tree['fields']['title'])]
for n in walk(tree):
 if n['kind']=='Section':expected.append(plain(n['fields']['title']))
 if n['kind']=='Paragraph':expected.append(plain(n))
 if n['kind']=='Row':expected.extend(plain(c) for c in n['fields']['cells'])
md=(p/'source'/paths[0]).read_text(encoding='utf8');html=BeautifulSoup(mistune.create_markdown(plugins=['table'])(md),'html.parser')
actual=[n.get_text().replace('\n','') for n in html.find_all(['h1','h2','p','li','th','td']) if not (n.name=='li' and n.find('p'))]
# Explicit code spacing in Doc preserves source token separators across soft line wrapping.
assert expected==actual,[(i,a,b) for i,(a,b) in enumerate(zip(expected,actual)) if a!=b]
codes=[n['fields']['text'] for n in walk(tree) if n['kind']=='InlineCode'];assert codes==[n.get_text() for n in html.find_all('code')]
assert not any(n['kind'] in ('Link','RawCode','Anno') for n in walk(tree))
(p/'result.json').write_text(json.dumps({'fixed_commit':head,'inputs':ids,'full_heading_paragraph_table_text_equal':True,'inline_codes':codes,'readings':readings,'runtime':'not-run','new_repo_release':'not-performed'},ensure_ascii=False,indent=2)+'\n',encoding='utf8');print('PASS',len(expected),len(codes))
