from pathlib import Path
import subprocess,json,hashlib
out=Path(__file__).parent;ws=out/'workspace';exe=(out/'target/debug/nepl3-tools.exe').resolve()
def sha(b):return hashlib.sha256(b).hexdigest()
rows=[]
for name,path,replace in [
    ('old-markdown-is-stale','doc/spec/22-external-extensions.md',lambda b:(out/'before/doc/spec/22-external-extensions.md').read_bytes()),
    ('missing-legacy-alias','doc/migration/aliases/22-external-extensions.json',lambda b:(json.dumps(json.loads(b)[:-1],ensure_ascii=False)+'\n').encode()),
    ('changed-doc-source','doc/spec/22-external-extensions.nepld',lambda b:b.replace(b'monorepo',b'MONOREPO',1)),
]:
    p=ws/path;before=p.read_bytes();altered=replace(before);assert altered!=before
    q=out/'mutations'/name;q.mkdir(parents=True,exist_ok=True);(q/'input').write_bytes(altered)
    p.write_bytes(altered)
    try:
        cmd=[str(exe),'doc-canonical','--check'];r=subprocess.run(cmd,cwd=ws,capture_output=True,timeout=120)
        (q/'stdout.log').write_bytes(r.stdout);(q/'stderr.log').write_bytes(r.stderr)
        assert r.returncode!=0 and b'stale generated Markdown: doc/spec/22-external-extensions.md' in r.stderr
        assert p.read_bytes()==altered
        rows.append(dict(name=name,path=path,command=cmd,exit_code=r.returncode,before_sha256=sha(before),altered_sha256=sha(altered),input_not_rewritten=True))
    finally:p.write_bytes(before)
(out/'boundaries.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8')
print('PASS three actual canonical stale failures, no writes')
