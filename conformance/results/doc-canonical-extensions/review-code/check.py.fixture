from pathlib import Path
import sys, json, re, hashlib, subprocess
import mistune
from bs4 import BeautifulSoup
out=Path(__file__).parent;ws=out/'workspace';sys.path.insert(0,str(ws))
from tools.audit.structure import Parser,load_forms
def sha(b):return hashlib.sha256(b).hexdigest()
doc=(ws/'doc/spec/22-external-extensions.nepld').read_bytes()
assert doc==(out/'before/doc/migration/authored/22-external-extensions.nepld').read_bytes()==(out/'prior/content/source/doc/migration/authored/22-external-extensions.nepld').read_bytes()
assert sha(doc)=='0a4b8bf7f98cfc2c75ef1e96cd4bf8e9a6dd84cb070aed7ff5f3ff70c55a64fa'
old=(out/'before/doc/spec/22-external-extensions.md').read_bytes()
assert old==(out/'prior/legacy-anchors/source.md').read_bytes()==(out/'prior/content/source/doc/spec/22-external-extensions.md').read_bytes()
tree=Parser(doc.decode(),load_forms(ws)).complete('Doc/Article')
readings=[]
def plain(n,annotated=False):
    if isinstance(n,list):return ''.join(plain(v,annotated) for v in n)
    if not isinstance(n,dict):return ''
    k=n['kind'];f=n.get('fields',{})
    if k=='leaf':
        text=json.loads(n['token'])
        def sub(m):
            base,reading=m.groups()
            assert re.fullmatch(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3005]+',base)
            assert reading
            if not annotated:readings.append([base,reading])
            return base+'['+reading+']' if annotated else base
        return re.sub(r'\[([^/\[\]]+)/([^\[\]]+)\]',sub,text)
    if k=='Ruby':
        base=plain(f['base'],annotated);reading=plain(f['reading'],annotated)
        assert re.fullmatch(r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3005]+',base)
        if not annotated:readings.append([base,reading])
        return base+'['+reading+']' if annotated else base
    if k in ('Text','InlineCode'):return f['text']
    return ''.join(plain(v,annotated) for v in f.values())
def walk(n):
    if isinstance(n,dict):
        yield n
        for v in n.get('fields',{}).values():yield from walk(v)
    elif isinstance(n,list):
        for v in n:yield from walk(v)
nodes=list(walk(tree))
def entries(annotated):
    result=[plain(tree['fields']['title'],annotated)]
    for n in nodes:
        if n['kind']=='Section':result.append(plain(n['fields']['title'],annotated))
        if n['kind']=='Paragraph':result.append(plain(n,annotated))
        if n['kind']=='Row':result.extend(plain(v,annotated) for v in n['fields']['cells'])
    return result
md=mistune.create_markdown(escape=False,plugins=['table'])
generated=(ws/'doc/spec/22-external-extensions.md').read_bytes()
views=[BeautifulSoup(md(x.decode()),'html.parser') for x in [old,generated]]
comparisons=[]
for mode,soup in zip([False,True],views):
    actual=[n.get_text().replace('\n','') for n in soup.find_all(['h1','h2','p','li','th','td']) if not(n.name=='li' and n.find('p')) and n.get_text().strip()]
    expected=entries(mode)
    assert actual==expected,[(i,a,b) for i,(a,b) in enumerate(zip(actual,expected)) if a!=b]
    assert len(soup.find_all('table'))==1 and len(soup.select('table tr'))==6
    assert all(len(row.find_all(['td','th'],recursive=False))==2 for row in soup.select('table tr'))
    assert len(soup.select('ol'))==1 and len(soup.select('ol > li'))==6 and soup.ol.get('start','1')=='1'
    codes=[n['fields']['text'] for n in nodes if n['kind']=='InlineCode']
    assert [n.get_text() for n in soup.find_all('code')]==codes
    comparisons.append(dict(annotated=mode,entries=len(actual),table_rows=6,table_columns=2,list_items=6,codes=codes))
assert len(codes)==4 and not any(n['kind'] in ('Link','RawCode','Anno') for n in nodes)
registry=json.loads((ws/'doc/canonical.json').read_bytes());previous=json.loads((out/'before/doc/canonical.json').read_bytes())
assert registry['version']==previous['version'] and registry['pages'][:2]==previous['pages'] and len(registry['pages'])==3
assert registry['pages'][2]==dict(id='external-extensions',source='doc/spec/22-external-extensions.nepld',projection='doc/spec/22-external-extensions.md',aliases='doc/migration/aliases/22-external-extensions.json',route='docs/spec/22-external-extensions.html',renderer='nepl3-tools.markdown-annotated/2')
aliasbytes=(ws/'doc/migration/aliases/22-external-extensions.json').read_bytes();aliases=json.loads(aliasbytes)
assert len(aliases)==5
legacy=BeautifulSoup((out/'prior/legacy-anchors/richText.html').read_bytes(),'html.parser')
server=BeautifulSoup((out/'prior/legacy-anchors/github.html').read_bytes(),'html.parser')
oldnames=[n['id'].removeprefix('user-content-') for n in legacy.select('a[id^="user-content-"]')]
assert [a['name'] for a in aliases]==oldnames
assert all(server.find(id='user-content-'+name) for name in oldnames)
assert '\n'.join(json.loads((out/'prior/legacy-anchors/rawLines.json').read_bytes()))+'\n'==old.decode()
sections=[n['fields']['id'] for n in nodes if n['kind']=='Section']
assert sections==['boundary','units','compatibility','stages']==[a['section'] for a in aliases[1:]]
semantic=['n-'+s.encode().hex() for s in sections]
expectedanchors=[aliases[0]['name']]+[a for sem,item in zip(semantic,aliases[1:]) for a in [sem,item['name']]]
assert [a['name'] for a in views[1].find_all('a',attrs={'name':True})]==expectedanchors
assert len(expectedanchors)==len(set(expectedanchors))==9
assert sha(doc) in generated.decode() and sha(aliasbytes) in generated.decode()
assert generated.endswith(b'\n') and not generated.endswith(b'\n\n')
(out/'comparison.json').write_text(json.dumps(dict(status='PASS',comparisons=comparisons,readings=readings,legacy_anchors=oldnames,emitted_anchors=expectedanchors,doc_sha256=sha(doc),old_md_sha256=sha(old),generated_sha256=sha(generated),aliases_sha256=sha(aliasbytes),mistune=mistune.__version__,scope='Direct whole-text reading supplemented by structural and parsed Markdown comparisons. Saved fixed GitHub HTML identity; no new browser navigation.'),ensure_ascii=False,indent=2)+'\n',encoding='utf8')
print('PASS old and annotated',comparisons)
