from pathlib import Path
import json,hashlib,re,subprocess,sys
from playwright.sync_api import sync_playwright
out=Path(__file__).parent;box=out/'bootstrap-sandbox'
script=out/'restore-exact-readme.py'
readme=(out/'source/README.md').read_text(encoding='utf8')
assert script.read_text(encoding='utf8')==re.findall(r'```python\n(.*?)```',readme,re.S)[0]
cmd=[sys.executable,str(script)];p=subprocess.run(cmd,cwd=box,capture_output=True,timeout=30)
(out/'restore.stdout.log').write_bytes(p.stdout);(out/'restore.stderr.log').write_bytes(p.stderr);assert p.returncode==0
artifact=box/'dist/canonical22-snapshot'
def files(d):return {p.relative_to(d).as_posix():p.read_bytes() for p in d.rglob('*') if p.is_file()}
a=files(artifact);b=files(out/'independent-generated');assert a==b and len(a)==5
rows=[]
with sync_playwright() as p:
    for engine in ['chromium','firefox','webkit']:
        browser=getattr(p,engine).launch();context=browser.new_context(java_script_enabled=False);page=context.new_page();network=[]
        def block(route):network.append(route.request.url);route.abort()
        context.route(re.compile(r'^https?://'),block)
        page.goto((artifact/'docs/spec/22-external-extensions.html').as_uri(),wait_until='load')
        v=page.evaluate('''()=>({scripts:document.scripts.length,ruby:document.querySelectorAll('.nepl-ruby').length,headings:document.querySelectorAll('h1,h2,h3').length,lists:[...document.querySelectorAll('ol')].map(n=>n.children.length),table:[...document.querySelectorAll('table tr')].map(n=>n.children.length),background:getComputedStyle(document.querySelector('article')).backgroundColor,css:[...document.querySelectorAll('link[rel=stylesheet]')].map(n=>!!n.sheet)})''')
        assert not network and v['scripts']==0 and v['ruby']==324 and v['headings']==5 and v['lists']==[6] and v['table']==[2]*6 and v['background']=='rgb(13, 17, 23)' and v['css']==[True]
        rows.append(dict(engine=engine,version=browser.version,measurement=v,http_requests=network,passed=True));context.close();browser.close()
result=dict(command=cmd,cwd=str(box),exit_code=0,readme_sha256=hashlib.sha256((out/'source/README.md').read_bytes()).hexdigest(),files=[dict(path=k,bytes=len(v),sha256=hashlib.sha256(v).hexdigest()) for k,v in sorted(a.items())],rows=rows)
(out/'bootstrap.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf8');print('5 exact README-restored files; three JS-disabled offline browser passes')
