from pathlib import Path
import json,hashlib,shutil,re
out=Path(__file__).parent;root=out.parents[1];code=root/'.tmp/review-canonical22-code'
def sha(b):return hashlib.sha256(b).hexdigest()
rows=[]
def copy(src,dest):
    b=src.read_bytes();p=out/dest;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b)
    rows.append(dict(source=str(src),path=Path(dest).as_posix(),bytes=len(b),sha256=sha(b)))
for name in ['snapshot.json','manifest.json','generation.json','commands.json','rust-version.stdout.log','cargo-version.stdout.log','canonical-check.stdout.log','canonical-check.stderr.log','html-first.stdout.log','html-first.stderr.log','html-second.stdout.log','html-second.stderr.log','comparison.json','html-content.json','record.md']:
    copy(code/name,Path('code-generation')/name)
for folder in ['verify-canonical22','github-canonical22','browser-canonical22','bootstrap-canonical22']:
    for p in (root/'.tmp'/folder).rglob('*'):
        if p.is_file():copy(p,Path('original')/folder/p.relative_to(root/'.tmp'/folder))
for name in ['doc/canonical.json','doc/spec/22-external-extensions.md','doc/spec/22-external-extensions.nepld','doc/migration/aliases/22-external-extensions.json']:
    copy(code/'workspace'/name,Path('source')/name)
for p in (code/'html-first').rglob('*'):
    if p.is_file():copy(p,Path('independent-generated')/p.relative_to(code/'html-first'))
archive=root/'conformance/results/doc-canonical-extensions'
copy(archive/'README.md','source/README.md');copy(archive/'payloads.json','source/payloads.json')
idx=json.loads((archive/'payloads.json').read_bytes());selected=[e for e in idx['files'] if e['owner']=='root-verification' and e['restore'].startswith('first/')];assert len(selected)==5
for row in selected:
    b=(archive/row['file']).read_bytes();assert len(b)==row['bytes'] and sha(b)==row['sha256']
    copy(archive/row['file'],Path('bootstrap-sandbox/conformance/results/doc-canonical-extensions')/row['file'])
copy(archive/'payloads.json','bootstrap-sandbox/conformance/results/doc-canonical-extensions/payloads.json')
fences=re.findall(r'```python\n(.*?)```',(out/'source/README.md').read_text(encoding='utf8'),re.S);assert len(fences)==1
(out/'restore-exact-readme.py').write_text(fences[0],encoding='utf8',newline='\n')
(out/'original-files.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
print('FROZEN',len(rows),'original files, five compiler-free payloads')
