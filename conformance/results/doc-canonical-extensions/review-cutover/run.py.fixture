from pathlib import Path
import subprocess,json,sys,time
out=Path(__file__).parent;name=sys.argv[1]
py=Path('C:/projects/NEPL3-doc-canonical-preview/.tmp/browser-venv/Scripts/python.exe')
cmd=[str(py),str(out/(name+'.py'))];start=time.monotonic()
try:
    p=subprocess.run(cmd,cwd=out,capture_output=True,timeout=600)
    stdout=p.stdout;stderr=p.stderr;status=p.returncode
except subprocess.TimeoutExpired as e:
    stdout=e.stdout or b'';stderr=e.stderr or b'';status='timeout'
(out/(name+'.stdout.log')).write_bytes(stdout);(out/(name+'.stderr.log')).write_bytes(stderr)
(out/(name+'.command.json')).write_text(json.dumps(dict(command=cmd,cwd=str(out),deadline_seconds=600,exit_code=status,elapsed=time.monotonic()-start),indent=2)+'\n',encoding='utf8')
print(name,status,stdout.decode('utf8','replace'),stderr.decode('utf8','replace'),flush=True)
assert status==0
