s=s.replace("record.update(browser=b.version,raw_lines_match=True,status=response.status)","""record.update(browser=b.version,raw_lines_match=True,status=response.status)
        rawurl=f'https://raw.githubusercontent.com/neknaj/NEPL3/{head}/doc/spec/22-external-extensions.md'
