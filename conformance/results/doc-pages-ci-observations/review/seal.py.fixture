from pathlib import Path
import hashlib,json
p=Path('.tmp/ci-observations-review')
with (p/'review.md').open('a',encoding='utf8',newline='\n') as f:f.write('\nFinal deployment/README.md observation section was independently reviewed and matches the fixed routes, response cap, isolated child, error sanitization and non-atomic/semantic eligibility limitations. Parent live authenticated successes are not relabeled as this reviewer\'s live network tests; existing 100-test suite predates this module.\n')
for name in ['tools/site/deployment/observations/__init__.py','tools/site/deployment/observations/worker.py','tools/site/test_ci_observations.py','tools/site/deployment/README.md','tools/site/deployment/transport.py']:
 f=p/'source'/name;f.parent.mkdir(parents=True,exist_ok=True);f.write_bytes(Path(name).read_bytes())
rows=[]
for f in sorted(p.rglob('*')):
 if f.is_file() and f.name!='manifest.json':
  b=f.read_bytes();rows.append(dict(path=f.relative_to(p).as_posix(),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
(p/'manifest.json').write_text(json.dumps(dict(files=rows),indent=2)+'\n',encoding='utf8');print(len(rows),sum(r['bytes'] for r in rows))
