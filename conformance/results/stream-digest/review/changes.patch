+pub(super) fn digest(
+    domain: &[u8],
+    item: &NdfValue,
+    budget: &mut Budget,
+) -> Result<Digest, WireError> {
+    budget.charge(Resource::OutputBytes, 32)?;
+    budget.charge(Resource::Work, domain.len() as u64)?;
+    let mut hash = Sha256::new();
+    hash.update(domain);
+    emit(item, &mut hash, budget)?;
+    Ok(Digest(hash.finalize().into()))
+}
