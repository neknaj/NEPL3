{
  "schema": "nepl3.acceptance-catalog/1",
  "design_revision": "nepl3-design-2026-09-06-r4",
  "targets": {
    "baremetal-armv6m-build": {
      "description": "Production foundation compiled into thumbv6m-none-eabi RP2040 firmware; record compiler, source and firmware identities; compilation does not imply execution",
      "kind": "command"
    },
    "baremetal-rp2040-rp2040js": {
      "description": "Exact identified UF2 executed from vector entry under pinned rp2040js; initial four core/wire checks only; not boot ROM, peripherals, full reader/engine or hardware acceptance",
      "kind": "command"
    },
    "wasi-wasip2-pulley64": {
      "description": "Same wasm32-wasip2 foundation component compared under Wasmtime native codegen and Pulley64 interpreter; not an independent compiler implementation",
      "kind": "command"
    },
    "native-x86_64-linux": {
      "description": "x86_64-unknown-linux-gnu native runner; log OS, compiler and runner versions",
      "kind": "command"
    },
    "native-x86_64-windows": {
      "description": "x86_64-pc-windows-msvc native runner; log OS, compiler and runner versions",
      "kind": "command"
    },
    "native-aarch64-macos": {
      "description": "aarch64-apple-darwin native runner; log OS, compiler and runner versions",
      "kind": "command"
    },
    "wasi-wasip2-wasmtime": {
      "description": "wasm32-wasip2 executed by version-pinned Wasmtime; build alone is not a run",
      "kind": "command"
    },
    "browser-chromium": {
      "description": "wasm32-unknown-unknown in real Chromium browser; log exact browser and automation versions",
      "kind": "command"
    },
    "browser-firefox": {
      "description": "wasm32-unknown-unknown in real Firefox browser; log exact browser and automation versions",
      "kind": "command"
    },
    "browser-webkit": {
      "description": "wasm32-unknown-unknown in real WebKit browser; log exact browser and automation versions; does not imply Safari device QA",
      "kind": "command"
    },
    "host-repository": {
      "description": "tracked source, metadata, dependency DAG and every implemented core no_std target checks on development host",
      "kind": "command"
    },
    "static-build-linux": {
      "description": "pinned site renderer and tools on Linux; deterministic offline build of current documentation inputs",
      "kind": "command"
    },
    "static-http-nonroot": {
      "description": "HTTP-served generated site tested under /NEPL3/ and /acceptance/project/ with direct deep links",
      "kind": "command"
    },
    "github-pages-https": {
      "description": "deployed GitHub Pages HTTPS environment, exact artifact and commit identity checked after deployment",
      "kind": "command"
    },
    "semantic-review": {
      "description": "independent human-readable semantic review of every migrated page against recorded original and mapping",
      "kind": "review"
    }
  },
  "groups": [
