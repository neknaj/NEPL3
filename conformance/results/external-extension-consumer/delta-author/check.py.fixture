from pathlib import Path
import re,json,difflib
r=Path('.tmp/author-extension-deltas')
p=Path('doc/migration/authored/11-conformance.nepld')
s=p.read_text(encoding='utf-8');block=s[s.index('    cons list unordered'):s.index('    cons list unordered',s.index('    cons list unordered')+1)]
parts=re.findall(r'cons "((?:[^"\\]|\\.)*)"',block)
plain=[re.sub(r'\[([^\[\]/]+)/[^\[\]]+\]',r'\1',v) for v in parts]
canonical=Path('doc/spec/11-conformance.md').read_text(encoding='utf-8')
expected=[v for v in canonical.splitlines() if v.startswith(('X01:','X02:'))]
assert [''.join(plain[:3]),''.join(plain[3:])]==expected
paths=['doc/migration/authored/guide/README.nepld','doc/migration/authored/01-architecture.nepld','doc/migration/authored/11-conformance.nepld']
checks=[]
for name in paths:
 before=(r/'before'/name).read_bytes(); after=Path(name).read_bytes()
 assert b'\r' not in after and not after.startswith(b'\xef\xbb\xbf')
 a=before.decode().splitlines(keepends=True);b=after.decode().splitlines(keepends=True)
 edits=[(tag,i,j,k,l) for tag,i,j,k,l in difflib.SequenceMatcher(a=a,b=b,autojunk=False).get_opcodes() if tag!='equal']
 assert all(tag=='insert' for tag,*_ in edits),(name,edits)
 checks.append({'path':name,'edits':edits})
 q=r/'after'/name;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(after)
(r/'author-check.json').write_text(json.dumps({'X01_X02_plain_text_exact':True,'old_lines_unchanged':checks,'utf8_lf_no_bom':True,'scope':'author self-check, independent review pending'},indent=2),encoding='utf-8')
print(checks)
