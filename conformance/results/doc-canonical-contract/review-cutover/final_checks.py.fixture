from pathlib import Path
from urllib.request import urlopen
import hashlib,json,subprocess
O=Path(__file__).resolve().parent;R=O.parents[1]
head='4895c1a6a94660a43e617ed86a21844838a7324d';merged='6e7ab06197c412d28305a174a54deda355daa790'
url=f'https://raw.githubusercontent.com/neknaj/NEPL3/{head}/doc/spec/00-contract.md'
with urlopen(url,timeout=45) as response: b=response.read();status=response.status
assert b==(O/'source/doc/spec/00-contract.md').read_bytes()
(O/'independent-github/raw-projection.md').write_bytes(b)
paths=subprocess.check_output(['git','diff','--name-only',head,merged],cwd=R).decode().splitlines()
assert len(paths)==142 and all(p.startswith('conformance/results/doc-annotated-blocks/') for p in paths)
record=dict(remote_raw=dict(url=url,status=status,bytes=len(b),sha256=hashlib.sha256(b).hexdigest(),exact_bytes_including_terminal_LF=True),merge=dict(before=head,after=merged,changed_paths=paths,production_and_inputs_unchanged=True))
(O/'final-checks.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8',newline='\n');print('fixed public raw bytes and archive-only merge passed')
