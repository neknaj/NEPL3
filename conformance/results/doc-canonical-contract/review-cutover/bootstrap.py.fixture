from pathlib import Path
import json,hashlib,re,subprocess,sys
from playwright.sync_api import sync_playwright
O=Path(__file__).resolve().parent;R=O.parents[1];A=R/'conformance/results/doc-canonical-contract';S=O/'bootstrap-sandbox';S.mkdir(exist_ok=True)
def copy(src,dst):dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(src.read_bytes())
for n in ['README.md','payloads.json']:copy(A/n,S/'conformance/results/doc-canonical-contract'/n)
readme=(A/'README.md').read_text(encoding='utf-8');matches=re.findall(r'```python\n(.*?)\n```',readme,re.S);assert len(matches)==1
script=matches[0]+'\n';(O/'restore-exact-readme.py').write_text(script,encoding='utf-8',newline='\n')
entries=json.loads((A/'payloads.json').read_bytes())['files'];selected=[e for e in entries if e['owner']=='root-verification' and e['restore'].startswith('first/')];assert len(selected)==4
for e in selected:copy(A/e['file'],S/'conformance/results/doc-canonical-contract'/e['file'])
cmd=[sys.executable,str(O/'restore-exact-readme.py')];p=subprocess.run(cmd,cwd=S,capture_output=True,timeout=30);(O/'restore.stdout.log').write_bytes(p.stdout);(O/'restore.stderr.log').write_bytes(p.stderr);assert p.returncode==0
artifact=S/'dist/canonical00-snapshot';original=O/'independent-generated'
a={p.relative_to(artifact).as_posix():p.read_bytes() for p in artifact.rglob('*') if p.is_file()};b={p.relative_to(original).as_posix():p.read_bytes() for p in original.rglob('*') if p.is_file()};assert a==b
rows=[]
with sync_playwright() as p:
    for engine in ['chromium','firefox','webkit']:
        browser=getattr(p,engine).launch();context=browser.new_context(java_script_enabled=False);page=context.new_page();network=[]
        def block(route):network.append(route.request.url);route.abort()
        context.route(re.compile(r'^https?://'),block)
        page.goto((artifact/'docs/spec/00-contract.html').as_uri(),wait_until='load')
        v=page.evaluate('''()=>({scripts:document.scripts.length,ruby:document.querySelectorAll('.nepl-ruby').length,headings:document.querySelectorAll('h1,h2,h3').length,lists:[...document.querySelectorAll('ul')].map(n=>n.children.length),background:getComputedStyle(document.querySelector('article')).backgroundColor,css:[...document.querySelectorAll('link[rel=stylesheet]')].map(n=>!!n.sheet)})''')
        assert not network and v['scripts']==0 and v['ruby']==277 and v['headings']==7 and v['lists']==[4,6,14] and v['background']=='rgb(13, 17, 23)' and v['css']==[True]
        rows.append(dict(engine=engine,version=browser.version,measurement=v,http_requests=network,passed=True));context.close();browser.close()
for f in (R/'.tmp/bootstrap-canonical00').iterdir():
    if f.is_file():copy(f,O/'original/bootstrap-canonical00'/f.name)
result=dict(command=cmd,cwd=str(S),exit_code=0,readme_sha256=hashlib.sha256((A/'README.md').read_bytes()).hexdigest(),payload_index_sha256=hashlib.sha256((S/'conformance/results/doc-canonical-contract/payloads.json').read_bytes()).hexdigest(),files=[dict(path=p,bytes=len(v),sha256=hashlib.sha256(v).hexdigest()) for p,v in a.items()],rows=rows)
(O/'bootstrap.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8',newline='\n');print('exact README restore + JS disabled file URL three engines passed')
