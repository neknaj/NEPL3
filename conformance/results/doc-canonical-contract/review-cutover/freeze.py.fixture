from pathlib import Path
import hashlib,json,shutil,subprocess
O=Path(__file__).resolve().parent;R=O.parents[1];head='4895c1a6a94660a43e617ed86a21844838a7324d'
rows=[]
def copy(src,dst):
    b=src.read_bytes();dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(b)
    rows.append(dict(original=str(src),path=dst.relative_to(O).as_posix(),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
for name in ['github-canonical00','browser-canonical00','verify-canonical00']:
    for p in sorted((R/'.tmp'/name).rglob('*')):
        if p.is_file():copy(p,O/'original'/name/p.relative_to(R/'.tmp'/name))
for name in ['github-canonical00.py','browser-canonical00.py','verify-canonical00.py']:copy(R/'.tmp'/name,O/'original'/name)
for p in ['doc/spec/00-contract.md','doc/spec/00-contract.nepld','doc/migration/aliases/00-contract.json','doc/canonical.json']:
    b=subprocess.check_output(['git','show',head+':'+p],cwd=R)
    target=O/'source'/p;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(b)
    assert (R/p).read_bytes()==b
first=O/'original/verify-canonical00/first';second=O/'original/verify-canonical00/second'
a={p.relative_to(first).as_posix():p.read_bytes() for p in first.rglob('*') if p.is_file()};b={p.relative_to(second).as_posix():p.read_bytes() for p in second.rglob('*') if p.is_file()};assert a==b
manifest=json.loads(a['manifest.json'])
for item in manifest['files']:assert hashlib.sha256(a[item['path']]).hexdigest()==item['sha256']
(O/'original-files.json').write_text(json.dumps(dict(head=head,files=rows,html_runs_exact=True,html_files=len(a)),indent=2)+'\n',encoding='utf-8',newline='\n')
print(len(rows),'original payloads fixed')
