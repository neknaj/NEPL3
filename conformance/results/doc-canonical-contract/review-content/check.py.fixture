from pathlib import Path
import hashlib,json,subprocess,sys
from bs4 import BeautifulSoup,NavigableString
import mistune
r=Path(__file__).resolve().parents[2];p=Path(__file__).parent;sys.path.insert(0,str(r))
from tools.audit.structure import Parser,load_forms
def sha(b):return hashlib.sha256(b).hexdigest()
paths={'source':'tools/migration/fixtures/00-contract.md','draft':'doc/spec/00-contract.nepld','projection':'doc/spec/00-contract.md','html':'.tmp/verify-canonical00/first/docs/spec/00-contract.html','aliases':'doc/migration/aliases/00-contract.json','guidance':'doc/authoring.md'}
identity={}
for name,path in paths.items():
 b=(r/path).read_bytes();(p/name).write_bytes(b);identity[name]={'path':path,'bytes':len(b),'sha256':sha(b)}
assert (p/'source').read_bytes()==subprocess.check_output(['git','show','a163764:doc/spec/00-contract.md'],cwd=r)
assert sha((p/'draft').read_bytes())=='48c2b1696c7308ee43f26dbf06a6038b38f0199233c1da3ef15a04453f810e93'
pre=r.parent/'NEPL3-doc-block-projection/.tmp/preflight-canonical00'
for name in ['github.html','result.json','initial-review-review.md','ruby-review-review.md','initial-review-manifest.json','ruby-review-manifest.json']:(p/('prior-'+name)).write_bytes((pre/name).read_bytes())
tree=Parser((p/'draft').read_text(encoding='utf8'),load_forms(r)).complete('Doc/Article')
def lit(token):
 s=token[1:-1];i=0
 def rec(ends=''):
  nonlocal i
  out=''
  while i<len(s) and s[i] not in ends:
   c=s[i];i+=1
   if c=='\\':c=s[i];i+=1;out+=dict(n='\n',t='\t',r='\r').get(c,c)
   elif c in '[{':
    end=']' if c=='[' else '}';parts=[rec('/'+end)]
    while s[i]!=end:i+=1;parts.append(rec('/'+end))
    i+=1;out+=parts[0]+c+'/'.join(parts[1:])+end
   else:out+=c
  return out
 return rec()
def text(n):
 if isinstance(n,list):return ''.join(map(text,n))
 if not isinstance(n,dict):return ''
 k=n['kind'];f=n.get('fields',{})
 if k=='leaf':return lit(n['token'])
 if k in ('Text','InlineCode'):return f['text']
 if k=='Ruby':return text(f['base'])+'['+text(f['reading'])+']'
 if k=='Anno':return text(f['base'])+'{'+'/'.join(map(text,f['notes']))+'}'
 return ''.join(text(x) for x in f.values())
def walk(n):
 if isinstance(n,dict):
  yield n
  for x in n.get('fields',{}).values():yield from walk(x)
 elif isinstance(n,list):
  for x in n:yield from walk(x)
expected=[text(tree['fields']['title'])]
for n in walk(tree):
 if n['kind']=='Section':expected.append(text(n['fields']['title']))
 if n['kind']=='Paragraph':expected.append(text(n))
md=BeautifulSoup(mistune.create_markdown(escape=False)( (p/'projection').read_text(encoding='utf8')),'html.parser')
got=[n.get_text() for n in md.find_all(['h1','h2','p','li']) if n.get_text() and not (n.name=='li' and n.find('p'))]
assert got==expected,[(i,a,b) for i,(a,b) in enumerate(zip(expected,got)) if a!=b]
html=BeautifulSoup((p/'html').read_bytes(),'html.parser')
def htmltext(n):
 if isinstance(n,NavigableString):return str(n)
 classes=n.get('class',[])
 if 'nepl-ruby' in classes:return htmltext(n.select_one(':scope > .nepl-base'))+'['+htmltext(n.select_one(':scope > .nepl-reading'))+']'
 if 'nepl-anno' in classes:return htmltext(n.select_one(':scope > .nepl-base'))+'{'+'/'.join(htmltext(x) for x in n.select(':scope > .nepl-notes > .nepl-note'))+'}'
 return ''.join(htmltext(c) for c in n.children)
actual=[htmltext(n) for n in html.find_all(['h1','h2','p'])]
assert actual==expected
codes=[n['fields']['text'] for n in walk(tree) if n['kind']=='InlineCode'];assert codes==['cons','nil','v1','Fn','value','splice','call','map','then','design/forms.json']
assert [n.get_text() for n in md.find_all('code')]==codes==[n.get_text() for n in html.find_all('code')]
assert [len(n.find_all('li',recursive=False)) for n in md.find_all('ul')]==[4,6,14]
assert [len(n.find_all('li',recursive=False)) for n in html.find_all('ul')]==[4,6,14]
old=BeautifulSoup((p/'prior-github.html').read_bytes(),'html.parser');aliases=json.loads((p/'aliases').read_bytes())
for row in aliases:
 assert old.find(id='user-content-'+row['name']) is not None,row
 assert len(md.find_all('a',attrs={'name':row['name']}))==1,row
for i in range(1,15):assert sum(('INV%02d'%i) in x for x in expected)==1
(p/'result.json').write_text(json.dumps({'identities':identity,'all_annotated_heading_paragraph_text_equal':True,'inline_code':codes,'list_counts':[4,6,14],'old_anchor_mappings':7,'new_GitHub_navigation':'not-checked','runtime_rerun':False},ensure_ascii=False,indent=2)+'\n',encoding='utf8')
print('PASS: full annotated text, codes, lists, invariant IDs and seven legacy mappings')
