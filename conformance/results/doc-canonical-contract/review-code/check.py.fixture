from pathlib import Path
import ast, hashlib, json, subprocess, shutil, sys
R=Path(__file__).resolve().parents[2]
O=Path(__file__).resolve().parent
BASE='652d3b2476416a1ead7332f12055d1a18018cfb6'
def sha(b): return hashlib.sha256(b).hexdigest()
def git(*args): return subprocess.check_output(['git',*args],cwd=R)
def save(p,b):
    p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b)
def dump(p,v): save(p,(json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode())
paths=set(git('diff','--name-only').decode().splitlines())|set(git('ls-files','--others','--exclude-standard').decode().splitlines())
rows=[]
for path in sorted(paths):
    p=R/path
    b=p.read_bytes() if p.is_file() else None
    if b is not None: save(O/'source'/path,b)
    rows.append(dict(path=path,deleted=b is None,bytes=len(b) if b is not None else None,sha256=sha(b) if b is not None else None))
dump(O/'snapshot.json',dict(base=BASE,files=rows))
save(O/'source.patch',git('diff','--binary',BASE))
def blob(rev,path): return git('show',rev+':'+path)
def current(path): return (O/'source'/path).read_bytes()
oldmd=blob(BASE,'doc/spec/00-contract.md')
oldfixture=blob(BASE,'doc/migration/00-contract.nepld')
oldconverter=blob(BASE,'tools/migration/contract.py')
oldtest=blob(BASE,'tools/tests/doc/projection.rs')
checks={}
checks['source_move_exact']=current('doc/spec/00-contract.nepld')==blob(BASE,'doc/migration/authored/00-contract.nepld')==blob('cd451bf','doc/migration/authored/00-contract.nepld')
checks['historical_source_exact']=current('tools/migration/fixtures/00-contract.md')==oldmd==blob('a163764e93e2809f8013d7bbe16721082f979143','doc/spec/00-contract.md')
checks['old_generated_fixture_unchanged']=(R/'doc/migration/00-contract.nepld').read_bytes()==oldfixture
before=ast.parse(oldconverter);after=ast.parse(current('tools/migration/contract.py'))
for name in ['generate','sentence','quoted']:
    a=next(n for n in before.body if isinstance(n,ast.FunctionDef) and n.name==name)
    b=next(n for n in after.body if isinstance(n,ast.FunctionDef) and n.name==name)
    checks['same_function_'+name]=ast.dump(a)==ast.dump(b)
expected=oldtest.replace(b'actual_contract_projects_to_equivalent_markdown_events',b'historical_contract_projects_to_equivalent_markdown_events').replace(b'../../../doc/spec/00-contract.md',b'../../migration/fixtures/00-contract.md')
checks['test_only_name_and_input_changed']=current('tools/tests/doc/projection.rs')==expected
registry=json.loads(current('doc/canonical.json'))
checks['previous_registry_unchanged']=registry['pages'][1:]==json.loads(blob(BASE,'doc/canonical.json'))['pages']
for path,b in [('old-source.md',oldmd),('old-generated.nepld',oldfixture),('old-converter.py',oldconverter),('old-projection.rs',oldtest)]: save(O/'before'/path,b)
pre=Path('C:/projects/NEPL3-doc-block-projection/.tmp/preflight-canonical00')
for name in ['manifest.json','sources.json','result.json','initial-review-manifest.json','initial-review-review.md','ruby-review-manifest.json','ruby-review-review.md','github.html','github-url.txt']:
    save(O/'prior'/name,(pre/name).read_bytes())
dump(O/'identities.json',dict(checks=checks,source=dict(bytes=len(oldmd),sha256=sha(oldmd)),draft=dict(bytes=len(current('doc/spec/00-contract.nepld')),sha256=sha(current('doc/spec/00-contract.nepld'))),historical_output=dict(bytes=len(oldfixture),sha256=sha(oldfixture))))
assert all(checks.values()),checks
# Fixed dependencies: Git blobs plus the recorded dirty overlay, no live Cargo source.
W=O/'workspace';W.mkdir(exist_ok=True)
selected=[]
for path in git('ls-tree','-r','--name-only',BASE).decode().splitlines():
    if path.startswith(('crates/','tools/','doc/','interfaces/','design/','languages/','conformance/fixtures/','.cargo/')) or '/' not in path:
        selected.append(path)
proc=subprocess.Popen(['git','cat-file','--batch'],cwd=R,stdin=subprocess.PIPE,stdout=subprocess.PIPE)
deps=[]
for path in selected:
    proc.stdin.write((BASE+':'+path+'\n').encode());proc.stdin.flush()
    header=proc.stdout.readline().decode().split();length=int(header[2]);b=proc.stdout.read(length);assert proc.stdout.read(1)==b'\n'
    save(W/path,b);deps.append(dict(path=path,bytes=len(b),sha256=sha(b)))
proc.stdin.close();assert proc.wait()==0
for row in rows:
    p=W/row['path']
    if row['deleted']:
        if p.exists(): p.unlink()
    else: save(p,(O/'source'/row['path']).read_bytes())
dump(O/'dependencies.json',dict(base=BASE,files=deps))
print(json.dumps(dict(checks=checks,files=len(rows),dependencies=len(deps))))
