from pathlib import Path
import json,hashlib,subprocess
O=Path(__file__).resolve().parent;W=O/'workspace';exe=O/'target/debug/nepl3-tools.exe'
def sha(b): return hashlib.sha256(b).hexdigest()
cases=[]
md=W/'doc/spec/00-contract.md';aliases=W/'doc/migration/aliases/00-contract.json';source=W/'doc/spec/00-contract.nepld'
mutations=[('hand-edited-view',md,md.read_bytes()+b'\nmanual edit\n'),('missing-legacy-alias',aliases,(json.dumps(json.loads(aliases.read_bytes())[1:],ensure_ascii=False)+'\n').encode()),('changed-doc-text',source,source.read_bytes().replace('対象'.encode(),'範囲'.encode(),1))]
for name,path,changed in mutations:
    original=path.read_bytes();path.write_bytes(changed)
    try:
        inputs={p:p.read_bytes() for p in [md,aliases,source]}
        run=subprocess.run([str(exe),'doc-canonical','--check'],cwd=W,capture_output=True,timeout=120)
        (O/(name+'.stdout.log')).write_bytes(run.stdout);(O/(name+'.stderr.log')).write_bytes(run.stderr)
        assert run.returncode!=0 and b'stale generated Markdown' in run.stderr,(name,run.stderr)
        assert all(p.read_bytes()==b for p,b in inputs.items())
        cases.append(dict(case=name,command=[str(exe),'doc-canonical','--check'],exit_code=run.returncode,changed_path=path.relative_to(W).as_posix(),changed_sha256=sha(changed),writes=False))
    finally:path.write_bytes(original)
identity=dict(binary=dict(path=str(exe),bytes=exe.stat().st_size,sha256=sha(exe.read_bytes())),cases=cases)
(O/'canonical-boundaries.json').write_text(json.dumps(identity,indent=2)+'\n',encoding='utf-8',newline='\n')
print('independent actual chapter00 canonical negative cases:',len(cases))
