from pathlib import Path
import importlib.util,hashlib,json,subprocess,sys,tempfile
from unittest.mock import patch
from html.parser import HTMLParser
O=Path(__file__).resolve().parent;R=O.parents[1];W=O/'workspace'
def sha(b): return hashlib.sha256(b).hexdigest()
def dump(n,v): (O/n).write_text(json.dumps(v,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
head='4895c1a6a94660a43e617ed86a21844838a7324d'
matches=[]
for row in json.loads((O/'snapshot.json').read_bytes())['files']:
    p=row['path']
    r=subprocess.run(['git','show',head+':'+p],cwd=R,capture_output=True)
    ok=r.returncode!=0 if row['deleted'] else r.returncode==0 and sha(r.stdout)==row['sha256']
    matches.append(dict(path=p,matches=ok));assert ok,p
dump('final-head.json',dict(head=head,files=matches))
P=Path('C:/projects/NEPL3-doc-block-projection/.tmp/preflight-canonical00')
rows=[]
for row in json.loads((P/'manifest.json').read_bytes())['files']:
    b=(P/row['path']).read_bytes();assert len(b)==row['bytes'] and sha(b)==row['sha256'];rows.append(row)
dump('prior-verified.json',dict(manifest_sha256=sha((P/'manifest.json').read_bytes()),files=rows))
class Links(HTMLParser):
    def __init__(self): super().__init__();self.anchors=[]
    def handle_starttag(self,t,a):
        d=dict(a)
        if t=='a' and d.get('id','').startswith('user-content-') and 'anchor' in d.get('class','').split(): self.anchors.append(d)
html=Links();html.feed((P/'github.html').read_text(encoding='utf-8'))
aliases=json.loads((W/'doc/migration/aliases/00-contract.json').read_bytes())
ids=[a['id'].removeprefix('user-content-') for a in html.anchors]
assert ids==[a['name'] for a in aliases],ids
md=(W/'doc/spec/00-contract.md').read_text(encoding='utf-8')
for a in aliases: assert md.count('<a name="'+a['name']+'"></a>')==1,a
dump('aliases.json',dict(aliases=aliases,old_github_heading_anchors=html.anchors,old_github_html_sha256=sha((P/'github.html').read_bytes()),generated_exact_alias_tags=True,new_github_navigation='not run in code review'))
spec=importlib.util.spec_from_file_location('review_contract',W/'tools/migration/contract.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
checks=[];good=m.SOURCE.read_bytes()
with tempfile.TemporaryDirectory(dir=O) as tmp:
    p=Path(tmp);src=p/'source.md';target=p/'out.nepld';audit=target.with_suffix('.json')
    for label,b in [('changed-code',good.replace(b'`cons`',b'`changed`')),('extra-section',good+b'\n## Extra\n\nbody\n'),('current-generated-md',md.encode()),('BOM',b'\xef\xbb\xbf'+good)]:
        src.write_bytes(b);target.write_bytes(b'expected-sentinel');audit.write_bytes(b'audit-sentinel')
        with patch.object(m,'SOURCE',src),patch.object(m,'TARGET',target),patch('sys.argv',['contract.py','--write']):
            try:m.main();raise AssertionError('unexpected success')
            except SystemExit as e: assert 'historical converter input changed' in str(e)
        assert target.read_bytes()==b'expected-sentinel' and audit.read_bytes()==b'audit-sentinel'
        checks.append(dict(case=label,rejected_before_both_writes=True,input_sha256=sha(b)))
    src.write_bytes(good.replace(b'\n',b'\r\n'))
    with patch.object(m,'SOURCE',src),patch.object(m,'TARGET',target),patch('sys.argv',['contract.py','--write']):m.main()
    assert target.read_bytes()==(W/'doc/migration/00-contract.nepld').read_bytes()
    checks.append(dict(case='CRLF checkout',normalized_LF_hash_matches=True,generated_bytes_unchanged=True))
dump('converter-boundaries.json',checks)
print(json.dumps(dict(final_head_matches=True,prior_files=len(rows),legacy_aliases=len(aliases),independent_converter_cases=len(checks))))
