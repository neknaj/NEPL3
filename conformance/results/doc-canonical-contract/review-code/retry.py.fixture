from pathlib import Path
import subprocess,json,hashlib,os
O=Path(__file__).resolve().parent;R=O.parents[1];W=O/'workspace';base='652d3b2476416a1ead7332f12055d1a18018cfb6'
rows=[]
for p in subprocess.check_output(['git','ls-tree','-r','--name-only',base,'examples'],cwd=R).decode().splitlines():
    b=subprocess.check_output(['git','show',base+':'+p],cwd=R)
    target=W/p;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(b)
    rows.append(dict(path=p,bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
(O/'dependency-addendum.json').write_text(json.dumps(dict(reason='Initial isolated checkout omitted examples used by compile-time include_str; no test executed in failed build.',files=rows),indent=2)+'\n',encoding='utf-8',newline='\n')
env=os.environ.copy();env['CARGO_TARGET_DIR']=str(O/'target');results=[]
for name,args in [('historical-retry',['cargo','test','--locked','-p','nepl3-tools','--test','doc','projection::historical_contract_projects_to_equivalent_markdown_events','--','--exact']),('canonical',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','--check'])]:
    p=subprocess.run(args,cwd=W,env=env,capture_output=True,timeout=900)
    (O/(name+'.stdout.log')).write_bytes(p.stdout);(O/(name+'.stderr.log')).write_bytes(p.stderr)
    results.append(dict(name=name,command=args,cwd=str(W),exit_code=p.returncode,target_dir=env['CARGO_TARGET_DIR']))
    (O/'commands-retry.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf-8',newline='\n')
    print(name,p.returncode,flush=True)
    assert p.returncode==0,p.stderr[-2000:]
    if name.startswith('historical'): assert b'1 passed; 0 failed' in p.stdout
