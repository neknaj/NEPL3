from pathlib import Path
import re,json,hashlib,difflib
from tools.audit.structure import Parser,load_forms
root=Path.cwd();r=root/'.tmp/author-canonical00-deltas'
helper=Path('C:/projects/NEPL3-external-extensions/.tmp/author-external-extensions/helpers.py')
exec(helper.read_text(encoding='utf8'))
def visible(n):
    if isinstance(n,list):return ''.join(visible(x) for x in n)
    if not isinstance(n,dict):return ''
    k=n['kind'];f=n['fields']
    if k=='Link':return visible(f['label'])
    if k in ('Text','InlineCode','RawCode'):return f['text']
    return ''.join(visible(x) for x in f.values())
results=[]
for src,draft in [('doc/migration/README.md','doc/migration/authored/migration/README.nepld'),('doc/development.md','doc/migration/authored/guide/development.nepld')]:
    b=(r/'before'/draft).read_bytes();a=(root/draft).read_bytes()
    assert b'\r' not in a and not a.startswith(b'\xef\xbb\xbf')
    forms=load_forms(root)
    before=normalize(Parser(b.decode(),forms).complete('Doc/Article'))
    raw=Parser(a.decode(),forms).complete('Doc/Article');after=normalize(raw,True)
    bp=[visible(n['fields']['items']) for n in walk(before) if n['kind']=='Paragraph']
    ap=[visible(n['fields']['items']) for n in walk(after) if n['kind']=='Paragraph']
    assert len(bp)==len(ap)
    changes=[(i,x,y) for i,(x,y) in enumerate(zip(bp,ap)) if x!=y]
    # Only explicitly authorized prose paragraphs may change. RawCode, links,
    # all blocks, and their order remain the existing structures.
    assert len(changes)==(5 if 'README' in src else 1),changes
    for kind in ['RawCode','Link','Section','List','Table']:
        if kind=='Section':
            project=lambda n: {k:v for k,v in n['fields'].items() if k!='body'}
        else:project=lambda n:n
        assert [project(n) for n in walk(before) if n['kind']==kind]==[project(n) for n in walk(after) if n['kind']==kind],kind
    for element in walk(raw):
        if element['kind']=='Paragraph' and visible(normalize(element)) in [y for _,_,y in changes]:audit_text(element)
    source=(r/'before'/src).read_text(encoding='utf8')
    source_paragraphs=[]
    for p in re.sub(r'```[^\n]*\n.*?```','',source,flags=re.S).split('\n\n'):
        if p.strip().startswith('#') or not p.strip():continue
        p=''.join(p.splitlines()).strip()
        p=re.sub(r'\[([^\]]+)\]\(([^)]+)\)',r'\1',p).replace('`','')
        source_paragraphs.append(p)
    # Markdown line wrapping around code spans retains a display space in Doc.
    source_paragraphs=[p.replace('正本は../canonical.json','正本は ../canonical.json') for p in source_paragraphs]
    for i,x,y in changes:assert y in source_paragraphs,(src,i,y)
    assert (root/src).read_bytes()==(r/'before'/src).read_bytes()
    path=r/'after'/draft;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(a)
    (r/(Path(src).stem+'.diff')).write_text(''.join(difflib.unified_diff(b.decode().splitlines(True),a.decode().splitlines(True),fromfile='before/'+draft,tofile='after/'+draft)),encoding='utf8',newline='\n')
    results.append({'source':src,'source_sha256':hashlib.sha256((root/src).read_bytes()).hexdigest(),'draft':draft,'before_sha256':hashlib.sha256(b).hexdigest(),'after_sha256':hashlib.sha256(a).hexdigest(),'changed_paragraphs':changes,'unchanged_rawcode_links_sections_lists_tables':True,'source_unchanged':True})
(r/'helpers.py').write_bytes(helper.read_bytes())
(r/'result.json').write_text(json.dumps({'status':'PASS: author self-check only, formal structure not runtime','files':results},ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS: 2 complete formal Article checks, 6 changed paragraphs match source, unrelated structure preserved')
