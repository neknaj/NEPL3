from pathlib import Path
import sys,json,gzip,tarfile
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_release import ReleaseTests
from deployment.release import recover,verify
p=Path('.tmp/stored-payload-review');data=gzip.decompress(Path('conformance/results/doc-pages-payload/final-review/identical-tars.tar.gz.fixture').read_bytes());manifest='39000dd5b7aad48deae97741c5b077b44a242a0badb7b30e81b3c1c26f301446';t=ReleaseTests();results=[]
raw,kwargs=t.stored_payload(data);kwargs['assets']=tuple(reversed(kwargs['assets']));metadata=json.loads(raw);metadata['assets'].reverse();receipt,payload=recover(json.dumps(metadata).encode(),expected_manifest=manifest,**kwargs)
assert payload.data is data and payload.files==22;results.append({'case':'reordered pins/metadata','result':'original bytes retained'})
for name,bad in [('compressed wrapper',gzip.compress(data,mtime=0)),('trailing zero block',data+b'\0'*512),('truncated archive',data[:600])]:
 raw,kwargs=t.stored_payload(bad);verify(raw,**kwargs)
 try:recover(raw,expected_manifest=manifest,**kwargs);raise AssertionError(name+' accepted')
 except (ValueError,tarfile.TarError) as ex:results.append({'case':name,'storage':'valid','recovery':'rejected','error':str(ex)})
(p/'probe-results.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(json.dumps(results,indent=2))
