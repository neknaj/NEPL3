from pathlib import Path
import subprocess,json,time,hashlib
root=Path.cwd();out=root/'.tmp/generation-initial';out.mkdir(exist_ok=False)
binary=Path('C:/projects/NEPL3-doc-canonical-editor/target/debug/nepl3-tools.exe')
head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
assert not subprocess.check_output(['git','status','--porcelain']).strip()
assert not subprocess.check_output(['git','diff','5c4ce6184f6d5fa817f472d202101aaf86af3195',head,'--','tools','crates','Cargo.toml','Cargo.lock','rust-toolchain.toml']).strip()
rows=[]
for kind in ['markdown','html']:
    cmd=[str(binary),'doc-canonical',kind,f'.tmp/{kind}-initial']
    row=dict(source_commit=head,command=cmd,executable_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),executable_build_source='5c4ce6184f6d5fa817f472d202101aaf86af3195; Rust/manifests unchanged',registry_sha256=hashlib.sha256((root/'doc/canonical.json').read_bytes()).hexdigest(),deadline_seconds=900)
    rows.append(row);start=time.monotonic()
    with (out/(kind+'.stdout.log')).open('wb') as stdout,(out/(kind+'.stderr.log')).open('wb') as stderr:
        p=subprocess.Popen(cmd,stdout=stdout,stderr=stderr);row['pid']=p.pid
        (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8',newline='\n')
        try:row['exit_code']=p.wait(timeout=900)
        except subprocess.TimeoutExpired:
            p.kill();p.wait();row.update(exit_code=p.returncode,result='process-timeout')
    row.update(elapsed_seconds=time.monotonic()-start,output_exists=(root/f'.tmp/{kind}-initial').exists())
    (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8',newline='\n')
    assert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==head
    assert not subprocess.check_output(['git','status','--porcelain']).strip()
    print(kind,row,flush=True)
    print((out/(kind+'.stderr.log')).read_text(encoding='utf-8')[-1200:],flush=True)
