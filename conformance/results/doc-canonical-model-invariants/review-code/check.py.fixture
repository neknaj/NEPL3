from pathlib import Path
import hashlib,json,re,html,collections
from html.parser import HTMLParser
p=Path(__file__).parent.resolve()
def raw(n):return (p/n).read_bytes()
def read(n):return raw(n).decode('utf8')
def js(n):return json.loads(raw(n))
def sha(b):return hashlib.sha256(b).hexdigest()
out={};chapter='12-model-invariants'
doc=raw('source/doc/spec/'+chapter+'.nepld');assert doc==raw('before/doc/migration/authored/'+chapter+'.nepld')==raw('preflight-source/doc/spec/'+chapter+'.nepld')
assert sha(doc)==js('prior-content/checks.json')['doc_sha256'];assert sha(raw('before/doc/spec/'+chapter+'.md'))==js('prior-content/checks.json')['original_md_sha256']
out['source']={'doc_sha256':sha(doc),'doc_bytes':len(doc),'original_md_sha256':sha(raw('before/doc/spec/'+chapter+'.md')),'unchanged_move':True}
reg=js('source/doc/canonical.json');before=js('before/doc/canonical.json');assert reg['pages'][:7]==before['pages'] and len(reg['pages'])==8
expected=json.loads(raw('before/doc/canonical.json'));expected['pages'].append(dict(id='model-invariants',source='doc/spec/'+chapter+'.nepld',projection='doc/spec/'+chapter+'.md',aliases='doc/migration/aliases/'+chapter+'.json',route='docs/spec/'+chapter+'.html',renderer='nepl3-tools.markdown-annotated-pages/1'));expected['output_limits'].update(work=600000000,allocation_units=1500000000);assert expected==reg
out['registry']={'only_selected_markdown_work_allocation_changed':True,'existing_seven_entries_unchanged':True,'html_limits_unchanged':True}
out['repeated_artifacts']={}
for kind,count in [('markdown',9),('html',10)]:
    folder=p/(kind+'-first');files=sorted(q.relative_to(folder).as_posix() for q in folder.rglob('*') if q.is_file());second=p/(kind+'-second');assert len(files)==count
    assert files==sorted(q.relative_to(second).as_posix() for q in second.rglob('*') if q.is_file());rows=[]
    for n in files:
        b=raw(kind+'-first/'+n);assert b==raw(kind+'-second/'+n);rows.append(dict(path=n,bytes=len(b),sha256=sha(b)))
    for r in js(kind+'-first/manifest.json')['files']:
        b=raw(kind+'-first/'+r['path']);assert sha(b)==r['sha256']
        if 'bytes' in r:assert len(b)==r['bytes']
    out['repeated_artifacts'][kind]=rows
for page in reg['pages']:assert raw('markdown-first/'+page['projection'])==raw('source/'+page['projection'])
out['old_legacy_markdown']=[]
for n in ['00-contract','07-circuit','13-reproducibility','18-html-delivery','19-html-fragment','22-external-extensions']:
    n='doc/spec/'+n+'.md';b=raw('markdown-first/'+n);assert b==raw('prior-l/markdown-first/'+n);out['old_legacy_markdown'].append(dict(path=n,sha256=sha(b)))
out['old_seven_html_and_css']=[]
for n in ['00-contract.html','01-architecture.html','07-circuit.html','13-reproducibility.html','18-html-delivery.html','19-html-fragment.html','22-external-extensions.html','assets/doc.css']:
    n='docs/spec/'+n;b=raw('html-first/'+n);assert b==raw('prior-l/html-first/'+n);out['old_seven_html_and_css'].append(dict(path=n,sha256=sha(b)))
old=read('before/doc/spec/01-architecture.md');new=read('markdown-first/doc/spec/01-architecture.md');assert old==read('prior-l/markdown-first/doc/spec/01-architecture.md')
strip=lambda v:re.sub(r'(input PageSet digest |input context SHA-256 )[0-9a-f]{64}',r'\1<DIGEST>',v)
assert strip(old)==strip(new) and old!=new
group=bytes.fromhex(re.search(r'input PageSet digest ([0-9a-f]{64})',new)[1]);fields=[b'nepl3.canonical-input-context/1\0',b'nepl3-tools.markdown-annotated-pages/1',b'doc/canonical.json',raw('source/doc/canonical.json'),group,(8).to_bytes(8,'big')]
for page in reg['pages']:
    fields.extend(page[k].encode() for k in ['id','source','projection','aliases','route','renderer']);fields.extend(hashlib.sha256(raw('source/'+page[k])).digest() for k in ['source','aliases'])
context=sha(b''.join(len(v).to_bytes(8,'big')+v for v in fields));assert context==js('markdown-first/manifest.json')['input_context']
for name in ['01-architecture',chapter]:
    header=html.unescape(read('markdown-first/doc/spec/'+name+'.md').splitlines()[0]);page=next(x for x in reg['pages'] if x['projection']=='doc/spec/'+name+'.md')
    for part in ['Generated from '+page['source']+';','renderer '+page['renderer']+';','page '+page['id']+';','input context SHA-256 '+context,'input PageSet digest '+group.hex(),'source SHA-256 '+sha(raw('source/'+page['source'])),'alias input SHA-256 '+sha(raw('source/'+page['aliases']))]:assert part in header,part
out['context']={'architecture_only_two_header_fields_changed':True,'both_pages1_headers_recomputed':True,'context':context,'pageset':group.hex()}
names=['12-意味モデル中間表現の補足不変条件','方針','1-値と参照','11-foundation制約id','2-checked値の境界','3-回路ir','4-markup安全性','5-operationの具体型'];sections=['policy','values','constraints','checked','circuit','markup','operations'];semantic=['n-'+s.encode().hex() for s in sections]
assert js('source/doc/migration/aliases/'+chapter+'.json')==[dict(section=s,name=n) for s,n in zip([None]+sections,names)]
aliases=re.findall(r'<a name="([^"]+)"></a>',read('markdown-first/doc/spec/'+chapter+'.md'));assert len(aliases)==15 and len(set(aliases))==15 and set(aliases)==set(names+semantic)
class Tags(HTMLParser):
    def __init__(self):super().__init__();self.count=collections.Counter();self.ids=[];self.codes=[];self.code=None;self.links=[];self.cell=None;self.cells=[]
    def handle_starttag(self,t,a):
        self.count[t]+=1;a=dict(a)
        if 'id' in a:self.ids.append(a['id'])
        if t=='code':self.code=''
        if t=='a':self.links.append(a.get('href'))
        if t in ['td','th']:self.cell=''
    def handle_endtag(self,t):
        if t=='code':self.codes.append(self.code);self.code=None
        if t in ['td','th']:self.cells.append(self.cell);self.cell=None
    def handle_data(self,v):
        if self.code is not None:self.code+=v
        if self.cell is not None:self.cell+=v
t=Tags();t.feed(read('html-first/docs/spec/'+chapter+'.html'));assert t.ids==semantic and t.links==['19-html-fragment.html']
assert [t.count[k] for k in ['h1','h2','p','table','tr','th','td','ul','ol','pre','script']]==[1,7,32,1,18,2,34,0,0,0,0]
codes=['interfaces/model.json','record','[fieldName, typeExpression]','sum','union','NEPL3-ENVIRONMENT-1','design/markup.json','design/markup.json','interfaces/contracts.json'];assert t.codes==codes
ids=['source.identity','source.content','source.bundle','source.span','schema.reference / schema.type-reference','schema.descriptor','operation.reporting','report.trace-overflow','namespace.reference','environment.bindings / environment.digest','syntax.graph / syntax.foreign','source.map / origin.graph','source.reservation','schema.kind-id','view.graph','token.boundary','view.presentation'];assert t.cells[2::2]==ids
assert (p/'html-first/docs/spec/19-html-fragment.html').is_file()
out['model_output']={'markdown_aliases':aliases,'html_semantic_ids':t.ids,'codes':codes,'constraint_ids':ids,'tags':dict(t.count),'href':t.links,'actual_page19_output_exists':True}
class Scripts(HTMLParser):
    def __init__(self):super().__init__();self.active=False;self.parts=[];self.scripts=[]
    def handle_starttag(self,t,a):
        if t=='script' and dict(a).get('type')=='application/json':self.active=True;self.parts=[]
    def handle_data(self,s):
        if self.active:self.parts.append(s)
    def handle_endtag(self,t):
        if t=='script' and self.active:self.scripts.append(''.join(self.parts));self.active=False
class OldAnchors(HTMLParser):
    def __init__(self):super().__init__();self.ids=[]
    def handle_starttag(self,t,a):
        a=dict(a)
        if t=='a' and a.get('id','').startswith('user-content-'):self.ids.append(a['id'][13:])
s=Scripts();s.feed(read('prior-content/historical-12-model-invariants-github.html'));payload=next(x['payload'] for x in map(json.loads,s.scripts) if 'codeViewBlobRoute' in x.get('payload',{}));assert ('\n'.join(payload['codeViewBlobLayoutRoute.StyledBlob']['rawLines'])+'\n').encode()==raw('before/doc/spec/'+chapter+'.md')
a=OldAnchors();a.feed(payload['codeViewBlobRoute']['richText']);assert a.ids==names
out['old_anchor_receipt']={'rawlines_equal_original':True,'eight_aliases_equal_old_names':True,'new_navigation_unrun':True}
hm=js('html-first/manifest.json');mm=js('markdown-first/manifest.json');assert hm['output_budget']['limits']==reg['html_output_limits'] and mm['output_budget']['limits']==reg['output_limits']
for m in [hm,mm]:assert not any(m['output_budget']['initial_usage'].values())
assert len(hm['pages'])==8 and hm['registered_files']==[] and hm['viewer_scripts'] is False
for page,row in zip(reg['pages'],hm['pages']):
    for k,expected in [('id',page['id']),('input',page['source']),('source',page['projection']),('route',page['route']),('source_sha256',sha(raw('source/'+page['source'])))]:assert row[k]==expected
    for phase in ['parse','lower']:
        assert not any(row[phase+'_initial_usage'].values());assert row[phase+'_limits']['work']==100000000 and row[phase+'_limits']['allocation_units']==500000000 and row[phase+'_limits']['nodes']==10000000
usage=mm['output_budget']['usage_before_receipt_serialization'];assert usage['allocation_units']>1000000000
assert all(usage[k]<=reg['output_limits'][k] for k in reg['output_limits']);assert all(hm['output_budget']['usage'][k]<=reg['html_output_limits'][k] for k in reg['html_output_limits'])
out['receipts']={'markdown_before_receipt_serialization_usage':usage,'html_output_usage':hm['output_budget']['usage'],'eight_input_identities':True,'parse_lower_defaults_retained':True}
low=js('old-budget-registry.json');expected=json.loads(raw('source/doc/canonical.json'));expected['output_limits'].update(work=400000000,allocation_units=1000000000);assert low==expected
assert 'AllocationLimit' in read('markdown-old-budget.stderr.log') and not (p/'markdown-old-budget').exists();assert js('commands.json')[-1]['registry_sha256']==sha(raw('old-budget-registry.json'))
missing=js('missing-page19-registry.json');expected=json.loads(raw('source/doc/canonical.json'));expected['pages']=[q for q in expected['pages'] if q['id']!='html-fragment'];assert missing==expected
assert 'MissingPage' in read('missing-page19.stderr.log') and not (p/'markdown-missing-page19').exists();assert js('missing-page19-command.json')['registry_sha256']==sha(raw('missing-page19-registry.json'))
out['negative_operations']={'old_budget':read('markdown-old-budget.stderr.log'),'page19_unregistered_physical_file_present':read('missing-page19.stderr.log'),'no_output_directories':True}
for row in js('dependencies.json'):
    b=raw('workspace/'+row['path']);assert len(b)==row['bytes'] and sha(b)==row['sha256'],row['path']
out['fixed_dependencies_reverified']=len(js('dependencies.json'))
(p/'checks.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
print('PASS unchanged source /selected limits /9+10 repeated outputs /old6MD+7HTML+CSS /two pages1 metadata/context /17IDs+9code+real19link /old aliases /allocation stop /unregistered19 rejection /679 hashes')
