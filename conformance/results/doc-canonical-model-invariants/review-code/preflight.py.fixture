from pathlib import Path
import subprocess,json,hashlib,sys,collections
p=Path(__file__).parent.resolve();root=p.parents[1];head='7d6d3f1ff77f9f83aac4e39b21f27008df67fbf3'
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
def sha(b):return hashlib.sha256(b).hexdigest()
def put(n,b):q=p/n;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
base=git('rev-parse','3a1a80c^').decode().strip()
scope=['AGENTS.md','doc/authoring.md','doc/canonical.json','doc/spec/12-model-invariants.nepld','doc/migration/aliases/12-model-invariants.json','doc/spec/16-doc-migration.md','doc/spec/21-doc-pages.md','tools/src/doc/canonical.rs','tools/src/doc/canonical/projection.rs','tools/src/doc/projection/annotated/pages.rs','tools/src/doc/projection/annotated/blocks.rs','tools/audit/structure.py','design/forms.json']
rows=[]
for n in scope:
    b=git('show',head+':'+n);put('preflight-source/'+n,b);rows.append(dict(path=n,bytes=len(b),sha256=sha(b)))
for n in ['doc/spec/12-model-invariants.md','doc/migration/authored/12-model-invariants.nepld','doc/canonical.json']:put('preflight-before/'+n,git('show',base+':'+n))
assert (p/'preflight-source/doc/spec/12-model-invariants.nepld').read_bytes()==(p/'preflight-before/doc/migration/authored/12-model-invariants.nepld').read_bytes()
low=json.loads(git('show','3a1a80c:doc/canonical.json'));high=json.loads(git('show',head+':doc/canonical.json'))
assert low['output_limits']['work']==400000000 and low['output_limits']['allocation_units']==1000000000
low['output_limits'].update(work=600000000,allocation_units=1500000000);assert low==high
sys.path.insert(0,str(p/'preflight-source'))
from tools.audit.structure import Parser,load_forms
tree=Parser((p/'preflight-source/doc/spec/12-model-invariants.nepld').read_text(encoding='utf8'),load_forms(p/'preflight-source')).complete('Doc/Article')
def walk(x):
    if isinstance(x,list):
        for v in x:yield from walk(v)
    elif isinstance(x,dict):
        yield x
        for v in x.get('fields',{}).values():yield from walk(v)
nodes=list(walk(tree));kinds=collections.Counter(n['kind'] for n in nodes)
assert kinds['Paragraph']==32 and kinds['Row']==18 and kinds['InlineCode']==9 and kinds['Link']==1 and kinds['Table']==1
codes=[n['fields']['text'] for n in nodes if n['kind']=='InlineCode']
put('preflight.patch',git('diff','--binary',base,head))
put('preflight.json',(json.dumps(dict(head=head,base=base,scope='Read-only preliminary source/contract inspection; generation awaits final fixed commit',unchanged_move=True,only_selected_markdown_work_allocation_changed=True,kinds=dict(kinds),codes=codes,files=rows),indent=2)+'\n').encode())
print('Preflight PASS; 32 paragraphs, table header+17 data rows, 9 code and one relative19 Link; no generation run')
