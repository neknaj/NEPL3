use pulldown_cmark::{Alignment,Event,Options,Parser,Tag,TagEnd};

#[test]
fn actual_model_chapter_preserves_constraints_and_resolves_real_page19() -> Result<(),Box<dyn std::error::Error>> {
    let root=std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
    let original=std::fs::read_to_string(root.join("before/doc/spec/12-model-invariants.md"))?;
    let generated=std::fs::read_to_string(root.join("markdown-first/doc/spec/12-model-invariants.md"))?;
    fn inspect(text:&str)->(Vec<String>,Vec<String>,Vec<String>,usize,usize,usize,usize) {
        let mut codes=Vec::new();let mut links=Vec::new();let mut cells=Vec::new();let mut cell=None::<String>;
        let mut paragraphs=0;let mut headings=0;let mut rows=0;let mut alias_paragraphs=0;let mut visible=false;
        for event in Parser::new_ext(text,Options::ENABLE_TABLES) {
            match event {
                Event::Start(Tag::Table(align))=>assert_eq!(align,[Alignment::None;2]),
                Event::Start(Tag::TableRow)=>rows+=1,
                Event::Start(Tag::TableCell)=>cell=Some(String::new()),
                Event::End(TagEnd::TableCell)=>cells.push(cell.take().expect("cell start")),
                Event::Code(value)=>{visible=true;codes.push(value.into_string());},
                Event::Text(value)=>{visible|=!value.is_empty();if let Some(cell)=&mut cell{cell.push_str(&value);}},
                Event::Start(Tag::Paragraph)=>visible=false,
                Event::End(TagEnd::Paragraph)=>if visible{paragraphs+=1;}else{alias_paragraphs+=1;},
                Event::Start(Tag::Heading {..})=>headings+=1,
                Event::Start(Tag::Link {dest_url,..})=>links.push(dest_url.into_string()),
                Event::Start(Tag::List(_) | Tag::CodeBlock(_))=>panic!("unexpected list or code block"),
                _=>{}
            }
        }
        assert_eq!(cells.len(),36);
        let identifiers=cells.into_iter().skip(2).step_by(2).collect();
        (codes,links,identifiers,paragraphs,headings,rows,alias_paragraphs)
    }
    let old=inspect(&original);let new=inspect(&generated);
    assert_eq!(old.0,new.0);assert_eq!(old.1,new.1);assert_eq!(old.2,new.2);
    assert_eq!(new.0, ["interfaces/model.json","record","[fieldName, typeExpression]","sum","union","NEPL3-ENVIRONMENT-1","design/markup.json","design/markup.json","interfaces/contracts.json"]);
    assert_eq!(new.1,["19-html-fragment.md"]);
    assert_eq!((old.3,old.4,old.5,old.6),(32,8,17,0));
    assert_eq!((new.3,new.4,new.5,new.6),(32,8,17,15));
    println!("MODEL_CONSTRAINTS {}",serde_json::to_string(&new.2)?);
    Ok(())
}
