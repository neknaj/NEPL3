from pathlib import Path
import subprocess,json,hashlib,time
p=Path(__file__).parent.resolve();ws=p/'workspace';reg=ws/'doc/canonical.json';original=reg.read_bytes()
binary=p/'target/debug/nepl3-tools.exe';identity=hashlib.sha256(binary.read_bytes()).hexdigest();assert identity==json.loads((p/'binary.json').read_bytes())['sha256']
v=json.loads(original);v['pages']=[page for page in v['pages'] if page['id']!='html-fragment'];mutated=(json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode();(p/'missing-page19-registry.json').write_bytes(mutated)
assert (ws/'doc/spec/19-html-fragment.nepld').is_file()
cmd=[str(binary),'doc-canonical','markdown',str(p/'markdown-missing-page19')];start=time.monotonic()
try:
    reg.write_bytes(mutated);r=subprocess.run(cmd,cwd=ws,capture_output=True,timeout=900)
    (p/'missing-page19.stdout.log').write_bytes(r.stdout);(p/'missing-page19.stderr.log').write_bytes(r.stderr)
    (p/'missing-page19-command.json').write_text(json.dumps(dict(command=cmd,head='2b0bbf4b888ea18ef5e97eaabe2391008e86fe69',registry_sha256=hashlib.sha256(mutated).hexdigest(),binary_sha256=identity,exit_code=r.returncode,deadline_seconds=900,elapsed_seconds=time.monotonic()-start),indent=2)+'\n',encoding='utf8')
    assert r.returncode!=0 and b'MissingPage' in r.stderr and not (p/'markdown-missing-page19').exists()
finally:reg.write_bytes(original)
assert hashlib.sha256(binary.read_bytes()).hexdigest()==identity
print('Unregistered page19 rejected despite existing physical Doc file; no output')
