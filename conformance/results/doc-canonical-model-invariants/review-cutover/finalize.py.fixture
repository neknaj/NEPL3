from pathlib import Path
import json,hashlib
p=Path(__file__).parent;sha=lambda b:hashlib.sha256(b).hexdigest()
assert len(json.loads((p/'html-results.json').read_bytes()))==12
assert len(json.loads((p/'github-results.json').read_bytes())['rows'])==15
for f in ['all-notes-content.json','all-notes-table.json','old-anchors.json']:assert json.loads((p/f).read_bytes())['result']=='PASS'
assert len(json.loads((p/'table-boundaries.json').read_bytes()))==3
assert json.loads((p/'bootstrap-results.json').read_bytes())['complete']
files=[]
for f in sorted(p.rglob('*')):
    rel=f.relative_to(p)
    if not f.is_file() or f.name=='manifest.json' and f.parent==p:continue
    if rel.parts[0] in ['served','bootstrap-workspace'] or '__pycache__' in rel.parts:continue
    data=f.read_bytes();files.append(dict(path=rel.as_posix(),bytes=len(data),sha256=sha(data)))
b=(json.dumps(dict(version=1,source_commit='2b0bbf4b888ea18ef5e97eaabe2391008e86fe69',scope='Independent browser/cutover artifact review plus exact ten-file README reconstruction and offline cross-page navigation',prior_manifest=dict(path='initial-manifest.json',sha256='f7b53fa18b46a37ed3a4d325393e53db39059e58d248852602776d1183197c7f'),excluded=['served/**','bootstrap-workspace/**','**/__pycache__/**'],files=files),ensure_ascii=False,indent=2)+'\n').encode();(p/'manifest.json').write_bytes(b);print(len(files),sha(b))
