from pathlib import Path
import subprocess,hashlib,json,re,sys
ROOT=Path.cwd();OUT=ROOT/'.tmp/review-canonical12-cutover';HEAD='7d6d3f1ff77f9f83aac4e39b21f27008df67fbf3'
def git(path):return subprocess.check_output(['git','show',HEAD+':'+path])
files=[]
for path in ['doc/spec/12-model-invariants.md','doc/spec/12-model-invariants.nepld','doc/migration/aliases/12-model-invariants.json','doc/authoring.md','design/forms.json','tools/audit/structure.py']:
    data=git(path);p=OUT/'preparation'/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(data);files.append(dict(path=path,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
helper=Path('C:/projects/NEPL3-doc-canonical-html-delivery/.tmp/preflight-after18/helpers.py').read_bytes();(OUT/'helpers.py').write_bytes(helper)
sys.path.insert(0,str(OUT/'preparation'))
from tools.audit.structure import Parser,load_forms
exec(helper.decode())
raw=Parser(git('doc/spec/12-model-invariants.nepld').decode(),load_forms(OUT/'preparation')).complete('Doc/Article')
audit_text(raw);pairs.clear();doc=normalize(raw,True)
def text(n):
    if isinstance(n,list):return ''.join(map(text,n))
    if not isinstance(n,dict):return ''
    f=n['fields'];k=n['kind']
    if k in ('Text','InlineCode'):return f['text']
    if k=='Link':return text(f['label'])
    return ''.join(text(x) for x in f.values())
sections=[n for n in walk(doc) if n['kind']=='Section'];headings=[text(doc['fields']['title'])]+[text(n['fields']['title']) for n in sections]
paragraphs=[text(n) for n in walk(doc) if n['kind']=='Paragraph'];codes=[n['fields']['text'] for n in walk(doc) if n['kind']=='InlineCode']
table=next(n for n in walk(doc) if n['kind']=='Table');rows=[table['fields']['header']['fields']['row']]+table['fields']['rows'];cells=[[text(c) for c in row['fields']['cells']] for row in rows]
source=git('doc/spec/12-model-invariants.md').decode();sourcecells=[[c.strip() for c in line.strip('|').split('|')] for line in source.splitlines() if line.startswith('|') and not line.startswith('| ---')]
assert cells==sourcecells and len(cells)==18 and all(len(row)==2 for row in cells)
assert re.findall(r'`([^`]+)`',source)==codes and len(codes)==9
assert [m[2] for m in re.finditer(r'^(#{1,6}) (.+)$',source,re.M)]==headings and len(headings)==8
assert len(paragraphs)==32
links=[n['fields'] for n in walk(doc) if n['kind']=='Link'];assert len(links)==1 and links[0]['target']==dict(kind='RelativeTarget',fields=dict(path='19-html-fragment.md',fragment=dict(kind='NoText',fields={})))
assert git('doc/spec/12-model-invariants.nepld')==subprocess.check_output(['git','show','840a0e1:doc/migration/authored/12-model-invariants.nepld'])
expected=dict(preparation_commit=HEAD,source_hashes=files,headings=headings,paragraphs=paragraphs,codes=codes,table_cells=cells,links=links,section_ids=[n['fields']['id'] for n in sections],semantic_ids=['n-'+n['fields']['id'].encode().hex() for n in sections],ruby_count=len(pairs),aliases=json.loads(git('doc/migration/aliases/12-model-invariants.json')),draft_unchanged_from='840a0e1',scope='Formal structure/content expectations only; final commit and repeated artifacts pending, no browser execution')
(OUT/'prepared-expectations.json').write_text(json.dumps(expected,ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('Prepared: 32 paragraphs, 18 rows / 36 cells exact original, 9 exact code values, 8 headings, 7 Section IDs, 1 relative link; Ruby',len(pairs))
