from pathlib import Path
import subprocess,json,hashlib
root=Path.cwd()
fixed=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
assert not subprocess.check_output(['git','status','--porcelain']).strip()
src=Path('C:/projects/NEPL3-doc-canonical-html-fragment/.tmp')
s=(src/'verify-integration.py').read_text(encoding='utf-8').replace('e8c396ada1e3d48d981f7a43276889e691e1be1b',fixed).replace('All nine HTML','All ten HTML')
(root/'.tmp/verify-integration.py').write_text(s,encoding='utf-8')
g=(src/'github-canonical19.py').read_text(encoding='utf-8').replace('e8c396ada1e3d48d981f7a43276889e691e1be1b',fixed).replace('canonical19','canonical12').replace('19-html-fragment','12-model-invariants').replace('assert len(rows)==1','assert len(rows)==15')
(root/'.tmp/github-canonical12.py').write_text(g,encoding='utf-8')
a=root/'.tmp/html-initial';b=root/'.tmp/html-budget-first'
first={p.relative_to(a).as_posix():p.read_bytes() for p in a.rglob('*') if p.is_file()}
second={p.relative_to(b).as_posix():p.read_bytes() for p in b.rglob('*') if p.is_file()}
assert first==second
(root/'.tmp/generation-budget/html-independent-budget.json').write_text(json.dumps(dict(source_commit=fixed,files=len(first),all_bytes_identical=True,scope='Only Markdown output limits changed. HTML allowance, parse/lower defaults and artifact bytes unchanged.'),indent=2)+'\n',encoding='utf-8')
