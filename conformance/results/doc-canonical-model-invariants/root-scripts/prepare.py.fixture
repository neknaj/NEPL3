from pathlib import Path
import hashlib,json,subprocess
root=Path.cwd();tmp=root/'.tmp';tmp.mkdir(exist_ok=True)
assert not subprocess.check_output(['git','status','--porcelain']).strip()
source=root/'doc/migration/authored/12-model-invariants.nepld';original=root/'doc/spec/12-model-invariants.md'
(tmp/'start.json').write_text(json.dumps(dict(commit=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),status='',source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),original_sha256=hashlib.sha256(original.read_bytes()).hexdigest(),purpose='Prepare chapter12 with real page-context reference to pending canonical19; no completed acceptance claim'),indent=2)+'\n',encoding='utf-8')
(tmp/'original.md').write_bytes(original.read_bytes())
source.rename(root/'doc/spec/12-model-invariants.nepld')
aliases=[dict(section=s,name=n) for s,n in [(None,'12-意味モデル中間表現の補足不変条件'),('policy','方針'),('values','1-値と参照'),('constraints','11-foundation制約id'),('checked','2-checked値の境界'),('circuit','3-回路ir'),('markup','4-markup安全性'),('operations','5-operationの具体型')]]
(root/'doc/migration/aliases/12-model-invariants.json').write_text(json.dumps(aliases,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
path=root/'doc/canonical.json';registry=json.loads(path.read_bytes())
registry['pages'].append(dict(id='model-invariants',source='doc/spec/12-model-invariants.nepld',projection='doc/spec/12-model-invariants.md',aliases='doc/migration/aliases/12-model-invariants.json',route='docs/spec/12-model-invariants.html',renderer='nepl3-tools.markdown-annotated-pages/1'))
path.write_text(json.dumps(registry,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
