from pathlib import Path
import hashlib,json,subprocess
root=Path.cwd();path=root/'doc/canonical.json';before=path.read_bytes();data=json.loads(before)
assert data['output_limits']['work']==400000000
assert data['output_limits']['allocation_units']==1000000000
data['output_limits']['work']=600000000
data['output_limits']['allocation_units']=1500000000
after=(json.dumps(data,indent=2)+'\n').encode();path.write_bytes(after)
(root/'.tmp/output-budget-selection.json').write_text(json.dumps(dict(source_commit=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),before_sha256=hashlib.sha256(before).hexdigest(),after_sha256=hashlib.sha256(after).hexdigest(),reason='Eight-page Markdown stopped AllocationLimit before writing any output. The same fixed executable completed HTML, including parsing/lowering the added page. Prior seven-page Markdown consumed Work325596451 and Allocation862487830 before receipt serialization. Select a separate finite aggregate Markdown allowance Work600M/Allocation1.5B for eight pages; these are operation accounting units, not physical heap or predicted usage. All other limits, core defaults, parse/lower and HTML allowances remain unchanged. Preserve the initial failure; no sticky stopped budget is reused.'),indent=2)+'\n',encoding='utf-8')
template=Path('C:/projects/NEPL3-doc-canonical-html-fragment/.tmp/generate-budget.py').read_text(encoding='utf-8')
template=template.replace("page['id']!='html-fragment'", "page['id']!='model-invariants'")
(root/'.tmp/generate-budget.py').write_text(template,encoding='utf-8')
