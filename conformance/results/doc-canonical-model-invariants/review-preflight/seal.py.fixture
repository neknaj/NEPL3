from pathlib import Path
import hashlib,json,subprocess
p=Path(__file__).parent;r=p.parents[1]
sha=lambda b:hashlib.sha256(b).hexdigest()
head='e8c396ada1e3d48d981f7a43276889e691e1be1b'
paths=['AGENTS.md','doc/authoring.md','doc/spec/21-doc-pages.md','tools/src/doc/projection/annotated.rs','tools/src/doc/projection/annotated/pages.rs','tools/src/doc/projection/annotated/blocks.rs','design/forms.json','tools/audit/structure.py']
sources=[]
for name in paths:
 b=subprocess.check_output(['git','show',head+':'+name],cwd=r);q=p/'context'/name;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b);sources.append({'path':name,'sha256':sha(b)})
g=json.loads((p/'github.json').read_text(encoding='utf8'));s=json.loads((p/'structure.json').read_text(encoding='utf8'));aliases={}
for stem in s:
 ids=[None]+[x['id'] for x in s[stem]['headings']];old=g[stem]['anchors'];assert len(ids)==len(old)
 aliases[stem]=[{'old':a['href'][1:],'section':i} for a,i in zip(old,ids)]
 for name,local in [(f'doc/spec/{stem}.md',stem+'.md'),(f'doc/migration/authored/{stem}.nepld',stem+'.nepld')]:
  b=(p/local).read_bytes();assert b==subprocess.check_output(['git','show',head+':'+name],cwd=r);sources.append({'path':name,'sha256':sha(b),'bytes':len(b)})
(p/'aliases.json').write_text(json.dumps(aliases,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
files=[{'path':x.relative_to(p).as_posix(),'bytes':x.stat().st_size,'sha256':sha(x.read_bytes())} for x in sorted(p.rglob('*')) if x.is_file() and x.name!='manifest.json']
(p/'manifest.json').write_text(json.dumps({'scope':'independent read-only content/shape preflight; no runtime or cutover','source_commit':head,'sources':sources,'files':files},indent=2)+'\n',encoding='utf8');print(sha((p/'manifest.json').read_bytes()))
