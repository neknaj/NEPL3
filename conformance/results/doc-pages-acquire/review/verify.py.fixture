from pathlib import Path
import sys,subprocess,json
from unittest.mock import patch
p=Path('.tmp/pages-acquire-review');rows=[]
for flags in [[],['-O']]:
 cmd=[sys.executable]+flags+['-m','unittest','discover','-s','tools/site','-p','test_acquire.py'];r=subprocess.run(cmd,capture_output=True);label='optimized' if flags else 'normal';(p/(label+'.stdout')).write_bytes(r.stdout);(p/(label+'.stderr')).write_bytes(r.stderr);rows.append(dict(command=cmd,exit_code=r.returncode))
(p/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf8')
if any(r['exit_code'] for r in rows):raise ValueError('test failure')
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_acquire import AcquireTests
from deployment.acquire import acquire
from deployment.observations import Kind
results=[]
for late in [False,True]:
 args,pins,tar,responses,calls,read,download=AcquireTests().fixture();clock=[0];allowances=[];main_count=[0]
 def rd(q,t,**opts):
  allowances.append(opts['timeout']);data=read(q,t,**opts);clock[0]+=1
  if q.kind==Kind.MAIN:
   main_count[0]+=1
   if late and main_count[0]==2:clock[0]=13
  return data
 def dl(q,t,**opts):
  allowances.append(opts['timeout']);data=download(q,t,**opts);clock[0]+=1;return data
 rejected=False
 with patch('deployment.acquire.time.monotonic',side_effect=lambda:clock[0]),patch('deployment.acquire.read',rd),patch('deployment.acquire.download',dl):
  try:result=acquire('token',**pins,timeout=12)
  except ValueError as e:rejected='deadline' in str(e)
 if rejected!=late or allowances!=[10,10,10,9,8,7,6,5,4,3]:raise ValueError('budget contract')
 if not late and (result.payload.data!=tar or result.evidence.run_before!=args[0] or result.evidence.run_after!=args[0] or result.evidence.diagnostic_archive!=args[3] or result.evidence.upload_archive!=args[5]):raise ValueError('evidence changed')
 results.append(dict(late_final_main=late,rejected=rejected,timeouts=allowances,main_fetches=main_count[0]))
(p/'deadline-probes.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(results)
