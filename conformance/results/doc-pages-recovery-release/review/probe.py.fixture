from pathlib import Path
import sys,json,copy
from dataclasses import replace
from unittest.mock import patch
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment.release import verify,MAX_ASSET
from test_release import ReleaseTests
p=Path('.tmp/recovery-release-review');data,kwargs=ReleaseTests().fixture();results=[]
def rejects(label,metadata=data,inputs=kwargs):
 try:verify(json.dumps(metadata).encode(),**inputs);raise AssertionError(label+' accepted')
 except ValueError as ex:results.append({'case':label,'result':'rejected','reason':str(ex)})
for field in ['id','url','tag_name','draft','immutable','published_at','assets']:
 altered=copy.deepcopy(data);del altered[field];rejects('missing release '+field,altered)
for field in ['id','name','url','state','size','digest']:
 altered=copy.deepcopy(data);del altered['assets'][0][field];rejects('missing asset '+field,altered)
for name in kwargs['downloads']:
 broken=dict(kwargs['downloads']);broken[name]=b'x'*len(broken[name]);rejects('same-length corruption '+name,inputs=dict(kwargs,downloads=broken))
for field,value in [('asset_id',True),('size',True),('size',0),('size',MAX_ASSET+1),('sha256','g'*64)]:
 pins=(replace(kwargs['assets'][0],**{field:value}),*kwargs['assets'][1:]);rejects('invalid pin '+field+str(value),inputs=dict(kwargs,assets=pins))
encoded=json.dumps(data).encode();exact=encoded+b' '*(65536-len(encoded));receipt=verify(exact,**kwargs)
assert receipt.assets==kwargs['assets']
try:verify(exact+b' ',**kwargs);raise AssertionError('metadata over-limit accepted')
except ValueError:results.append({'case':'metadata byte boundary','result':'65536 accepted; 65537 rejected'})
maximum=max(map(len,kwargs['downloads'].values()))
with patch('deployment.release.MAX_ASSET',maximum):verify(encoded,**kwargs)
with patch('deployment.release.MAX_ASSET',maximum-1):rejects('asset configured exact/plus-one boundary')
(p/'probe-results.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(json.dumps({'cases':len(results),'all_expected':True}))
