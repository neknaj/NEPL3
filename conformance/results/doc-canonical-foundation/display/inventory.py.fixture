from pathlib import Path
import re,json
OUT=Path(__file__).parent;original=Path('.tmp/chapter02/original.md').read_text(encoding='utf-8');source=Path('doc/spec/02-foundation.nepld').read_text(encoding='utf-8')
original_codes=re.findall(r'`([^`]+)`',original);expected=original_codes.copy();expected.insert(-1,'[start,end)')
source_codes=[json.loads(s) for s in re.findall(r'cons code ("(?:[^"\\]|\\.)*")',source)]
result={'scope':'Text inventory only; not Doc parser or meaning proof','original_code_count':len(original_codes),'source_code_count':len(source_codes),'expected_code_sequence_equal':source_codes==expected,'original_codes':original_codes,'source_codes':source_codes,'headings_original':re.findall(r'^(#{1,3}) (.+)$',original,re.M),'source_sections':re.findall(r'^(\s*)cons section (\w+) (".*")$',source,re.M)}
(OUT/'inventory.json').write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf-8');print(json.dumps({k:result[k] for k in ['original_code_count','source_code_count','expected_code_sequence_equal']}))
