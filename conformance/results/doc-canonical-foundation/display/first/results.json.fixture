    "headings": [
      {
        "tag": "H1",
        "text": "02. 共通データ契約"
      },
      {
        "tag": "H2",
        "text": "方針"
      },
      {
        "tag": "H2",
        "text": "1. SourceとRange"
      },
      {
        "tag": "H2",
        "text": "2. schemaとkind"
      },
      {
