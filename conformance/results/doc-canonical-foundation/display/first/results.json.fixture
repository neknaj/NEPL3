[
  {
    "headings": [
      {
        "tag": "H1",
        "text": "02. 共通データ契約"
      },
      {
        "tag": "H2",
        "text": "方針"
      },
      {
        "tag": "H2",
        "text": "1. SourceとRange"
      },
      {
        "tag": "H2",
        "text": "2. schemaとkind"
      },
      {
        "tag": "H2",
        "text": "3. Tokenと構文"
      },
      {
        "tag": "H2",
        "text": "4. 内部view"
      },
      {
        "tag": "H2",
        "text": "5. Origin graph"
      },
      {
        "tag": "H2",
        "text": "6. 名前・関係"
      },
      {
        "tag": "H3",
        "text": "6.1. 共通factsと専用処理の変更範囲"
      },
      {
        "tag": "H2",
        "text": "7. 診断とevent"
      },
      {
        "tag": "H2",
        "text": "8. 予算と結果"
      }
    ],
    "codes": [
      "SourceId",
      "Revision",
      "SnapshotId = (SourceId, Revision, contentDigest)",
      "Span = (SnapshotId, start:u64, end:u64)",
      "[start,end)",
      "0 <= start <= end <= source.len",
      "SchemaRef = (packageName, revision, digest)",
      "KindRef = (SchemaRef, LocalKindId)",
      "List<T>",
      "Option<T>",
      "HeadShape = {arity, arguments, transitionRecipe}",
      "ViewElement = {kind, span, fields, roles, relations}",
      "Origin = Direct(Span) | Composite(List<OriginId>) | Generated(operation, callsite, inputs) | Synthetic(reason, anchor)",
      "SourceMap",
      "EntityId",
      "Occurrence",
      "ScopeId",
      "[start,end)",
      "traceOverflow: Option<TraceOverflow>"
    ],
    "preamble": "atomic pointerを使えるnative/Wasmでは、SourceAdmissionが受入済みの不変snapshot storageを操作内だけで所有し、索引化できる。同じstorageの再受入には既存の証明を再利用し、独立decodeのstorageにはsource/revision/digest/URIとSourceBytesの検査を行う。所有参照を保持して、addressの再利用を防ぐ。内部addressをwire・identity・出力へ含めてはならない。索引のWorkには要素数による探索・shiftの上界を事前計上し、allocatorの配置によるUsageの差を防ぐ。別のSourceAdmissionや非atomic targetへ、この証明を引き継がない。",
    "preamble_before_policy": true,
    "facts_parent": "n-6e616d65735f72656c6174696f6e73",
