from pathlib import Path
import subprocess, json, hashlib, sys

root = Path(__file__).resolve().parent.parent
out = root / '.tmp/canonical-verification'
out.mkdir(parents=True, exist_ok=True)
commands = [
    ['rustc', '--version', '--verbose'],
    ['cargo', 'fmt', '--all', '--', '--check'],
    ['cargo', 'test', '--locked', '-p', 'nepl3-tools', '--lib'],
    ['cargo', 'test', '--locked', '-p', 'nepl3-tools', '--test', 'doc'],
    ['cargo', 'clippy', '--workspace', '--all-targets', '--locked', '--', '-D', 'warnings'],
    ['cargo', 'build', '--locked', '-p', 'nepl3-tools'],
]
records = []
for index, cmd in enumerate(commands):
    result = subprocess.run(cmd, cwd=root, capture_output=True, timeout=1200)
    for channel in ['stdout', 'stderr']:
        (out / f'{index}-{channel}.log').write_bytes(getattr(result, channel))
    records.append(dict(command=cmd, exit_code=result.returncode))
    print(index, result.returncode, ' '.join(cmd), flush=True)
    (out / 'commands.json').write_text(json.dumps(records, indent=2)+'\n', encoding='utf-8', newline='\n')
    if result.returncode:
        sys.exit(result.returncode)
binary = root / 'target/debug/nepl3-tools.exe'
args = ['doc-markdown', 'annotated', 'doc/spec/13-reproducibility.nepld', 'doc/migration/aliases/13-reproducibility.json']
for name in ['13-first.md', '13-second.md']:
    destination = out / name
    result = subprocess.run([str(binary), *args, str(destination)], cwd=root, capture_output=True, timeout=300)
    (out / (name + '.stdout.log')).write_bytes(result.stdout)
    (out / (name + '.stderr.log')).write_bytes(result.stderr)
    if result.returncode:
        sys.exit(result.returncode)
first = (out/'13-first.md').read_bytes()
assert first == (out/'13-second.md').read_bytes()
(root/'doc/spec/13-reproducibility.md').write_bytes(first)
for index, args in enumerate([
    ['doc-canonical', '--check'],
    ['doc-canonical', 'html', 'dist/canonical-first'],
    ['doc-canonical', 'html', 'dist/canonical-second'],
    ['check'],
]):
    result = subprocess.run([str(binary), *args], cwd=root, capture_output=True, timeout=600)
    (out / f'operation-{index}-stdout.log').write_bytes(result.stdout)
    (out / f'operation-{index}-stderr.log').write_bytes(result.stderr)
    records.append(dict(command=[str(binary), *args], exit_code=result.returncode))
    print('operation', index, result.returncode, flush=True)
    (out / 'commands.json').write_text(json.dumps(records, indent=2)+'\n', encoding='utf-8', newline='\n')
    if result.returncode:
        sys.exit(result.returncode)
def digests(directory):
    return {p.relative_to(directory).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(directory.rglob('*')) if p.is_file()}
assert digests(root/'dist/canonical-first') == digests(root/'dist/canonical-second')
(out/'reproduction.json').write_text(json.dumps(dict(markdown_sha256=hashlib.sha256(first).hexdigest(), html_files=digests(root/'dist/canonical-first')), indent=2)+'\n', encoding='utf-8', newline='\n')
print('Exact Markdown and HTML reproduction passed', flush=True)
