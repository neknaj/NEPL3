from pathlib import Path
from functools import partial
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
from threading import Thread
from playwright.sync_api import sync_playwright
import json, sys
from urllib.parse import quote

root = Path(__file__).resolve().parent.parent
out = root / '.tmp/canonical-browser-display'
out.mkdir(parents=True, exist_ok=True)
sections = ['policy', 'digest', 'semantic', 'execution', 'wire', 'artifacts', 'limits']
semantic = ['n-' + s.encode().hex() for s in sections]
legacy = ['13-再現性schema識別契約の判定', '方針', '1-digest', 'package意味正規形', '具体実行identity', '2-native値とwire値', '3-normal-formとartifact', '4-limitsとproviderの互換']
links = ['https://www.rfc-editor.org/rfc/rfc3986.html#section-3.1', 'https://www.rfc-editor.org/rfc/rfc3987.html']
class Quiet(SimpleHTTPRequestHandler):
    def log_message(self, *args): pass
server = ThreadingHTTPServer(('127.0.0.1', 0), partial(Quiet, directory=str(root/'dist')))
thread = Thread(target=server.serve_forever, daemon=True)
thread.start()
rows = []
try:
    with sync_playwright() as playwright:
        for name in ['chromium', 'firefox', 'webkit']:
            browser = getattr(playwright, name).launch(headless=True)
            for prefix in ['canonical-first', 'canonical-second']:
                for width in [375, 1280]:
                    context = browser.new_context(java_script_enabled=False, viewport={'width':width, 'height':900})
                    page = context.new_page()
                    failures = []
                    page.on('requestfailed', lambda r: failures.append(r.url))
                    url = f'http://127.0.0.1:{server.server_port}/{prefix}/docs/spec/13-reproducibility.html'
                    response = page.goto(url, wait_until='networkidle')
                    row = page.evaluate('''() => ({scripts:document.scripts.length,
                        article_language:document.querySelector('article').lang,
                        headings:[...document.querySelectorAll('h1,h2,h3')].map(n=>n.textContent),
                        links:[...document.querySelectorAll('a[href]')].map(n=>n.getAttribute('href')),
                        ids:[...document.querySelectorAll('[id]')].map(n=>n.id),
                        ruby:document.querySelectorAll('.nepl-ruby').length,
                        styles:[...document.styleSheets].map(s=>s.cssRules.length)})''')
                    assert response.status == 200 and not failures
                    assert row['scripts'] == 0 and row['article_language'] == 'ja'
                    assert len(row['headings']) == 8 and row['links'] == links
                    assert row['ruby'] == 674 and row['styles'] and all(row['styles'])
                    assert len(row['ids']) == len(set(row['ids']))
                    assert set(semantic) <= set(row['ids'])
                    navigation = []
                    for identity in semantic:
                        page.goto(url + '#' + identity, wait_until='load')
                        target = page.locator('[id="' + identity + '"]')
                        assert target.count() == 1
                        box = target.bounding_box()
                        assert box is not None and box['y'] < 900 and box['y'] + box['height'] > 0
                        navigation.append(dict(id=identity, box=box))
                    page.goto(url, wait_until='load')
                    # Fragment navigation retains the sequential focus start in
                    # some engines. Start the keyboard check in a fresh document.
                    page.reload(wait_until='load')
                    focused = []
                    for expected in links:
                        page.keyboard.press('Tab')
                        active = page.evaluate('document.activeElement.getAttribute("href")')
                        focused.append(active)
                    stem = f'{name}-{prefix}-{width}'
                    ax = page.locator('article').aria_snapshot()
                    assert 'RFC 3986' in ax and 'RFC 3987' in ax
                    (out/(stem+'.aria.txt')).write_text(ax, encoding='utf-8', newline='\n')
                    page.goto(url, wait_until='load')
                    page.screenshot(path=str(out/(stem+'.png')))
                    row.update(browser=name, version=browser.version, width=width, prefix=prefix,
                        navigation=navigation, focused=focused, keyboard='Tab after full reload',
                        keyboard_result=('passed' if focused == links else 'failed'),
                        failed_requests=failures, display_and_fragment_result='passed')
                    rows.append(row)
                    print(stem, 'passed', flush=True)
                    context.close()
            browser.close()
finally:
    server.shutdown()
    server.server_close()
    thread.join()
    (out/'local.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2)+'\n', encoding='utf-8', newline='\n')
