from pathlib import Path
from playwright.sync_api import sync_playwright
from urllib.parse import quote
import subprocess, json

root = Path(__file__).resolve().parent.parent
out = root / '.tmp/canonical-github'
out.mkdir(parents=True, exist_ok=True)
head = subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip()
url = f'https://github.com/neknaj/NEPL3/blob/{head}/doc/spec/13-reproducibility.md'
legacy = ['13-再現性schema識別契約の判定', '方針', '1-digest', 'package意味正規形', '具体実行identity', '2-native値とwire値', '3-normal-formとartifact', '4-limitsとproviderの互換']
semantic = ['n-'+s.encode().hex() for s in ['policy','digest','semantic','execution','wire','artifacts','limits']]
rows=[]
try:
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        page = browser.new_page(viewport={'width':1280,'height':1000})
        response = page.goto(url,wait_until='domcontentloaded',timeout=90000)
        page.locator('article.markdown-body').wait_for(timeout=60000)
        (out/'page.html').write_text(page.content(),encoding='utf-8',newline='\n')
        elements = page.locator('article.markdown-body').evaluate('''a=>[...a.querySelectorAll('[id],[name]')].map(n=>({tag:n.tagName,id:n.id,name:n.getAttribute('name'),text:n.textContent}))''')
        (out/'elements.json').write_text(json.dumps(elements,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
        for fragment in legacy+semantic:
            target = page.locator('article.markdown-body').locator('[id="user-content-'+fragment+'"], [name="user-content-'+fragment+'"]')
            assert target.count()==1, (fragment,target.count())
            # Real same-page navigation, including GitHub's unprefixed-to-user-content handling.
            page.goto(url+'#'+quote(fragment,safe='-'),wait_until='domcontentloaded')
            page.wait_for_function('''f=>{
                const t=document.getElementById('user-content-'+f)||document.getElementsByName('user-content-'+f)[0];
                if(!t)return false; const b=t.getBoundingClientRect();
                return b.top>=-1 && b.top<innerHeight;
            }''',arg=fragment,timeout=15000)
            geometry = target.evaluate('n=>({top:n.getBoundingClientRect().top,scrollY:scrollY,hash:location.hash,text:n.textContent})')
            rows.append(dict(fragment=fragment,geometry=geometry,result='passed'))
        page.screenshot(path=str(out/'final-anchor.png'))
        browser.close()
finally:
    (out/'results.json').write_text(json.dumps(dict(head=head,url=url,rows=rows),ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
print('GitHub final path anchors:',len(rows),'passed')
