from pathlib import Path
import json,time
from urllib.parse import quote
from playwright.sync_api import sync_playwright
r=Path(__file__).resolve().parent
original=json.loads((r/'original/canonical-github/results.json').read_text(encoding='utf-8'))
rows=[]
with sync_playwright() as p:
 b=p.chromium.launch(headless=True)
 page=b.new_page(viewport={'width':1280,'height':1000},reduced_motion='reduce')
 response=page.goto(original['url'],wait_until='networkidle',timeout=90000)
 page.locator('article.markdown-body').wait_for(timeout=60000)
 for item in original['rows']:
  f=item['fragment'];page.goto(original['url'],wait_until='domcontentloaded')
  target=page.locator('article.markdown-body').locator('[id="user-content-'+f+'"], [name="user-content-'+f+'"]')
  assert target.count()==1
  absolute=target.evaluate('n=>n.getBoundingClientRect().top+scrollY')
  page.evaluate('(y)=>window.scrollTo({top:y,behavior:"instant"})',10000000 if absolute<4000 else 0)
  before=target.evaluate('n=>({top:n.getBoundingClientRect().top,scrollY:scrollY})')
  assert before['top']<0 or before['top']>=1000
  page.goto(original['url']+'#'+quote(f,safe='-'),wait_until='domcontentloaded')
  previous=None;stable=0
  for _ in range(100):
   current=target.evaluate('n=>({top:n.getBoundingClientRect().top,scrollY:scrollY,hash:location.hash})')
   if previous and abs(current['scrollY']-previous['scrollY'])<.1:stable+=1
   else:stable=0
   previous=current
   if stable>=5 and 0<=current['top']<1000:break
   page.wait_for_timeout(100)
  assert stable>=5 and 0<=current['top']<1000,(f,current)
  assert abs(before['scrollY']-current['scrollY'])>1,(f,before,current)
  rows.append(dict(fragment=f,before=before,after=current,stable_samples=stable,result='passed'))
  print(f.encode('ascii','backslashreplace').decode(),current['top'],flush=True)
 (r/'independent-github.json').write_text(json.dumps(dict(url=original['url'],status=response.status,browser=b.version,method='start with target outside viewport, then actual hash navigation, >=5 stable scroll samples',rows=rows),ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
 b.close()
