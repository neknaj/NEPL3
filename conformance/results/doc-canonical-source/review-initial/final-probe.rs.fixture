use nepl3_tools::doc::{canonical, projection::annotated::host, source};
use serde_json::json;
use std::{fs, path::Path};
type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
fn registry(root: &Path, source: &str, projection: &str) -> Result<()> {
    fs::write(root.join("doc/canonical.json"), serde_json::to_vec(&json!({"version":1,"pages":[{"id":"sample","source":source,"projection":projection,"aliases":"doc/aliases.json","route":"docs/sample.html","renderer":"nepl3-tools.markdown-annotated/1"}]}))?)?;
    Ok(())
}
fn main() -> Result<()> {
    let root = std::env::args().nth(1).ok_or("fixture root")?;
    let root = Path::new(&root);
    fs::create_dir_all(root.join("doc/real"))?;
    let text = r#"article en "Title" body cons paragraph cons "A[B/read]{C/note}" nil nil"#;
    let compiled = source::compiled()?;
    registry(root,"doc/sample.nepld","doc/sample.md")?;
    fs::write(root.join("doc/sample.nepld"), text)?;
    fs::write(root.join("doc/aliases.json"), b"[]")?;
    let generated = host::generate(&compiled,"doc/sample.nepld",text,b"[]")?;
    assert!(generated.contains("AB\\[read\\]C\\{note\\}"));
    fs::write(root.join("doc/sample.md"), &generated)?;
    canonical::check(root,"doc/canonical.json")?;
    let mut cases = vec![json!({"case":"exact_generation","passed":true})];
    for (name,path,value) in [
        ("stale_projection","doc/sample.md",generated.clone()+"stale\n"),
        ("source_only_change","doc/sample.nepld",text.replace("Title","Other")),
        ("aliases_byte_change","doc/aliases.json","[ ]".to_owned()),
        ("unknown_alias_section","doc/aliases.json",r#"[{"section":"missing","name":"old"}]"#.to_owned()),
        ("invalid_source","doc/sample.nepld","not an article".to_owned()),
    ] {
        let path=root.join(path);let before=fs::read(&path)?;fs::write(&path,&value)?;
        let error=canonical::check(root,"doc/canonical.json").err().ok_or("invalid accepted")?;
        assert_eq!(fs::read(&path)?,value.as_bytes());fs::write(path,before)?;
        cases.push(json!({"case":name,"error":error.to_string()}));
    }
    for (name,value) in [
        ("duplicate_json",r#"{"version":1,"version":1,"pages":[]}"#),
        ("unknown_key",r#"{"version":1,"pages":[],"extra":false}"#),
    ] {
        fs::write(root.join("doc/canonical.json"),value)?;
        cases.push(json!({"case":name,"error":canonical::load(root,"doc/canonical.json").err().ok_or("bad registry accepted")?.to_string()}));
    }
    registry(root,"doc/sample.nepld","doc/sample.md")?;
    canonical::html(root,"doc/canonical.json",&root.join("output"))?;
    let rendered=fs::read(root.join("output/docs/sample.html"))?;
    assert!(String::from_utf8_lossy(&rendered).contains("nepl-ruby"));
    assert!(String::from_utf8_lossy(&rendered).contains("nepl-notes"));
    assert!(canonical::html(root,"doc/canonical.json",&root.join("output")).is_err());
    assert_eq!(fs::read(root.join("output/docs/sample.html"))?,rendered);
    cases.push(json!({"case":"html_and_existing_output","passed":true}));
    // Observe Windows filesystem spelling aliases; do not pre-judge the intended contract.
    fs::write(root.join("doc/real/input.nepld"),text)?;
    fs::write(root.join("doc/hash#name.nepld"),text)?;
    for name in ["doc/hash#name.nepld","doc/real/input.nepld","doc/real./input.nepld","doc/real /input.nepld","doc/linked/input.nepld"] {
        registry(root,name,"doc/sample.md")?;
        fs::write(root.join("doc/sample.md"),host::generate(&compiled,name,text,b"[]")?)?;
        let result=canonical::check(root,"doc/canonical.json");
        cases.push(json!({"case":"physical_alias","path":name,"accepted":result.is_ok(),"error":result.err().map(|e|e.to_string())}));
    }
    registry(root,"doc/hash#name.nepld","doc/sample.md")?;
    let result=canonical::html(root,"doc/canonical.json",&root.join("hash-output"));
    cases.push(json!({"case":"hash_source_html","accepted":result.is_ok(),"error":result.err().map(|e|e.to_string())}));
    fs::write(root.join("results.json"),serde_json::to_vec_pretty(&cases)?)?;
    println!("{} independent checks/observations",cases.len());
    Ok(())
}
