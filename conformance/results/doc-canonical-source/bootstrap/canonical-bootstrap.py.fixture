from pathlib import Path
from playwright.sync_api import sync_playwright
import hashlib, json

root=Path(__file__).resolve().parent.parent
out=root/'.tmp/canonical-bootstrap'
out.mkdir(parents=True,exist_ok=True)
artifact=root/'dist/canonical-snapshot'
original=root/'dist/canonical-first'
paths=[p.relative_to(artifact) for p in artifact.rglob('*') if p.is_file()]
assert len(paths)==3
for path in paths:
    assert (artifact/path).read_bytes()==(original/path).read_bytes()
rows=[]
with sync_playwright() as p:
    for name in ['chromium','firefox','webkit']:
        browser=getattr(p,name).launch(headless=True)
        context=browser.new_context(java_script_enabled=False)
        page=context.new_page()
        response=page.goto((artifact/'docs/spec/13-reproducibility.html').as_uri(),wait_until='load')
        row=page.evaluate('''()=>({scripts:document.scripts.length,
            ruby:document.querySelectorAll('.nepl-ruby').length,
            headings:document.querySelectorAll('h1,h2,h3').length,
            background:getComputedStyle(document.querySelector('article')).backgroundColor,
            css:[...document.querySelectorAll('link[rel=stylesheet]')].map(n=>!!n.sheet)})''')
        assert row['scripts']==0 and row['ruby']==674 and row['headings']==8
        # The user palette's primary background is --nepl-bg (#0d1117),
        # not the third background color --nepl-bg3 (#0c1118).
        assert row['background']=='rgb(13, 17, 23)' and row['css']==[True]
        row.update(browser=name,version=browser.version,result='passed')
        rows.append(row)
        context.close();browser.close()
(out/'results.json').write_text(json.dumps(dict(scope='restore archived byte-identical snapshot and read file URLs with JavaScript disabled; no Rust compilation',initial_failure='Initial probe asserted the third background palette instead of the primary background. Corrected the expected CSS color from --nepl-bg3 to --nepl-bg; no production or artifact change.',files={p.as_posix():hashlib.sha256((artifact/p).read_bytes()).hexdigest() for p in paths},rows=rows),indent=2)+'\n',encoding='utf-8',newline='\n')
for file in ['canonical-bootstrap.py','restore-canonical.py']:
    (out/file).write_bytes((root/'.tmp'/file).read_bytes())
items=[dict(path=f.name,bytes=f.stat().st_size,sha256=hashlib.sha256(f.read_bytes()).hexdigest()) for f in sorted(out.iterdir()) if f.name!='manifest.json']
(out/'manifest.json').write_text(json.dumps(dict(files=items),indent=2)+'\n',encoding='utf-8',newline='\n')
print('Three-engine compiler-free, script-free restored snapshot: passed')
