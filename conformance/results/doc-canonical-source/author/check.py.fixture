from pathlib import Path
import sys,json,re,hashlib,difflib
import mistune
from bs4 import BeautifulSoup
p=Path(__file__).resolve().parent;root=p.parents[1]
sys.path.insert(0,str(root))
from tools.audit.structure import Parser,load_forms
exec(compile((p/'helpers.py').read_text(encoding='utf-8'),'helpers.py','exec'))
c=json.loads((p/'capture.json').read_text(encoding='utf-8'))
def visible(n):
    if isinstance(n,list):return ''.join(visible(x) for x in n)
    if not isinstance(n,dict):return ''
    k=n['kind'];f=n['fields']
    if k=='Link':return visible(f['label'])
    if k in ('Text','InlineCode','RawCode'):return f['text']
    return ''.join(visible(x) for x in f.values())
results=[]
for i,(source,draft) in enumerate(c['pairs']):
    old=(p/(str(i)+'-draft-before.txt')).read_bytes();new=(root/draft).read_bytes()
    assert b'\r' not in new and not new.startswith(b'\xef\xbb\xbf')
    tree=Parser(new.decode(),load_forms(root)).complete('Doc/Article')
    audit_text(tree);pairs.clear();base=normalize(tree,True)
    paragraphs=[visible(n) for n in walk(base) if n['kind']=='Paragraph']
    source_snapshot=p/('0-source-path-delta.md' if i==0 else str(i)+'-source-before.txt')
    src=source_snapshot.read_text(encoding='utf-8')
    html=BeautifulSoup(mistune.create_markdown(escape=False)(src),'html.parser')
    mparas=[n.get_text().replace('\n','') for n in html.find_all(['p','li'])]
    markers=[['未移行ページのMarkdown','等価な既存表現','独立した意味同等性レビュー','意味同等性レビューは、','doc/canonical.json のversion','nepl3-tools doc-canonical --check','nepl3-tools doc-canonical html <new-directory>','互換aliasとGitHub'],['正本registryに登録'],['doc/canonical.json に登録'],['最終文書はNEPL3']][i]
    checks=[]
    if i==0:markers.append('version 1のregistry pathとroute')
    for marker in markers:
        expected=next(t for t in mparas if marker in t)
        if i==0 and marker=='未移行ページのMarkdown':expected='。'.join(expected.split('。')[:2])+'。'
        if i==0 and marker=='等価な既存表現':expected=next(t+'。' for t in expected.split('。') if '等価な既存表現' in t)
        assert any(expected in x for x in paragraphs),(i,marker,expected)
        checks.append(expected)
    oldtree=normalize(Parser(old.decode(),load_forms(root)).complete('Doc/Article'))
    def codeitems(t):return [(n['kind'],n['fields']['text']) for n in walk(t) if n['kind'] in ('InlineCode','RawCode')]
    addedcodes=codeitems(base)
    for item in codeitems(oldtree):addedcodes.remove(item)
    oldhtml=BeautifulSoup(mistune.create_markdown(escape=False)((p/(str(i)+'-source-base.md')).read_text(encoding='utf-8')),'html.parser')
    newcode=[n.get_text() for n in html.find_all('code')]
    for n in oldhtml.find_all('code'):newcode.remove(n.get_text())
    assert [x[1] for x in addedcodes]==newcode
    def links(t):return [(n['fields']['target'],visible(n['fields']['label'])) for n in walk(t) if n['kind']=='Link']
    addedlinks=links(base)
    for item in links(oldtree):addedlinks.remove(item)
    sourcelinks=[(n['href'],n.get_text()) for n in html.find_all('a')]
    for n in oldhtml.find_all('a'):sourcelinks.remove((n['href'],n.get_text()))
    assert [(x['fields']['path'],text) for x,text in addedlinks]==sourcelinks
    aa=old.decode().splitlines(True);bb=new.decode().splitlines(True)
    changes=[]
    for tag,a,b,c1,d in difflib.SequenceMatcher(None,aa,bb,autojunk=False).get_opcodes():
        if tag!='equal':changes.append({'kind':tag,'old_lines':[a+1,b],'new_lines':[c1+1,d],'removed':aa[a:b],'added':bb[c1:d]})
    assert sum(len(x['removed']) for x in changes)==[3,0,0,1][i]
    assert all(x['kind'] in ('insert','replace') for x in changes)
    if i==0:
        registry=next(n for n in walk(base) if n['kind']=='Section' and n['fields']['id']=='registry')
        assert visible(registry['fields']['title'])=='正本registryと生成物の検査'
        assert len(registry['fields']['body']['fields']['blocks'])==6
        assert visible(registry['fields']['body']['fields']['blocks'][-1]).startswith('文書をrenderしただけで、')
    (p/(str(i)+'-draft-after.nepld')).write_bytes(new)
    (p/(str(i)+'-draft.patch')).write_text(''.join(difflib.unified_diff(aa,bb,fromfile=draft,tofile=draft)),encoding='utf-8',newline='\n')
    results.append({'source':source,'draft':draft,'source_sha256':hashlib.sha256(src.encode()).hexdigest(),'draft_before_sha256':hashlib.sha256(old).hexdigest(),'draft_after_sha256':hashlib.sha256(new).hexdigest(),'source_still_fixed':(root/source).read_bytes()==source_snapshot.read_bytes(),'matched_text':checks,'added_code':newcode,'added_links':sourcelinks,'changed_ranges':changes,'unrelated_lines_unchanged':True,'formal_structure':True,'ruby_ordinary_text_audit':True})
(p/'result.json').write_text(json.dumps({'scope':'Author self-check only','files':results,'production_parser':False,'html':False,'independent_review':False,'main_cutover':False},ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
print(json.dumps([{k:r[k] for k in ['source','draft','source_sha256','draft_after_sha256','source_still_fixed']} for r in results]))
