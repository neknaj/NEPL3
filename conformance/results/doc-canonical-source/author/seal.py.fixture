from pathlib import Path
import subprocess,sys,json,hashlib
p=Path(__file__).resolve().parent;root=p.parents[1]
c=json.loads((p/'capture.json').read_text())
r=subprocess.run([sys.executable,str(p/'check.py')],cwd=root,capture_output=True)
(p/'check.log').write_bytes(r.stdout+r.stderr);assert r.returncode==0
initial=json.loads((p/'result-initial.json').read_text(encoding='utf-8'))
latest=json.loads((p/'result.json').read_text(encoding='utf-8'))
for a,b in zip(initial['files'][1:],latest['files'][1:]):assert a['draft_after_sha256']==b['draft_after_sha256']
import difflib
aa=(p/'0-draft-initial.nepld').read_text(encoding='utf-8').splitlines(True)
bb=(p/'0-draft-after.nepld').read_text(encoding='utf-8').splitlines(True)
edits=[x for x in difflib.SequenceMatcher(None,aa,bb,autojunk=False).get_opcodes() if x[0]!='equal']
assert len(edits)==1 and edits[0][0]=='insert' and edits[0][4]-edits[0][3]==7
(p/'path-delta.patch').write_text(''.join(difflib.unified_diff(aa,bb)),encoding='utf-8',newline='\n')
r=subprocess.run(['git','diff','--check','--',*(x[1] for x in c['pairs'])],cwd=root,capture_output=True)
(p/'draft-diff-check.log').write_bytes(r.stdout+r.stderr);assert r.returncode==0
files=[]
for f in sorted(p.iterdir()):
    if f.is_file() and f.name!='manifest.json':
        b=f.read_bytes();files.append({'path':f.name,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
(p/'manifest.json').write_text(json.dumps({'scope':'Manual canonical registry source delta synchronization, four authored drafts','drafts':[x[1] for x in c['pairs']],'production_edited':False,'independent_review':False,'runtime':False,'main_cutover':False,'files':files},indent=2)+'\n',encoding='utf-8',newline='\n')
print(hashlib.sha256((p/'manifest.json').read_bytes()).hexdigest())
