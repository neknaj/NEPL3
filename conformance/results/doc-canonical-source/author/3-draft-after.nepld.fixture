      cons item none body
        cons paragraph
          cons sentence
            cons ruby text "変更後" text "へんこうご" cons text "は " cons code "doc/development.md" cons text " の" cons ruby text "検査" text "けんさ" cons text "を" cons ruby text "実行" text "じっこう" cons text "し、diffを" cons ruby text "確認" text "かくにん" cons text "する。" nil
          cons "[未実行/みじっこう]の[受入試験/うけいれしけん]をCI[成功/せいこう]から[推定/すいてい]しない。"
          nil
        nil
      cons item none body
        cons paragraph
          cons sentence
            cons code "tools" cons text " は" cons ruby text "開発" text "かいはつ" cons text "host" cons ruby text "用" text "よう" cons text "。" nil
          cons "JSONなどの[動的入力境界/どうてきにゅうりょくきょうかい]でのみ[動的/どうてき]な[値/あたい]を[使/つか]い、[言語/げんご]の[意味/いみ]モデルの[代用/だいよう]にしない。"
          nil
        nil
      cons item none body
        cons paragraph
          cons "Web UIは[純粋/じゅんすい]TEAのnepl3-ui-coreとhost adapterを[分/わ]け、UI coreからsuite・DOM・Worker・I/Oを[実行/じっこう]しない。"
          cons "UI/Workerの[型/かた]・codec・[不変条件/ふへんじょうけん]を[実装/じっそう]してR006/R009の[関連課題/かんれんかだい]を[解消/かいしょう]し、[公開契約/こうかいけいやく]を[確定/かくてい]する[前/まえ]に[検証/けんしょう]する。"
          nil
        nil
      cons item none body
        cons paragraph
          cons "[最終文書/さいしゅうぶんしょ]はNEPL3 Doc DSLへ[移行/いこう]する。"
          cons "[未移行/みいこう]ページはMarkdownを[正本/せいほん]とし、T21の[表現/ひょうげん]gap[監査/かんさ]・[意味同等性/いみどうとうせい]・リンク/[安定/あんてい]ID・bootstrap[検査後/けんさご]にページ[単位/たんい]で[切/き]り[替/か]える。"
          cons "[移行済/いこうず]みページの[正本/せいほん]はdoc/canonical.jsonを[参照/さんしょう]し、[生成/せいせい]Markdownを[手編集/てへんしゅう]しない。"
          cons "AGENTS[等/とう]の[必要/ひつよう]なMarkdownはDoc[正本/せいほん]からの[生成/せいせい]projectionを[許/ゆる]すが[二重手書/にじゅうてが]き[保守/ほしゅ]は[禁止/きんし]。"
          nil
        nil
      cons item none body
        cons paragraph
          cons sentence
            cons ruby text "日本語文書" text "にほんごぶんしょ" cons text "の" cons ruby text "振" text "ふ" cons text "り" cons ruby text "仮名" text "がな" cons text "は " cons link external "https://github.com/neknaj/gloss#ruby" concat cons text "GlossのRuby" cons ruby text "指針" text "ししん" nil cons text " に" cons ruby text "従" text "したが" cons text "い" cons ruby text "漢字部分" text "かんじぶぶん" cons text "へ" cons ruby text "付" text "つ" cons text "け、" cons ruby text "仮名" text "かな" cons text "・" cons ruby text "数字" text "すうじ" cons text "・" cons ruby text "記号" text "きごう" cons text "をRubyの" cons ruby text "本体" text "ほんたい" cons text "へまとめない。" nil
          cons "[送/おく]り[仮名/がな]や[助詞/じょし]は[通常/つうじょう]のTextとし、[語句全体/ごくぜんたい]の[英訳/えいやく]はAnnoへ[置/お]く。"
          cons "prefix[構築/こうちく]では[必要/ひつよう]に[応/おう]じてAnnoのbaseをConcatで[組/く]み、[漢字部分/かんじぶぶん]のRubyと[通常/つうじょう]Textを[併存/へいそん]させる。"
          cons "これは[日本語文書/にほんごぶんしょ]の[執筆方針/しっぴつほうしん]であり、Rubyによる[他言語/たげんご]の[発音注釈/はつおんちゅうしゃく]をDSLの[型/かた]やparserで[禁止/きんし]する[規則/きそく]ではない。"
          nil
