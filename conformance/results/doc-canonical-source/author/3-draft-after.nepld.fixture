article ja "[実装指示/じっそうしじ]" body
  cons section norms "[規範/きはん]" body
    cons paragraph
      cons sentence
        cons code "doc/spec/" cons text " と " cons code "design/forms.json" cons text " を" cons ruby text "実装契約" text "じっそうけいやく" cons text "とする。" nil
      cons "[既存/きそん]の[会話/かいわ]にある[説明用/せつめいよう]の[文法/ぶんぽう]へ[勝手/かって]に[戻/もど]さない。"
      cons "[設計/せっけい]の[誤/あやま]りが[発覚/はっかく]した[場合/ばあい]は、[仕様/しよう]・schema・[全影響箇所/ぜんえいきょうかしょ]・conformanceを[同/おな]じ[変更/へんこう]で[修正/しゅうせい]し、[変更理由/へんこうりゆう]を[記録/きろく]する。"
      cons "[実装困難/じっそうこんなん]な[部分/ぶぶん]を[省略/しょうりゃく]して[完了/かんりょう]と[報告/ほうこく]してはならない。"
      nil
    nil
  cons section quality "コード[品質/ひんしつ]" body
    cons paragraph
      cons sentence
        cons ruby text "全" text "ぜん" cons text "coreは " cons code "#![no_std]" cons text " と " cons code "extern crate alloc" cons text "。" nil
      cons "プラットフォームI/O、[時計/とけい]、[環境変数/かんきょうへんすう]、ネットワーク、stdout/stderrはappsまたは[開発用/かいはつよう]toolsだけで[扱/あつか]う。"
      cons "[通常/つうじょう]の[失敗/しっぱい]は[型付/かたつ]きResult、[未存在/みそんざい]はOption。"
      cons "[入力/にゅうりょく]によるpanic、unwrap、todo、unimplemented、[黙殺/もくさつ]fallbackは[禁止/きんし]。"
      cons "[内部不変条件/ないぶふへんじょうけん]のassertも[外部入力/がいぶにゅうりょく]の[検査後/けんさご]に[限/かぎ]る。"
      nil
    cons paragraph
      cons "core[内/ない]の[公開/こうかい]データはstruct/enumで[表/あらわ]す。"
      cons sentence
        cons text "schemaの" cons ruby text "動的境界" text "どうてききょうかい" cons text "を" cons ruby text "除" text "のぞ" cons text "いて、" cons ruby text "文字列" text "もじれつ" cons text "キーの" cons ruby text "万能辞書" text "ばんのうじしょ" cons text "や " cons code "Any" cons text " を" cons ruby text "使" text "つか" cons text "わない。" nil
      cons "[外部境界/がいぶきょうかい]では[必/かなら]ずschema validationを[行/おこな]う。"
      cons "coreの[標準出力/ひょうじゅんしゅつりょく]へのログは[禁止/きんし]。"
      cons "[診断/しんだん]・eventを[返/かえ]り[値/ち]として[返/かえ]す。"
      nil
    cons paragraph
      cons sentence
        cons code "design/dependencies.json" cons text " にないworkspace" cons ruby text "依存" text "いぞん" cons text "を" cons ruby text "追加" text "ついか" cons text "する" cons ruby text "前" text "まえ" cons text "に" cons ruby text "依存仕様" text "いぞんしよう" cons text "を" cons ruby text "修正" text "しゅうせい" cons text "し、DAG・no_std・" cons ruby text "責務" text "せきむ" cons text "を" cons ruby text "再検査" text "さいけんさ" cons text "する。" nil
      cons "doc/math/circuit core[同士/どうし]の[直接依存/ちょくせついぞん]は[禁止/きんし]。"
      cons "production[側/がわ]からtools/appsへの[依存/いぞん]は[禁止/きんし]。"
      cons sentence
        cons text "ファイル" cons ruby text "名" text "めい" cons text "へ" cons ruby text "擬似的" text "ぎじてき" cons text "な" cons ruby text "階層" text "かいそう" cons text "を " cons code "_" cons text " で" cons ruby text "詰" text "つ" cons text "めず、ディレクトリで" cons ruby text "責務" text "せきむ" cons text "を" cons ruby text "表" text "あらわ" cons text "す。" nil
      nil
    nil
  cons section completion "[完成条件/かんせいじょうけん]" body
    cons paragraph
      cons "[各/かく]タスクに[記載/きさい]した[失敗系/しっぱいけい]・[境界系/きょうかいけい]・roundtrip・cross-target・portable-provider[比較/ひかく]を[実行/じっこう]する。"
      cons "goldenの[更新/こうしん]を[正/ただ]しさの[代/か]わりにしない。"
      cons "[期待値/きたいち]の[根拠/こんきょ]をテストに[記述/きじゅつ]する。"
      cons "[未実行/みじっこう]を[成功/せいこう]として[報告/ほうこく]しない。"
      nil
    nil
  cons section sequence "[作業/さぎょう]の[順序/じゅんじょ]" body
    cons paragraph
      cons sentence
        cons code "design/tasks.json" cons text " の" cons ruby text "依存順" text "いぞんじゅん" cons text "に" cons ruby text "実装" text "じっそう" cons text "する。" nil
      cons "[段階/だんかい]ごとにbuildできることと、[最終仕様/さいしゅうしよう]を[縮小/しゅくしょう]することは[別/べつ]である。"
      cons "[後段/こうだん]の[未実装/みじっそう]を[成功/せいこう]Resultやダミー[成果物/せいかぶつ]で[覆/おお]わない。"
      cons sentence
        cons ruby text "実装状態" text "じっそうじょうたい" cons text "は " cons code "implementation-status.json" cons text " で" cons ruby text "仕様状態" text "しようじょうたい" cons text "と" cons ruby text "分離" text "ぶんり" cons text "する。" nil
      nil
    cons paragraph
      cons "Rust[以外/いがい]によるcore[実装/じっそう]への[置換/ちかん]では、[同/おな]じ[操作/そうさ]schemaとconformanceを[使用/しよう]する。"
      cons "[公開契約/こうかいけいやく]をRust[型/がた]のABI、serdeのデフォルトenum[表現/ひょうげん]、ネイティブpointerに[依存/いぞん]させない。"
      nil
    nil
  cons section repository "このリポジトリでの[作業/さぎょう]" body
    cons list unordered
      cons item none body
        cons paragraph
          cons "テキストはUTF-8。"
          cons "PowerShellで[読/よ]み[書/か]きする[場合/ばあい]はEncoding UTF8を[明示/めいじ]する。"
          cons "[通常/つうじょう]ファイルはLF、source[位置試験/いちしけん]のfixtureは[元/もと]byte[列/れつ]を[維持/いじ]する。"
          nil
        nil
      cons item none body
        cons paragraph
          cons sentence
            cons text "Docの" cons ruby text "例" text "れい" cons text "・" cons ruby text "解説" text "かいせつ" cons text "は " cons link relative "doc/authoring.md" none ruby text "執筆指針" text "しっぴつししん" cons text " に" cons ruby text "従" text "したが" cons text "う。" nil
          cons "[通常/つうじょう]の[本文/ほんぶん]はsentence literalを[基本/きほん]とし、[強調/きょうちょう]・[参照/さんしょう]・[埋/う]め[込/こ]み[等/とう]が[必要/ひつよう]な[文/ぶん]は[明示的/めいじてき]なsentence[構築/こうちく]を[使/つか]う。"
          cons "parallelは[文単位/ぶんたんい]の[意味対応/いみたいおう]を[保/たも]ち、[教材/きょうざい]では[両表記/りょうひょうき]を[適切/てきせつ]に[残/のこ]す。"
          nil
        nil
      cons item none body
        cons paragraph
          cons "ユーザー[指示/しじ]を[方針/ほうしん]・[契約/けいやく]に[照/て]らして[検証/けんしょう]し、[問題/もんだい]があれば[根拠/こんきょ]を[示/しめ]す。"
          cons "ライブラリ[仕様/しよう]が[曖昧/あいまい]ならWeb[検索/けんさく]で[公式資料/こうしきしりょう]を[確認/かくにん]する。"
          nil
        nil
      cons item none body
        cons paragraph
          cons sentence
            cons code ".tmp/" cons text " は" cons ruby text "説明用" text "せつめいよう" cons text "のローカル" cons ruby text "資料" text "しりょう" cons text "でありGit" cons ruby text "管理" text "かんり" cons text "・ビルド・CI・" cons ruby text "配布" text "はいふ" cons text "へ" cons ruby text "含" text "ふく" cons text "めない。" nil
          cons sentence
            cons ruby text "正式" text "せいしき" cons text "な" cons ruby text "入口" text "いりぐち" cons text "は " cons code "doc/README.md" cons text "。" nil
          nil
        nil
      cons item none body
        cons paragraph
          cons "[現在/げんざい]は[共通/きょうつう]runtimeの[実装/じっそう]を[進/すす]めている。"
          cons "20 crateは[目標構成/もくひょうこうせい]で、[実際/じっさい]のmemberはCargo.tomlが[示/しめ]す。"
          cons "R006/R009/R014は[実装開始/じっそうかいし]を[禁止/きんし]する[条件/じょうけん]ではなく、[実装/じっそう]とともに[解消/かいしょう]し[公開契約/こうかいけいやく]を[確定/かくてい]する[前/まえ]に[検証/けんしょう]する[課題/かだい]である。"
          cons "[型付/かたつ]きschema・Rust API・codec・[不変条件試験/ふへんじょうけんしけん]を[対応/たいおう]させ、[空/から]のcrateや[成功/せいこう]stubを[揃/そろ]えない。"
