from pathlib import Path
import subprocess,json,hashlib
p=Path(__file__).resolve().parent;root=p.parents[1]
pairs=[('doc/spec/16-doc-migration.md','doc/migration/authored/16-doc-migration.nepld'),('doc/README.md','doc/migration/authored/guide/README.nepld'),('doc/development.md','doc/migration/authored/guide/development.nepld'),('AGENTS.md','doc/migration/authored/project/AGENTS.nepld')]
files=[]
for i,(s,d) in enumerate(pairs):
    for kind,path in [('source',s),('draft',d)]:
        target=p/(str(i)+'-'+kind+'-before.txt');assert not target.exists()
        b=(root/path).read_bytes();target.write_bytes(b);files.append({'path':path,'snapshot':target.name,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
    (p/(str(i)+'-source-base.md')).write_bytes(subprocess.check_output(['git','show','HEAD:'+s],cwd=root))
(p/'source.patch').write_bytes(subprocess.check_output(['git','diff','--',*(x[0] for x in pairs)],cwd=root))
(p/'capture.json').write_text(json.dumps({'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root).decode().strip(),'pairs':pairs,'files':files},indent=2)+'\n',encoding='utf-8')
