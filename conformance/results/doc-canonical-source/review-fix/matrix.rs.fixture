use nepl3_tools::doc::{canonical,projection::annotated::host,source};
use serde_json::json;
use std::{fs,path::Path};
fn main()->Result<(),Box<dyn std::error::Error>> {
 let root=std::env::args().nth(1).ok_or("root")?;let root=Path::new(&root);fs::create_dir_all(root.join("doc"))?;
 let base=json!({"version":1,"pages":[{"id":"sample","source":"doc/sample.nepld","projection":"doc/sample.md","aliases":"doc/aliases.json","route":"docs/sample.html","renderer":"nepl3-tools.markdown-annotated/1"}]});
 let mut results=Vec::new();
 for (field,suffix) in [("source","nepld"),("projection","md"),("aliases","json"),("route","html")] {
  for (part,ok) in [("real.",false),("real ",false),("",false),(".",false),("..",false),("CON",false),("con.any",false),("PrN",false),("AUX",false),("nul",false),("Com1",false),("COM9.more",false),("Lpt1",false),("LPT9",false),("hash#x",false),("percent%20",false),("?",false),("x\\y",false),("x:y",false),("x\ny",false),("x?y",false),(".hidden",true),("Real.Name",true),("COM0",true),("COM10",true),("CONSOLE",true),("a-b_c.1",true)] {
   let path=format!("doc/{part}/sample.{suffix}");let mut v=base.clone();v["pages"][0][field]=json!(path);fs::write(root.join("doc/canonical.json"),serde_json::to_vec(&v)?)?;
   let actual=canonical::load(root,"doc/canonical.json").is_ok();assert_eq!(actual,ok,"{field}: {path}");results.push(json!({"field":field,"path":path,"accepted":actual}));
  }
  let mut v=base.clone();let mut second=base["pages"][0].clone();second["id"]=json!("second");second["source"]=json!("doc/second.nepld");second["projection"]=json!("doc/second.md");second["aliases"]=json!("doc/second.json");second["route"]=json!("docs/second.html");second[field]=json!(base["pages"][0][field].as_str().ok_or("field")?.replace("sample","SAMPLE").replace("aliases","ALIASES"));v["pages"].as_array_mut().ok_or("pages")?.push(second);fs::write(root.join("doc/canonical.json"),serde_json::to_vec(&v)?)?;assert!(canonical::load(root,"doc/canonical.json").is_err());results.push(json!({"field":field,"case":"casefold_duplicate","rejected":true}));
 }
 let compiled=source::compiled()?;
 for text in [r#"article en "Title" body cons paragraph cons "A" nil nil"#,r#"article en "Title" body cons paragraph cons "A" nil cons paragraph cons "B" nil nil"#] {
  let artifact=host::from_source(&compiled,text,&[])?;let result=host::generate(&compiled,"doc/sample.nepld",text,b"[]")?;
  let body=result.split_once("-->\n\n").ok_or("metadata")?.1;
  assert_eq!(body,artifact.markdown.trim_end_matches('\n').to_owned()+"\n");assert!(result.ends_with('\n'));assert!(!result.ends_with("\n\n"));
  results.push(json!({"case":"one_final_lf_and_internal_bytes","source":text,"passed":true}));
 }
 fs::write(root.join("results.json"),serde_json::to_vec_pretty(&results)?)?;println!("{} independent matrix/LF cases passed",results.len());Ok(())
}
