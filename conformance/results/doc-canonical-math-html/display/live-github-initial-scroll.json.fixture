    "KaTeXPreferred",
    "MathMlOnly",
    "--math-renderer katex-preferred|mathml-only",
    "htmlAndMathml",
    "output: html",
    "throwOnError: true",
    "trust: false",
    "maxExpand",
    "maxSize",
    "maxExpand",
    "maxSize",
    "design/markup.json",
    "style-src-attr 'none'",
    "SaveFinished"
  ],
  "tables": [
    [
      [
        "場面[ばめん]",
        "生成環境[せいせいかんきょう]",
        "渡[わた]す成果物[せいかぶつ]"
      ],
      [
        "CLI",
        "host側[がわ]の許可済[きょかず]みKaTeX adapter",
        "完成[かんせい]HTML・CSS・font"
      ],
      [
        "Playground",
        "ブラウザWorker内[ない]のJavaScript adapter",
        "完成[かんせい]した検査済[けんさず]みHTML artifact"
      ],
      [
        "preview・書出[かきだ]し済[ず]み文書[ぶんしょ]の閲覧[えつらん]",
        "KaTeXを実行[じっこう]しない",
        "同[おな]じ生成結果[せいせいけっか]とassetを表示[ひょうじ]"
      ]
    ],
    [
      [
        "条件[じょうけん]",
        "結果[けっか]"
      ],
      [
        "忠実[ちゅうじつ]なTeX変換[へんかん]・KaTeX実行[じっこう]・出力検査[しゅつりょくけんさ]が成功[せいこう]",
        "KaTeX生成済[せいせいず]みHTMLを採用[さいよう]する。"
      ],
      [
        "忠実[ちゅうじつ]に変換不能[へんかんふのう]、host能力[のうりょく]なし、module読込失敗[よみこみしっぱい]",
        "理由[りゆう]を診断[しんだん]として保持[ほじ]し、その数式[すうしき]をNEPL3 MathMLへ切[き]り替[か]える。"
      ],
      [
        "KaTeX通常構文[つうじょうこうぶん]エラー",
        "エラーを隠[かく]さず、その数式[すうしき]をNEPL3 MathMLへ切[き]り替[か]える。"
      ],
      [
        "偽[にせ]identity・未要求資源[みようきゅうしげん]・出力安全性違反[しゅつりょくあんぜんせいいはん]",
        "provider違反[いはん]を記録[きろく]し、正常[せいじょう]な能力不足[のうりょくぶそく]として扱[あつか]わず、親操作[おやそうさ]が継続可能[けいぞくかのう]とする明示[めいじ]policyがある場合[ばあい]だけMathML代替[だいたい]を許[ゆる]す。"
      ],
      [
        "文書全体[ぶんしょぜんたい]の取消[とりけ]し・予算超過[よさんちょうか]・期限[きげん]、それによるWorker強制終了[きょうせいしゅうりょう]",
        "元[もと]のStopped理由[りゆう]を保持[ほじ]し、既[すで]に利用可能[りようかのう]な同[おな]じ要求[ようきゅう]のMathMLだけを表示上[ひょうじじょう]の代替[だいたい]にできる。"
      ],
      [
        "許容[きょよう]されたrenderer局所期限[きょくしょきげん]による専用[せんよう]Worker終了[しゅうりょう]",
        "親操作[おやそうさ]が継続可能[けいぞくかのう]で必要資源[ひつようしげん]が残[のこ]る場合[ばあい]だけ、局所失敗[きょくしょしっぱい]を診断[しんだん]として正式[せいしき]なMathML fallbackへ移[うつ]る。"
      ],
      [
        "CSS・fontの欠落[けつらく]や遮断[しゃだん]",
        "asset診断[しんだん]と、明示的[めいじてき]なMathMlOnlyへの再生成操作[さいせいせいそうさ]を提供[ていきょう]する。"
      ],
      [
        "元[もと]Mathまたはfallback MathMLが不正[ふせい]",
        "型付[かたつ]き失敗[しっぱい]とし、空[から]の成功[せいこう]fragmentを返[かえ]さない。"
      ]
    ]
  ],
