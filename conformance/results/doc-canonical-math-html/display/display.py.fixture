from pathlib import Path
from functools import partial
from http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler
from threading import Thread
from playwright.sync_api import sync_playwright
import json,re,sys
ROOT=Path(sys.argv[1]).resolve(); OUT=Path(__file__).parent / sys.argv[2];OUT.mkdir(exist_ok=True)
aliases=json.loads(Path('doc/migration/aliases/17-math-html.json').read_text(encoding='utf-8'))
original=Path('.tmp/original.md').read_text(encoding='utf-8')
class Quiet(SimpleHTTPRequestHandler):
 def log_message(self,*a):pass
server=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(ROOT.parent)))
Thread(target=server.serve_forever,daemon=True).start()
url=f'http://127.0.0.1:{server.server_port}/{ROOT.name}/docs/spec/17-math-html.html'
rows=[]
try:
 with sync_playwright() as p:
  for name in ['chromium','firefox','webkit']:
   browser=getattr(p,name).launch(headless=True)
   for width in [375,1280]:
    context=browser.new_context(java_script_enabled=False,viewport={'width':width,'height':900})
    page=context.new_page(); failures=[];page.on('requestfailed',lambda r:failures.append(r.url))
    response=page.goto(url,wait_until='networkidle')
    row=page.evaluate('''()=>{let plain=n=>{let c=n.cloneNode(true);c.querySelectorAll('.nepl-reading,.nepl-notes').forEach(x=>x.remove());return c.textContent};return {title:document.title,scripts:document.scripts.length,lang:document.documentElement.lang,headings:[...document.querySelectorAll('h1,h2,h3')].map(plain),codes:[...document.querySelectorAll('code')].map(n=>n.textContent),tables:[...document.querySelectorAll('table')].map(t=>({rows:[...t.rows].map(r=>[...r.cells].map(plain)),scrollWidth:t.scrollWidth,width:t.clientWidth})),links:[...document.querySelectorAll('a[href]')].map(n=>({href:n.getAttribute('href'),text:plain(n)})),ids:[...document.querySelectorAll('[id]')].map(n=>n.id),ruby:document.querySelectorAll('.nepl-ruby').length,css:[...document.styleSheets].map(s=>({href:s.href,rules:s.cssRules.length})),overflow:document.documentElement.scrollWidth>innerWidth,bodyWidth:document.documentElement.scrollWidth,background:getComputedStyle(document.querySelector('article')).backgroundColor,rubyPositions:[...document.querySelectorAll('.nepl-ruby')].slice(0,5).map(n=>({base:n.querySelector('.nepl-base').getBoundingClientRect().y,reading:n.querySelector('.nepl-reading').getBoundingClientRect().y}))}}''')
    row.update(browser=name,version=browser.version,width=width,status=response.status,failures=failures,code_exact=row['codes']==re.findall(r'`([^`]+)`',original))
    page.screenshot(path=str(OUT/f'{name}-{width}.png'))
    page.locator('table').nth(1).scroll_into_view_if_needed();page.screenshot(path=str(OUT/f'{name}-{width}-table.png'))
    row['navigation']=[]
    for alias in aliases:
     page.goto(url+'#'+alias['name'],wait_until='load')
     row['navigation'].append(page.evaluate('''name=>{let n=document.getElementById(name);return {name,count:[...document.querySelectorAll('[id]')].filter(n=>n.id===name).length,top:n?.getBoundingClientRect().top,scroll:scrollY}}''',alias['name']))
    page.goto(url,wait_until='load')
    link=page.locator('a').filter(has_text='18').first
    chapter=next(x for x in row['links'] if '18-html-delivery.html' in x['href'])
    page.goto(url.rsplit('/',1)[0]+'/'+chapter['href'],wait_until='load')
    row['chapter18_target']=page.locator('h1').inner_text()
    rows.append(row);context.close()
   browser.close()
finally:server.shutdown();server.server_close()
(OUT/'results.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2),encoding='utf-8')
print(json.dumps([{k:r[k] for k in ['browser','width','status','overflow','ruby','code_exact','failures']} for r in rows]))
