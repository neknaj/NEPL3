from pathlib import Path
from playwright.sync_api import sync_playwright
import json,re
OUT=Path(__file__).parent
URL='https://github.com/neknaj/NEPL3/blob/2f3545ecad601bc19e19c0d3495ee6fd11eedb36/doc/spec/17-math-html.md'
aliases=json.loads(Path('doc/migration/aliases/17-math-html.json').read_text(encoding='utf-8'))
names=[a['name'] for a in aliases]+['n-'+a['section'].encode().hex() for a in aliases if a['section']]
original=Path('.tmp/original.md').read_text(encoding='utf-8')
with sync_playwright() as p:
 b=p.chromium.launch(headless=True);page=b.new_page()
 response=page.goto(URL,wait_until='domcontentloaded',timeout=60000)
 page.locator('article.markdown-body').wait_for(timeout=60000)
 result=page.locator('article.markdown-body').evaluate('''article=>({codes:[...article.querySelectorAll('code')].map(n=>n.textContent),tables:[...article.querySelectorAll('table')].map(t=>[...t.rows].map(r=>[...r.cells].map(c=>c.textContent))),links:[...article.querySelectorAll('a[href]')].map(n=>({href:n.getAttribute('href'),text:n.textContent})),ids:[...article.querySelectorAll('[id]')].map(n=>n.id)})''')
 result.update(url=URL,status=response.status,code_exact=result['codes']==re.findall(r'`([^`]+)`',original),navigation=[])
 for name in names:
  page.goto(URL+'#'+name,wait_until='domcontentloaded',timeout=60000)
  page.wait_for_timeout(1500)
  result['navigation'].append(page.evaluate('''name=>{let nodes=[...document.querySelectorAll('article.markdown-body [id],article.markdown-body [name]')].filter(n=>n.id==='user-content-'+name||n.id===name||n.getAttribute('name')===name||n.getAttribute('name')==='user-content-'+name);return {name,nodes:nodes.map(n=>({id:n.id,name:n.getAttribute('name'),top:n.getBoundingClientRect().top,next:n.parentElement.nextElementSibling?.textContent.slice(0,150)})),scroll:scrollY}}''',name))
 page.screenshot(path=str(OUT/'live-github.png'))
 (OUT/'live-github.json').write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf-8')
 b.close()
print(json.dumps({'status':result['status'],'code_exact':result['code_exact'],'table_rows':[len(x) for x in result['tables']],'anchor_counts':[len(x['nodes']) for x in result['navigation']]},ensure_ascii=False))
