from pathlib import Path
import re,json,difflib
a=Path('.tmp/original.md').read_text(encoding='utf-8')
b=Path('.tmp/markdown-generated-first/doc/spec/17-math-html.md').read_text(encoding='utf-8')
x=re.findall(r'`([^`]+)`',a); y=re.findall(r'`([^`]+)`',b)
clean=re.sub(r'\\\[[^\]]*?\\\]','',b)
clean=re.sub(r'<!--.*?-->\s*','',clean,flags=re.S)
clean=re.sub(r'<a name="[^"]+"></a>\s*','',clean)
clean=clean.replace('\\.','.').replace('\\|','|')
Path('.tmp/review17-display/clean-projection.md').write_text(clean,encoding='utf-8')
Path('.tmp/review17-display/prose.diff').write_text(''.join(difflib.unified_diff(a.splitlines(True),clean.splitlines(True))),encoding='utf-8')
result={'original_code':x,'generated_code':y,'exact_code_match':x==y,'table_original_rows':sum(l.startswith('|') for l in a.splitlines()),'table_projection_rows':sum(l.startswith('|') for l in b.splitlines())}
Path('.tmp/review17-display/compare.json').write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf-8')
print(json.dumps(result,ensure_ascii=False))
