from pathlib import Path
from playwright.sync_api import sync_playwright
import json
OUT=Path(__file__).parent;ROOT=Path('.tmp/html-expanded-first').resolve()
with sync_playwright() as p:
 b=p.webkit.launch(headless=True);ctx=b.new_context(java_script_enabled=False,viewport={'width':375,'height':900})
 ctx.route('http://**/*',lambda route:route.abort());ctx.route('https://**/*',lambda route:route.abort())
 page=ctx.new_page();requests=[];page.on('request',lambda r:requests.append(r.url))
 url=(ROOT/'docs/spec/17-math-html.html').as_uri();page.goto(url,wait_until='load')
 result=page.evaluate('''()=>({ruby:document.querySelectorAll('.nepl-ruby').length,css:[...document.styleSheets].map(s=>s.href),background:getComputedStyle(document.querySelector('article')).backgroundColor,overflow:document.documentElement.scrollWidth>innerWidth,ids:[...document.querySelectorAll('[id]')].map(n=>n.id)})''')
 result['navigation']=[]
 for ident in result['ids']:
  page.goto(url+'#'+ident,wait_until='load')
  result['navigation'].append(page.evaluate('''id=>({id,top:document.getElementById(id).getBoundingClientRect().top,scroll:scrollY})''',ident))
 page.screenshot(path=str(OUT/'webkit-file.png'))
 page.goto((ROOT/'docs/spec/18-html-delivery.html').as_uri(),wait_until='load');result['chapter18_heading']=page.locator('h1').inner_text()
 result['http_requests']=[u for u in requests if u.startswith('http')];result['requests']=requests;result['delivery']='file URI, normal context, HTTP and HTTPS route abort, JavaScript disabled'
 (OUT/'webkit-file.json').write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf-8');b.close()
print(json.dumps(result,ensure_ascii=False))
