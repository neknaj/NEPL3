from pathlib import Path
import hashlib,json,subprocess
root=Path.cwd(); out=root/'.tmp/archive17';out.mkdir(exist_ok=False)
rows=[]
def save(owner,p,relative):
    data=p.read_bytes();assert len(data)<1048576
    name=f'{owner}/{relative}.fixture';dest=out/name
    assert dest.resolve().is_relative_to(out.resolve())
    dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(data)
    rows.append(dict(owner=owner,file=name,restore=relative,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
for owner,directory in [('failed-generation','generation'),('generation','generation-expanded'),('checks','checks17'),('html','html-expanded-first'),('markdown','markdown-expanded-first')]:
    d=root/'.tmp'/directory
    for p in sorted(d.rglob('*')):
        if p.is_file():save(owner,p,p.relative_to(d).as_posix())
for name in ['generate.py','generate-expanded.py','check17.py','adopt17.py','adopt17-original.py','restore17.py','archive17.py']:
    save('scripts',root/'.tmp'/name,name)
for name in ['original.md','original.nepld','review17-adoption.md']:
    save('review',root/'.tmp'/name,name)
preflight=Path('C:/projects/NEPL3-doc-adjacent-list/.tmp/preflight17')
for name in ['review.md','facts.json']:save('preflight',preflight/name,name)
display=root/'.tmp/review17-display'
manifest=json.loads((display/'seal.json').read_text(encoding='utf-8'))
save('display',display/'seal.json','seal.json')
for row in manifest:
    p=display/row['path']; assert hashlib.sha256(p.read_bytes()).hexdigest()==row['sha256']
    save('display',p,row['path'])
head='2f3545ecad601bc19e19c0d3495ee6fd11eedb36';sources=[]
for name in ['doc/canonical.json','doc/spec/17-math-html.nepld','doc/spec/17-math-html.md','doc/spec/01-architecture.md','doc/spec/12-model-invariants.md','doc/migration/aliases/17-math-html.json']:
    data=(root/name).read_bytes();assert data==subprocess.check_output(['git','show',head+':'+name])
    sources.append(dict(path=name,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
(out/'payloads.json').write_text(json.dumps(dict(implementation_commit=head,sources=sources,files=rows),indent=2)+'\n',encoding='utf-8',newline='\n')
(out/'.gitattributes').write_text('*.fixture -text -whitespace\n',encoding='utf-8',newline='\n')
print(len(rows),'payloads',sum(r['bytes'] for r in rows),'bytes')
