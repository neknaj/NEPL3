from pathlib import Path
import sys,json
sys.path.insert(0,str(Path('tools/site').resolve()))
from deployment.receipt import Receipt,created,observed
from payload import digest
p=Path('.tmp/deployment-receipt-review')
url='https://api.github.com/repos/neknaj/NEPL3/pages/deployments/abc123'
r=created(json.dumps(dict(id='abc123',status_url=url)).encode(),owner='neknaj',repository='NEPL3')
results={}
for name,kwargs in [('wrong-id',dict(deployment_id='other',status_endpoint=url,response_sha256='a'*64)),('bad-digest',dict(deployment_id='abc123',status_endpoint=url,response_sha256='bad'))]:
 try:Receipt(**kwargs);results[name]='accepted'
 except ValueError as ex:results[name]='rejected: '+str(ex)
for status,expected in [('succeed','succeeded'),('deployment_queued','pending'),('deployment_in_progress','pending'),('deployment_failed','failed'),('deployment_content_failed','failed'),('deployment_cancelled','failed'),('deployment_lost','unknown'),('unknown_status','unknown'),('not_found','unknown'),('deployment_attempt_error','unknown'),('future','unknown')]:
 raw=json.dumps({'status':status}).encode();o=observed(raw,receipt=r,request_url=url);assert o.phase.value==expected and o.response_sha256==digest(raw)
 results[status]=o.phase.value
raw=b'{"status":"succeed"}';exact=raw+b' '*(65536-len(raw));assert observed(exact,receipt=r,request_url=url).phase.value=='succeeded'
try:observed(exact+b' ',receipt=r,request_url=url);raise AssertionError('oversize accepted')
except ValueError:results['response_boundary']='65536 accepted, 65537 rejected'
object.__setattr__(r,'deployment_id','tampered')
try:observed(raw,receipt=r,request_url=url);raise AssertionError('tampered receipt accepted')
except ValueError:results['observation_revalidation']='rejected tampered receipt'
assert all(results[k].startswith('rejected:') for k in ['wrong-id','bad-digest'])
(p/'final-probe.json').write_text(json.dumps(results,indent=2)+'\n',encoding='utf8');print(json.dumps(results,indent=2))
