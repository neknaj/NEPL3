from pathlib import Path
import sys,re,json,subprocess,hashlib,difflib
OUT=Path(__file__).parent;ROOT=OUT.parents[1];sys.path.insert(0,str(ROOT))
from tools.audit.structure import Parser,load_forms
exec((OUT/'helpers.py').read_text(encoding='utf8'))
HEAD='f071d09dd890423c8f5dc134bc0eeae38a0ccba1';draft='doc/migration/authored/guide/development.nepld'
get=lambda rev,path:subprocess.check_output(['git','show',rev+':'+path],cwd=ROOT)
after=get(HEAD,draft);before=get('4de46ba',draft);source=get(HEAD,'doc/development.md')
assert source==get('4de46ba','doc/development.md')
for path in ['tools/src/doc/canonical.rs','doc/spec/16-doc-migration.md','doc/migration/authored/16-doc-migration.nepld']:
    assert get(HEAD,path)==get('4de46ba',path)
for name,raw in [('guide-before.nepld',before),('guide-after.nepld',after),('guide-source.md',source)]:
    (OUT/name).write_bytes(raw)
a=before.decode().splitlines(True);b=after.decode().splitlines(True)
ops=[o for o in difflib.SequenceMatcher(None,a,b).get_opcodes() if o[0]!='equal']
assert len(ops)==2 and all(o[0]=='insert' for o in ops)
reconstructed=b.copy()
for _,_,_,k,l in reversed(ops):del reconstructed[k:l]
assert ''.join(reconstructed).encode()==before
tree=Parser(after.decode(),load_forms(ROOT)).complete('Doc/Article')
# Collect actual paragraph sentences from the complete typed structure; select exact added values.
expected_a=source.decode().split('ページ間リンクを持つ ',1)[1].split('\n`cargo run --locked -p nepl3-tools -- doc-canonical html',1)[0]
expected_a=('ページ間リンクを持つ '+expected_a).replace('`','').replace('\n','')
expected_b=source.decode().split('HTML集合の有限出力予算',1)[1].split('\nいずれも文書の',1)[0]
expected_b=('HTML集合の有限出力予算'+expected_b).replace('`','').replace('\n','')
expected=[s+'。' for s in expected_a.split('。')[:-1]]+[s+'。' for s in expected_b.split('。')[:-1]]
sentences=[]
for n in walk(tree):
    if n['kind']=='Paragraph':
        for item in n['fields']['items']:
            value=plain(normalize(item))
            if value in expected:sentences.append(item)
assert len(sentences)==6
assert [plain(normalize(n)) for n in sentences]==expected
for n in sentences:audit_text(n)
normalized=normalize(sentences,True)
codes=[n['fields']['text'] for n in walk(normalized) if n['kind']=='InlineCode']
assert codes==['nepl3-tools.markdown-annotated-pages/1','cargo run --locked -p nepl3-tools -- doc-canonical markdown dist/canonical-markdown','html_output_limits','output_limits']
(OUT/'guide.diff').write_text(''.join(difflib.unified_diff(a,b)),encoding='utf8',newline='\n')
(OUT/'guide-result.json').write_text(json.dumps({'head':HEAD,'full_structure':True,'old_bytes_unchanged_after_removing_two_insertions':True,'new_sentences_exact':expected,'codes':codes,'ruby_count':len(pairs),'readings':pairs,'source_sha256':hashlib.sha256(source).hexdigest(),'before_sha256':hashlib.sha256(before).hexdigest(),'after_sha256':hashlib.sha256(after).hexdigest(),'runtime':'not executed by reviewer'},ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS: six exact sentences / four codes / two pure insertions; 4de production and chapter16 unchanged')
