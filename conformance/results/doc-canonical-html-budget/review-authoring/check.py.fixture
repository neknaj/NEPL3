from pathlib import Path
import sys,subprocess,json,re,hashlib,difflib
ROOT=Path(__file__).resolve().parents[2];OUT=Path(__file__).parent
HEAD='4de46baf5f22f8dcb5e99d0312d9b61e36a44d6b'
sys.path.insert(0,str(ROOT))
from tools.audit.structure import Parser,load_forms
exec((OUT/'helpers.py').read_text(encoding='utf8'))
sha=lambda b:hashlib.sha256(b).hexdigest()
paths=['doc/spec/16-doc-migration.md','doc/migration/authored/16-doc-migration.nepld','doc/development.md','doc/authoring.md','tools/src/doc/canonical.rs','tools/src/doc/canonical/projection.rs','tools/src/doc/export/pages.rs','tools/src/doc/export/pages/resources.rs']
snapshots=[]
for i,path in enumerate(paths):
    raw=subprocess.check_output(['git','show',HEAD+':'+path],cwd=ROOT)
    assert raw==(ROOT/path).read_bytes()
    name=f'fixed-{i}'+Path(path).suffix;(OUT/name).write_bytes(raw)
    snapshots.append({'path':path,'snapshot':name,'bytes':len(raw),'sha256':sha(raw)})
source=(OUT/'fixed-0.md').read_text(encoding='utf8');draft=(OUT/'fixed-1.nepld').read_bytes()
before=subprocess.check_output(['git','show',HEAD+'^:'+paths[1]],cwd=ROOT);(OUT/'before.nepld').write_bytes(before)
a=before.decode().splitlines(True);b=draft.decode().splitlines(True)
ops=[o for o in difflib.SequenceMatcher(None,a,b).get_opcodes() if o[0]!='equal'];assert len(ops)==1 and ops[0][0]=='insert'
_,i,j,k,l=ops[0];assert ''.join(b[:k]+b[l:]).encode()==before
insert=''.join(b[k:l]);(OUT/'added.nepld').write_text(insert,encoding='utf8',newline='\n')
# Parse the real full article and the isolated inserted Block, independently of rendering.
tree=Parser(draft.decode(),load_forms(ROOT)).complete('Doc/Article')
block=next(n for n in walk(tree) if n['kind']=='Paragraph' and any(x['kind']=='InlineCode' and x['fields']['text']=='html_output_limits' for x in walk(n)))
audit_text(block);normalized=normalize(block,True)
sentences=normalized['fields']['items'];assert len(sentences)==8 and all(n['kind']=='Sentence' for n in sentences)
expected=source[source.index('HTML集合書出しの予算は、'):].split('\n\n',1)[0].replace('`','').replace('\n','')
assert plain(normalized)==expected
codes=[n['fields']['text'] for n in walk(normalized) if n['kind']=='InlineCode'];assert codes==['html_output_limits','output_limits']
assert not any(n['kind']=='Link' for n in walk(normalized))
assert all(han.fullmatch(base) for base,reading in pairs)
dev=(OUT/'fixed-2.md').read_bytes();olddev=subprocess.check_output(['git','show',HEAD+'^:'+paths[2]],cwd=ROOT)
(OUT/'development.diff').write_text(''.join(difflib.unified_diff(olddev.decode().splitlines(True),dev.decode().splitlines(True))),encoding='utf8',newline='\n')
(OUT/'draft.diff').write_text(''.join(difflib.unified_diff(a,b)),encoding='utf8',newline='\n')
result={'commit':HEAD,'source_files':snapshots,'full_article_structure':True,'single_insertion_preserves_every_old_byte':True,'inserted_lines':l-k,'sentence_count':8,'paragraph_visible_text_exact':True,'code_bytes':codes,'ruby_count':len(pairs),'readings':pairs,'runtime':'not executed; root owns production execution','development_authored_guide_has_new_field': 'html_output_limits' in (ROOT/'doc/migration/authored/guide/development.nepld').read_text(encoding='utf8')}
(OUT/'result.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n',encoding='utf8',newline='\n')
print('PASS: full formal structure; exact 8-sentence paragraph; 2 codes; Ruby; one pure insertion')
