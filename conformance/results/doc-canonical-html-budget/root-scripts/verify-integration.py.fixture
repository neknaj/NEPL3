from pathlib import Path
import subprocess,json,time
out=Path('.tmp/verification-integration');out.mkdir(exist_ok=True)
def head():return subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
def clean():return not subprocess.check_output(['git','status','--porcelain']).strip()
fixed=head();assert clean();rows=[]
for name,cmd in [('canonical-tests',['cargo','test','--locked','-p','nepl3-tools','--lib','doc::canonical::','--','--test-threads=1','--skip','synchronized_context_spec_drafts_parse_lower_and_check_labels']),('canonical-current',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','--check']),('clippy',['cargo','clippy','--locked','--workspace','--all-targets','--','-D','warnings']),('repository',['cargo','run','--locked','-p','nepl3-tools','--','check']),('format',['cargo','fmt','--all','--','--check'])]:
    assert head()==fixed and clean();started=time.monotonic()
    with (out/(name+'.stdout.log')).open('wb') as stdout,(out/(name+'.stderr.log')).open('wb') as stderr:
        p=subprocess.run(cmd,stdout=stdout,stderr=stderr,timeout=1200)
    unchanged=head()==fixed and clean()
    rows.append(dict(source_commit=fixed,unchanged_clean_tree=unchanged,command=cmd,exit_code=p.returncode,elapsed=time.monotonic()-started))
    (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8')
    print(name,p.returncode,flush=True)
    assert unchanged and p.returncode==0
