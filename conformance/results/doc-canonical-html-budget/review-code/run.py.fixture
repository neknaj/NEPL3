from pathlib import Path
import subprocess,json,hashlib,os,sys
p=Path(__file__).parent.resolve();ws=p/'workspace';phase=sys.argv[1];assert phase in ['before','after'];label=sys.argv[2]
for n in json.loads((p/'snapshot.json').read_bytes())['changed']:(ws/n).write_bytes((p/('before' if phase=='before' else 'source')/n).read_bytes())
probe=(p/'probe.rs').read_bytes();q=ws/'tools/src/doc/canonical/tests.rs';q.write_bytes(q.read_bytes()+b'\n'+probe)
cmd=['cargo','test','--locked','-p','nepl3-tools','--lib','independent_html_default_unchanged' if phase=='before' else 'independent_html','--','--nocapture','--test-threads=1']
r=subprocess.run(cmd,cwd=ws,env=dict(os.environ,CARGO_TARGET_DIR=str(p/'target'),NEPL3_REVIEW_HTML_OUTPUT=str(p/('default-'+label))),capture_output=True,timeout=900)
(p/(label+'.stdout.log')).write_bytes(r.stdout);(p/(label+'.stderr.log')).write_bytes(r.stderr)
(p/(label+'.command.json')).write_text(json.dumps(dict(phase=phase,label=label,head=json.loads((p/'snapshot.json').read_bytes())['base' if phase=='before' else 'head'],all_changed_files_restored=True,command=cmd,deadline_seconds=900,exit_code=r.returncode,probe_sha256=hashlib.sha256(probe).hexdigest(),binaries=[dict(path=str(b),sha256=hashlib.sha256(b.read_bytes()).hexdigest(),bytes=b.stat().st_size) for b in (p/'target/debug/deps').glob('nepl3_tools-*.exe')]),indent=2)+'\n',encoding='utf8')
print(r.stdout.decode('utf8').encode('ascii','backslashreplace').decode()[-1600:]);print(r.stderr.decode('utf8')[-2000:]);assert r.returncode==0
