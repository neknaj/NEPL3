from pathlib import Path
import subprocess,json,hashlib
p=Path(__file__).parent.resolve()
r=subprocess.run(['python',str(p/'check.py')],capture_output=True,timeout=60)
(p/'check.stdout.log').write_bytes(r.stdout);(p/'check.stderr.log').write_bytes(r.stderr);assert r.returncode==0,r.stderr
versions={k:subprocess.check_output(v).decode('utf8') for k,v in [('rustc',['rustc','-Vv']),('cargo',['cargo','-V'])]}
(p/'versions.json').write_text(json.dumps(versions,indent=2)+'\n',encoding='utf8')
names=set('''freeze.py run.py run-initial.py probe.rs check.py checks.json record.md finalize.py versions.json
snapshot.json dependencies.json source.patch check.stdout.log check.stderr.log
motivation/commands.json motivation/html-first.stdout.log motivation/html-first.stderr.log
'''.split())
for phase in ['before','after','before-exact','after-exact']:
    names.update(phase+'.'+suffix for suffix in ['command.json','stdout.log','stderr.log'])
    names.update('default-'+phase+'/'+name for name in ['manifest.json','site/a.html','site/assets/doc.css'])
m=json.loads((p/'snapshot.json').read_bytes())
names.update('source/'+n for n in m['scope']);names.update('before/'+n for n in m['changed'])
rows=[]
for n in sorted(names):
    assert '..' not in Path(n).parts and not any(x in Path(n).parts for x in ['workspace','target'])
    b=(p/n).read_bytes();rows.append(dict(path=n,bytes=len(b),sha256=hashlib.sha256(b).hexdigest()))
out=dict(head=m['head'],base=m['base'],scope='Independent canonical HTML output-budget code/native host review; authored content and five-page cutover separate',strict_allowlist=True,files=rows)
(p/'manifest.json').write_text(json.dumps(out,indent=2)+'\n',encoding='utf8')
print(len(rows),'files',sum(r['bytes'] for r in rows),'bytes',hashlib.sha256((p/'manifest.json').read_bytes()).hexdigest())
