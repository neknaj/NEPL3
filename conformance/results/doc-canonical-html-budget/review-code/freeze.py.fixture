from pathlib import Path
import subprocess,json,hashlib
p=Path(__file__).parent.resolve();root=p.parents[1];head='4de46baf5f22f8dcb5e99d0312d9b61e36a44d6b';base=subprocess.check_output(['git','rev-parse','eee542f'],cwd=root).decode().strip()
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
def put(n,b):q=p/n;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
def sha(b):return hashlib.sha256(b).hexdigest()
changed=['doc/development.md','doc/migration/authored/16-doc-migration.nepld','doc/spec/16-doc-migration.md','tools/src/doc/canonical.rs','tools/src/doc/canonical/tests.rs']
assert sorted(git('diff','--name-only',base,head).decode().splitlines())==sorted(changed)
scope=changed+['AGENTS.md','tools/src/doc/export/pages.rs','tools/src/doc/export/pages/resources.rs','tools/src/doc/canonical/projection.rs','tools/src/doc/source.rs','doc/spec/21-doc-pages.md']
names=git('ls-tree','-r','--name-only',head).decode().splitlines();names=[n for n in names if '/' not in n or n.startswith(('tools/','crates/','design/','interfaces/','languages/','doc/','conformance/fixtures/','examples/','.cargo/'))]
proc=subprocess.Popen(['git','cat-file','--batch'],cwd=root,stdin=subprocess.PIPE,stdout=subprocess.PIPE);rows=[]
for n in names:
    proc.stdin.write((head+':'+n+'\n').encode());proc.stdin.flush();h=proc.stdout.readline().split();assert h[1]==b'blob';b=proc.stdout.read(int(h[2]));assert proc.stdout.read(1)==b'\n'
    put('workspace/'+n,b);rows.append(dict(path=n,sha256=sha(b),bytes=len(b)))
    if n in scope:put('source/'+n,b)
proc.stdin.close();assert proc.wait()==0
for n in changed:put('before/'+n,git('show',base+':'+n))
put('source.patch',git('diff',base,head))
for n in ['commands.json','html-first.stdout.log','html-first.stderr.log']:
    put('motivation/'+n,(Path('C:/projects/NEPL3-doc-canonical-html-delivery/.tmp/generation')/n).read_bytes())
put('snapshot.json',(json.dumps(dict(head=head,base=base,changed=changed,scope=scope),indent=2)+'\n').encode());put('dependencies.json',(json.dumps(rows,indent=2)+'\n').encode())
print('Frozen',len(rows),'Git dependencies; five allowed paths')
