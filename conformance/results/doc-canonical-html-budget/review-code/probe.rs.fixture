fn independent_html_fixture(f:&Fixture)->Result<serde_json::Value>{
    f.write("doc/a.nepld",r#"article ja "[文/ぶん]" body cons paragraph cons sentence cons text "<&>" cons break cons text "tail" nil nil nil"#)?;
    f.write("doc/a.json",b"[]")?;
    let value=json!({"version":1,"pages":[{"id":"a","source":"doc/a.nepld","projection":"doc/a.md","aliases":"doc/a.json","route":"site/a.html","renderer":RENDERER}]});
    f.json("doc/canonical.json",&value)?;Ok(value)
}
fn independent_html_receipt(f:&Fixture,name:&str)->Result<serde_json::Value>{
    let out=f.root().join(name);html(f.root(),"doc/canonical.json",&out)?;
    Ok(serde_json::from_slice(&fs::read(out.join("manifest.json"))?)?)
}
#[test]
fn independent_html_default_unchanged()->Result<()>{
    let f=Fixture::new()?;independent_html_fixture(&f)?;
    let out=std::path::PathBuf::from(std::env::var("NEPL3_REVIEW_HTML_OUTPUT")?);html(f.root(),"doc/canonical.json",&out)?;
    let h=fs::read_to_string(out.join("site/a.html"))?;assert!(h.contains("&lt;&amp;&gt;") && h.contains("<br>"));
    let r:serde_json::Value=serde_json::from_slice(&fs::read(out.join("manifest.json"))?)?;
    println!("INDEPENDENT_HTML_DEFAULT {r}");Ok(())
}
#[test]
fn independent_html_limits_receipt_phase_separation()->Result<()>{
    let f=Fixture::new()?;let base=independent_html_fixture(&f)?;
    let before=independent_html_receipt(&f,"omitted")?;
    let limits=json!({"source_bytes":1000000,"work":3000000,"depth":40,"nodes":100000,"allocation_units":8000000,"output_bytes":300000,"diagnostics":3,"events":7});
    let defaults=serde_json::to_value(super::super::export::pages::resources::OutputLimits::default())?;
    let mut v=base.clone();v["html_output_limits"]=defaults.clone();v["output_limits"]=defaults.clone();v["output_limits"]["work"]=json!(0);f.json("doc/canonical.json",&v)?;
    let explicit=independent_html_receipt(&f,"explicit")?;assert_eq!(explicit,before);
    let md=f.root().join("md-stopped");assert!(markdown(f.root(),"doc/canonical.json",&md).is_err());assert!(!md.exists());
    v["html_output_limits"]=limits.clone();f.json("doc/canonical.json",&v)?;let selected=independent_html_receipt(&f,"selected")?;
    assert_eq!(selected["output_budget"]["limits"],limits);assert_eq!(selected["identity"],before["identity"]);assert_ne!(selected["execution_identity"],before["execution_identity"]);
    assert_ne!(selected["phase_execution"]["identity"],before["phase_execution"]["identity"]);
    for field in ["pages","files","options","output_usage"]{assert_eq!(selected[field],before[field],"{field}");}
    assert!(selected["output_budget"]["initial_usage"].as_object().ok_or("usage")?.values().all(|n|n==0));
    for name in ["site/a.html","site/assets/doc.css"]{assert_eq!(fs::read(f.root().join("omitted").join(name))?,fs::read(f.root().join("selected").join(name))?);}
    assert!(html(f.root(),"doc/canonical.json",&f.root().join("selected")).is_err());
    println!("INDEPENDENT_HTML_SELECTED {selected}");Ok(())
}
#[test]
fn independent_html_stop_boundaries_and_new_markdown_context()->Result<()>{
    let f=Fixture::new()?;let base=independent_html_fixture(&f)?;let defaults=serde_json::to_value(super::super::export::pages::resources::OutputLimits::default())?;
    for (field,reason) in [("work","WorkLimit"),("allocation_units","AllocationLimit"),("nodes","NodeLimit"),("depth","DepthLimit"),("source_bytes","SourceLimit"),("output_bytes","OutputLimit")] {
        let mut v=base.clone();v["html_output_limits"]=defaults.clone();v["html_output_limits"][field]=json!(0);f.json("doc/canonical.json",&v)?;
        let out=f.root().join(format!("stop-{field}"));let error=html(f.root(),"doc/canonical.json",&out).err().ok_or("unexpected success")?;
        assert!(error.to_string().contains(reason),"{field}: {error}");assert!(!out.exists());
        println!("INDEPENDENT_HTML_STOP {}",json!({"field":field,"reason":reason,"error":error.to_string(),"output_exists":false}));
    }
    let mut v=base.clone();v["pages"][0]["renderer"]=json!(projection::RENDERER);f.json("doc/canonical.json",&v)?;
    let a=f.root().join("new-md-a");markdown(f.root(),"doc/canonical.json",&a)?;
    v["html_output_limits"]=defaults;v["html_output_limits"]["work"]=json!(0);f.json("doc/canonical.json",&v)?;
    let b=f.root().join("new-md-b");markdown(f.root(),"doc/canonical.json",&b)?;
    let first=fs::read_to_string(a.join("doc/a.md"))?;let second=fs::read_to_string(b.join("doc/a.md"))?;
    assert_eq!(first.split_once("\n\n").ok_or("body")?.1,second.split_once("\n\n").ok_or("body")?.1);assert_ne!(first,second);
    println!("INDEPENDENT_HTML_SCOPE {}",json!({"new_markdown_body_equal":true,"new_markdown_context_changed":true,"html_work0_did_not_stop_markdown":true}));Ok(())
}
#[test]
fn independent_html_strict_raw_config_and_late_failure()->Result<()>{
    let f=Fixture::new()?;let base=independent_html_fixture(&f)?;
    let defaults=serde_json::to_value(super::super::export::pages::resources::OutputLimits::default())?;
    let mut bads=vec![serde_json::Value::Null,json!({}),json!({"work":1}),json!([]),json!(false),json!("unlimited")];
    for bad in [json!(-1),json!(1.5),json!(true),serde_json::Value::Null] {let mut obj=defaults.clone();obj["work"]=bad;bads.push(obj);}
    let mut obj=defaults.clone();obj["unlimited"]=json!(true);bads.push(obj);
    for bad in bads.iter(){let mut v=base.clone();v["html_output_limits"]=bad.clone();f.json("doc/canonical.json",&v)?;assert!(load(f.root(),"doc/canonical.json").is_err());assert!(html(f.root(),"doc/canonical.json",&f.root().join("invalid")).is_err());assert!(!f.root().join("invalid").exists());}
    let mut v=base.clone();v["html_output_limits"]=defaults.clone();let raw=serde_json::to_string(&v)?;
    for mutation in [raw.replace("\"work\":100000000","\"work\":18446744073709551616"),raw.replace("\"work\":100000000","\"work\":100000000,\"work\":1")] {assert_ne!(mutation,raw);f.write("doc/canonical.json",mutation)?;assert!(load(f.root(),"doc/canonical.json").is_err());}
    for (case,source,route) in [("invalid-source","not an Article","site/b.html"),("late-path",r#"article en "B" body nil"#,"site/a.html/child.html")] {
        let mut v=base.clone();v["html_output_limits"]=defaults.clone();v["html_output_limits"]["work"]=json!(200000000);
        v["pages"].as_array_mut().ok_or("pages")?.push(json!({"id":"b","source":"doc/b.nepld","projection":"doc/b.md","aliases":"doc/b.json","route":route,"renderer":RENDERER}));f.write("doc/b.nepld",source)?;f.json("doc/canonical.json",&v)?;
        let out=f.root().join(case);assert!(html(f.root(),"doc/canonical.json",&out).is_err());assert!(!out.exists());
    }
    println!("INDEPENDENT_HTML_NEGATIVES {}",json!({"typed_invalid":bads.len(),"raw_duplicate_or_overflow":2,"late_no_output":2}));Ok(())
}
