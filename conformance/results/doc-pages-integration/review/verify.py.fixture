from pathlib import Path
import json,hashlib,subprocess,tempfile,sys
from dataclasses import replace
from unittest.mock import patch
p=Path('.tmp/deployment-integration-review')
changed=subprocess.run(['git','diff','--name-only','origin/main...HEAD','--','tools/site'],capture_output=True,check=True,text=True).stdout.splitlines()
checks=[]
for name in changed:
 if not name.endswith('.py') or name.endswith('__init__.py'):continue
 matches=[]
 for review in Path('.tmp').glob('*review'):
  f=review/'source'/name
  if f.is_file() and f.read_bytes().replace(bytes([13,10]),bytes([10]))==Path(name).read_bytes().replace(bytes([13,10]),bytes([10])):
   m=review/'manifest.json'
   if m.is_file():
    rows=json.loads(m.read_text(encoding='utf8'))['files'];row=next((r for r in rows if r['path']==f.relative_to(review).as_posix()),None)
    if row and row['sha256']==hashlib.sha256(f.read_bytes()).hexdigest():matches.append(str(review))
 checks.append(dict(path=name,matching_sealed_reviews=matches));assert matches,name
(p/'prior-source-match.json').write_text(json.dumps(checks,indent=2)+'\n',encoding='utf8')
sys.path.insert(0,str(Path('tools/site').resolve()))
from test_submit import SubmitTests
from test_receipt_journal import RAW
from deployment.submit import execute
from deployment.smoke import record
from deployment.receipt import observed
from deployment.transport import Result
from deployment.poll import Stop
from journal import load
from journal.model import encode,decode
from payload import digest,tar_bytes
with tempfile.TemporaryDirectory() as d:
 server,mirror,intent,kw=SubmitTests().setup(d)
 root=Path(d)/'site';root.mkdir()
 files={'index.html':b'<h1>Doc</h1>','build.json':encode(dict(source_commit=intent.source_commit,base_path='/NEPL3/',capability='docs-only')),'.nojekyll':b''}
 files['manifest.json']=encode(dict(version=1,files=[dict(path=n,bytes=len(b),sha256=digest(b)) for n,b in files.items()]))
 for n,b in files.items():(root/n).write_bytes(b)
 identity=digest(files['manifest.json']);intent=replace(intent,payload_sha256=digest(tar_bytes(files)))
 phases=iter(['deployment_in_progress','succeed']);calls=[]
 def get(receipt,token,**options):
  state=load(server);calls.append(state.events[-1].kind)
  raw=encode(dict(status=next(phases)));return Result(observed(raw,receipt=receipt,request_url=receipt.status_endpoint),raw)
 with patch('deployment.submit.create',return_value=(None,RAW)) as post,patch('deployment.transport.status',side_effect=get),patch('time.sleep'):
  head,result=execute(mirror,None,intent,**dict(kw,remaining_seconds=600))
 assert result.stop==Stop.SUCCEEDED and post.call_count==1 and calls==['DeployReceipt','Observation']
 report=dict(result='passed',source_commit=intent.source_commit,manifest_sha256=identity,url='https://neknaj.github.io/NEPL3/',transport='https',publication_verified=False)
 with patch('deployment.smoke.http_smoke.run',return_value=report):
  final,actual=record(mirror,head,root,identity,report['url'],expected_url=str(server),owner='neknaj',repository='NEPL3',remaining_seconds=300)
 state=load(server)
 assert state.head==final and state.events[-1].kind=='SmokePassed' and decode(state.evidence[-1])['report']==report
 assert all(e.transaction==intent.transaction and e.payload_sha256==intent.payload_sha256 for e in state.events)
 outcome=dict(events=[e.kind for e in state.events],post_calls=post.call_count,get_preceding_remote_events=calls,remote_final_head=final,raw_smoke_preserved=True,identity_preserved=True)
(p/('chain-optimized.json' if sys.flags.optimize else 'chain-normal.json')).write_text(json.dumps(outcome,indent=2)+'\n',encoding='utf8');print(json.dumps(outcome))
