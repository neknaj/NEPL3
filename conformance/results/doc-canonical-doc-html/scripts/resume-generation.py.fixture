from pathlib import Path
import subprocess,json,hashlib,time
root=Path.cwd();out=root/'.tmp/resumed-generation';out.mkdir(exist_ok=False)
head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
assert not subprocess.check_output(['git','status','--porcelain']).strip()
binary=root/'target/debug/nepl3-tools.exe';rows=[]
def run(name,cmd):
    row=dict(head=head,command=cmd,registry_sha256=hashlib.sha256((root/'doc/canonical.json').read_bytes()).hexdigest());rows.append(row);start=time.monotonic()
    with (out/(name+'.stdout.log')).open('wb') as stdout,(out/(name+'.stderr.log')).open('wb') as stderr:
        p=subprocess.Popen(cmd,stdout=stdout,stderr=stderr);row['pid']=p.pid
        try:row['exit_code']=p.wait(timeout=1200)
        except subprocess.TimeoutExpired:p.kill();p.wait();row.update(exit_code=p.returncode,result='timeout')
    row.update(elapsed_seconds=time.monotonic()-start)
    if binary.exists():row['binary_sha256']=hashlib.sha256(binary.read_bytes()).hexdigest()
    (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8',newline='\n')
    assert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==head
    assert not subprocess.check_output(['git','status','--porcelain']).strip()
    print(name,row['exit_code'],row['elapsed_seconds'],flush=True)
    if row['exit_code']:
        print((out/(name+'.stderr.log')).read_text(encoding='utf-8')[-2000:],flush=True)
        raise SystemExit(row['exit_code'])
run('build',['cargo','build','--locked','-p','nepl3-tools'])
for phase in ['first','second']:
    for kind in ['markdown','html']:
        run(kind+'-'+phase,[str(binary),'doc-canonical',kind,f'.tmp/{kind}-resumed-{phase}'])
for kind,count in [('markdown',11),('html',12)]:
    def bundle(phase):return {p.relative_to(root/f'.tmp/{kind}-resumed-{phase}').as_posix():p.read_bytes() for p in (root/f'.tmp/{kind}-resumed-{phase}').rglob('*') if p.is_file()}
    a,b=bundle('first'),bundle('second');assert a==b and len(a)==count
    assert any('20-doc-html' in n for n in a)
    (out/(kind+'-comparison.json')).write_text(json.dumps([dict(path=n,bytes=len(v),sha256=hashlib.sha256(v).hexdigest()) for n,v in a.items()],indent=2)+'\n',encoding='utf-8',newline='\n')
    print(kind,count,'byte-identical files',flush=True)
