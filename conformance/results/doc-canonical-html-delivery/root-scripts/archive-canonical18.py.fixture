from pathlib import Path
import hashlib,json,subprocess,sys
root=Path.cwd();out=root/'conformance/results/doc-canonical-html-delivery';out.mkdir(parents=True,exist_ok=True)
rows=[]
def save(owner,path,relative):
    data=path.read_bytes();assert len(data)<=1048576,path
    safe='/'.join('saved-'+p.lstrip('.') if p in {'.tmp','dist','target','.git','node_modules','__pycache__'} else p for p in relative.split('/'))
    name=f'{owner}/{safe}.fixture';destination=out/name
    assert destination.resolve().is_relative_to(out.resolve())
    destination.parent.mkdir(parents=True,exist_ok=True);destination.write_bytes(data)
    rows.append(dict(owner=owner,file=name,restore=relative,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
for owner,name in [('root-observation','generation'),('root-generation','generation-budget'),('root-fixed','verification-fixed'),('root-html-first','html-budget-first'),('root-html-second','html-budget-second'),('root-markdown-first','markdown-budget-first'),('root-markdown-second','markdown-budget-second'),('root-browser','browser-canonical18'),('root-github','github-canonical18-final'),('root-github-initial-label','github-canonical18')]:
    directory=root/'.tmp'/name
    for path in sorted(directory.rglob('*')):
        if path.is_file():save(owner,path,path.relative_to(directory).as_posix())
for name in ['start.json','original.md','prepare.py','generate.py','select-html-budget.py','html-budget-selection.json','generate-budget.py','verify-fixed.py','browser-canonical18.py','github-canonical18.py','github-canonical18-final.py','github-count-correction.md','archive-canonical18.py']:
    save('root-scripts',root/'.tmp'/name,name)
directories={'review-content':Path('C:/projects/NEPL3-doc-canonical-page-context/.tmp/preflight-canonical18')}
if '--review' in sys.argv:
    directories.update({'review-code':root/'.tmp/review-canonical18-code','review-cutover':root/'.tmp/review-canonical18-cutover'})
if '--bootstrap' in sys.argv:
    for path in sorted((root/'.tmp/bootstrap-canonical18').iterdir()):
        if path.is_file():save('root-bootstrap',path,path.name)
for owner,directory in directories.items():
    manifest=json.loads((directory/'manifest.json').read_text(encoding='utf-8'));save(owner,directory/'manifest.json','manifest.json')
    for row in manifest['files']:
        path=directory/row['path'];data=path.read_bytes()
        assert len(data)==row['bytes'] and hashlib.sha256(data).hexdigest()==row['sha256']
        save(owner,path,row['path'])
head='799f00d6384d45e8160b51366d03fecb1dd2dfe1';sources=[]
for name in ['doc/canonical.json','doc/spec/01-architecture.md','doc/spec/18-html-delivery.md','doc/spec/18-html-delivery.nepld','doc/migration/aliases/18-html-delivery.json']:
    data=(root/name).read_bytes();assert data==subprocess.check_output(['git','show',head+':'+name])
    sources.append(dict(path=name,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
test_commit='3abd255d5a52eec41f741b6b17e4ec9e2213efdc'
test_path='tools/src/doc/canonical/tests.rs';data=(root/test_path).read_bytes()
assert data==subprocess.check_output(['git','show',test_commit+':'+test_path])
test_source=dict(commit=test_commit,path=test_path,bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
(out/'payloads.json').write_text(json.dumps(dict(implementation_commit=head,sources=sources,test_source=test_source,files=rows),indent=2)+'\n',encoding='utf-8',newline='\n')
(out/'.gitattributes').write_text('*.fixture -text -whitespace\n',encoding='utf-8',newline='\n')
print(len(rows),'payloads',sum(r['bytes'] for r in rows),'bytes')
