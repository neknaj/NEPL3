from pathlib import Path
import json,hashlib,subprocess
root=Path.cwd();path=root/'doc/canonical.json';before=path.read_bytes()
registry=json.loads(before)
assert 'html_output_limits' not in registry
registry['html_output_limits']=dict(registry['output_limits'])
assert registry['html_output_limits']['work']==300_000_000
assert registry['html_output_limits']['allocation_units']==750_000_000
path.write_text(json.dumps(registry,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
(root/'.tmp/html-budget-selection.json').write_text(json.dumps(dict(reason='Prior five-page canonical HTML run stopped at the independent default Work100M. This is a separately selected new operation, not a continuation of that stopped budget.',head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),prior_registry_sha256=hashlib.sha256(before).hexdigest(),new_registry_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),html_output_limits=registry['html_output_limits']),indent=2)+'\n',encoding='utf-8')
source=(root/'.tmp/generate.py').read_text(encoding='utf-8')
source=source.replace("out=root/'.tmp/generation'", "out=root/'.tmp/generation-budget'")
source=source.replace("f'.tmp/{kind}-{phase}'", "f'.tmp/{kind}-budget-{phase}'")
source=source.replace("root/'.tmp/markdown-first'", "root/'.tmp/markdown-budget-first'")
source=source.replace("f'.tmp/{kind}-first'", "f'.tmp/{kind}-budget-first'").replace("f'.tmp/{kind}-second'", "f'.tmp/{kind}-budget-second'")
(root/'.tmp/generate-budget.py').write_text(source,encoding='utf-8',newline='\n')
