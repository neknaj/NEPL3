from pathlib import Path
import hashlib,json,subprocess,time
root=Path.cwd();out=root/'.tmp/generation-budget';out.mkdir(exist_ok=True)
rows=[]
for phase in ['first','second']:
    for kind in ['markdown','html']:
        cmd=['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical',kind,f'.tmp/{kind}-budget-{phase}']
        started=time.monotonic()
        with (out/f'{kind}-{phase}.stdout.log').open('wb') as stdout,(out/f'{kind}-{phase}.stderr.log').open('wb') as stderr:
            p=subprocess.run(cmd,stdout=stdout,stderr=stderr,timeout=1200)
        rows.append(dict(command=cmd,exit_code=p.returncode,elapsed=time.monotonic()-started))
        (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8')
        if p.returncode:
            print((out/f'{kind}-{phase}.stderr.log').read_text(encoding='utf-8')[-1200:],flush=True)
            raise SystemExit(p.returncode)
        print(kind,phase,'PASS',flush=True)
    if phase=='first':
        registry=json.loads((root/'doc/canonical.json').read_bytes())
        changes=[]
        for page in registry['pages']:
            path=root/page['projection'];old=path.read_bytes();new=(root/'.tmp/markdown-budget-first'/page['projection']).read_bytes()
            if page['id']=='architecture':assert old.split(b'\n\n',1)[1]==new.split(b'\n\n',1)[1]
            elif page['id']!='html-delivery':assert old==new
            if old!=new:
                changes.append(dict(path=page['projection'],old_sha256=hashlib.sha256(old).hexdigest(),new_sha256=hashlib.sha256(new).hexdigest()))
                path.write_bytes(new)
        (out/'adoption.json').write_text(json.dumps(changes,indent=2)+'\n',encoding='utf-8')
for kind in ['markdown','html']:
    a=root/f'.tmp/{kind}-budget-first';b=root/f'.tmp/{kind}-budget-second'
    first={p.relative_to(a).as_posix():p.read_bytes() for p in a.rglob('*') if p.is_file()}
    second={p.relative_to(b).as_posix():p.read_bytes() for p in b.rglob('*') if p.is_file()}
    assert first==second
    (out/f'{kind}-comparison.json').write_text(json.dumps([dict(path=n,bytes=len(v),sha256=hashlib.sha256(v).hexdigest()) for n,v in first.items()],indent=2)+'\n',encoding='utf-8')
    print(kind,len(first),'files byte-identical',flush=True)
