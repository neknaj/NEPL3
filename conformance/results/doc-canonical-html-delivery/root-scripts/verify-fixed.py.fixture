from pathlib import Path
import subprocess,json,time,hashlib
root=Path.cwd();out=root/'.tmp/verification-fixed';out.mkdir(exist_ok=True)
def head():return subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
def clean():return not subprocess.check_output(['git','status','--porcelain']).strip()
fixed=head();assert clean();rows=[]
for name,cmd in [('check',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','--check']),('markdown',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','markdown','.tmp/markdown-fixed']),('html',['cargo','run','--locked','-p','nepl3-tools','--','doc-canonical','html','.tmp/html-fixed'])]:
    assert head()==fixed and clean();started=time.monotonic()
    with (out/(name+'.stdout.log')).open('wb') as stdout,(out/(name+'.stderr.log')).open('wb') as stderr:
        p=subprocess.run(cmd,stdout=stdout,stderr=stderr,timeout=1200)
    unchanged=head()==fixed and clean()
    rows.append(dict(source_commit=fixed,unchanged_clean_tree=unchanged,command=cmd,exit_code=p.returncode,elapsed=time.monotonic()-started))
    (out/'commands.json').write_text(json.dumps(rows,indent=2)+'\n',encoding='utf-8')
    assert unchanged and p.returncode==0
    print(name,'PASS',flush=True)
for kind in ['markdown','html']:
    a=root/f'.tmp/{kind}-fixed';b=root/f'.tmp/{kind}-budget-first'
    values={p.relative_to(a).as_posix():p.read_bytes() for p in a.rglob('*') if p.is_file()}
    prior={p.relative_to(b).as_posix():p.read_bytes() for p in b.rglob('*') if p.is_file()}
    assert values==prior
    (out/f'{kind}-comparison.json').write_text(json.dumps([dict(path=n,bytes=len(v),sha256=hashlib.sha256(v).hexdigest()) for n,v in values.items()],indent=2)+'\n',encoding='utf-8')
    print(kind,len(values),'fixed-commit files equal prior generation',flush=True)
