from pathlib import Path
import hashlib,json,subprocess
root=Path.cwd();tmp=root/'.tmp';tmp.mkdir(exist_ok=True)
assert not subprocess.check_output(['git','status','--porcelain']).strip()
head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
(tmp/'start.json').write_text(json.dumps(dict(commit=head,status='',purpose='Prepare chapter18 on the pending chapter01 cutover; no merge or acceptance completion claimed'),indent=2)+'\n',encoding='utf-8')
source=root/'doc/migration/authored/18-html-delivery.nepld'
assert hashlib.sha256(source.read_bytes()).hexdigest()=='90c02690b3b98e6c6d305c69750a65678d1ad81c7688042620a77b600babac73'
original=(root/'doc/spec/18-html-delivery.md').read_bytes()
assert hashlib.sha256(original).hexdigest()=='d084c6ac2b6855adc4cf7e4a8fd7e64e0f8982c7a2259ea6e248481414eb5e71'
(tmp/'original.md').write_bytes(original)
source.rename(root/'doc/spec/18-html-delivery.nepld')
aliases=[dict(section=s,name=n) for s,n in [(None,'18-htmlを先行利用する実装段階'),('implementation_dependencies','実装依存'),('document_preparation','h0h1の契約'),('math_and_browser','h2h3の契約と検証'),('documentation_migration','正式文書のdoc移行')]]
(root/'doc/migration/aliases/18-html-delivery.json').write_text(json.dumps(aliases,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
path=root/'doc/canonical.json';registry=json.loads(path.read_bytes())
registry['pages'].append(dict(id='html-delivery',source='doc/spec/18-html-delivery.nepld',projection='doc/spec/18-html-delivery.md',aliases='doc/migration/aliases/18-html-delivery.json',route='docs/spec/18-html-delivery.html',renderer='nepl3-tools.markdown-annotated/2'))
path.write_text(json.dumps(registry,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
print('unchanged manuscript moved; existing output limits retained')
