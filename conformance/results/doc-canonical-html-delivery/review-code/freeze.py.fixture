from pathlib import Path
import subprocess,json,hashlib
p=Path(__file__).parent.resolve();root=p.parents[1];head='799f00d6384d45e8160b51366d03fecb1dd2dfe1';base=subprocess.check_output(['git','rev-parse','3d33a63'],cwd=root).decode().strip()
def git(*a):return subprocess.check_output(['git',*a],cwd=root)
def sha(b):return hashlib.sha256(b).hexdigest()
def put(n,b):q=p/n;q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b)
changed=['doc/canonical.json','doc/migration/aliases/18-html-delivery.json','doc/migration/authored/18-html-delivery.nepld','doc/spec/01-architecture.md','doc/spec/18-html-delivery.md','doc/spec/18-html-delivery.nepld']
assert sorted(git('diff','--no-renames','--name-only',base,head).decode().splitlines())==sorted(changed)
assert git('show',head+':tools/src/doc/canonical.rs')==git('show','4de46ba:tools/src/doc/canonical.rs')
assert git('show',head+':tools/tests/doc/annotated_pages.rs')==git('show','652347c:tools/tests/doc/annotated_pages.rs')
scope=changed+['AGENTS.md','doc/authoring.md','doc/spec/16-doc-migration.md','doc/spec/21-doc-pages.md','tools/src/doc/canonical.rs','tools/src/doc/canonical/projection.rs','tools/src/doc/export/pages.rs','tools/src/doc/export/pages/resources.rs','tools/src/doc/projection/annotated/blocks.rs','tools/tests/doc/annotated_pages.rs','design/forms.json','tools/audit/structure.py']
reg=json.loads(git('show',head+':doc/canonical.json'))
for page in reg['pages']:scope.extend(page[k] for k in ['source','projection','aliases'])
scope=list(dict.fromkeys(scope))
names=git('ls-tree','-r','--name-only',head).decode().splitlines();names=[n for n in names if '/' not in n or n.startswith(('tools/','crates/','design/','interfaces/','languages/','doc/','conformance/fixtures/','examples/','.cargo/'))]
proc=subprocess.Popen(['git','cat-file','--batch'],cwd=root,stdin=subprocess.PIPE,stdout=subprocess.PIPE);rows=[]
for n in names:
    proc.stdin.write((head+':'+n+'\n').encode());proc.stdin.flush();h=proc.stdout.readline().split();assert h[1]==b'blob';b=proc.stdout.read(int(h[2]));assert proc.stdout.read(1)==b'\n'
    put('workspace/'+n,b);rows.append(dict(path=n,sha256=sha(b),bytes=len(b)))
    if n in scope:put('source/'+n,b)
proc.stdin.close();assert proc.wait()==0
for n in changed:
    r=subprocess.run(['git','show',base+':'+n],cwd=root,capture_output=True)
    if r.returncode==0:put('before/'+n,r.stdout)
put('source.patch',git('diff','--binary',base,head))
pre=Path('C:/projects/NEPL3-doc-canonical-page-context/.tmp/preflight-canonical18');m=(pre/'manifest.json').read_bytes();put('prior-content/manifest.json',m)
for row in json.loads(m)['files']:
    b=(pre/row['path']).read_bytes();assert len(b)==row['bytes'] and sha(b)==row['sha256'];put('prior-content/'+row['path'],b)
prior=Path('C:/projects/NEPL3-doc-canonical-architecture/.tmp/review-canonical01-code');m=(prior/'manifest.json').read_bytes();put('prior-g/manifest.json',m)
index={r['path']:r for r in json.loads(m)['files']}
for n in ['html-first/docs/spec/00-contract.html','html-first/docs/spec/01-architecture.html','html-first/docs/spec/13-reproducibility.html','html-first/docs/spec/22-external-extensions.html','html-first/docs/spec/assets/doc.css','record.md']:
    b=(prior/n).read_bytes();r=index[n];assert len(b)==r['bytes'] and sha(b)==r['sha256'];put('prior-g/'+n,b)
put('snapshot.json',(json.dumps(dict(head=head,base=base,changed=changed,scope=scope,code_identity='canonical.rs equals reviewedI4de; annotated_pages fixture equals reviewedG652'),indent=2)+'\n').encode());put('dependencies.json',(json.dumps(rows,indent=2)+'\n').encode())
print('Frozen',len(rows),'Git dependencies, six H paths, prior content and G artifact bytes')
