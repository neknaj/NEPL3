from pathlib import Path
from html.parser import HTMLParser
import subprocess,json,hashlib,time
root=Path.cwd();out=root/'.tmp/github-lists';out.mkdir(exist_ok=True)
source='''article en "Lists" body
cons list unordered cons item checked body cons paragraph cons "[A/a]" nil nil nil
cons list unordered cons item unchecked body cons paragraph cons "B" nil nil nil
cons list ordered 7 cons item none body cons paragraph cons "C" nil nil nil
cons list ordered 7 cons item none body cons paragraph cons "D" nil nil nil
cons list ordered 42 cons item none body cons paragraph cons sentence
  cons text "E" cons break cons code "x" nil nil nil nil
cons list unordered cons item none body cons paragraph cons "<!-- -->" nil nil nil nil
'''
(out/'source.nepld').write_text(source,encoding='utf-8',newline='\n')
(out/'aliases.json').write_text('[]\n',encoding='utf-8',newline='\n')
cmd=[str(root/'target/debug/nepl3-tools.exe'),'doc-markdown','annotated',str(out/'source.nepld'),str(out/'aliases.json'),str(out/'view.md')]
start=time.monotonic();p=subprocess.run(cmd,capture_output=True)
(out/'generation.stdout.log').write_bytes(p.stdout);(out/'generation.stderr.log').write_bytes(p.stderr)
assert p.returncode==0,p.stderr
markdown=(out/'view.md').read_text(encoding='utf-8')
payload=json.dumps(dict(text=markdown,mode='gfm',context='neknaj/NEPL3')).encode()
api=['gh','api','markdown','--input','-'];r=subprocess.run(api,input=payload,capture_output=True)
(out/'github.html').write_bytes(r.stdout);(out/'github.stderr.log').write_bytes(r.stderr);assert r.returncode==0,r.stderr
class Structure(HTMLParser):
    def __init__(self):
        super().__init__();self.lists=[];self.stack=[];self.items=[];self.checks=[];self.breaks=0;self.text=[]
    def handle_starttag(self,tag,attrs):
        attrs=dict(attrs)
        if tag in ('ol','ul'):
            assert not self.stack,'unexpected nesting';self.stack.append(tag)
            self.lists.append((tag,attrs.get('start')));self.items.append(0)
        if tag=='li':self.items[-1]+=1
        if tag=='input' and attrs.get('type')=='checkbox':self.checks.append('checked' in attrs)
        if tag=='br':self.breaks+=1
    def handle_endtag(self,tag):
        if tag in ('ul','ol'):assert self.stack.pop()==tag
    def handle_data(self,text):self.text.append(text)
parsed=Structure();parsed.feed(r.stdout.decode())
assert parsed.lists==[('ul',None),('ul',None),('ol','7'),('ol','7'),('ol','42'),('ul',None)],parsed.lists
assert parsed.items==[1]*6 and parsed.checks==[True,False] and parsed.breaks==1
assert '<!-- -->' in ''.join(parsed.text),'source text was lost as a comment'
assert markdown.count('<!-- -->')==5
record=dict(source_commit=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),
    generation_command=cmd,github_command=api,generation_exit=p.returncode,github_exit=r.returncode,
    elapsed_seconds=time.monotonic()-start,lists=parsed.lists,items=parsed.items,checks=parsed.checks,breaks=parsed.breaks,
    scope='Real production Doc source to annotated Markdown to GitHub GFM API HTML; not browser, accessibility or canonical migration acceptance',
    files={f.name:hashlib.sha256(f.read_bytes()).hexdigest() for f in out.iterdir() if f.is_file()})
(out/'result.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8',newline='\n')
print('GitHub GFM: 6 independent lists, starts7/7/42, 2 task markers and break preserved')
