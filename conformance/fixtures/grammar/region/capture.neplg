language Regions 1 Expr
  cons category Expr Main
  cons reader word some scalar digit
  cons reader head literal "pair"
  cons reader ws some scalar whitespace
  cons mode Main cons skip ws cons take Head head cons take Word word nil
  cons leaf Word Expr Word none
    cons selection self 3 nil
  cons form Pair Expr "pair"
    cons field first local Expr
    cons field second local Expr
    nil
    group cons visit first cons visit second nil
    cons style head "marker"
    cons selection head 7
    cons selection capture absent 9
    nil
  nil
