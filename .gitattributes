* text=auto eol=lf
*.rs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.neplg text eol=lf
*.nepld text eol=lf
*.neplm text eol=lf
*.neplc text eol=lf
*.ndf binary
*.png binary
*.zip binary

# Command evidence retains the original bytes, including Windows line endings.
conformance/results/**/*.stdout -text -whitespace
conformance/results/**/*.stderr -text -whitespace
conformance/results/**/spec.json -text -whitespace

# 取り込み元の証拠とsource位置試験は元byte列を保つ。
doc/history/source-manifest.json -text
doc/history/design-validation.json -text
conformance/fixtures/source/** -text

# 取得したCIログの元の空白・制御文字を、整形対象のソースとして変更しない。
conformance/results/foundation-slice/main-ci.log -text -whitespace
# Hash-bound raw execution and independent review records retain original bytes.

.tmp/** export-ignore
target/** export-ignore
dist/** export-ignore

/conformance/results/doc-pages/** -text -whitespace
